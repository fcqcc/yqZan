<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    wx:for-index="idx"
    class="tab-item {{selected === idx ? 'active' : ''}}"
    data-index="{{idx}}"
    catchtouchstart="onTabTouchStart"
  >
    <image
      class="tab-icon"
      src="{{selected === idx ? item.iconActive : item.icon}}"
      mode="aspectFit"
      lazy-load="{{false}}"
    />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
