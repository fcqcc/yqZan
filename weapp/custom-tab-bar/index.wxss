.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 500;
  display: flex;
  justify-content: space-around;
  align-items: stretch;
  padding: 2rpx 12rpx 0;
  padding-bottom: calc(4rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(4rpx + env(safe-area-inset-bottom));
  background: #fff5fb;
  border-top: 1px solid #ffd6e8;
  box-shadow: 0 -4rpx 16rpx rgba(214, 92, 138, 0.08);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 0;
  color: #8a6a7a;
  font-size: 18rpx;
}

.tab-item.active {
  color: #d65c8a;
  font-weight: 600;
}

.tab-icon {
  width: 54rpx;
  height: 54rpx;
  display: block;
  pointer-events: none;
}

.tab-text {
  font-size: 18rpx;
  line-height: 1;
  margin-top: 2rpx;
  pointer-events: none;
}
