/* 全站主题「Bloom」— 偏粉、实色块面、无毛玻璃 */

page {
  background: linear-gradient(165deg, #fff5fb 0%, #ffe8f2 42%, #ffd6ea 100%) !important;
  background-attachment: fixed;
  min-height: 100%;
}

.app-root {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
}

/* ---------- 粉调实色：卡片不透底、描边柔和 ---------- */
.app-root.app-theme-bloom {
  --text: #3d2c38;
  --text-secondary: #8a6a7a;
  --text-light: #b89aa8;
  --pink: #f8a5c4;
  --pink-dark: #d65c8a;
  --cream: #fff5f9;
  --gold: #c9a0b2;
  --gold-light: #f5e3ec;
  --purple: #b59ed4;
  --purple-light: #f3ecfc;
  --pink-glass: rgba(248, 165, 196, 0.35);
  --white: #ffffff;
  --card-bg: #ffffff;
  --card-border: 1px solid #ffd6e8;
  --shadow-sm: 0 2px 10px rgba(214, 92, 138, 0.1);
  --shadow-md: 0 8px 24px rgba(214, 92, 138, 0.12), 0 2px 8px rgba(214, 92, 138, 0.06);
  --shadow-lg: 0 14px 36px rgba(214, 92, 138, 0.14), 0 4px 12px rgba(214, 92, 138, 0.08);
  --save-ring-track: rgba(214, 92, 138, 0.2);
  --progress-bar-bg: rgba(214, 92, 138, 0.15);
  --tag-bg: rgba(248, 165, 196, 0.45);
  --empty-color: #b89aa8;
  --glass-bg: #fff8fc;
  --glass-border: #ffd6e8;
  --glass-shadow: 0 12rpx 32rpx rgba(214, 92, 138, 0.12), 0 4rpx 12rpx rgba(214, 92, 138, 0.06);
  --settings-label: #8a6a7a;
  --settings-code: #c45a8a;
  --level-badge-bg: rgba(248, 165, 196, 0.35);
  --divider: rgba(214, 92, 138, 0.15);
  --menu-hover: rgba(214, 92, 138, 0.1);
  --chevron: rgba(61, 44, 56, 0.28);
  --avatar-ph-text: #c45a8a;
  --avatar-slot-border: rgba(214, 92, 138, 0.45);
  --avatar-slot-bg: #fff0f7;
  --unbind-color: #e85a7a;
  --unbind-bg: #ffe4ec;
  --logout-color: #8a6a7a;
  --logout-bg: #f5eef2;
  --chip-off-bg: #fff8fc;
  --chip-off-border: rgba(214, 92, 138, 0.22);
  --chip-on-bg: rgba(214, 92, 138, 0.14);
  --chip-on-border: rgba(214, 92, 138, 0.4);
  --chip-on-text: #b03070;
  --accent: #d65c8a;
  --accent-partner: #f8a5c4;
  --accent-soft: rgba(214, 92, 138, 0.14);
  --avatar-ph-bg: linear-gradient(145deg, #ffffff, #ffe3f0);
  --unbind-shadow: 0 8rpx 20rpx rgba(232, 90, 122, 0.18);
  --login-page-bg: linear-gradient(155deg, #3d2440 0%, #6b3560 45%, #d65c8a 100%);
  --login-card-bg: #ffffff;
  --login-accent: #d65c8a;
  --login-muted: #9a7a8a;
  background: linear-gradient(165deg, #fff5fb 0%, #ffe8f2 42%, #ffd6ea 100%);
}

/* 登录页 */
.app-root .login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--login-page-bg);
  padding: 20px;
  box-sizing: border-box;
}

.app-root .login-card {
  background: var(--login-card-bg);
  border-radius: 14px;
  padding: 32px 24px;
  width: 100%;
  max-width: 340px;
  text-align: center;
  box-sizing: border-box;
  border: 1px solid #ffd6e8;
  box-shadow: 0 16px 40px rgba(61, 36, 56, 0.18);
}

.app-root .app-name {
  color: var(--login-accent);
}

.app-root .switch {
  color: var(--login-accent);
}

.app-root .app-desc {
  color: var(--login-muted);
}
