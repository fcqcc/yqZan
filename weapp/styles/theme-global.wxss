/* 全站主题 — 可爱手绘风（默认） */
@import 'theme-handdrawn.wxss';

page {
  background:
    radial-gradient(circle at 20% 80%, rgba(232, 145, 164, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(168, 212, 230, 0.12) 0%, transparent 50%),
    linear-gradient(180deg, #FFF9F5 0%, #FFE8EE 100%) !important;
  background-attachment: fixed;
  min-height: 100%;
}

.app-root {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  color: var(--text, #5D4E60);
}

/* 手绘风（默认） */
.app-root.app-theme-handdrawn,
.app-theme-handdrawn {
  --text: #5D4E60;
  --text-secondary: #8B7A8E;
  --text-light: #B8A9BB;
  --rose: #E891A4;
  --rose-light: #FADCE6;
  --rose-pale: #FFF0F5;
  --rose-deep: #D4708A;
  --primary: #E891A4;
  --primary-light: #FADCE6;
  --primary-pale: #FFF0F5;
  --cream: #FFF9F5;
  --gradient-header: linear-gradient(135deg, #E891A4 0%, #D4708A 50%, #E891A4 100%);
  --login-page-bg: linear-gradient(180deg, #FFFFFF 0%, #FFF0F5 100%);
  --login-accent: #D4708A;
  --login-muted: #8B7A8E;
  background: transparent;
}

.app-root .login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--login-page-bg);
  padding: 40px 24px;
  box-sizing: border-box;
}

.app-root .login-title {
  color: #4A3548;
}

.app-root .app-desc,
.app-root .login-subtitle {
  color: #5D4E60;
}

.app-root .login-footer {
  color: #6B5A6E;
}

/* 蜜桃苏打（备选，设置页可切换） */
.app-root.app-theme-bloom {
  --text: #3a2e35;
  --text-secondary: #8a7078;
  --rose: #ff6b9d;
  --rose-light: #ff8fab;
  --rose-pale: #ffe8f0;
  --rose-deep: #e84d85;
  --primary: #ff6b9d;
  --primary-light: #ff8fab;
  --gradient-header: linear-gradient(180deg, #ff8fab 0%, #ff6b9d 50%, #d4a0f0 100%);
  --login-page-bg: linear-gradient(155deg, #f06b8f 0%, #e84d85 45%, #9b6fd4 100%);
  background: linear-gradient(165deg, #fff5f2 0%, #fff0eb 42%, #ffe8f0 100%);
}
