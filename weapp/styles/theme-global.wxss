/* 全站主题 — 可爱手绘风（默认） */
@import 'theme-handdrawn.wxss';

page {
  background:
    radial-gradient(circle at 20% 80%, rgba(249, 168, 92, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(168, 212, 230, 0.12) 0%, transparent 50%),
    linear-gradient(180deg, #FFF8E6 0%, #FDF0D8 100%) !important;
  background-attachment: fixed;
  min-height: 100%;
}

.app-root {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  color: var(--text, #7A5C4A);
}

/* 手绘风（默认） */
.app-root.app-theme-handdrawn,
.app-theme-handdrawn {
  --text: #7A5C4A;
  --text-secondary: #A89080;
  --text-light: #C8B8A8;
  --rose: #F9A85C;
  --rose-light: #FDE8C8;
  --rose-pale: #FFF8E6;
  --rose-deep: #E8924C;
  --primary: #F9A85C;
  --primary-light: #FDE8C8;
  --primary-pale: #FFF8E6;
  --cream: #FFF8E6;
  --gradient-header: linear-gradient(135deg, #F9A85C 0%, #E8924C 50%, #F9A85C 100%);
  --login-page-bg: linear-gradient(180deg, #FFFFFF 0%, #FFF8E6 100%);
  --login-accent: #E8924C;
  --login-muted: #A89080;

  /* ===== 字体现范 ===== */
  /* 字族 */
  --font-deco: 'ZCOOL KuaiLe', cursive;
  --font-body: 'Noto Sans SC', -apple-system, sans-serif;

  /* 字号 & 字重 */
  --text-h1-size: 34rpx;
  --text-h1-weight: 700;
  --text-h2-size: 32rpx;
  --text-h2-weight: 700;
  --text-h3-size: 30rpx;
  --text-h3-weight: 700;
  --text-body-size: 28rpx;
  --text-body-weight: 500;
  --text-meta-size: 24rpx;
  --text-meta-weight: 500;
  --text-tag-size: 20rpx;
  --text-tag-weight: 600;
  --text-hero-xl: 100rpx;
  --text-hero-lg: 64rpx;
  --text-hero-md: 48rpx;
  --text-hero-sm: 36rpx;

  /* 标签页栏字号 */
  --text-tab-size: 20rpx;

  background: transparent;
}

.app-root .login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--login-page-bg);
  padding: 40px 24px;
  box-sizing: border-box;
}

.app-root .login-title {
  color: #5D3E2A;
}

.app-root .app-desc,
.app-root .login-subtitle {
  color: #7A5C4A;
}

.app-root .login-footer {
  color: #8B6E5A;
}

/* 蜜桃苏打（备选，设置页可切换） */
.app-root.app-theme-bloom {
  --text: #3a2e35;
  --text-secondary: #8a7078;
  --rose: #ff6b9d;
  --rose-light: #ff8fab;
  --rose-pale: #ffe8f0;
  --rose-deep: #e84d85;
  --primary: #ff6b9d;
  --primary-light: #ff8fab;
  --gradient-header: linear-gradient(180deg, #ff8fab 0%, #ff6b9d 50%, #d4a0f0 100%);
  --login-page-bg: linear-gradient(155deg, #f06b8f 0%, #e84d85 45%, #9b6fd4 100%);
  background: linear-gradient(165deg, #fff5f2 0%, #fff0eb 42%, #ffe8f0 100%);
}
