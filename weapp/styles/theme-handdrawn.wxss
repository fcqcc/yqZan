/* ===== 可爱手绘风主题（完整版） ===== */
/* 与 .app-theme-handdrawn 配合使用 */

.app-theme-handdrawn {
  /* ── 色板 ── */
  --hd-primary: #F9A85C;
  --hd-primary-dark: #E8924C;
  --hd-primary-light: #FDE8C8;
  --hd-primary-pale: #FFF8E6;
  --hd-accent: #FFD93D;
  --hd-success: #7BC67B;
  --hd-text: #5D3E2A;
  --hd-text-secondary: #8B6E5A;
  --hd-text-light: #A89080;
  --hd-bg-cream: #FFF8EC;
  --hd-bg-pink: #FDF0D8;
  --hd-card-bg: #FFFDF8;
  --hd-border: #E8D0B8;
  --hd-line-dot: #E0D0C0;

  /* 覆盖现有 theme-global 变量 */
  --text: #5D3E2A;
  --text-secondary: #8B6E5A;
  --text-light: #A89080;
  --text-muted: #A89080;
  --rose: #F9A85C;
  --rose-light: #FDE8C8;
  --rose-pale: #FFF8E6;
  --rose-deep: #E8924C;
  --peach: #F9A85C;
  --lilac: #D4A0E8;
  --lilac-pale: #F5EDFF;
  --mint: #7BC67B;
  --primary: #F9A85C;
  --primary-light: #FDE8C8;
  --primary-pale: #FFF8E6;
  --ink: #5D3E2A;
  --ink-soft: #8B6E5A;
  --ink-muted: #A89080;
  --bg-start: #FFF8EC;
  --bg-mid: #FFF2E0;
  --bg-end: #FDF0D8;
  --surface: #FFFDF8;
  --card-bg: #FFFDF8;
  --card-border: 2px dashed #E8D0B8;
  --line: #E0D0C0;
  --line-strong: #E8D0B8;
  --header-start: #F9A85C;
  --header-mid: #E8924C;
  --header-end: #F9A85C;
  --gradient-header: linear-gradient(180deg, #F9A85C 0%, #E8924C 50%, #F9A85C 100%);
  --progress-bar-bg: rgba(249, 168, 92, 0.2);

  background: 
    radial-gradient(circle at 15% 30%, rgba(249, 168, 92, 0.07) 0%, transparent 45%),
    radial-gradient(circle at 85% 70%, rgba(255, 217, 61, 0.05) 0%, transparent 40%),
    linear-gradient(165deg, #FFF8EC 0%, #FFF2E0 42%, #FDF0D8 100%) !important;
}

/* ===== 所有卡片 ===== */
.app-theme-handdrawn .card,
.app-theme-handdrawn .plan-item,
.app-theme-handdrawn .plan-card,
.app-theme-handdrawn .anni-item,
.app-theme-handdrawn .wish-card,
.app-theme-handdrawn .note-item,
.app-theme-handdrawn .pet-card,
.app-theme-handdrawn .section-card,
.app-theme-handdrawn .menu-group,
.app-theme-handdrawn .bind-card,
.app-theme-handdrawn .vault-card__body,
.app-theme-handdrawn .checkin,
.app-theme-handdrawn .exp-card,
.app-theme-handdrawn .gacha-pool .pool-info,
.app-theme-handdrawn .pity-card,
.app-theme-handdrawn .result-card,
.app-theme-handdrawn .prob-modal,
.app-theme-handdrawn .task-card,
.app-theme-handdrawn .exchange-item,
.app-theme-handdrawn .stat-card,
.app-theme-handdrawn .totem-card,
.app-theme-handdrawn .login-card,
.app-theme-handdrawn .privacy-card,
.app-theme-handdrawn .anniversary-card,
.app-theme-handdrawn .pet-stage-inner,
.app-theme-handdrawn .plan-premium,
.app-theme-handdrawn .gacha-btn-section,
.app-theme-handdrawn .level-card {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 18px 8px 20px 10px !important;
  background: rgba(255, 251, 249, 0.85) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), 0 2px 8px rgba(249, 168, 92, 0.1), 0 8px 28px rgba(249, 168, 92, 0.06), 6px 6px 0 rgba(249, 168, 92, 0.2) !important;
  position: relative !important;
}
/* 卡片右下角装饰折角 */
.app-theme-handdrawn .card::after,
.app-theme-handdrawn .plan-item::after,
.app-theme-handdrawn .plan-card::after,
.app-theme-handdrawn .anni-item::after,
.app-theme-handdrawn .wish-card::after,
.app-theme-handdrawn .note-item::after,
.app-theme-handdrawn .section-card::after,
.app-theme-handdrawn .menu-group::after,
.app-theme-handdrawn .bind-card::after,
.app-theme-handdrawn .task-card::after,
.app-theme-handdrawn .stat-card::after,
.app-theme-handdrawn .anniversary-card::after,
.app-theme-handdrawn .level-card::after {
  content: '' !important;
  position: absolute !important;
  bottom: 0 !important;
  right: 0 !important;
  width: 24px !important;
  height: 24px !important;
  background: linear-gradient(135deg, transparent 50%, rgba(249, 168, 92, 0.08) 50%) !important;
  border-radius: 0 0 10px 0 !important;
  pointer-events: none !important;
}

/* ===== 所有按钮 ===== */
.app-theme-handdrawn .btn-primary,
.app-theme-handdrawn .btn-money,
.app-theme-handdrawn .btn-wish,
.app-theme-handdrawn .btn-todo,
.app-theme-handdrawn .btn-task,
.app-theme-handdrawn .btn-anni,
.app-theme-handdrawn .btn-gift,
.app-theme-handdrawn .btn-note,
.app-theme-handdrawn .gacha-btn,
.app-theme-handdrawn .add-plan-btn,
.app-theme-handdrawn .bind-btn,
.app-theme-handdrawn .checkin-cta,
.app-theme-handdrawn .plan-foot-btn-wrap .btn,
.app-theme-handdrawn .pet-modal-btn,
.app-theme-handdrawn .guest-card-btn,
.app-theme-handdrawn .wish-fab,
.app-theme-handdrawn .result-actions .btn,
.app-theme-handdrawn .privacy-btn-agree,
.app-theme-handdrawn .plan-action-btn,
.app-theme-handdrawn .checkin-mini-btn {
  border-radius: 25px 10px 25px 10px !important;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.3) !important;
  border: none !important;
  transition: transform 0.12s ease !important;
}
.app-theme-handdrawn .login-btn-primary {
  border-radius: 25px 10px 25px 10px !important;
  box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.4) !important;
  border: none !important;
  transition: transform 0.12s ease !important;
}
.app-theme-handdrawn .login-btn-secondary {
  border-radius: 25px 10px 25px 10px !important;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.2) !important;
  transition: transform 0.12s ease !important;
}
.app-theme-handdrawn .btn-primary:active,
.app-theme-handdrawn .gacha-btn:active,
.app-theme-handdrawn .login-btn-primary:active {
  transform: translate(2px, 2px) scale(0.97) !important;
  box-shadow: 1px 1px 0 rgba(232, 146, 76, 0.3) !important;
}

.app-theme-handdrawn .btn-outline {
  border: 2px solid var(--hd-primary) !important;
  border-radius: 25px 10px 25px 10px !important;
  background: #fff !important;
  color: #E8924C !important;
  box-shadow: 2px 2px 0 rgba(249, 168, 92, 0.12) !important;
}

.app-theme-handdrawn .btn-danger {
  border-radius: 25px 10px 25px 10px !important;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.25) !important;
}

/* ===== 登录页按钮（更宽） ===== */
.app-theme-handdrawn .login-btn-primary {
  width: 85% !important;
  max-width: 300px !important;
  margin: 0 auto 14px !important;
  background: linear-gradient(135deg, var(--hd-primary) 0%, var(--hd-primary-dark) 100%) !important;
  color: #fff !important;
  padding: 14px 0 !important;
  font-size: 15px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
}
.app-theme-handdrawn .login-btn-secondary {
  width: 85% !important;
  max-width: 300px !important;
  background: #fff !important;
  color: #E8924C !important;
  border: 2px solid #F9A85C !important;
  padding: 14px 0 !important;
  font-size: 15px !important;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.2) !important;
}

/* ===== 登录页标题与背景 ===== */
.app-theme-handdrawn .login-page {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8E6 100%) !important;
}
.app-theme-handdrawn .login-title {
  font-size: 36px !important;
  font-weight: 800 !important;
  color: #5D3E2A !important;
  letter-spacing: 2px !important;
  margin-bottom: 10px !important;
}
.app-theme-handdrawn .login-subtitle {
  color: #7A5C4A !important;
  font-size: 14px !important;
  margin-bottom: 40px !important;
}
.app-theme-handdrawn .login-footer {
  color: #8B6E5A !important;
}

/* ===== 输入框 ===== */
.app-theme-handdrawn .input {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 14px 6px 14px 6px !important;
  background: #FFFDF8 !important;
}
.app-theme-handdrawn .input:focus {
  border-color: var(--hd-primary) !important;
  box-shadow: 0 0 0 3px rgba(249, 168, 92, 0.12) !important;
}

/* ===== 渐变头部 ===== */
.app-theme-handdrawn .fixed-dock,
.app-theme-handdrawn .plans-header,
.app-theme-handdrawn .wish-header,
.app-theme-handdrawn .draw-header,
.app-theme-handdrawn .gacha-header,
.app-theme-handdrawn .bp-header,
.app-theme-handdrawn .level-header,
.app-theme-handdrawn .profile-header,
.app-theme-handdrawn .home-header {
  background: linear-gradient(135deg, #F9A85C 0%, #FDE8C8 100%) !important;
}

/* ===== 首页头部统计卡片 ===== */
.app-theme-handdrawn .stat-card {
  border: 2px dashed rgba(255,255,255,0.3) !important;
  border-radius: 14px 6px 14px 6px !important;
  background: rgba(255, 255, 255, 0.35) !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
  box-shadow: none !important;
}

/* ===== 快捷入口（首页dock） ===== */
.app-theme-handdrawn .dock-icon {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 16px 8px 16px 8px !important;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.15), 0 2px 8px rgba(249, 168, 92, 0.06) !important;
}

/* ===== 标签/徽章 ===== */
.app-theme-handdrawn .tag,
.app-theme-handdrawn .plan-item-status,
.app-theme-handdrawn .badge,
.app-theme-handdrawn .cat-chip,
.app-theme-handdrawn .wish-status,
.app-theme-handdrawn .wish-plan-link,
.app-theme-handdrawn .pill,
.app-theme-handdrawn .plan-tag,
.app-theme-handdrawn .pet-tag,
.app-theme-handdrawn .vault-card__tag {
  border: 1.5px dashed var(--hd-border) !important;
  border-radius: 12px 4px 12px 4px !important;
  background: var(--hd-primary-pale) !important;
  color: var(--hd-primary-dark) !important;
}
.app-theme-handdrawn .cat-chip--active {
  border: none !important;
  background: linear-gradient(145deg, var(--hd-primary), var(--hd-primary-dark)) !important;
}
.app-theme-handdrawn .cat-chip--active .cat-chip-name {
  color: #fff !important;
}

/* ===== 进度条 ===== */
.app-theme-handdrawn .vault-track,
.app-theme-handdrawn .progress-bar:not(.totem-progress),
.app-theme-handdrawn .plan-premium-track,
.app-theme-handdrawn .pity-track,
.app-theme-handdrawn .pet-intimacy-track,
.app-theme-handdrawn .intimacy-bar {
  border: 2px solid #E8E0D8 !important;
  border-radius: 8px !important;
  height: 12px !important;
  overflow: hidden !important;
}
.app-theme-handdrawn .vault-track__fill,
.app-theme-handdrawn .progress-fill,
.app-theme-handdrawn .plan-premium-fill,
.app-theme-handdrawn .pity-fill,
.app-theme-handdrawn .intimacy-fill,
.app-theme-handdrawn .pet-intimacy-fill {
  border-radius: 6px !important;
  background: linear-gradient(90deg, #F9A85C 0%, #E8924C 50%, #FFD93D 100%) !important;
}

/* ===== 宠物按钮 ===== */
.app-theme-handdrawn .pet-dock-btn .pet-dock-icon,
.app-theme-handdrawn .pet-action-icon {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 12px 4px 12px 4px !important;
  box-shadow: 2px 2px 0 rgba(249, 168, 92, 0.15) !important;
  background: var(--hd-primary-pale) !important;
}

/* ===== 宠物卡片 ===== */
.app-theme-handdrawn .pet-stage {
  position: relative !important;
}
.app-theme-handdrawn .pet-stage-glow {
  position: absolute !important;
  top: 0; left: 0; right: 0;
  height: 100px !important;
  background: linear-gradient(180deg, var(--hd-primary-pale) 0%, transparent 100%) !important;
  border-radius: 18px 8px 0 0 !important;
}

/* ===== 纪念日图标 ===== */
.app-theme-handdrawn .anni-premium-icon {
  background: var(--hd-primary) !important;
  border-radius: 12px 4px 12px 4px !important;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.2) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* ===== 签到按钮 ===== */
.app-theme-handdrawn .checkin-mini {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 14px 6px 14px 6px !important;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.12) !important;
}

/* ===== 分隔线 ===== */
.app-theme-handdrawn .vault-stats,
.app-theme-handdrawn .vault-stat__sep,
.app-theme-handdrawn .wish-foot,
.app-theme-handdrawn .sheet-title,
.app-theme-handdrawn .sec-head {
  border-color: var(--hd-line-dot) !important;
  border-style: dotted !important;
}

/* ===== 头像 ===== */
.app-theme-handdrawn .avatar-ring,
.app-theme-handdrawn .profile-avatar-item {
  border: 3px solid rgba(249, 168, 92, 0.4) !important;
  background: linear-gradient(145deg, #fff, #FFF8E6) !important;
}
.app-theme-handdrawn .avatar-ring--empty {
  border: 3px dashed rgba(249, 168, 92, 0.4) !important;
  background: rgba(249, 168, 92, 0.08) !important;
}

/* ===== 菜单组 ===== */
.app-theme-handdrawn .menu-group {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 18px 8px 18px 8px !important;
}
.app-theme-handdrawn .menu-group--settings {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 18px 8px 18px 8px !important;
  margin-top: 0;
}
.app-theme-handdrawn .menu-icon {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 10px 4px 10px 4px !important;
  background: var(--hd-primary-pale) !important;
}

/* ===== 抽签按钮 ===== */
.app-theme-handdrawn .draw-btn-inner {
  box-shadow: 5px 5px 0 rgba(232, 146, 76, 0.35) !important;
}

/* ===== 自定义返回按钮 ===== */
.app-theme-handdrawn .page-header__back,
.app-theme-handdrawn .draw-header__back,
.app-theme-handdrawn .dc-hero__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  font-size: 26px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  margin-right: 2px;
  line-height: 1;
}
.app-theme-handdrawn .page-header__back:active,
.app-theme-handdrawn .draw-header__back:active,
.app-theme-handdrawn .dc-hero__back:active {
  background: rgba(255,255,255,0.35);
}

/* 页面导航空白区与头部渐变一致（硬编码消除色差） */
.app-theme-handdrawn .page-nav {
  background: none !important;
}

/* 手绘风格分隔线 */
.app-theme-handdrawn .divider-doodle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 6px 20px;
  opacity: 0.5;
}
.app-theme-handdrawn .divider-doodle::before,
.app-theme-handdrawn .divider-doodle::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--hd-border), transparent);
}
.app-theme-handdrawn .divider-doodle__icon {
  font-size: 12px;
  color: var(--hd-primary);
}

/* ===== 结果内容 ===== */
.app-theme-handdrawn .result-content {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 14px 6px 14px 6px !important;
}

/* ===== 底部弹窗 ===== */
.app-theme-handdrawn .sheet {
  border-top: 2px dashed var(--hd-border) !important;
}

/* ===== 数量金额（大数字） ===== */
.app-theme-handdrawn .vault-card__amount,
.app-theme-handdrawn .plan-current,
.app-theme-handdrawn .total-amount-value,
.app-theme-handdrawn .vault-stat__num,
.app-theme-handdrawn .profile-stat-value,
.app-theme-handdrawn .level-number {
  font-weight: 800 !important;
  letter-spacing: -0.5px !important;
}

/* ===== 底部安全说明 ===== */
.app-theme-handdrawn .footer-disclaimer {
  color: var(--hd-text-light) !important;
  border-top: 2px dashed var(--hd-border) !important;
}

/* ===== 小猫印章（签到） ===== */
.app-theme-handdrawn .checkin-cta--done {
  background: var(--hd-primary-pale) !important;
  color: var(--hd-primary) !important;
}

/* ===== 订单完成标记 ===== */
.app-theme-handdrawn .plan-item-status.active {
  background: #E8F5E9 !important;
  border: 1px dashed var(--hd-success) !important;
  color: var(--hd-success) !important;
}
.app-theme-handdrawn .plan-item-status.completed {
  background: var(--hd-primary-pale) !important;
  border: 1px dashed var(--hd-primary) !important;
  color: var(--hd-primary-dark) !important;
}

/* ===== 弹窗遮罩 ===== */
.app-theme-handdrawn .overlay,
.app-theme-handdrawn .modal-overlay {
  background: rgba(249, 168, 92, 0.2) !important;
}

/* ===== 扭蛋机 ===== */
.app-theme-handdrawn .machine-body {
  border: 2px dashed var(--hd-border) !important;
  border-radius: 16px 8px 16px 8px !important;
}

/* ===== 宝石/积分数字 ===== */
.app-theme-handdrawn .shard-count,
.app-theme-handdrawn .crystal-balance-num {
  font-weight: 800 !important;
  color: var(--hd-primary-dark) !important;
}
