/* gacha.wxss — 抽卡（app_inline 升级版） */
.page { height: 100vh; background: transparent; }

/* ===== 头部banner ===== */
.gacha-header {
  position: relative; overflow: hidden;
  min-height: 70px;
}
.gacha-header-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
}
.gacha-header-content {
  position: relative; z-index: 2;
  padding: 16px 20px;
  display: flex; flex-direction: column; gap: 10px;
}
.gacha-title-img { width: 70%; max-width: 200px; }
.gacha-ticket-bar {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,0.9);
  padding: 7px 16px; border-radius: 20px;
  font-size: 12px; color: var(--text-primary);
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.gacha-ticket-bar .num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 16px; color: var(--primary-dark); font-weight: 700;
}
.gacha-ticket-bar .divider { color: #D9A378; margin: 0 3px; }
.prob-btn {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--primary-pale);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; margin-left: auto;
}

/* ===== 抽奖机 ===== */
.gacha-stage {
  margin: 16px; padding: 28px 20px 20px;
  background: white; border-radius: 20px 12px 20px 12px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(232,145,164,0.15);
  position: relative; overflow: hidden;
}
.gacha-stage::before {
  content: ''; position: absolute;
  top: 50%; left: 50%;
  width: 180px; height: 180px;
  background: radial-gradient(circle, rgba(255,217,61,0.1) 0%, transparent 70%);
  border-radius: 50%; pointer-events: none;
  transform: translate(-50%, -50%);
  animation: stageBreathe 3s ease-in-out infinite;
}
@keyframes stageBreathe {
  0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
}
.gacha-machine {
  width: 160px; height: 160px;
  margin: 0 auto; position: relative;
}
.machine-img { width: 100%; height: 100%; display: block; overflow: hidden; }
.gacha-machine .machine-img {
  animation: machFloat 3s ease-in-out infinite;
}
@keyframes machFloat {
  0%, 100% { transform: translateY(0) rotate(0); }
  25% { transform: translateY(-3px) rotate(-2deg); }
  75% { transform: translateY(-3px) rotate(2deg); }
}
.gacha-machine.shaking .machine-img {
  animation: machShake 0.6s ease-in-out;
}
@keyframes machShake {
  0%, 100% { transform: translateY(0) rotate(0); }
  10% { transform: translateX(-8px) rotate(-5deg); }
  20% { transform: translateX(8px) rotate(5deg); }
  30% { transform: translateX(-6px) rotate(-4deg); }
  40% { transform: translateX(6px) rotate(4deg); }
  50% { transform: translateX(-4px) rotate(-3deg); }
  60% { transform: translateX(4px) rotate(3deg); }
}

/* 扭蛋弹出 */
.ball-wrap { position: absolute; top: 50%; left: 50%; pointer-events: none; z-index: 5; }
.ball-pop {
  position: absolute; top: 0; left: 0;
  transform: translate(-50%, -50%) scale(0);
  animation: ballPop 1.2s ease-out forwards;
}
.ball-emoji { font-size: 60px; display: block; }
@keyframes ballPop {
  0% { transform: translate(-50%, -50%) scale(0) rotate(0); }
  20% { transform: translate(-50%, -150%) scale(1.2) rotate(180deg); }
  40% { transform: translate(-50%, -180%) scale(1) rotate(360deg); }
  70% { transform: translate(-50%, -180%) scale(1) rotate(360deg); }
  100% { transform: translate(-50%, -180%) scale(0) rotate(540deg); }
}

.gacha-tickets-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: linear-gradient(135deg, #FFE5D9, #FFD9B3);
  padding: 6px 16px; border-radius: 16px;
  margin-top: 12px; font-size: 13px; font-weight: 600;
  color: var(--text-primary);
}
.gacha-tickets-badge .num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px; color: var(--primary-dark);
}

/* ===== 概率公示（直接展示） ===== */
.gacha-prob-direct {
  position: relative; overflow: hidden;
  margin: 0 16px 12px;
  border-radius: 20px 12px 20px 12px;
  box-shadow: 0 6px 20px rgba(232,145,164,0.2);
}
.gacha-prob-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
}
.gacha-prob-overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.25);
  z-index: 1; pointer-events: none;
}
.gacha-prob-content {
  position: relative; z-index: 2;
  padding: 16px 18px;
}
.gacha-prob-title {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 15px; color: #fff;
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  margin-bottom: 10px; display: block;
}
.gacha-prob-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 6px;
}
.gacha-prob-row {
  display: flex; align-items: center;
  gap: 4px; font-size: 11px; color: #fff;
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  padding: 3px 0;
}
.gp-rarity { font-weight: 700; min-width: 36px; }
.gp-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gp-pct { font-weight: 700; font-family: 'ZCOOL KuaiLe', cursive; opacity: 0.95; }
.gacha-prob-foot {
  display: block; margin-top: 10px;
  font-size: 10px; color: rgba(255,255,255,0.8);
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  text-align: center;
}

/* ===== 保底 ===== */
.gacha-pity {
  margin: -4px 16px 12px; padding: 8px 12px;
  background: white; border-radius: 14px;
  font-size: 11px; color: var(--text-secondary);
  display: flex; align-items: center; gap: 6px;
}
.pity-bar { flex: 1; height: 4px; background: #f5e8ec; border-radius: 2px; overflow: hidden; }
.pity-fill { height: 100%; background: linear-gradient(90deg, #FFD93D, #FF8E8E); border-radius: 2px; }

/* ===== 概率加成 ===== */
.gacha-bonus {
  margin: 0 16px 12px; padding: 10px 14px;
  background: linear-gradient(135deg, #FFF5E1, #FFE8C7);
  border-radius: 14px; font-size: 12px; color: #8B5A2B;
  display: flex; align-items: center; gap: 6px;
}

/* ===== 按钮 ===== */
.gacha-buttons { display: flex; gap: 10px; padding: 0 16px 12px; }
.gacha-btn {
  flex: 1; height: auto; padding: 12px; border-radius: 16px;
  text-align: center; font-size: 13px; font-weight: 700;
  color: white; border: none; line-height: 1.3;
  box-shadow: 0 6px 16px rgba(232,145,164,0.3);
}
.gacha-btn::after { border: none; }
.gacha-btn.disabled { opacity: 0.5; }
.gacha-btn.single { background: linear-gradient(135deg, #FFB199 0%, #FF8E8E 100%); }
.gacha-btn.ten { background: linear-gradient(135deg, #FF9A8B 0%, #E97F4A 50%, #D96B38 100%); }
.gacha-btn small { font-size: 10px; opacity: 0.95; display: block; margin-top: 2px; font-weight: 400; }

/* ===== 加注 ===== */
.gacha-currency { display: flex; justify-content: center; padding: 0 16px 14px; font-size: 11px; color: var(--text-light); }
.boost-option { display: flex; align-items: center; gap: 4px; }

/* ===== 卡池 ===== */
.gacha-pool { margin: 0 16px 16px; padding: 12px; background: white; border-radius: 16px; box-shadow: 0 4px 14px rgba(232,145,164,0.1); }
.pool-title { text-align: center; font-family: 'ZCOOL KuaiLe', cursive; font-size: 14px; color: var(--text-primary); margin-bottom: 8px; }
.pool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.pool-item { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-primary); padding: 4px 0; }
.pool-rate { color: #FF6B6B; font-weight: 700; font-family: 'ZCOOL KuaiLe', cursive; }

/* ===== 十连 ===== */
.ten-list { margin: 0 16px 16px; }
.ten-title { font-family: 'ZCOOL KuaiLe', cursive; font-size: 14px; color: var(--text-primary); margin-bottom: 8px; }
.ten-items { display: flex; flex-wrap: wrap; gap: 8px; }
.ten-i {
  background: white; border-radius: 14px; padding: 10px 12px;
  flex: 1; min-width: 80px; text-align: center;
  border: 1.5px dashed #F5D6B0;
}
.ten-i-SSR { border-color: #FFD700; background: #FFF8E1; }
.ten-i-SSRP { border-color: #FF6B6B; background: #FFE8E8; }
.ten-i-icon { font-size: 28px; margin-bottom: 4px; }
.ten-i-name { font-size: 11px; font-weight: 600; color: var(--text-primary); display: block; }
.ten-i-rarity { font-size: 9px; color: var(--text-light); display: block; }
.ten-summary { margin-top: 8px; text-align: center; font-size: 11px; color: var(--text-secondary); }

/* ===== 结果弹窗 ===== */
.result-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.7); z-index: 200;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  animation: fadeIn 0.3s;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.ssr-flash {
  position: absolute; inset: 0;
  background: radial-gradient(circle, rgba(255,217,61,0.8) 0%, transparent 70%);
  pointer-events: none;
  animation: ssrFlash 1.5s ease-out;
}
@keyframes ssrFlash {
  0% { opacity: 0; transform: scale(0); }
  30% { opacity: 1; transform: scale(1.5); }
  100% { opacity: 0; transform: scale(3); }
}
.result-card {
  background: white; border-radius: 24px; padding: 30px 24px;
  text-align: center; max-width: 300px; width: 100%;
  position: relative;
  animation: resultPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes resultPop {
  0% { transform: scale(0) rotate(-20deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.result-card--ssr { background: linear-gradient(135deg, #FFD89B 0%, #FF9A8B 50%, #E97F4A 100%); }
.result-badge {
  display: inline-block;
  background: linear-gradient(135deg, #FFD93D, #FF8E53); color: white;
  padding: 4px 14px; border-radius: 12px;
  font-size: 12px; font-weight: 700; margin-bottom: 12px;
}
.result-card--ssr .result-badge { background: rgba(255,255,255,0.25); }
.result-ball { margin: 0 auto 12px; animation: ballSpin 1.5s ease-out; }
@keyframes ballSpin {
  0% { transform: scale(0) rotate(0); }
  50% { transform: scale(1.3) rotate(360deg); }
  100% { transform: scale(1) rotate(720deg); }
}
.result-name {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 22px; color: var(--text-primary); margin-bottom: 4px;
}
.result-card--ssr .result-name { color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
.result-desc { font-size: 12px; color: var(--text-secondary); margin-bottom: 16px; }
.result-card--ssr .result-desc { color: rgba(255,255,255,0.95); }
.result-actions { display: flex; gap: 8px; justify-content: center; }
.result-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white; border: none; border-radius: 14px;
  padding: 10px 20px; font-size: 13px; font-weight: 600; height: auto;
}
.result-btn::after { border: none; }

/* ===== 概率弹窗 ===== */
.modal-overlay { position: fixed; inset: 0; background: rgba(61,44,56,0.5); z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px; }
.prob-modal { background: white; border-radius: 20px; padding: 24px; max-width: 340px; width: 100%; max-height: 70vh; display: flex; flex-direction: column; }
.prob-title { font-family: 'ZCOOL KuaiLe', cursive; font-size: 16px; color: var(--text-primary); text-align: center; margin-bottom: 14px; flex-shrink: 0; }
.prob-list { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.prob-row { display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 4px 0; }
.prob-rarity { font-weight: 700; width: 50px; }
.prob-name { flex: 1; color: var(--text-secondary); }
.prob-pct { color: #FF6B6B; font-weight: 700; font-family: 'ZCOOL KuaiLe', cursive; }
.prob-foot { font-size: 10px; color: var(--text-light); text-align: center; display: block; margin: 14px 0 12px; }
.prob-close { width: 100%; }
.footer-disclaimer { padding: 16px; text-align: center; font-size: 10px; color: var(--text-light); line-height: 1.5; }
