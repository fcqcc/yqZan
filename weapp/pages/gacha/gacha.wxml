<!-- pages/gacha/gacha.wxml — 扭蛋机抽卡 -->
<scroll-view class="page" scroll-y>
  <!-- ===== 顶部：扭蛋机标题 + 抽卡券数量 ===== -->
  <view class="header">
    <view class="header-title">
      <text class="header-icon">🎰</text>
      <text class="header-text">扭蛋机</text>
    </view>
    <view class="ticket-bar">
      <text class="ticket-icon">🎟️</text>
      <text class="ticket-count">{{tickets}}</text>
      <text class="ticket-label">张</text>
      <text class="shard-divider">|</text>
      <text class="shard-icon">💎</text>
      <text class="shard-count">{{shards}}</text>
      <text class="ticket-label">积分</text>
      <view class="prob-btn" bindtap="showProb">❓</view>
    </view>
  </view>

  <!-- ===== 扭蛋机主体（装饰区） ===== -->
  <view class="machine-area">
    <view class="machine">
      <view class="machine-top">
        <text class="machine-knob">🔮</text>
      </view>
      <view class="machine-body">
        <view class="machine-ball {{animating ? 'ball-shake' : ''}}">
          <text class="ball-icon">{{animating ? '🌀' : '🎯'}}</text>
        </view>
        <view class="machine-dots">
          <view class="machine-dot"></view>
          <view class="machine-dot"></view>
          <view class="machine-dot"></view>
        </view>
      </view>
      <view class="machine-bottom"></view>
    </view>
  </view>

  <!-- ===== 抽卡按钮 ===== -->
  <view class="btn-section">
    <view wx:if="{{pityCount > 0}}" class="pity-bar">
      <text class="pity-text">保底进度：{{pityCount}}/60</text>
      <view class="pity-track"><view class="pity-fill" style="width:{{pityCount / 60 * 100 > 100 ? 100 : pityCount / 60 * 100}}%"></view></view>
    </view>
    <label wx:if="{{shards >= 50}}" class="boost-option">
      <checkbox class="boost-checkbox" checked="{{useBoost}}" bindchange="toggleBoost" />
      <text class="boost-label">积分加注 💎+50<text style="font-size:10px;color:var(--text-muted)"> SSR概率↑</text></text>
    </label>
    <view class="btn-actions-row">
      <button class="btn-draw btn-draw-single {{drawing ? 'btn-disabled' : ''}}" 
              disabled="{{drawing || tickets < 1}}" 
              bindtap="onDrawSingle">
        <text class="btn-label">单抽</text>
        <text class="btn-cost">消耗 1 张券</text>
      </button>
      <button class="btn-draw btn-draw-ten {{drawing ? 'btn-disabled' : ''}}" 
              disabled="{{drawing || tickets < 10}}" 
              bindtap="onDrawTen">
        <text class="btn-label">十连抽</text>
        <text class="btn-cost">消耗 10 张 · 返还 1 张</text>
      </button>
    </view>
  </view>

  <!-- ===== 十连结果列表 ===== -->
  <view wx:if="{{tenResults.length > 0}}" class="ten-list">
    <view class="ten-list-title">🎊 抽卡记录</view>
    <view class="ten-items">
      <view 
        wx:for="{{tenResults}}" 
        wx:key="index" 
        class="ten-item ten-item-{{item.rarityClass || item.rarity}}"
        data-index="{{index}}"
        bindtap="onShowItemDetail"
      >
        <view class="ten-item-icon">
          <text wx:if="{{item.rarity === 'N'}}">⚪</text>
          <text wx:elif="{{item.rarity === 'R'}}">🔵</text>
          <text wx:elif="{{item.rarity === 'SR'}}">🟣</text>
          <text wx:elif="{{item.rarity === 'SSR'}}">🟡</text>
          <text wx:else>💎</text>
        </view>
        <view class="ten-item-info">
          <text class="ten-item-name">{{item.name}}</text>
          <text class="ten-item-rarity">[{{item.rarity}}]</text>
        </view>
      </view>
    </view>
    <view class="ten-summary">
      <text class="ten-summary-text">本次获得 
        <text wx:for="{{summaryList}}" wx:key="type">
          <text wx:if="{{index > 0}}"> · </text>
          {{item.label}} ×{{item.count}}
        </text>
      </text>
    </view>
  </view>

  <!-- ===== 结果弹窗遮罩 ===== -->
  <view wx:if="{{showResult}}" class="result-overlay {{resultAnimClass}}" 
        bindtap="onCloseResult" catchtouchmove="preventMove">
    <!-- SSR / SSR+ 全屏闪烁背景 -->
    <view wx:if="{{currentResult.rarity === 'SSR' || currentResult.rarity === 'SSR+'}}" 
          class="ssr-burst">
      <view class="ssr-ray ray-1"></view>
      <view class="ssr-ray ray-2"></view>
      <view class="ssr-ray ray-3"></view>
      <view class="ssr-ray ray-4"></view>
      <view class="ssr-ray ray-5"></view>
      <view class="ssr-ray ray-6"></view>
      <view class="ssr-ray ray-7"></view>
      <view class="ssr-ray ray-8"></view>
    </view>

    <view class="result-card result-card-{{currentResult.rarity}}" catchtap="catchTap">
      <view class="result-icon">
        <text wx:if="{{currentResult.rarity === 'N'}}">⚪</text>
        <text wx:elif="{{currentResult.rarity === 'R'}}">🔵</text>
        <text wx:elif="{{currentResult.rarity === 'SR'}}">🟣</text>
        <text wx:elif="{{currentResult.rarity === 'SSR'}}">🟡</text>
        <text wx:else>💎</text>
      </view>
      <text class="result-rarity result-rarity-{{currentResult.rarityClass || currentResult.rarity}}">{{currentResult.rarity}}{{currentResult.rarity === 'SSR+' ? '+' : ''}}</text>
      <text class="result-name">{{currentResult.name}}</text>
      <text wx:if="{{currentResult.desc}}" class="result-desc">{{currentResult.desc}}</text>
      <view class="result-btn-area">
        <button class="btn-result" bindtap="onCloseResult">知道了</button>
      </view>
    </view>
  </view>

  <!-- ===== 概率详情弹窗 ===== -->
  <view wx:if="{{showProbModal}}" class="modal-overlay" bindtap="hideProb">
    <view class="prob-modal" catchtap="catchTap">
      <view class="prob-modal-title">🎯 抽卡概率公示</view>
      <view class="prob-list">
        <view wx:for="{{probList}}" wx:key="id" class="prob-row">
          <text class="prob-rarity prob-rarity-{{item.rarity}}">{{item.rarity}}</text>
          <text class="prob-name">{{item.name}}</text>
          <text class="prob-pct">{{item.pct}}%</text>
        </view>
      </view>
      <view class="prob-modal-footer">抽卡券通过存钱/打卡免费获取，概率公开透明</view>
      <button class="btn btn-primary prob-close" bindtap="hideProb">知道了</button>
    </view>
  </view>

  <!-- ===== 底部合规声明 ===== -->
  <view class="footer-disclaimer">
    <text>抽卡券通过存钱/打卡免费获取，不可兑换现金，仅供娱乐</text>
  </view>
</scroll-view>
