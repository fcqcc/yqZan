<!-- 抽卡页（app_inline 升级版） -->
<scroll-view class="app-root app-theme-{{uiTheme}} page" scroll-y>

  <!-- ===== 头部banner ===== -->
  <view class="gacha-header">
    <image src="/assets/images/gacha_header_bg.png" mode="aspectFill" class="gacha-header-bg" />
    <view class="gacha-header-content">
      <image src="/assets/images/gacha_title_img.png" mode="widthFix" class="gacha-title-img" />
    </view>
    <view class="gacha-ticket-bar">
      <text>🎟️</text>
      <text class="num">{{tickets}}</text>
      <text>张</text>
      <text class="divider">|</text>
      <text>💎</text>
      <text class="num">{{shards}}</text>
      <text>积分</text>
      <view class="prob-btn" bindtap="showProb">❓</view>
    </view>
  </view>

  <!-- ===== 抽奖机 ===== -->
  <view class="gacha-stage">
    <view class="gacha-machine {{animating ? 'shaking' : ''}}">
      <image src="/assets/images/gacha_machine.png" mode="aspectFill" class="machine-img" />
      <view wx:if="{{showBall}}" class="ball-wrap">
        <view class="ball-pop"><text class="ball-emoji">{{resultEmoji}}</text></view>
      </view>
    </view>
    <view class="gacha-tickets-badge">
      <text>🎟️</text>
      <text class="num">{{tickets}}</text>
      <text>张可抽</text>
    </view>
  </view>

  <!-- ===== 保底进度 ===== -->
  <view wx:if="{{pityCount > 0}}" class="gacha-pity">
    <text>🎁 SSR保底</text>
    <view class="pity-bar"><view class="pity-fill" style="width:{{pityCount / 60 * 100}}%"></view></view>
    <text>{{pityCount}}/60</text>
  </view>

  <!-- ===== 概率加成提示 ===== -->
  <view wx:if="{{pityCount >= 20}}" class="gacha-bonus">
    <text>{{pityCount >= 40 ? '🔥 40抽 2倍概率' : '🔥 20抽 1.5倍概率'}}</text>
    <text wx:if="{{pityCount >= 60}}" style="color:#FF6B6B;font-weight:700;">60抽 3倍概率</text>
  </view>

  <!-- ===== 按钮 ===== -->
  <view class="gacha-buttons">
    <button class="gacha-btn single {{drawing ? 'disabled' : ''}}"
            disabled="{{drawing || tickets < 1}}" bindtap="onDrawSingle">
      🎰 单抽
      <small>1张券</small>
    </button>
    <button class="gacha-btn ten {{drawing ? 'disabled' : ''}}"
            disabled="{{drawing || tickets < 10}}" bindtap="onDrawTen">
      🔥 十连抽
      <small>10张券</small>
    </button>
  </view>

  <!-- ===== 加注选项 ===== -->
  <view class="gacha-currency">
    <label class="boost-option">
      <checkbox checked="{{useBoost}}" bindchange="toggleBoost" style="transform:scale(0.8)" />
      <text>💎+50加注抽 <text style="color:#FF6B6B;">SSR概率↑</text></text>
    </label>
  </view>

  <!-- ===== 抽卡记录 ===== -->
  <view wx:if="{{tenResults.length > 0}}" class="ten-list">
    <view class="ten-title">🎊 抽卡记录</view>
    <view class="ten-items">
      <view wx:for="{{tenResults}}" wx:key="index" class="ten-i ten-i-{{item.rarityClass || item.rarity}}"
            data-index="{{index}}" bindtap="onShowItemDetail">
        <view class="ten-i-icon">
          <text wx:if="{{item.rarity === 'N'}}">⚪</text>
          <text wx:elif="{{item.rarity === 'R'}}">🔵</text>
          <text wx:elif="{{item.rarity === 'SR'}}">🟣</text>
          <text wx:elif="{{item.rarity === 'SSR'}}">🟡</text>
          <text wx:else>💎</text>
        </view>
        <text class="ten-i-name">{{item.name}}</text>
        <text class="ten-i-rarity">[{{item.rarity}}]</text>
      </view>
    </view>
    <view class="ten-summary">
      <text wx:for="{{summaryList}}" wx:key="type">
        <text wx:if="{{index > 0}}"> · </text>
        {{item.label}} ×{{item.count}}
      </text>
    </view>
  </view>

  <!-- ===== 结果弹窗 ===== -->
  <view wx:if="{{showResult}}" class="result-overlay" catchtouchmove="preventMove">
    <view wx:if="{{currentResult.rarity === 'SSR' || currentResult.rarity === 'SSR+'}}" class="ssr-flash"></view>
    <view class="result-card {{currentResult.rarity === 'SSR' ? 'result-card--ssr' : ''}}"
          catchtap="catchTap">
      <text class="result-badge">{{currentResult.rarity}}</text>
      <view class="result-ball">
        <text style="font-size:80px;display:block;text-align:center;">
          {{currentResult.rarity === 'N' ? '⚪' : currentResult.rarity === 'R' ? '🔵' : currentResult.rarity === 'SR' ? '🟣' : currentResult.rarity === 'SSR' ? '🟡' : '💎'}}
        </text>
      </view>
      <text class="result-name">{{currentResult.name}}</text>
      <text wx:if="{{currentResult.desc}}" class="result-desc">{{currentResult.desc}}</text>
      <view class="result-actions">
        <button class="result-btn" bindtap="onCloseResult">知道了</button>
      </view>
    </view>
  </view>

  <!-- ===== 概率详情弹窗 ===== -->
  <view wx:if="{{showProbModal}}" class="modal-overlay" bindtap="hideProb">
    <view class="prob-modal" catchtap="catchTap">
      <view class="prob-title">🎯 抽卡概率公示</view>
      <view class="prob-list">
        <view wx:for="{{probList}}" wx:key="id" class="prob-row">
          <text class="prob-rarity prob-rarity-{{item.rarity}}">{{item.rarity}}</text>
          <text class="prob-name">{{item.name}}</text>
          <text class="prob-pct">{{item.pct}}%</text>
        </view>
      </view>
      <text class="prob-foot">抽卡券通过存钱/打卡免费获取，概率公开透明</text>
      <button class="btn btn-primary prob-close" bindtap="hideProb">知道了</button>
    </view>
  </view>

  <view class="footer-disclaimer">
    <text>抽卡券通过存钱/打卡免费获取，不可兑换现金，仅供娱乐</text>
  </view>
</scroll-view>
