<scroll-view class="page" scroll-y>
  <!-- 等级头部 -->
  <view class="level-header">
    <text class="level-badge">🏅</text>
    <text class="level-number">{{level}} 级</text>
    <text class="level-title-text">{{levelTitle}}</text>
    <text class="level-next">还差 {{expRemaining}} 经验升级到 {{level + 1}} 级</text>
  </view>

  <!-- 经验卡片 -->
  <view class="exp-card">
    <view class="exp-header">
      <text class="exp-label">当前经验</text>
      <text class="exp-value">{{current_exp}} / {{next_level_exp}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{progress_pct}}%"></view>
    </view>
  </view>

  <!-- 等级特权 -->
  <view class="section-header">
    <view class="section-title"><text>📜</text> 等级特权</view>
  </view>
  <view class="unlock-list">
    <view wx:if="{{nextUnlock}}" class="unlock-item unlock-item--locked">
      <text class="unlock-icon">🌟</text>
      <view class="unlock-info">
        <text class="unlock-name">{{nextUnlock.name}}</text>
        <text class="unlock-level">{{nextUnlock.level}}级解锁</text>
      </view>
      <text class="unlock-lock">🔒</text>
    </view>
    <view wx:for="{{unlocks}}" wx:key="feature" class="unlock-item">
      <text class="unlock-icon">🎨</text>
      <view class="unlock-info">
        <text class="unlock-name">{{item.name}}</text>
        <text class="unlock-level">{{item.desc}}</text>
      </view>
      <text class="unlock-check">✓</text>
    </view>
  </view>

  <!-- 经验记录 -->
  <view class="section-header">
    <view class="section-title"><text>📋</text> 最近经验记录</view>
  </view>
  <view class="log-list">
    <view wx:for="{{logs}}" wx:key="id" class="log-item">
      <view class="log-info">
        <text class="log-reason">{{item.reason}}</text>
        <text class="log-date">{{item.logDate}}</text>
      </view>
      <text class="log-amount">+{{item.amount}}</text>
    </view>
    <view wx:if="{{!logs.length}}" class="empty">暂无记录</view>
  </view>
</scroll-view>
