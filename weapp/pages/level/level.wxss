/* pages/level/level.wxss — 原型风格 */
.level-header {
  background: linear-gradient(135deg, #E891A4 0%, #FADCE6 100%);
  padding: 24px;
  color: white;
  text-align: center;
  border-radius: 0 0 30px 15px;
}

.level-badge {
  display: block;
  font-size: 60px;
  margin-bottom: 10px;
}

.level-number {
  display: block;
  font-size: 30px;
  font-weight: 700;
  margin-bottom: 4px;
}

.level-title-text {
  display: block;
  font-size: 14px;
  opacity: 0.9;
}

.level-next {
  display: block;
  font-size: 12px;
  opacity: 0.8;
  margin-top: 10px;
}

.exp-card {
  background: white;
  border-radius: 16px;
  padding: 16px;
  margin: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.exp-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
}

.exp-label {
  font-size: 13px;
  color: var(--text-secondary, #666);
}

.exp-value {
  font-size: 13px;
  color: var(--primary, #ff6b9d);
  font-weight: 600;
}

.progress-bar {
  height: 8px;
  background: #f5f5f5;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary, #ff6b9d), var(--primary-light, #ff8fab));
  border-radius: 4px;
}

.section-header {
  padding: 16px 16px 8px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text, #333);
  display: flex;
  align-items: center;
  gap: 6px;
}

.unlock-list {
  padding: 0 16px 16px;
}

.unlock-item {
  display: flex;
  align-items: center;
  gap: 10px;
  background: white;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.unlock-icon {
  font-size: 24px;
}

.unlock-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.unlock-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text, #333);
}

.unlock-level {
  font-size: 11px;
  color: var(--text-secondary, #666);
}

.unlock-check {
  color: #4caf50;
  font-size: 18px;
}

.unlock-lock {
  color: var(--text-light, #999);
  font-size: 16px;
}

.log-list {
  padding: 0 16px 24px;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.log-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.log-reason {
  font-size: 13px;
  color: var(--text, #333);
}

.log-date {
  font-size: 11px;
  color: var(--text-light, #999);
}

.log-amount {
  color: #2e7d32;
  font-weight: 700;
  font-size: 14px;
}

.empty {
  text-align: center;
  padding: 20px;
  color: var(--text-light, #999);
  font-size: 13px;
}
