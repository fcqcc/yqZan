<scroll-view class="page" scroll-y>
  <view class="page-title">🎁 礼物记录</view>
  <view class="page-subtitle">记下送出的每一份心意</view>
  <button class="btn btn-primary" style="margin:0 12px 12px" bindtap="toggleForm">➕ 记录</button>
  <view wx:if="{{showForm}}" class="overlay" bindtap="toggleForm">
    <view class="sheet" catchtap="">
      <view class="sheet-title">记录礼物</view>
      <input class="input" placeholder="礼物名称" model:value="{{name}}" />
      <input class="input" type="digit" placeholder="价格（可选）" model:value="{{price}}" style="margin-top:8px" />
      <input class="input" placeholder="备注" model:value="{{note}}" style="margin-top:8px" />
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" bindtap="toggleForm">取消</button>
        <button class="btn btn-primary" bindtap="create">记录</button>
      </view>
    </view>
  </view>
  <view wx:for="{{gifts}}" wx:key="id" class="card" style="display:flex;justify-content:space-between;align-items:center">
    <view><view style="font-weight:600">{{item.name}}</view><view style="font-size:12px;color:#999;margin-top:2px">{{item.date_val}} {{item.note}}</view></view>
    <view style="color:#9d2d5a;font-weight:700">{{item.price > 0 ? '¥' + item.price.toLocaleString() : ''}}</view>
  </view>
  <view wx:if="{{!gifts.length}}" class="empty">还没有礼物记录</view>
</scroll-view>