.totem-center {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  flex: 1;
  justify-content: center;
  min-height: 0;
}

.totem-card-wrap {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  animation: totem-card-entrance 1.35s cubic-bezier(0.22, 1.15, 0.32, 1) forwards;
}

@keyframes totem-card-entrance {
  0% {
    transform: scale(0.35) rotate(-28deg);
    opacity: 0;
  }
  35% {
    opacity: 1;
  }
  55% {
    transform: scale(1.08) rotate(12deg);
  }
  72% {
    transform: scale(0.96) rotate(-8deg);
  }
  88% {
    transform: scale(1.02) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.totem-card-glow {
  position: absolute;
  inset: -24rpx;
  border-radius: 28rpx;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 235, 120, 0.75) 0%,
    rgba(255, 193, 7, 0.25) 45%,
    transparent 70%
  );
  animation: totem-glow-pulse 0.65s ease-in-out infinite alternate;
  z-index: 0;
  pointer-events: none;
}

@keyframes totem-glow-pulse {
  from {
    transform: scale(0.96);
    opacity: 0.75;
  }
  to {
    transform: scale(1.04);
    opacity: 1;
  }
}

.totem-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(165deg, #fffef5 0%, #fff8e1 40%, #ffecb3 100%);
  border: 3rpx solid rgba(255, 193, 7, 0.85);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.6) inset,
    0 20rpx 60rpx rgba(255, 152, 0, 0.35),
    0 8rpx 24rpx rgba(80, 40, 20, 0.2);
  text-align: center;
  animation: totem-card-float 2.2s ease-in-out infinite alternate;
}

@keyframes totem-card-float {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-12rpx);
  }
}

.totem-emoji {
  display: block;
  font-size: 64rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 152, 0, 0.45));
}

.totem-head {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #e65100;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.totem-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #4e342e;
  line-height: 1.35;
}

.totem-amt-row {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.totem-amt {
  color: #d65c8a;
}

.totem-slash {
  margin: 0 8rpx;
  color: #8d6e63;
  font-weight: 600;
}

.totem-target {
  color: #6d4c41;
}

.totem-sub {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #795548;
  line-height: 1.5;
}

.totem-tap-hint {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  font-size: 24rpx;
  color: rgba(255, 248, 220, 0.85);
  text-align: center;
  letter-spacing: 1rpx;
}
