/* pages/plans/plans.wxss — 存钱计划 */

.plans-wrap {
  min-height: 100vh;
  position: relative;
}

.page--scroll {
  height: 100vh;
  box-sizing: border-box;
}

.plans-cta {
  padding: 0 12px 12px;
}

.plan-card {
  margin-bottom: 14px;
  padding-top: 6px;
}

.plan-head {
  padding-right: 40px;
}

.plan-head-main {
  min-width: 0;
}

.plan-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.plan-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
}

.plan-done-tag {
  font-size: 11px;
  font-weight: 600;
  color: var(--pink-dark);
  background: rgba(214, 92, 138, 0.14);
  padding: 2px 8px;
  border-radius: 999px;
}

.plan-amount-row {
  margin-top: 6px;
  font-size: 14px;
  color: var(--text-secondary);
}

.plan-amount {
  font-weight: 800;
  color: var(--pink-dark);
  font-variant-numeric: tabular-nums;
}

.plan-slash {
  margin: 0 4px;
  opacity: 0.5;
}

.plan-target {
  font-variant-numeric: tabular-nums;
}

.plan-deadline {
  margin-top: 8px;
  font-size: 12px;
  color: var(--text-secondary);
}

.plan-chevron {
  font-size: 14px;
  color: var(--text-light);
  line-height: 1.2;
}

.plan-foot-btn-wrap {
  display: flex;
  justify-content: flex-start;
  margin-top: 14px;
}

.plan-expand-panel {
  margin-top: 8px;
  border: 1px solid rgba(42, 36, 38, 0.1);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.65);
  overflow: hidden;
}

.plan-expand-panel--after-progress {
  margin-top: 14px;
}

.plan-expand-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
  background: rgba(255, 248, 252, 0.9);
}

.plan-expand-bar:active .plan-chevron {
  color: var(--pink-dark);
}

.plan-detail--in-panel {
  margin-top: 0;
  padding-top: 10px;
  padding-left: 4px;
  padding-right: 4px;
  padding-bottom: 8px;
  border-top: 1px solid rgba(42, 36, 38, 0.08);
}

.deliver-datetime-row {
  display: flex;
  flex-direction: row;
  gap: 8px;
  margin-top: 8px;
}

.deliver-date-cell,
.deliver-time-cell {
  flex: 1;
  min-width: 0;
}

.field-tag-optional {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  margin-left: 4px;
}

.field-sublabel {
  display: block;
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 4px;
  line-height: 1.4;
}

.plan-progress {
  margin-top: 12px;
}

.plan-detail {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.plan-detail-loading,
.plan-detail-empty {
  font-size: 13px;
  color: var(--text-light);
  padding: 8px 0;
}

.deliver-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(42, 36, 38, 0.06);
}

.deliver-row:last-child {
  border-bottom: none;
}

.deliver-left {
  flex: 1;
  min-width: 0;
}

.deliver-amt {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--pink-dark);
  font-variant-numeric: tabular-nums;
}

.deliver-note {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--text);
  word-break: break-all;
}

.deliver-note.muted {
  color: var(--text-light);
  font-style: italic;
}

.deliver-time {
  font-size: 11px;
  color: var(--text-light);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.sheet--drawer {
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.sheet-body {
  padding-bottom: 8px;
}

.field-hint {
  font-size: 12px;
  color: var(--text-light);
  line-height: 1.5;
}

.input-picker {
  display: flex;
  align-items: center;
  min-height: var(--input-min-height);
}

/* 完成日：贴底滚轮 */
.overlay--picker-bottom {
  z-index: 200;
  align-items: flex-end;
  justify-content: center;
  background: rgba(61, 44, 56, 0.45);
}

.deadline-picker-sheet {
  width: 100%;
  max-width: 500px;
  background: #fffafc;
  border-radius: 20px 20px 0 0;
  border-top: 1px solid #ffd6e8;
  box-shadow: 0 -8px 28px rgba(214, 92, 138, 0.15);
  padding-bottom: calc(12px + constant(safe-area-inset-bottom));
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.deadline-picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 10px;
  border-bottom: 1px solid rgba(214, 92, 138, 0.12);
}

.deadline-picker-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}

.deadline-picker-link {
  font-size: 15px;
  color: var(--text-secondary);
  padding: 4px 8px;
}

.deadline-picker-link--strong {
  color: var(--pink-dark);
  font-weight: 600;
}

.deadline-picker-view {
  width: 100%;
  height: 220px;
}

.deadline-picker-item {
  line-height: 44px;
  text-align: center;
  font-size: 16px;
  color: var(--text);
}

.deadline-picker-footer {
  padding: 12px 16px 0;
}

/* ========== 目标达成：MC 不死图腾风格庆祝（点屏关闭） ========== */
.totem-overlay {
  position: fixed;
  inset: 0;
  z-index: 350;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.totem-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 85% 70% at 50% 45%,
    rgba(255, 213, 79, 0.45) 0%,
    rgba(255, 152, 0, 0.22) 35%,
    rgba(40, 20, 50, 0.88) 100%
  );
  animation: totem-vignette-pulse 1.8s ease-in-out infinite alternate;
}

@keyframes totem-vignette-pulse {
  from {
    filter: brightness(1);
    opacity: 0.92;
  }
  to {
    filter: brightness(1.12);
    opacity: 1;
  }
}

.totem-flash {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 230, 0);
  animation: totem-screen-flash 0.9s ease-out forwards;
  pointer-events: none;
}

@keyframes totem-screen-flash {
  0% {
    background: rgba(255, 255, 255, 0.92);
  }
  18% {
    background: rgba(255, 235, 120, 0.55);
  }
  45% {
    background: rgba(255, 183, 77, 0.2);
  }
  100% {
    background: rgba(255, 183, 77, 0);
  }
}

.totem-sunburst {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 600rpx;
  height: 600rpx;
  margin-left: -300rpx;
  margin-top: -300rpx;
  animation: totem-rays-spin 4s linear infinite;
  pointer-events: none;
  opacity: 0.55;
}

@keyframes totem-rays-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.totem-ray {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 50%;
  margin-left: -2rpx;
  margin-top: -50%;
  background: linear-gradient(
    180deg,
    rgba(255, 248, 200, 0.95) 0%,
    rgba(255, 193, 7, 0.35) 45%,
    transparent 100%
  );
  transform-origin: 50% 100%;
}

.totem-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.totem-particle {
  position: absolute;
  left: 50%;
  top: 42%;
  opacity: 0;
  border-radius: 50%;
  animation-timing-function: cubic-bezier(0.12, 0.85, 0.18, 1);
  animation-fill-mode: forwards;
  box-shadow: 0 0 6rpx rgba(255, 255, 200, 0.8);
}

.totem-particle--sq {
  border-radius: 2px;
}

.totem-p--0 {
  animation-name: totem-burst-0;
}
.totem-p--1 {
  animation-name: totem-burst-1;
}
.totem-p--2 {
  animation-name: totem-burst-2;
}
.totem-p--3 {
  animation-name: totem-burst-3;
}
.totem-p--4 {
  animation-name: totem-burst-4;
}
.totem-p--5 {
  animation-name: totem-burst-5;
}
.totem-p--6 {
  animation-name: totem-burst-6;
}
.totem-p--7 {
  animation-name: totem-burst-7;
}
.totem-p--8 {
  animation-name: totem-burst-8;
}
.totem-p--9 {
