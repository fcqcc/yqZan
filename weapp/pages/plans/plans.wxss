}
.totem-p--10 {
  animation-name: totem-burst-10;
}
.totem-p--11 {
  animation-name: totem-burst-11;
}

@keyframes totem-burst-0 {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.35) rotate(0deg);
  }
  10% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) translate(0, -280rpx) scale(0.9) rotate(680deg);
  }
}
