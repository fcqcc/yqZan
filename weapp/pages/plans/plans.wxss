/* pages/plans/plans.wxss — 存钱计划（原型风格） */

.plans-wrap {
  min-height: 100vh;
  position: relative;
}

.page--scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* ===== 页面Header（原型风格） ===== */
.page-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute;
  top: -30px; right: -20px;
  width: 120px; height: 120px;
  background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 70%);
  border-radius: 50%;
}
.page-title {
  font-size: 17px;
  font-weight: 700;
  color: white;
  flex: 1;
  text-align: center;
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 2px;
  text-shadow: 1.5px 1.5px 0 rgba(212, 112, 138, 0.4);
}
.header-action {
  background: rgba(255,255,255,0.95);
  color: var(--primary-dark);
  padding: 6px 14px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.25);
  border: 1.5px dashed var(--primary);
}

/* ===== 顶部汇总卡 ===== */
.plan-summary {
  margin: 16px;
  padding: 22px 24px;
  background: linear-gradient(135deg, #D4708A 0%, #C8758E 50%, #A85A74 100%);
  border-radius: 28px 12px 28px 12px;
  color: white;
  position: relative;
  overflow: hidden;
  box-shadow: 6px 6px 0 rgba(168, 90, 116, 0.3);
  border: 2px dashed rgba(255,255,255,0.5);
}
.plan-summary::before {
  content: '';
  position: absolute;
  top: -50px; right: -50px;
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
  border-radius: 50%;
}
.plan-summary::after {
  content: '💰';
  position: absolute;
  bottom: -10px; right: 14px;
  font-size: 90px;
  opacity: 0.25;
  transform: rotate(-15deg);
}
.plan-summary__label {
  font-size: 12px;
  opacity: 0.9;
  font-weight: 500;
  margin-bottom: 4px;
  position: relative;
  z-index: 1;
}
.plan-summary__total {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 50px;
  font-weight: 700;
  text-shadow: 3px 3px 0 rgba(0,0,0,0.15);
  line-height: 1;
  letter-spacing: 2px;
  position: relative;
  z-index: 1;
}
.plan-summary__breakdown {
  display: flex;
  gap: 14px;
  margin-top: 14px;
  position: relative;
  z-index: 1;
}
.plan-summary__item {
  background: rgba(255,255,255,0.2);
  padding: 6px 12px;
  border-radius: 14px 4px 14px 4px;
  border: 1.5px dashed rgba(255,255,255,0.4);
  backdrop-filter: blur(4px);
}
.plan-summary__item-num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.1;
}
.plan-summary__item-label {
  font-size: 10px;
  opacity: 0.9;
}

/* ===== 月度趋势 ===== */
.plan-trend {
  margin: 0 16px 16px;
  padding: 16px 18px;
  background: white;
  border: 2px dashed var(--card-border);
  border-radius: 22px 10px 22px 10px;
  box-shadow: 4px 4px 0 rgba(232, 145, 164, 0.15);
}
.plan-trend__header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12px;
}
.plan-trend__title {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 16px;
  color: var(--text-primary);
  font-weight: 700;
}
.plan-trend__num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px;
  color: var(--primary-dark);
  font-weight: 700;
}
.plan-trend__bars {
  display: flex;
  gap: 6px;
  align-items: flex-end;
  height: 70px;
}
.plan-trend__bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.plan-trend__bar-fill {
  width: 100%;
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
  border-radius: 8px 8px 0 0;
  border: 1.5px dashed rgba(255,255,255,0.5);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.3);
}
.plan-trend__bar-label {
  font-size: 9px;
  color: var(--text-secondary);
  font-family: 'ZCOOL KuaiLe', cursive;
}

/* ===== 计划列表标题 ===== */
.plan-section-title {
  padding: 16px 20px 8px;
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 16px;
  color: var(--text-primary);
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
.plan-section-title__count {
  font-family: 'Noto Sans SC', sans-serif;
  font-size: 10px;
  color: var(--text-secondary);
  background: var(--primary-pale);
  padding: 2px 8px;
  border-radius: 8px 2px 8px 2px;
  border: 1px dashed var(--primary);
  font-weight: 600;
  margin-left: auto;
}

/* ===== 计划卡片 ===== */
.plan-list { padding: 0 16px 30px; }
.plan-card {
  margin-bottom: 14px;
  background: white;
  border: 2px dashed var(--card-border);
  border-radius: 28px 12px 28px 12px;
  padding: 16px 18px;
  position: relative;
  box-shadow: 5px 5px 0 rgba(232, 145, 164, 0.15);
  overflow: hidden;
}
.plan-card--pink { background: linear-gradient(135deg, white 0%, #FFF5FA 100%); }
.plan-card--orange { background: linear-gradient(135deg, white 0%, #FFF5EE 100%); }
.plan-card--blue { background: linear-gradient(135deg, white 0%, #F0F8FF 100%); }
.plan-card--green { background: linear-gradient(135deg, white 0%, #F0FFF0 100%); }

.plan-card__head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.plan-card__icon {
  width: 56px; height: 56px;
  background: white;
  border-radius: 16px 4px 16px 4px;
  display: flex; align-items: center; justify-content: center;
  font-size: 30px;
  border: 2px dashed var(--card-border);
  box-shadow: 3px 3px 0 rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.plan-card--pink .plan-card__icon { color: #E891A4; background: #FFE8EE; }
.plan-card--orange .plan-card__icon { color: #FF8E53; background: #FFE8D9; }
.plan-card--blue .plan-card__icon { color: #7BC4E8; background: #E0F4FF; }
.plan-card--green .plan-card__icon { color: #7BC67B; background: #E8F5E8; }

.plan-card__title-block { flex: 1; }
.plan-card__name {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 20px;
  color: var(--text-primary);
  font-weight: 700;
  line-height: 1.1;
}
.plan-card__sub {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}
.plan-card__status {
  padding: 5px 12px;
  border-radius: 14px 4px 14px 4px;
  font-size: 11px;
  font-weight: 700;
  border: 1.5px dashed;
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 1px;
  flex-shrink: 0;
}
.plan-card__status--active { color: #7BC67B; background: #E8F5E9; border-color: #7BC67B; }
.plan-card__status--done { color: var(--primary-dark); background: var(--primary-pale); border-color: var(--primary); }

.plan-card__progress-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 10px;
}
.plan-card__current {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 32px;
  color: var(--text-primary);
  font-weight: 700;
  line-height: 1;
}
.plan-card__target {
  font-size: 13px;
  color: var(--text-light);
  font-family: 'ZCOOL KuaiLe', cursive;
}
.plan-card__pct {
  margin-left: auto;
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px;
  color: var(--primary-dark);
  font-weight: 700;
}

.plan-card__bar {
  height: 16px;
  background: var(--primary-pale);
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid #F0E0E4;
  position: relative;
}
.plan-card__bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, #FFB347 50%, #FFD93D 100%);
  border-radius: 8px;
  position: relative;
}
.plan-card__bar-fill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(45deg, transparent 0, transparent 8px, rgba(255,255,255,0.15) 8px, rgba(255,255,255,0.15) 10px);
}

.plan-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1.5px dotted #F0E8EC;
}
.plan-card__date {
  font-size: 10px;
  color: var(--text-light);
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 0.5px;
}
.plan-card__btn {
  background: var(--primary);
  color: white;
  padding: 6px 16px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.3);
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 1px;
}
.plan-card__btn--done {
  background: var(--primary-pale);
  color: var(--primary-dark);
  border: 1.5px dashed var(--primary);
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.15);
}

.plan-card__del {
  position: absolute;
  top: 8px; right: 10px;
  font-size: 18px;
  color: var(--text-light);
  padding: 4px;
  z-index: 2;
  line-height: 1;
}

.plan-card__expand {
  margin-top: 8px;
  text-align: center;
  font-size: 11px;
  color: var(--text-light);
  padding: 6px 0;
}
.plan-card__chevron {
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 1px;
}
.plan-card__detail {
  margin-top: 6px;
  border-top: 1.5px dotted #F0E8EC;
  padding-top: 8px;
}
.plan-card__deliver-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px dotted #F5F0F2;
}
.plan-card__deliver-amt {
  font-size: 13px;
  color: var(--success);
  font-weight: 700;
}
.plan-card__deliver-note {
  font-size: 11px;
  color: var(--text-secondary);
  margin-left: 6px;
}
.plan-card__deliver-time {
  font-size: 10px;
  color: var(--text-light);
}
.plan-detail-loading,
.plan-detail-empty {
  text-align: center;
  color: var(--text-light);
  font-size: 12px;
  padding: 10px;
}

/* 以下保持原有不变量 — 弹窗/选择器/动效 */

/* ===== 交付行 ===== */
.deliver-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(42, 36, 38, 0.06);
}

.deliver-row:last-child {
  border-bottom: none;
}

.deliver-left {
  flex: 1;
  min-width: 0;
}

.deliver-amt {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--pink-dark);
  font-variant-numeric: tabular-nums;
}

.deliver-note {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--text);
  word-break: break-all;
}

.deliver-note.muted {
  color: var(--text-light);
  font-style: italic;
}

.deliver-time {
  font-size: 11px;
  color: var(--text-light);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.sheet--drawer {
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.sheet-body {
  padding-bottom: 8px;
}

.field-hint {
  font-size: 12px;
  color: var(--text-light);
  line-height: 1.5;
}

.input-picker {
  display: flex;
  align-items: center;
  min-height: var(--input-min-height);
}

/* 完成日：贴底滚轮 */
.overlay--picker-bottom {
  z-index: 200;
  align-items: flex-end;
  justify-content: center;
  background: rgba(61, 44, 56, 0.45);
}

.deadline-picker-sheet {
  width: 100%;
  max-width: 500px;
  background: #fffafc;
  border-radius: 20px 20px 0 0;
  border-top: 1px solid #ffdce8;
  box-shadow: 0 -8px 28px rgba(255, 107, 157, 0.15);
  padding-bottom: calc(12px + constant(safe-area-inset-bottom));
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.deadline-picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 10px;
  border-bottom: 1px solid rgba(255, 107, 157, 0.12);
}

.deadline-picker-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
}

.deadline-picker-link {
  font-size: 15px;
  color: var(--text-secondary);
  padding: 4px 8px;
}

.deadline-picker-link--strong {
  color: var(--pink-dark);
  font-weight: 600;
}

.deadline-picker-view {
  width: 100%;
  height: 220px;
}

.deadline-picker-item {
  line-height: 44px;
  text-align: center;
  font-size: 16px;
  color: var(--text);
}

.deadline-picker-footer {
  padding: 12px 16px 0;
}

/* ========== 目标达成：MC 不死图腾风格庆祝（点屏关闭） ========== */
.totem-overlay {
  position: fixed;
  inset: 0;
  z-index: 350;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.totem-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 85% 70% at 50% 45%,
    rgba(255, 213, 79, 0.45) 0%,
    rgba(255, 152, 0, 0.22) 35%,
    rgba(40, 20, 50, 0.88) 100%
  );
  animation: totem-vignette-pulse 1.8s ease-in-out infinite alternate;
}

@keyframes totem-vignette-pulse {
  from {
    filter: brightness(1);
    opacity: 0.92;
  }
  to {
    filter: brightness(1.12);
    opacity: 1;
  }
}

.totem-flash {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 230, 0);
  animation: totem-screen-flash 0.9s ease-out forwards;
  pointer-events: none;
}

@keyframes totem-screen-flash {
  0% {
    background: rgba(255, 255, 255, 0.92);
  }
  18% {
    background: rgba(255, 235, 120, 0.55);
  }
  45% {
    background: rgba(255, 183, 77, 0.2);
  }
  100% {
    background: rgba(255, 183, 77, 0);
  }
}

.totem-sunburst {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 600rpx;
  height: 600rpx;
  margin-left: -300rpx;
  margin-top: -300rpx;
  animation: totem-rays-spin 4s linear infinite;
  pointer-events: none;
  opacity: 0.55;
}

@keyframes totem-rays-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.totem-ray {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 4rpx;
  height: 50%;
  margin-left: -2rpx;
  margin-top: -50%;
  background: linear-gradient(
    180deg,
    rgba(255, 248, 200, 0.95) 0%,
    rgba(255, 193, 7, 0.35) 45%,
    transparent 100%
  );
  transform-origin: 50% 100%;
}

.totem-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.totem-particle {
  position: absolute;
  left: 50%;
  top: 42%;
  opacity: 0;
  border-radius: 50%;
  animation-timing-function: cubic-bezier(0.12, 0.85, 0.18, 1);
  animation-fill-mode: forwards;
  box-shadow: 0 0 6rpx rgba(255, 255, 200, 0.8);
}

.totem-particle--sq {
  border-radius: 2px;
}

.totem-p--0 {
  animation-name: totem-burst-0;
}
.totem-p--1 {
  animation-name: totem-burst-1;
}
.totem-p--2 {
  animation-name: totem-burst-2;
}
.totem-p--3 {
  animation-name: totem-burst-3;
}
.totem-p--4 {
  animation-name: totem-burst-4;
}
.totem-p--5 {
  animation-name: totem-burst-5;
}
.totem-p--6 {
  animation-name: totem-burst-6;
}
.totem-p--7 {
  animation-name: totem-burst-7;
}
.totem-p--8 {
  animation-name: totem-burst-8;
}
.totem-p--9 {
  animation-name: totem-burst-9;
}
.totem-p--10 {
  animation-name: totem-burst-10;
}
.totem-p--11 {
  animation-name: totem-burst-11;
}

@keyframes totem-burst-0 {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.35) rotate(0deg);
  }
  10% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) translate(0, -280rpx) scale(0.9) rotate(680deg);
  }
}
@keyframes totem-burst-1 {
