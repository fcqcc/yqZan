.totem-center {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  flex: 1;
  justify-content: center;
  min-height: 0;
}

.totem-card-wrap {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  animation: totem-card-entrance 1.35s cubic-bezier(0.22, 1.15, 0.32, 1) forwards;
}

@keyframes totem-card-entrance {
  0% {
    transform: scale(0.35) rotate(-28deg);
    opacity: 0;
  }
  35% {
    opacity: 1;
  }
  55% {
    transform: scale(1.08) rotate(12deg);
  }
  72% {
    transform: scale(0.96) rotate(-8deg);
  }
  88% {
    transform: scale(1.02) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.totem-card-glow {
  position: absolute;
  inset: -24rpx;
  border-radius: 28rpx;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(255, 235, 120, 0.75) 0%,
    rgba(255, 193, 7, 0.25) 45%,
    transparent 70%
  );
  animation: totem-glow-pulse 0.65s ease-in-out infinite alternate;
  z-index: 0;
  pointer-events: none;
}

@keyframes totem-glow-pulse {
  from {
    transform: scale(0.96);
    opacity: 0.75;
  }
  to {
    transform: scale(1.04);
    opacity: 1;
  }
}

.totem-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(165deg, #fffef5 0%, #fff8e1 40%, #ffecb3 100%);
  border: 3rpx solid rgba(255, 193, 7, 0.85);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.6) inset,
    0 20rpx 60rpx rgba(255, 152, 0, 0.35),
    0 8rpx 24rpx rgba(80, 40, 20, 0.2);
  text-align: center;
  animation: totem-card-float 2.2s ease-in-out infinite alternate;
}

@keyframes totem-card-float {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-12rpx);
  }
}

.totem-emoji {
  display: block;
  font-size: 64rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 152, 0, 0.45));
}

.totem-head {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #e65100;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.totem-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #4e342e;
  line-height: 1.35;
}

.totem-amt-row {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.totem-amt {
  color: #ff6b9d;
}

.totem-slash {
  margin: 0 8rpx;
  color: #8d6e63;
  font-weight: 600;
}

.totem-target {
  color: #6d4c41;
}

.totem-sub {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #795548;
  line-height: 1.5;
}

.totem-tap-hint {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  font-size: 24rpx;
  color: rgba(255, 248, 220, 0.85);
  text-align: center;
  letter-spacing: 1rpx;
}

/* 游客模式遮罩 */
.guest-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.guest-card {
  display: none;
}
.guest-card-icon { font-size: 44px; margin-bottom: 12px; }
.guest-card-title { font-size: 17px; font-weight: 700; color: var(--ink); display: block; margin-bottom: 6px; }
.guest-card-desc { font-size: 13px; color: var(--ink-soft); display: block; margin-bottom: 24px; }
.guest-card-btn {
  border: none; border-radius: 22px; padding: 12px 0;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  color: #fff; font-size: 15px; font-weight: 600; width: 100%; line-height: 1.4;
}
.guest-card-btn::after { border: none; }

/* ========== 存钱成功：金币弹射动画 ========== */
.coin-overlay {
  position: fixed;
  inset: 0;
  z-index: 400;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(40, 20, 40, 0.55);
  backdrop-filter: blur(6px);
}
.coin-burst {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.coin-particle {
  position: absolute;
  left: 50%;
  top: 45%;
  font-size: 28px;
  opacity: 0;
  animation: coinFly 0.8s cubic-bezier(0.22, 0.85, 0.15, 1) forwards;
  animation-delay: var(--coin-delay);
  transform: translate(-50%, -50%);
}
@keyframes coinFly {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5) rotate(0deg); }
  30% { opacity: 1; transform: translate(calc(-50% + var(--coin-x) * 0.4), calc(-50% + var(--coin-y) * 0.4)) scale(1.2) rotate(calc(var(--coin-rotate) * 0.4)); }
  100% { opacity: 0; transform: translate(calc(-50% + var(--coin-x)), calc(-50% + var(--coin-y))) scale(0.8) rotate(var(--coin-rotate)); }
}
.coin-center-text {
  position: relative;
  z-index: 2;
  text-align: center;
}
.coin-amount {
  display: block;
  font-size: 48px;
  font-weight: 900;
  color: #ffd54f;
  text-shadow: 0 2px 16px rgba(255, 213, 79, 0.6), 0 0 40px rgba(255, 193, 7, 0.3);
  animation: coinAmountBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}
.coin-label {
  display: block;
  font-size: 16px;
  color: rgba(255,255,255,0.85);
  margin-top: 8px;
  font-weight: 600;
  letter-spacing: 2px;
}
@keyframes coinAmountBounce {
  0% { transform: scale(0.3); opacity: 0; }
  70% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
