    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) translate(150rpx, -240rpx) scale(0.9) rotate(640deg);
  }
}
@keyframes totem-burst-2 {
  0% {
    opacity: 0;
