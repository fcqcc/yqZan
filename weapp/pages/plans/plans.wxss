.overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:100;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:#fff;border-radius:16px 16px 0 0;padding:20px;width:100%;max-width:500px}
.sheet-title{font-size:16px;font-weight:700;margin-bottom:14px;text-align:center}
.btn-block{width:100%}
.deliveries{margin-top:8px;border-top:1px solid #f0f0f0;padding-top:6px}
.del-item{display:flex;justify-content:space-between;font-size:12px;color:#666;padding:3px 0}
