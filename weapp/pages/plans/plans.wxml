<view class="app-root app-theme-{{uiTheme}} plans-wrap">
  <scroll-view class="page page--scroll" scroll-y>
    <!-- ===== 页面Header ===== -->
    <view class="page-header">
      <text class="page-title">存钱计划</text>
      <view class="header-action" bindtap="toggleForm">+ 新建</view>
    </view>

    <!-- ===== 总存汇总卡 ===== -->
    <view class="plan-summary">
      <view class="plan-summary__label">累计已存</view>
      <view class="plan-summary__total">¥{{totalSaved}}</view>
      <view class="plan-summary__breakdown">
        <view class="plan-summary__item">
          <view class="plan-summary__item-num">{{activeCount}}</view>
          <view class="plan-summary__item-label">进行中</view>
        </view>
        <view class="plan-summary__item">
          <view class="plan-summary__item-num">{{doneCount}}</view>
          <view class="plan-summary__item-label">已完成</view>
        </view>
        <view class="plan-summary__item">
          <view class="plan-summary__item-num">¥{{monthSaved}}</view>
          <view class="plan-summary__item-label">本月</view>
        </view>
      </view>
    </view>

    <!-- ===== 月度趋势 ===== -->
    <view class="plan-trend">
      <view class="plan-trend__header">
        <text class="plan-trend__title">📈 近 6 月存钱趋势</text>
        <text class="plan-trend__num">¥{{monthSaved}}</text>
      </view>
      <view class="plan-trend__bars">
        <view wx:for="{{trendBars}}" wx:key="label" class="plan-trend__bar">
          <view class="plan-trend__bar-fill" style="height: {{item.height}};{{item.isMax ? ' background:linear-gradient(180deg,#FF6B6B 0%,#FF8E53 100%);' : ''}}"></view>
          <text class="plan-trend__bar-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 计划列表标题 ===== -->
    <view class="plan-section-title">
      <text>💎 我的存钱计划</text>
      <text class="plan-section-title__count">共 {{plans.length}} 个</text>
    </view>

    <view class="plan-list">
      <view wx:for="{{plans}}" wx:key="id" class="plan-card plan-card--{{item.colorClass || 'pink'}}">
        <view class="plan-card__head">
          <view class="plan-card__icon">{{item.icon || '💰'}}</view>
          <view class="plan-card__title-block">
            <text class="plan-card__name">{{item.title}}</text>
            <text class="plan-card__sub">目标 ¥{{item._tarText}} · {{item.done ? '已完成' : '还差 ' + item._remainText}}</text>
          </view>
          <view class="plan-card__status plan-card__status--{{item.done ? 'done' : 'active'}}">{{item.done ? '已完成' : '进行中'}}</view>
        </view>

        <view class="plan-card__progress-row">
          <text class="plan-card__current">¥{{item._curText}}</text>
          <text class="plan-card__target">/ ¥{{item._tarText}}</text>
          <text class="plan-card__pct">{{item.progressPct}}%</text>
        </view>

        <view class="plan-card__bar">
          <view class="plan-card__bar-fill" style="width: {{item.progressPct}}%;"></view>
        </view>

        <view class="plan-card__footer">
          <text class="plan-card__date">{{item._dateRange}}</text>
          <view wx:if="{{!item.done}}" class="plan-card__btn" catchtap="openDeliver" data-id="{{item.id}}">+ 记一笔</view>
          <view wx:else class="plan-card__btn plan-card__btn--done" catchtap="toggleExpand" data-index="{{index}}">查看明细</view>
        </view>

        <!-- 删除按钮 -->
        <text class="plan-card__del" catchtap="del" data-id="{{item.id}}">×</text>

        <!-- 展开明细 -->
        <view class="plan-card__expand" catchtap="toggleExpand" data-index="{{index}}">
          <text class="plan-card__chevron">{{item.expanded ? '▲' : '▼'}} 明细</text>
        </view>
        <view wx:if="{{item.expanded}}" class="plan-card__detail">
          <view wx:if="{{item.deliveriesLoading}}" class="plan-detail-loading">加载中…</view>
          <block wx:else>
            <view wx:if="{{!item.deliveries.length}}" class="plan-detail-empty">暂无存入记录</view>
            <view wx:for="{{item.deliveries}}" wx:for-item="d" wx:for-index="di" wx:key="di" class="plan-card__deliver-row">
              <view class="plan-card__deliver-left">
                <text class="plan-card__deliver-amt">+¥{{d.amount}}</text>
                <text wx:if="{{d.note}}" class="plan-card__deliver-note">{{d.note}}</text>
              </view>
              <text class="plan-card__deliver-time">{{d._when}}</text>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{!plans.length}}" class="empty">还没有存钱计划，先创建一个吧</view>
    </view>
  </scroll-view>

  <!-- ===== 创建表单 ===== -->
  <view wx:if="{{showForm}}" class="overlay" bindtap="toggleForm">
    <view class="sheet sheet--drawer" catchtap="catchTap">
      <view class="sheet-title">创建存钱计划</view>
      <view class="sheet-body">
        <view class="field">
          <text class="field-label">计划名称</text>
          <input class="input" placeholder="例如：旅行基金" model:value="{{title}}" />
        </view>
        <view class="field">
          <text class="field-label">目标金额（元）</text>
          <input class="input" type="digit" placeholder="输入数字" model:value="{{target}}" />
        </view>
        <view class="field">
          <text class="field-label">目标完成日（可选）</text>
          <view class="input input-picker" bindtap="openDeadlinePicker">{{deadlineDate || '点选日期'}}</view>
        </view>
      </view>
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" catchtap="toggleForm">取消</button>
        <button class="btn btn-primary" catchtap="create">创建</button>
      </view>
    </view>
  </view>

  <!-- ===== 记一笔弹窗 ===== -->
  <view wx:if="{{showDeliver}}" class="overlay" bindtap="closeDeliver">
    <view class="sheet sheet--drawer" catchtap="catchTap">
      <view class="sheet-title">记一笔</view>
      <view class="sheet-body">
        <view class="field">
          <text class="field-label">存入金额（元）</text>
          <input class="input" type="digit" placeholder="本次存入" model:value="{{amount}}" />
        </view>
        <view class="field">
          <text class="field-label">完成时间 <text class="field-tag-optional">非必填</text></text>
          <text class="field-sublabel">不填则按服务器记录的存入时间</text>
          <view class="deliver-datetime-row">
            <picker mode="date" value="{{deliverCompleteDate}}" bindchange="onDeliverCompleteDate">
              <view class="input input-picker deliver-date-cell">{{deliverCompleteDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{deliverCompleteTime}}" bindchange="onDeliverCompleteTime">
              <view class="input input-picker deliver-time-cell">{{deliverCompleteTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="field">
          <text class="field-label">备注（可选）</text>
          <input class="input" placeholder="写一句心情或用途" model:value="{{note}}" />
        </view>
        <view class="field-hint">未填完成时间则由服务器记录入账时间。</view>
      </view>
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" catchtap="closeDeliver">取消</button>
        <button class="btn btn-primary" catchtap="doDeliver">提交</button>
      </view>
    </view>
  </view>

  <!-- ===== 完成日选择器 ===== -->
  <view wx:if="{{showDeadlinePicker}}" class="overlay overlay--picker-bottom" catchtap="cancelDeadlinePicker">
    <view class="deadline-picker-sheet" catchtap="catchTap">
      <view class="deadline-picker-bar">
        <text class="deadline-picker-link" catchtap="cancelDeadlinePicker">取消</text>
        <text class="deadline-picker-title">选择完成日</text>
        <text class="deadline-picker-link deadline-picker-link--strong" catchtap="clearDeadlinePicker">清空</text>
      </view>
      <picker-view
        class="deadline-picker-view"
        indicator-style="height:44px;"
        mask-style="background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,.6),rgba(255,255,255,.95));"
        value="{{deadlinePickerIdx}}"
        bindchange="onDeadlinePickerViewChange"
      >
        <picker-view-column>
          <view wx:for="{{deadlineYears}}" wx:key="*this" class="deadline-picker-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{deadlineMonths}}" wx:key="*this" class="deadline-picker-item">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{deadlineDays}}" wx:key="*this" class="deadline-picker-item">{{item}}日</view>
        </picker-view-column>
      </picker-view>
      <view class="deadline-picker-footer">
        <button class="btn btn-primary btn-block" catchtap="confirmDeadlinePicker">确定</button>
      </view>
    </view>
  </view>

  <!-- ===== 图腾庆祝特效 ===== -->
  <view wx:if="{{showTotemCelebrate}}" class="totem-overlay" bindtap="closeTotemCelebrate" catchtouchmove="noop">
    <view class="totem-vignette"></view>
    <view class="totem-flash"></view>
    <view class="totem-sunburst">
      <view wx:for="{{[0,1,2,3,4,5,6,7]}}" wx:key="*this" class="totem-ray" style="transform: rotate({{item * 45}}deg);"></view>
    </view>
    <view class="totem-particles">
      <view wx:for="{{totemParticles}}" wx:key="id" class="totem-particle totem-p--{{item.dir}} {{item.square ? 'totem-particle--sq' : ''}}" style="animation-delay: {{item.delay}}s; animation-duration: {{item.dur}}s; width: {{item.size}}px; height: {{item.size}}px; background-color: {{item.color}};"></view>
    </view>
    <view class="totem-center">
      <view class="totem-card-wrap">
        <view class="totem-card-glow"></view>
        <view class="totem-card">
          <text class="totem-emoji">🏆</text>
          <text class="totem-head">目标达成！</text>
          <text class="totem-title">{{totemPlan.title}}</text>
          <view class="totem-amt-row">
            <text class="totem-amt">¥{{totemPlan._curText}}</text>
            <text class="totem-slash">/</text>
            <text class="totem-target">¥{{totemPlan._tarText}}</text>
          </view>
          <text class="totem-sub">像图腾护佑一样，你们一起守住了这份约定 ✨</text>
        </view>
      </view>
    </view>
    <text class="totem-tap-hint">点击屏幕任意处继续</text>
  </view>

  <!-- ===== 金币动效 ===== -->
  <view wx:if="{{showCoinEffect}}" class="coin-overlay">
    <view wx:for="{{coinParticles}}" wx:key="*this" class="coin-particle" style="animation-delay: {{item.delay}}s; --tx: {{item.x}}px; --ty: {{item.y}}px; --rotate: {{item.rotate}}deg;">{{item.emoji}}</view>
  </view>
</view>
