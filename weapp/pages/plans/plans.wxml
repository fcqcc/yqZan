<!-- pages/plans/plans.wxml — 存钱计划（原型风格） -->
<view class="plans-wrap">
  <scroll-view class="page page--scroll" scroll-y>
    <!-- 顶部：累计已存 + 新建计划 -->
    <view class="plans-header">
      <view class="plans-header-left">
        <text class="total-amount-label">累计已存</text>
        <text class="total-amount-value">¥{{totalSaved}}</text>
      </view>
      <view class="add-plan-btn" bindtap="toggleForm"><text>+</text> 新建计划</view>
    </view>

    <view class="plan-list">

    <view wx:if="{{showForm}}" class="overlay" bindtap="toggleForm">
      <view class="sheet sheet--drawer" catchtap="catchTap">
        <view class="sheet-title">创建存钱计划</view>
        <view class="sheet-body">
          <view class="field">
            <text class="field-label">计划名称</text>
            <input class="input" placeholder="例如：旅行基金" model:value="{{title}}" />
          </view>
          <view class="field">
            <text class="field-label">目标金额（元）</text>
            <input class="input" type="digit" placeholder="输入数字" model:value="{{target}}" />
          </view>
          <view class="field">
            <text class="field-label">目标完成日（可选）</text>
            <view class="input input-picker" bindtap="openDeadlinePicker">
              {{deadlineDate || '点选日期'}}
            </view>
          </view>
        </view>
        <view class="sheet-actions-inline">
          <button class="btn btn-outline" catchtap="toggleForm">取消</button>
          <button class="btn btn-primary" catchtap="create">创建</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showDeliver}}" class="overlay" bindtap="closeDeliver">
      <view class="sheet sheet--drawer" catchtap="catchTap">
        <view class="sheet-title">记一笔</view>
        <view class="sheet-body">
          <view class="field">
            <text class="field-label">存入金额（元）</text>
            <input class="input" type="digit" placeholder="本次存入" model:value="{{amount}}" />
          </view>
          <view class="field">
            <text class="field-label">完成时间 <text class="field-tag-optional">非必填</text></text>
            <text class="field-sublabel">不填则按服务器记录的存入时间</text>
            <view class="deliver-datetime-row">
              <picker mode="date" value="{{deliverCompleteDate}}" bindchange="onDeliverCompleteDate">
                <view class="input input-picker deliver-date-cell">{{deliverCompleteDate || '选择日期'}}</view>
              </picker>
              <picker mode="time" value="{{deliverCompleteTime}}" bindchange="onDeliverCompleteTime">
                <view class="input input-picker deliver-time-cell">{{deliverCompleteTime || '选择时间'}}</view>
              </picker>
            </view>
          </view>
          <view class="field">
            <text class="field-label">备注（可选）</text>
            <input class="input" placeholder="写一句心情或用途" model:value="{{note}}" />
          </view>
          <view class="field-hint">未填完成时间则由服务器记录入账时间。</view>
        </view>
        <view class="sheet-actions-inline">
          <button class="btn btn-outline" catchtap="closeDeliver">取消</button>
          <button class="btn btn-primary" catchtap="doDeliver">提交</button>
        </view>
      </view>
    </view>

    <view wx:for="{{plans}}" wx:key="id" class="plan-item">
      <view
        class="plan-item-close"
        catchtap="del"
        data-id="{{item.id}}"
      >×</view>
      <view class="plan-item-header" bindtap="toggleExpand" data-index="{{index}}">
        <text class="plan-item-title">{{item.title}}</text>
        <text class="plan-item-status {{item.done ? 'completed' : 'active'}}">{{item.done ? '已完成' : '进行中'}}</text>
      </view>
      <view class="plan-amount-row">
        <text class="plan-current">¥{{item._curText}}</text>
        <text class="plan-target">/ ¥{{item._tarText}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width:{{item.progressPct}}%;" />
      </view>
      <view class="plan-item-date" wx:if="{{item.deadline_date}}">{{item.deadline_date}}</view>

      <view wx:if="{{!item.done}}" class="plan-foot-btn-wrap">
        <button class="btn btn-outline btn-sm" catchtap="openDeliver" data-id="{{item.id}}">🪙 记一笔</button>
      </view>

      <view class="plan-expand-panel">
        <view class="plan-expand-bar" catchtap="toggleExpand" data-index="{{index}}">
          <text class="plan-chevron">{{item.expanded ? '▲' : '▼'}} 明细</text>
        </view>
        <view wx:if="{{item.expanded}}" class="plan-detail plan-detail--in-panel">
          <view wx:if="{{item.deliveriesLoading}}" class="plan-detail-loading">加载中…</view>
          <block wx:else>
            <view wx:if="{{!item.deliveries.length}}" class="plan-detail-empty">暂无存入记录</view>
            <view wx:for="{{item.deliveries}}" wx:for-item="d" wx:for-index="di" wx:key="di" class="deliver-row">
              <view class="deliver-left">
                <text class="deliver-amt">+¥{{d.amount}}</text>
                <text wx:if="{{d.note}}" class="deliver-note">{{d.note}}</text>
              </view>
              <text class="deliver-time">{{d._when}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view wx:if="{{!plans.length}}" class="empty">还没有存钱计划，先创建一个吧</view>
    </view>
  </scroll-view>

  <!-- 完成日：底部滚轮（贴屏幕底） -->
  <view wx:if="{{showDeadlinePicker}}" class="overlay overlay--picker-bottom" catchtap="cancelDeadlinePicker">
    <view class="deadline-picker-sheet" catchtap="catchTap">
      <view class="deadline-picker-bar">
        <text class="deadline-picker-link" catchtap="cancelDeadlinePicker">取消</text>
        <text class="deadline-picker-title">选择完成日</text>
        <text class="deadline-picker-link deadline-picker-link--strong" catchtap="clearDeadlinePicker">清空</text>
      </view>
      <picker-view
        class="deadline-picker-view"
        indicator-style="height:44px;"
        mask-style="background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,.6),rgba(255,255,255,.95));"
        value="{{deadlinePickerIdx}}"
        bindchange="onDeadlinePickerViewChange"
      >
        <picker-view-column>
          <view wx:for="{{deadlineYears}}" wx:key="*this" class="deadline-picker-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{deadlineMonths}}" wx:key="*this" class="deadline-picker-item">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{deadlineDays}}" wx:key="*this" class="deadline-picker-item">{{item}}日</view>
        </picker-view-column>
      </picker-view>
      <view class="deadline-picker-footer">
        <button class="btn btn-primary btn-block" catchtap="confirmDeadlinePicker">确定</button>
      </view>
    </view>
  </view>

  <!-- 目标达成：图腾特效（点击屏幕任意处关闭） -->
  <view
    wx:if="{{showTotemCelebrate}}"
    class="totem-overlay"
    bindtap="closeTotemCelebrate"
    catchtouchmove="noop"
  >
    <view class="totem-vignette"></view>
    <view class="totem-flash"></view>
    <view class="totem-sunburst">
      <view wx:for="{{[0,1,2,3,4,5,6,7]}}" wx:key="*this" class="totem-ray" style="transform: rotate({{item * 45}}deg);"></view>
    </view>
    <view class="totem-particles">
      <view
        wx:for="{{totemParticles}}"
        wx:key="id"
        class="totem-particle totem-p--{{item.dir}} {{item.square ? 'totem-particle--sq' : ''}}"
        style="animation-delay: {{item.delay}}s; animation-duration: {{item.dur}}s; width: {{item.size}}px; height: {{item.size}}px; background-color: {{item.color}};"
      ></view>
    </view>
    <view class="totem-center">
      <view class="totem-card-wrap">
        <view class="totem-card-glow"></view>
        <view class="totem-card">
          <text class="totem-emoji">🏆</text>
          <text class="totem-head">目标达成！</text>
          <text class="totem-title">{{totemPlan.title}}</text>
          <view class="totem-amt-row">
            <text class="totem-amt">¥{{totemPlan._curText}}</text>
            <text class="totem-slash">/</text>
            <text class="totem-target">¥{{totemPlan._tarText}}</text>
          </view>
          <text class="totem-sub">像图腾护佑一样，你们一起守住了这份约定 ✨</text>
        </view>
      </view>
    </view>
    <text class="totem-tap-hint">点击屏幕任意处继续</text>
  </view>
</view>
