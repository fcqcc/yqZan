<!-- pages/login/login.wxml -->
<view class="app-root app-theme-{{uiTheme}}">
  <!-- 隐私政策弹窗（首次打开必现，用户需主动同意） -->
  <view wx:if="{{showPrivacy}}" class="privacy-overlay">
    <view class="privacy-card">
      <view class="privacy-icon">🔒</view>
      <text class="privacy-title">欢迎使用「一起攒」</text>
      <text class="privacy-desc">请仔细阅读以下协议，确认后开始使用</text>
      <view class="privacy-links">
        <text class="privacy-link" bindtap="onViewUserAgreement">《用户服务协议》</text>
        <text class="privacy-link" bindtap="onViewPrivacyPolicy">《隐私政策》</text>
      </view>
      <view class="privacy-actions">
        <button class="privacy-btn privacy-btn-agree" bindtap="onAgreePrivacy">同意并继续</button>
        <button class="privacy-btn privacy-btn-disagree" bindtap="onDisagreePrivacy">不同意</button>
      </view>
    </view>
  </view>

  <!-- 登录条款弹窗（合并隐私+采集同意） -->
  <view wx:if="{{showLoginTerms}}" class="privacy-overlay">
    <view class="privacy-card">
      <view class="privacy-icon">🔒</view>
      <text class="privacy-title">登录即表示同意</text>
      <text class="privacy-desc">继续登录即表示您已阅读并同意以下条款</text>
      <view class="privacy-links">
        <text class="privacy-link" bindtap="onViewLoginUserAgreement">《用户服务协议》</text>
        <text class="privacy-link" bindtap="onViewLoginPrivacyPolicy">《隐私政策》</text>
      </view>
      <view class="privacy-actions">
        <button class="privacy-btn privacy-btn-agree" bindtap="onAgreeLoginTerms">同意并登录</button>
        <button class="privacy-btn privacy-btn-disagree" bindtap="onDisagreeLoginTerms">不同意</button>
      </view>
    </view>
  </view>

  <view class="login-page">
    <!-- 背景图片（容器absolute，image无position） -->
    <view class="login-bg-wrap">
      <image class="login-bg-img" src="/assets/images/login-bg.jpg" mode="aspectFill" />
    </view>
    <!-- 渐变覆盖层 -->
    <view class="login-overlay"></view>
    <!-- 页面内容 -->
    <view class="login-content">
    <!-- 未登录：展示欢迎 + 微信登录按钮 -->
    <block wx:if="{{!step}}">
      <view class="login-stagger anim-stagger">
        <view class="login-logo login-logo-anim anim-item">
          <svg class="login-logo-svg" viewBox="0 0 100 100" style="width:100px;height:100px;">
            <circle cx="50" cy="50" r="45" fill="#FADCE6" stroke="#E891A4" stroke-width="3" stroke-dasharray="5,3"/>
            <path d="M50 25 C35 25 25 40 25 50 C25 65 40 75 50 85 C60 75 75 65 75 50 C75 40 65 25 50 25" fill="#E891A4"/>
            <circle cx="40" cy="45" r="5" fill="#333"/>
            <circle cx="60" cy="45" r="5" fill="#333"/>
            <path d="M40 60 Q50 70 60 60" stroke="#333" stroke-width="3" fill="none"/>
          </svg>
        </view>
        <view class="login-title anim-item">一起攒</view>
        <view class="login-subtitle anim-item">情侣存钱 · 共同成长</view>

        <button class="login-btn login-btn-primary anim-item" bindtap="handleWxLogin" loading="{{loading}}">
          微信一键登录
        </button>
        <button class="login-btn login-btn-secondary anim-item" bindtap="goBindPartner">
          已有账号？绑定伴侣
        </button>
        <view class="login-footer anim-item">登录即表示同意《用户服务协议》和《隐私政策》</view>
      </view>
    </block>

    <!-- 首次登录：设置昵称 -->
    <block wx:elif="{{step === 'set-nickname'}}">
      <view class="login-logo"></view>
      <view class="login-title">欢迎加入</view>
      <view class="login-subtitle">给自己取个喜欢的昵称吧</view>
      <input class="input nickname-input" placeholder="输入昵称" model:value="{{nickname}}" maxlength="12" />
      <button class="login-btn login-btn-primary" bindtap="handleSetNickname" loading="{{nicknameLoading}}">
        开始使用
      </button>
    </block>

    <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>
  </view>
</view>
