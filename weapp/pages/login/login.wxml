<!-- pages/login/login.wxml -->
<view class="app-root app-theme-{{uiTheme}}">
  <view class="login-page">
    <view class="login-card">

      <!-- 未登录：展示欢迎 + 微信登录按钮 -->
      <block wx:if="{{!step}}">
        <view class="logo">💑</view>
        <view class="app-name">一起攒</view>
        <view class="app-desc">情侣存钱 · 一起实现</view>
        <button class="btn btn-primary wx-login-btn" bindtap="handleWxLogin" loading="{{loading}}">
          微信一键登录
        </button>
      </block>

      <!-- 首次登录：设置昵称 -->
      <block wx:elif="{{step === 'set-nickname'}}">
        <view class="logo">👋</view>
        <view class="app-name">欢迎加入</view>
        <view class="app-desc">给自己取个喜欢的昵称吧</view>
        <input class="input" placeholder="输入昵称" model:value="{{nickname}}" maxlength="12" />
        <button class="btn btn-primary login-btn" bindtap="handleSetNickname" loading="{{nicknameLoading}}">
          开始使用
        </button>
      </block>

      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>
  </view>
</view>
