<!-- pages/login/login.wxml -->
<view class="app-root app-theme-{{uiTheme}}">
  <view class="login-page">
    <!-- 背景图片（容器absolute，image无position） -->
    <view class="login-bg-wrap">
      <image class="login-bg-img" src="/assets/images/login-bg.jpg" mode="aspectFill" />
    </view>
    <!-- 渐变覆盖层 -->
    <view class="login-overlay"></view>
    <!-- 页面内容 -->
    <view class="login-content">
    <!-- 未登录：展示欢迎 + 微信登录按钮 -->
    <block wx:if="{{!step}}">
      <view class="login-stagger anim-stagger">
        <view class="login-logo login-logo-anim anim-item">
          <svg class="login-logo-svg" viewBox="0 0 100 100" style="width:100px;height:100px;">
            <circle cx="50" cy="50" r="45" fill="#FFD9B3" stroke="#E97F4A" stroke-width="3" stroke-dasharray="5,3"/>
            <path d="M50 25 C35 25 25 40 25 50 C25 65 40 75 50 85 C60 75 75 65 75 50 C75 40 65 25 50 25" fill="#E97F4A"/>
            <circle cx="40" cy="45" r="5" fill="#333"/>
            <circle cx="60" cy="45" r="5" fill="#333"/>
            <path d="M40 60 Q50 70 60 60" stroke="#333" stroke-width="3" fill="none"/>
          </svg>
        </view>
        <view class="login-title anim-item">一起攒</view>
        <view class="login-subtitle anim-item">情侣存钱 · 共同成长</view>

        <button class="login-btn login-btn-primary anim-item {{!termsChecked ? 'login-btn-disabled' : ''}}" bindtap="handleWxLogin" loading="{{loading}}">
          微信一键登录
        </button>
        <button class="login-btn login-btn-secondary anim-item" bindtap="goBindPartner">
          已有账号？绑定伴侣
        </button>

        <!-- 协议勾选框 → 放在绑定伴侣和暂不登录之间 -->
        <view class="login-terms anim-item">
          <view class="login-terms-checkbox {{termsChecked ? 'login-terms-checkbox--checked' : ''}}" bindtap="onToggleTerms">
            <text wx:if="{{termsChecked}}">✓</text>
          </view>
          <view class="login-terms-text-wrap">
            <text class="login-terms-label">我已阅读并同意</text>
            <view class="login-terms-links">
              <text class="login-terms-link" bindtap="onViewUserAgreement">《用户服务协议》</text>
              <text class="login-terms-link" bindtap="onViewPrivacyPolicy">《隐私政策》</text>
            </view>
          </view>
        </view>

        <view class="login-skip anim-item" bindtap="goHome">暂不登录，浏览首页 ›</view>
      </view>
    </block>

    <!-- 首次登录：设置昵称 -->
    <block wx:elif="{{step === 'set-nickname'}}">
      <view class="login-logo"></view>
      <view class="login-title">欢迎加入</view>
      <view class="login-subtitle">给自己取个喜欢的昵称吧</view>
      <input class="input nickname-input" placeholder="输入昵称" model:value="{{nickname}}" maxlength="12" />
      <button class="login-btn login-btn-primary" bindtap="handleSetNickname" loading="{{nicknameLoading}}">
        开始使用
      </button>
    </block>

    <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>

    <!-- 条款确认弹窗 -->
    <view wx:if="{{showTermsModal}}" class="terms-modal-overlay" bindtap="onCloseTermsModal" catchtouchmove="preventMove">
      <view class="terms-modal-card" catchtap="noop">
        <view class="terms-modal-icon">📋</view>
        <view class="terms-modal-title">请确认条款</view>
        <view class="terms-modal-desc">请阅读并确认条款，同意后再登录吧</view>

        <view class="terms-modal-links">
          <text class="terms-modal-link" bindtap="onViewUserAgreement">《用户服务协议》</text>
          <text class="terms-modal-link" bindtap="onViewPrivacyPolicy">《隐私政策》</text>
        </view>

        <view class="terms-modal-actions">
          <button class="terms-modal-btn terms-modal-btn--cancel" bindtap="onCloseTermsModal">再想想</button>
          <button class="terms-modal-btn terms-modal-btn--confirm" bindtap="onAgreeTerms">好的</button>
        </view>
      </view>
    </view>
  </view>
</view>
