/* pages/login/login.wxss — 可爱手绘风 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  text-align: center;
  box-sizing: border-box;
  position: relative;
}

/* 登录页背景图 - 容器absolute，图片无position */
.login-bg-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
  line-height: 0;
}
.login-bg-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 渐变覆盖层，保证内容可读 */
.login-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,240,245,0.6) 100%);
}

/* 内容在覆盖层之上 */
.login-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.login-title {
  font-size: 36px;
  color: #5D3E2A;
  font-weight: 800;
  margin-bottom: 10px;
  letter-spacing: 2px;
}

.login-subtitle {
  font-size: 14px;
  color: #7A5C4A;
  margin-bottom: 40px;
}

.login-btn {
  width: 280px;
  border: none;
  border-radius: 25px 10px 25px 10px;
  padding: 14px 0;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 14px;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

/* SVG熊呼吸浮动 */
.login-logo {
  margin-bottom: 20px;
}
.login-logo-anim {
  animation: loginBearFloat 3s ease-in-out infinite;
}
@keyframes loginBearFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10rpx) scale(1.04); }
}

.login-logo-svg {
  display: block;
  filter: drop-shadow(2px 2px 0 rgba(249, 168, 92, 0.2));
}

/* 主按钮柔和脉动 */
.login-btn-primary {
  background: linear-gradient(135deg, #F9A85C 0%, #E8924C 100%);
  color: #fff;
  box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.4);
  animation: loginBtnPulse 3s ease-in-out infinite;
}
@keyframes loginBtnPulse {
  0%, 100% { box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.4); }
  50% { box-shadow: 4px 4px 16px rgba(232, 146, 76, 0.35), 4px 4px 0 rgba(232, 146, 76, 0.4); }
}

/* 交错入场 */
.login-stagger { width: 100%; display: flex; flex-direction: column; align-items: center; }

.login-btn-primary:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 rgba(232, 146, 76, 0.4);
}

.login-btn-secondary {
  background: #fff;
  color: #E8924C;
  border: 2px solid #F9A85C !important;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.2);
}

.login-footer {
  margin-top: 30px;
  font-size: 11px;
  color: #8B6E5A;
  line-height: 1.5;
}

/* 协议勾选框 */
.login-terms {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 10px;
  max-width: 280px;
}
.login-terms-checkbox {
  width: 18px;
  height: 18px;
  border: 2px solid #F9A85C;
  border-radius: 4px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #fff;
  background: #fff;
  margin-top: 1px;
}
.login-terms-checkbox--checked {
  background: #F9A85C;
  border-color: #E8924C;
}
.login-terms-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.login-terms-label {
  font-size: 12px;
  color: #8B6E5A;
  line-height: 1.4;
}
.login-terms-links {
  display: flex;
  flex-direction: row;
  gap: 0;
}
.login-terms-link {
  font-size: 12px;
  color: #C45A78;
  text-decoration: underline;
  font-weight: 600;
  line-height: 1.4;
}
.login-btn-disabled {
  opacity: 0.5;
}

/* 暂不登录 */
.login-skip {
  margin-top: 4px;
  font-size: 13px;
  color: #A89080;
  text-decoration: underline;
  padding: 8px 0;
}

.nickname-input {
  width: 280px;
  margin-bottom: 16px;
  border: 2px dashed #F5D6B0;
  border-radius: 14px 6px 14px 6px;
  padding: 12px 16px;
  font-size: 15px;
  box-sizing: border-box;
  background: #FFFDF8;
}

.error {
  color: #c62828;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
}

.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(249, 168, 92, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.privacy-card {
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  padding: 32px 24px 24px;
  width: 100%;
  max-width: 320px;
  text-align: center;
  border: 2px dashed #F5D6B0;
  box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.2);
}
.privacy-icon { font-size: 40px; margin-bottom: 12px; }
.privacy-title { font-size: 18px; font-weight: 700; color: #7A5C4A; display: block; margin-bottom: 8px; }
.privacy-desc { font-size: 13px; color: #A89080; display: block; margin-bottom: 20px; line-height: 1.5; }
.privacy-links { display: flex; justify-content: center; gap: 16px; margin-bottom: 24px; }
.privacy-link { font-size: 13px; color: #C45A78; text-decoration: underline; font-weight: 600; }

/* 条款确认弹窗 */
.terms-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(249, 168, 92, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
  animation: termsFadeIn 0.25s ease;
}
@keyframes termsFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.terms-modal-card {
  background: #fff;
  border-radius: 24px 8px 24px 8px;
  padding: 36px 28px 28px;
  width: 100%;
  max-width: 320px;
  text-align: center;
  border: 2px dashed #F5D6B0;
  box-shadow: 6px 6px 0 rgba(232, 146, 76, 0.2);
  animation: termsCardIn 0.3s ease;
}
@keyframes termsCardIn {
  from { transform: scale(0.92) translateY(10px); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}
.terms-modal-icon {
  font-size: 40px;
  margin-bottom: 12px;
}
.terms-modal-title {
  font-size: 18px;
  font-weight: 700;
  color: #5D3E2A;
  display: block;
  margin-bottom: 10px;
}
.terms-modal-desc {
  font-size: 13px;
  color: #A89080;
  display: block;
  margin-bottom: 20px;
  line-height: 1.6;
}
.terms-modal-links {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-bottom: 24px;
}
.terms-modal-link {
  font-size: 13px;
  color: #C45A78;
  text-decoration: underline;
  font-weight: 600;
}
.terms-modal-actions {
  display: flex;
  gap: 12px;
}
.terms-modal-btn {
  flex: 1;
  font-size: 14px;
  font-weight: 600;
  border-radius: 20px 6px 20px 6px;
  padding: 10px 0;
  border: none;
  line-height: 1.4;
}
.terms-modal-btn::after {
  border: none;
}
.terms-modal-btn--cancel {
  background: #f8f0f2;
  color: #A89080;
  border: 1.5px solid #EAD0D6 !important;
}
.terms-modal-btn--cancel:active {
  background: #f0e4e8;
}
.terms-modal-btn--confirm {
  background: linear-gradient(135deg, #F9A85C 0%, #E8924C 100%);
  color: #fff;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.35);
}
.terms-modal-btn--confirm:active {
  transform: translate(1.5px, 1.5px);
  box-shadow: 1.5px 1.5px 0 rgba(232, 146, 76, 0.35);
}
