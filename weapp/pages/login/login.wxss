/* pages/login/login.wxss — 可爱手绘风 */

/* ========== 封面背景（慢速平移动画） ========== */
.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  animation: bgSlowPan 18s ease-in-out infinite alternate;
  will-change: transform;
}

/* 背景覆盖层 — 让前景内容可读 */
.login-bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.3) 100%);
}

@keyframes bgSlowPan {
  0% {
    transform: scale(1) translate(0, 0);
  }
  100% {
    transform: scale(1.12) translate(-5%, -3%);
  }
}

/* 有背景时 — 提高内容亮度/字号，让文字浮在图片之上 */
.login-page--with-bg {
  position: relative;
  z-index: 2;
  background: transparent !important;
}
.login-page--with-bg .login-title { color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }
.login-page--with-bg .login-subtitle { color: rgba(255,255,255,0.9); text-shadow: 0 1px 4px rgba(0,0,0,0.4); }
.login-page--with-bg .login-logo-svg circle:first-child { fill: rgba(255,255,255,0.3); stroke: rgba(255,255,255,0.6); }
.login-page--with-bg .login-logo-svg path { fill: rgba(255,255,255,0.8); }
.login-page--with-bg .login-logo-svg circle:not(:first-child) { fill: #fff; }
.login-page--with-bg .login-btn-secondary {
  background: rgba(255,255,255,0.9);
  border-color: rgba(255,255,255,0.6) !important;
  color: #5D4E60;
}
.login-page--with-bg .login-footer { color: rgba(255,255,255,0.7); text-shadow: 0 1px 3px rgba(0,0,0,0.3); }

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  text-align: center;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF0F5 100%);
}

.login-title {
  font-size: 36px;
  color: #4A3548;
  font-weight: 800;
  margin-bottom: 10px;
  letter-spacing: 2px;
}

.login-subtitle {
  font-size: 14px;
  color: #5D4E60;
  margin-bottom: 40px;
}

.login-btn {
  width: 280px;
  border: none;
  border-radius: 25px 10px 25px 10px;
  padding: 14px 0;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 14px;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

.login-btn-primary {
  background: linear-gradient(135deg, #E891A4 0%, #D4708A 100%);
  color: #fff;
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.4);
}

.login-btn-primary:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.4);
}

.login-btn-secondary {
  background: #fff;
  color: #D4708A;
  border: 2px solid #E891A4 !important;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.2);
}

.login-logo { margin-bottom: 20px; }
.login-logo-svg {
  display: block;
  filter: drop-shadow(2px 2px 0 rgba(232, 145, 164, 0.2));
}

.login-footer {
  margin-top: 30px;
  font-size: 11px;
  color: #6B5A6E;
  line-height: 1.5;
}

.nickname-input {
  width: 280px;
  margin-bottom: 16px;
  border: 2px dashed #F5C6D0;
  border-radius: 14px 6px 14px 6px;
  padding: 12px 16px;
  font-size: 15px;
  box-sizing: border-box;
  background: #fffafb;
}

.error {
  color: #c62828;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
}

.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(232, 145, 164, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.privacy-card {
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  padding: 32px 24px 24px;
  width: 100%;
  max-width: 320px;
  text-align: center;
  border: 2px dashed #F5C6D0;
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.2);
}
.privacy-icon { font-size: 40px; margin-bottom: 12px; }
.privacy-title { font-size: 18px; font-weight: 700; color: #5D4E60; display: block; margin-bottom: 8px; }
.privacy-desc { font-size: 13px; color: #8B7A8E; display: block; margin-bottom: 20px; line-height: 1.5; }
.privacy-links { display: flex; justify-content: center; gap: 16px; margin-bottom: 24px; }
.privacy-link { font-size: 13px; color: #C45A78; text-decoration: underline; font-weight: 600; }
.privacy-actions { display: flex; flex-direction: column; gap: 10px; }
.privacy-btn {
  border: none; border-radius: 25px 10px 25px 10px; padding: 12px 0; font-size: 15px; font-weight: 600;
  width: 100%; line-height: 1.4;
}
.privacy-btn::after { border: none; }
.privacy-btn-agree {
  background: linear-gradient(135deg, #E891A4 0%, #D4708A 100%);
  color: #fff;
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}
.privacy-btn-disagree {
  background: #FFF9F5;
  color: #5D4E60;
  border: 2px solid #E8D8DE !important;
}
