/* pages/login/login.wxss - 首页同款蜜桃苏打 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
  box-sizing: border-box;
  background: var(--stone, #fff5f2);
}

.login-title {
  font-size: 28px;
  color: var(--ink, #3a2e35);
  font-weight: 700;
  margin-bottom: 8px;
}

.login-subtitle {
  font-size: 14px;
  color: var(--ink-soft, #8a7078);
  margin-bottom: 40px;
}

.login-btn {
  width: 280px;
  border: none;
  border-radius: 25px;
  padding: 14px 0;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 16px;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

.login-btn-primary {
  background: linear-gradient(180deg, var(--rose-light, #ff8fab), var(--rose, #ff6b9d));
  color: #fff;
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.28);
}

/* 功能预览区 */
.login-features {
  display: flex;
  gap: 12px;
  margin-bottom: 28px;
  width: 100%;
  max-width: 340px;
}
.login-feature {
  flex: 1;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 14px;
  padding: 14px 10px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(255,107,157,0.08);
}
.login-feature-icon { font-size: 26px; margin-bottom: 6px; }
.login-feature-title { font-size: 12px; font-weight: 700; color: var(--ink,#3a2e35); display: block; margin-bottom: 3px; }
.login-feature-desc { font-size: 10px; color: var(--ink-soft,#8a7078); display: block; line-height: 1.3; }

.login-btn-secondary {
  background: var(--surface, #fff);
  color: var(--rose-deep, #e84d85);
  border: 2px solid var(--rose-soft, #ffb8cc) !important;
  box-shadow: 0 4px 16px rgba(255, 107, 157, 0.1);
}

.login-footer {
  margin-top: 40px;
  font-size: 11px;
  color: var(--ink-muted, #b8a4ac);
  line-height: 1.5;
}

.nickname-input {
  width: 280px;
  margin-bottom: 16px;
  border: 1px solid var(--line-strong, rgba(255,107,157,0.18));
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 15px;
  box-sizing: border-box;
  background: var(--surface, #fff);
}

.error {
  color: #c62828;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
}

/* 隐私政策弹窗 */
.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.privacy-card {
  background: #fff;
  border-radius: 20px;
  padding: 32px 24px 24px;
  width: 100%;
  max-width: 320px;
  text-align: center;
  box-shadow: 0 16px 48px rgba(0,0,0,0.15);
}
.privacy-icon { font-size: 40px; margin-bottom: 12px; }
.privacy-title { font-size: 18px; font-weight: 700; color: var(--ink,#3a2e35); display: block; margin-bottom: 8px; }
.privacy-desc { font-size: 13px; color: var(--ink-soft,#8a7078); display: block; margin-bottom: 20px; line-height: 1.5; }
.privacy-links { display: flex; justify-content: center; gap: 16px; margin-bottom: 24px; }
.privacy-link { font-size: 13px; color: var(--rose,#ff6b9d); text-decoration: underline; }
.privacy-actions { display: flex; flex-direction: column; gap: 10px; }
.privacy-btn {
  border: none; border-radius: 22px; padding: 12px 0; font-size: 15px; font-weight: 600;
  width: 100%; line-height: 1.4;
}
.privacy-btn::after { border: none; }
.privacy-btn-agree { background: linear-gradient(180deg,var(--rose-light,#ff8fab),var(--rose,#ff6b9d)); color: #fff; }
.privacy-btn-disagree { background: var(--stone,#fff5f2); color: var(--ink-soft,#8a7078); }
