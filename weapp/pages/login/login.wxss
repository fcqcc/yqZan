/* pages/login/login.wxss - 首页同款蜜桃苏打 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
  box-sizing: border-box;
  background: var(--stone, #fff5f2);
}

.login-title {
  font-size: 28px;
  color: var(--ink, #3a2e35);
  font-weight: 700;
  margin-bottom: 8px;
}

.login-subtitle {
  font-size: 14px;
  color: var(--ink-soft, #8a7078);
  margin-bottom: 40px;
}

.login-btn {
  width: 280px;
  border: none;
  border-radius: 25px;
  padding: 14px 0;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 16px;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

.login-btn-primary {
  background: linear-gradient(180deg, var(--rose-light, #ff8fab), var(--rose, #ff6b9d));
  color: #fff;
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.28);
}

.login-btn-secondary {
  background: var(--surface, #fff);
  color: var(--rose-deep, #e84d85);
  border: 2px solid var(--rose-soft, #ffb8cc) !important;
  box-shadow: 0 4px 16px rgba(255, 107, 157, 0.1);
}

.login-footer {
  margin-top: 40px;
  font-size: 11px;
  color: var(--ink-muted, #b8a4ac);
  line-height: 1.5;
}

.nickname-input {
  width: 280px;
  margin-bottom: 16px;
  border: 1px solid var(--line-strong, rgba(255,107,157,0.18));
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 15px;
  box-sizing: border-box;
  background: var(--surface, #fff);
}

.error {
  color: #c62828;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
}
