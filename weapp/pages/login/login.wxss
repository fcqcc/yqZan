/* pages/login/login.wxss - peach soda login */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(58, 30, 48, 0.12) 0%, rgba(58, 30, 48, 0.28) 100%),
    linear-gradient(155deg, #f06b8f 0%, #e84d85 45%, #9b6fd4 100%);
}

.login-logo {
  font-size: 80px;
  margin-bottom: 20px;
  line-height: 1;
  filter: drop-shadow(0 4px 12px rgba(58, 30, 48, 0.2));
}

.login-title {
  font-size: 28px;
  color: #fff;
  font-weight: 700;
  margin-bottom: 8px;
  text-shadow: 0 2px 16px rgba(58, 30, 48, 0.35), 0 1px 3px rgba(58, 30, 48, 0.25);
}

.login-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 40px;
  text-shadow: 0 1px 8px rgba(58, 30, 48, 0.3);
}

.login-btn {
  width: 280px;
  border: none;
  border-radius: 25px;
  padding: 14px 0;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 16px;
  line-height: 1.4;
}

.login-btn::after {
  border: none;
}

.login-btn-primary {
  background: #fff;
  color: var(--primary, #ff6b9d);
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.28);
}

.login-btn-secondary {
  background: rgba(255, 255, 255, 0.95);
  color: var(--rose-deep, #e84d85);
  border: 2px solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 4px 16px rgba(58, 30, 48, 0.15);
}

.login-btn-icon {
  font-size: 18px;
}

.login-footer {
  margin-top: 40px;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 1px 6px rgba(58, 30, 48, 0.35);
  line-height: 1.5;
}

.nickname-input {
  width: 280px;
  margin-bottom: 16px;
  border: 1px solid #ffdce8;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 15px;
  box-sizing: border-box;
  background: white;
}

.error {
  color: #c62828;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
}
