<!-- pages/pets/pets.wxml — 宠物管理 -->
<scroll-view class="page" scroll-y>
  <!-- ===== 当前活跃宠物（大号展示） ===== -->
  <view class="active-card {{petHappyClass}} {{activePet.evolution_ready ? 'evolution-glow' : ''}}" wx:if="{{activePet}}" bindtap="onPetTap">
    <view class="active-emoji">
      <image wx:if="{{activePet.image_url}}" class="pet-image-lg {{activePet.evolution_ready ? 'evolution-flash' : ''}}" src="{{activePet.full_image_url}}" mode="aspectFit"></image>
      <text wx:else>{{activePet.emoji}}</text>
    </view>
    <view class="active-info">
      <view class="active-name-row">
        <text class="active-name">{{activePet.form_label || activePet.pet_type}}</text>
        <text class="rarity-badge rarity-{{activePet.rarity}}">{{activePet.rarity}}</text>
      </view>
      <text class="active-form">{{activePet.form_label}}</text>
    </view>
    <view class="active-intimacy">
      <view class="intimacy-label">亲密度</view>
      <view class="intimacy-bar">
        <view class="intimacy-fill" style="width:{{intimacyPct}}%"></view>
      </view>
      <text class="intimacy-text">{{activePet.intimacy}} / 100</text>
    </view>
    <!-- 经验/等级条 -->
    <view class="active-exp" wx:if="{{activePet}}">
      <view class="exp-label">
        <text>等级 {{activePet.level}} / {{activePet.max_level}}</text>
        <text wx:if="{{!activePet.evolution_ready}}" class="exp-num">EXP {{activePet.exp}}/{{activePet.exp_needed}}</text>
        <text wx:else class="exp-ready">✨ 可进化</text>
      </view>
      <view class="exp-bar" wx:if="{{!activePet.evolution_ready}}">
        <view class="exp-fill" style="width:{{activePet.exp_needed > 0 ? (activePet.exp / activePet.exp_needed * 100) : 0}}%"></view>
      </view>
    </view>
    <!-- 技能说明 -->
    <view class="active-skills">
      <view class="skill-item" wx:if="{{activePet.passive_skill}}">
        <text class="skill-icon">🎯</text>
        <view class="skill-info">
          <text class="skill-name">{{activePet.passive_skill}}</text>
          <text class="skill-desc">{{activePet.passive_skill_desc || '每天首次登录时触发冒险，带回收益'}}</text>
        </view>
      </view>
      <view class="skill-item">
        <text class="skill-icon">💕</text>
        <view class="skill-info">
          <text class="skill-name">{{intimacyStageName}}</text>
          <text class="skill-desc">{{intimacyStageDesc}}</text>
        </view>
      </view>
    </view>
    <view class="active-actions">
      <button class="btn btn-sm btn-outline" bindtap="onFeed">🍼 喂食</button>
      <button class="btn btn-sm btn-primary" wx:if="{{canEvolve}}" bindtap="onEvolve">✨ 进化</button>
      <button class="btn btn-sm btn-primary evolution-btn" wx:if="{{activePet && activePet.evolution_ready}}" bindtap="onLevelEvolve">🌟 等级进化</button>
    </view>
  </view>

  <!-- ===== 形态切换（已解锁的形态） ===== -->
  <view class="section-card" wx:if="{{forms.length > 1}}">
    <text class="section-label">🎭 形态切换</text>
    <view class="form-list">
      <view
        wx:for="{{forms}}"
        wx:key="form"
        class="form-chip {{item.form === activePet.form ? 'form-chip--active' : ''}} {{!item.unlocked ? 'form-chip--locked' : ''}}"
        bindtap="onSwitchForm"
        data-form="{{item.form}}"
      >
        <text class="form-chip-icon">{{item.emoji}}</text>
        <text class="form-chip-name">{{item.name}}</text>
        <text wx:if="{{!item.unlocked}}" class="form-chip-lock">🔒</text>
      </view>
    </view>
  </view>

  <!-- ===== 全部宠物列表 ===== -->
  <view class="section-card">
    <text class="section-label">🐾 我的宠物</text>
    <view class="pet-list">
      <view
        wx:for="{{pets}}"
        wx:key="id"
        class="pet-item {{item.active ? 'pet-item--active' : ''}}"
        bindtap="onSwitchPet"
        data-id="{{item.id}}"
      >
        <view class="pet-emoji">
          <image wx:if="{{item.image_url}}" class="pet-image-sm" src="{{item.full_image_url}}" mode="aspectFit"></image>
          <text wx:else>{{item.emoji || '🐾'}}</text>
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.form_label || item.pet_type || '未知宠物'}}</text>
            <text class="rarity-badge rarity-{{item.rarity}}">{{item.rarity}}</text>
          </view>
          <text class="pet-form-sub">{{item.form_label}}</text>
        </view>
        <view wx:if="{{item.active}}" class="pet-badge">当前</view>
        <view wx:else class="pet-switch-hint">切换 ›</view>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{!pets || pets.length === 0}}" class="empty">
    <text class="empty-icon">🐣</text>
    <text>还没有宠物哦~</text>
    <text class="empty-sub">去抽卡获取宠物吧！</text>
  </view>

  <!-- ===== 进化粒子特效 ===== -->
  <view wx:if="{{showEvoEffect}}" class="evo-overlay">
    <view class="evo-flash"></view>
    <view class="evo-particles">
      <text wx:for="{{16}}" wx:for-index="i" wx:key="i" class="evo-particle p{{i}}">✦</text>
    </view>
    <text class="evo-text">🌟 进化！</text>
  </view>
</scroll-view>
