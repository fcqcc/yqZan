<!-- pages/pets/pets.wxml — 宠物管理（紧凑排版） -->
<scroll-view class="app-root app-theme-{{uiTheme}} page" scroll-y>
  <!-- ===== 当前活跃宠物 ===== -->
  <view class="active-card {{petHappyClass}} {{activePet.evolution_ready ? 'evolution-glow' : ''}}" wx:if="{{activePet}}" bindtap="onPetTap">
    <view class="active-top">
      <view class="active-emoji">
        <image wx:if="{{activePet.image_url}}" class="pet-image-lg {{activePet.evolution_ready ? 'evolution-flash' : ''}}" src="{{activePet.full_image_url}}" mode="aspectFit"></image>
        <text wx:else>{{activePet.emoji}}</text>
      </view>
      <view class="active-info">
        <view class="active-name-row">
          <text class="active-name">{{activePet.form_label || activePet.pet_type}}</text>
          <text class="rarity-badge rarity-{{activePet.rarity}}">{{activePet.rarity}}</text>
        </view>
        <view class="active-stage">{{intimacyStageName}}</view>
      </view>
    </view>

    <!-- 两栏进度（亲密度+经验） -->
    <view class="active-stats">
      <view class="active-stat">
        <text class="as-label">亲密度</text>
        <view class="as-bar"><view class="as-fill as-fill--pink" style="width:{{intimacyPct}}%"></view></view>
        <text class="as-val">{{activePet.intimacy}}/100</text>
      </view>
      <view class="active-stat">
        <text class="as-label">Lv.{{activePet.level}}/{{activePet.max_level}}</text>
        <view class="as-bar"><view class="as-fill as-fill--purple" style="width:{{activePet.exp_needed > 0 ? (activePet.exp / activePet.exp_needed * 100) : 0}}%"></view></view>
        <text class="as-val" wx:if="{{!activePet.evolution_ready}}">EXP {{activePet.exp}}/{{activePet.exp_needed}}</text>
        <text class="as-val as-val--evo" wx:else>✨可进化</text>
      </view>
    </view>

    <!-- 被动技能小标签 -->
    <view class="active-skill-tag" wx:if="{{activePet.passive_skill}}" bindtap="onSkillTap" hover-class="active-skill-tag--hover">
      <text>🎯 {{activePet.passive_skill}}</text>
      <text class="active-skill-tag__arrow">›</text>
    </view>

    <!-- 互动次数 -->
    <view class="active-interact" wx:if="{{activePet}}">
      <text class="ai-label">今日互动</text>
      <view class="ai-dots">
        <view class="ai-dot {{todayInteractTotal >= 1 ? 'ai-dot--used' : ''}}"></view>
        <view class="ai-dot {{todayInteractTotal >= 2 ? 'ai-dot--used' : ''}}"></view>
        <view class="ai-dot {{todayInteractTotal >= 3 ? 'ai-dot--used' : ''}}"></view>
      </view>
      <text class="ai-count">{{todayInteractTotal}}/3</text>
    </view>

    <!-- 互动按钮行 -->
    <view class="active-actions">
      <button class="btn-interact" bindtap="onFeed" hover-class="btn-interact--hover">🍼 喂食</button>
      <button class="btn-interact" bindtap="onPlay" hover-class="btn-interact--hover">🎾 玩耍</button>
      <button class="btn-interact" bindtap="onWalkPet" hover-class="btn-interact--hover">🚶 走动</button>
      <button class="btn-evo" wx:if="{{canItemEvolve}}" bindtap="onEvolve">✨进化</button>
      <button class="btn-evo" wx:if="{{canLevelEvolve}}" bindtap="onLevelEvolve">🌟进化</button>
    </view>
  </view>

  <!-- ===== 形态切换（已解锁的形态） ===== -->
  <view class="section-card" wx:if="{{forms.length > 1}}">
    <text class="section-label">🎭 形态切换</text>
    <view class="form-list">
      <view
        wx:for="{{forms}}"
        wx:key="form"
        class="form-chip {{item.form === activePet.form ? 'form-chip--active' : ''}} {{!item.unlocked ? 'form-chip--locked' : ''}}"
        bindtap="onSwitchForm"
        data-form="{{item.form}}"
      >
        <text class="form-chip-icon">{{item.emoji}}</text>
        <text class="form-chip-name">{{item.name}}</text>
        <text wx:if="{{!item.unlocked}}" class="form-chip-lock">🔒</text>
      </view>
    </view>
  </view>

  <!-- ===== 全部宠物列表 ===== -->
  <view class="section-card">
    <text class="section-label">🐾 我的宠物</text>
    <view class="pet-list">
      <view
        wx:for="{{pets}}"
        wx:key="id"
        class="pet-item {{item.active ? 'pet-item--active' : ''}}"
        bindtap="onSwitchPet"
        data-id="{{item.id}}"
      >
        <view class="pet-emoji">
          <image wx:if="{{item.image_url}}" class="pet-image-sm" src="{{item.full_image_url}}" mode="aspectFit"></image>
          <text wx:else>{{item.emoji || '🐾'}}</text>
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.form_label || item.pet_type || '未知宠物'}}</text>
            <text class="rarity-badge rarity-{{item.rarity}}">{{item.rarity}}</text>
          </view>
          <text class="pet-form-sub">{{item.form_label}}</text>
        </view>
        <view wx:if="{{item.active}}" class="pet-badge">当前</view>
        <view wx:else class="pet-switch-hint">切换 ›</view>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{!pets || pets.length === 0}}" class="empty">
    <text class="empty-icon">🐣</text>
    <text>还没有宠物哦~</text>
    <text class="empty-sub">去抽卡获取宠物吧！</text>
  </view>

  <!-- ===== 进化粒子特效 ===== -->
  <view wx:if="{{showEvoEffect}}" class="evo-overlay">
    <view class="evo-flash"></view>
    <view class="evo-particles">
      <text wx:for="{{16}}" wx:for-index="i" wx:key="i" class="evo-particle p{{i}}">✦</text>
    </view>
    <text class="evo-text">🌟 进化！</text>
  </view>
</scroll-view>