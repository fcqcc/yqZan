/* pages/pets/pets.wxss — 宠物管理（原型风格） */
.page { height: 100vh; background: transparent; }

.rarity-badge {
  display: inline-flex;
  background: linear-gradient(135deg, #ffd700, #ffa500);
  color: white;
  padding: 3px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
}

/* ===== 旧头部（兼容） ===== */
.pets-detail-header {
  position: relative;
  overflow: hidden;
  margin: 10px 12px 8px;
  padding: 24px 20px 20px;
  background: linear-gradient(135deg, #E891A4 0%, #FADCE6 100%);
  border-radius: 20px 8px 20px 8px;
  border: 2px dashed rgba(255, 255, 255, 0.4);
  text-align: center;
}
.pets-detail-header-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 30% 0%, rgba(255,255,255,0.15), transparent 60%),
              radial-gradient(ellipse 50% 50% at 80% 100%, rgba(255,182,193,0.2), transparent 50%);
  pointer-events: none;
}
.pets-detail-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  position: relative;
  z-index: 1;
}
.pets-detail-icon { font-size: 28px; }
.pets-detail-title {
  font-size: 20px;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.pets-detail-subtitle {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6px;
  position: relative;
  z-index: 1;
}
.pets-detail-dot {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  pointer-events: none;
  animation: petsDotPulse 3s ease-in-out infinite;
}
.pets-detail-dot--1 { top: 18%; right: 12%; animation-delay: 0s; }
.pets-detail-dot--2 { bottom: 20%; left: 10%; animation-delay: 0.8s; }
.pets-detail-dot--3 { top: 40%; right: 8%; animation-delay: 1.6s; }
@keyframes petsDotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ===== 当前活跃宠物卡片 ===== */
.active-card {
  margin: 12px 12px 8px;
  background: linear-gradient(135deg, #ffffff 0%, #fffafb 55%, #ffe8f0 100%);
  border-radius: var(--radius-lg);
  padding: 24px 20px 20px;
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.12);
  border: 1.5px solid #f0c0d0;
  text-align: center;
}
.active-emoji { font-size: 64px; display: block; margin-bottom: 6px; }
.pet-image-lg { width: 160px; height: 160px; display: block; margin: 0 auto; }
.active-info { margin-bottom: 12px; }
.active-name-row { display: flex; align-items: center; justify-content: center; gap: 8px; }
.active-name { font-size: 18px; font-weight: 800; color: var(--text); display: block; }
.active-form { font-size: 13px; color: var(--text-secondary); display: block; margin-top: 2px; }

/* 亲密度进度条 */
.active-intimacy { margin-bottom: 14px; }
.intimacy-label { font-size: 11px; color: var(--text-secondary); margin-bottom: 4px; }
.intimacy-bar {
  height: 8px;
  background: rgba(255, 107, 157, 0.15);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 3px;
}
.intimacy-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 4px;
  transition: width 0.5s ease;
}
.intimacy-text { font-size: 11px; color: var(--text-muted); }

.active-actions { display: flex; gap: 10px; justify-content: center; }

/* 两栏统计（亲密度+经验并列） */
.active-stats {
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
}
.active-stats .active-intimacy,
.active-stats .active-exp {
  flex: 1;
  min-width: 0;
}
.active-stats .active-exp { margin-top: 0; }
.active-stats .intimacy-label,
.active-stats .exp-label { font-size: 10px; margin-bottom: 3px; }

/* 技能说明区 */
.active-skills {
  margin: 0 0 14px;
  display: flex; flex-direction: column; gap: 8px;
}
.skill-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(214,92,138,0.12);
  border-radius: 8px;
  padding: 8px 10px;
  text-align: left;
}
.skill-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
.skill-info { flex: 1; }
.skill-name { font-size: 12px; font-weight: 700; color: var(--text); display: block; }
.skill-desc { font-size: 11px; color: var(--text-secondary); display: block; margin-top: 1px; line-height: 1.4; }

/* ===== 形态切换 ===== */
.section-card {
  margin: 0 12px 8px;
  background: #ffffff;
  border: 1px solid #f0c0d0;
  border-radius: var(--radius);
  padding: 14px 16px;
  box-shadow: 0 2px 10px rgba(255, 107, 157, 0.1);
}
.section-label { font-size: 13px; font-weight: 700; color: var(--text); display: block; margin-bottom: 10px; }

.form-list { display: flex; flex-wrap: wrap; gap: 8px; }
.form-chip {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  border-radius: var(--radius-pill);
  background: #fffafb;
  border: 1px solid rgba(255, 107, 157, 0.22);
  font-size: 12px;
  color: var(--text-secondary);
  transition: all 0.12s ease;
}
.form-chip:active { transform: scale(0.96); }
.form-chip--active {
  background: rgba(255, 107, 157, 0.14);
  border-color: var(--pink-dark);
  color: var(--pink-dark);
  font-weight: 600;
}
.form-chip--locked { opacity: 0.5; }
.form-chip-icon { font-size: 16px; }
.form-chip-name { }
.form-chip-lock { font-size: 12px; }

/* ===== 宠物列表 ===== */
.pet-list { }
.pet-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(42, 36, 38, 0.06);
}
.pet-item:last-child { border-bottom: none; }
.pet-item--active { background: rgba(255, 107, 157, 0.04); margin: 0 -16px; padding: 10px 16px; border-radius: var(--radius-sm); }
.pet-emoji { font-size: 28px; width: 50px; text-align: center; }
.pet-image-sm { width: 48px; height: 48px; display: block; }
.pet-info { flex: 1; min-width: 0; }
.pet-name-row { display: flex; align-items: center; gap: 6px; }
.pet-name { font-size: 14px; font-weight: 600; color: var(--text); display: block; }
.pet-form-sub { font-size: 11px; color: var(--text-secondary); display: block; margin-top: 1px; }
.pet-badge {
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  background: var(--pink-dark);
  padding: 2px 8px;
  border-radius: var(--radius-pill);
}
.pet-switch-hint { font-size: 12px; color: var(--pink-dark); font-weight: 500; }

/* ===== 宠物互动动画 ===== */
.pet-happy .pet-image-lg {
  animation: petHappyJump 0.6s ease-out !important;
}
@keyframes petHappyJump {
  0% { transform: translateY(0) scale(1); }
  20% { transform: translateY(-18px) scale(1.12); }
  40% { transform: translateY(-8px) scale(1.05); }
  60% { transform: translateY(-14px) scale(1.08); }
  80% { transform: translateY(-4px) scale(1.02); }
  100% { transform: translateY(0) scale(1); }
}
.pet-fan-shake .pet-image-lg { animation: petsFanShake 0.5s ease-out !important; }
@keyframes petsFanShake {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-14deg) translateX(-4px); }
  40% { transform: rotate(12deg) translateX(4px); }
  60% { transform: rotate(-10deg) translateX(-3px); }
  80% { transform: rotate(8deg) translateX(3px); }
  100% { transform: rotate(0deg) translateX(0); }
}
.pet-violent-shake .pet-image-lg { animation: petsViolentShake 0.6s ease-in-out !important; }
@keyframes petsViolentShake {
  0%, 100% { transform: translateX(0) translateY(0) rotate(0deg); }
  10% { transform: translateX(-8px) translateY(-4px) rotate(-8deg); }
  20% { transform: translateX(10px) translateY(3px) rotate(8deg); }
  30% { transform: translateX(-6px) translateY(-10px) rotate(-6deg); }
  40% { transform: translateX(8px) translateY(5px) rotate(7deg); }
  50% { transform: translateX(-12px) translateY(-3px) rotate(-10deg); }
  60% { transform: translateX(10px) translateY(8px) rotate(9deg); }
  70% { transform: translateX(-5px) translateY(-8px) rotate(-5deg); }
  80% { transform: translateX(12px) translateY(3px) rotate(7deg); }
  90% { transform: translateX(-8px) translateY(-5px) rotate(-6deg); }
}
.pet-wild-move .pet-image-lg { animation: petsWildMove 0.7s ease-in-out !important; }
@keyframes petsWildMove {
  0% { transform: translate(0, 0) rotate(0deg); }
  12% { transform: translate(-12px, -8px) rotate(-8deg); }
  25% { transform: translate(10px, -12px) rotate(6deg); }
  37% { transform: translate(-8px, 10px) rotate(-10deg); }
  50% { transform: translate(14px, 6px) rotate(8deg); }
  62% { transform: translate(-10px, -10px) rotate(-6deg); }
  75% { transform: translate(8px, 12px) rotate(10deg); }
  87% { transform: translate(-14px, 4px) rotate(-12deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}
.pet-talk-anim .pet-image-lg { animation: petsTalkAnim 0.6s ease-in-out !important; }
@keyframes petsTalkAnim {
  0% { transform: translateX(0) rotate(0deg); }
  25% { transform: translateX(6px) rotate(4deg); }
  50% { transform: translateX(-6px) rotate(-4deg); }
  75% { transform: translateX(4px) rotate(2deg); }
  100% { transform: translateX(0) rotate(0deg); }
}

/* ===== 空状态 ===== */
.empty { text-align: center; padding: 40px 16px; color: var(--text-light); font-size: 14px; }
.empty-icon { font-size: 40px; display: block; margin-bottom: 8px; }
.empty-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; display: block; }

/* ===== 稀有度徽章 ===== */
.rarity-badge {
  font-size: 9px; font-weight: 700;
  padding: 1px 6px; border-radius: var(--radius-pill);
  display: inline-block; line-height: 1.4;
}
.rarity-N { color: #888; background: #f0f0f0; }
.rarity-R { color: #4d8cf0; background: #f0f6ff; }
.rarity-SR { color: #9c27b0; background: #faf0ff; }
.rarity-SSR { color: #ff8f00; background: #fff8e1; }

/* ===== 经验条 ===== */
.active-exp { margin-top: 10px; }
.exp-label { display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 4px; }
.exp-label text { color: var(--text-secondary); }
.exp-num { font-weight: 600; color: #7c4dff; }
.exp-ready { font-weight: 700; color: #ff6b35; animation: expPulse 1s ease-in-out infinite; }
.exp-bar { height: 6px; background: rgba(124, 77, 255, 0.12); border-radius: 3px; overflow: hidden; }
.exp-fill { height: 100%; background: linear-gradient(90deg, #7c4dff, #b388ff); border-radius: 3px; transition: width 0.5s ease; }

/* ===== 进化特效 ===== */
.evolution-glow {
  animation: evoGlow 0.8s ease-in-out infinite;
  box-shadow: 0 0 40px rgba(255, 215, 0, 0.5) !important;
  border: 2px solid rgba(255, 215, 0, 0.6) !important;
}
.evolution-flash {
  animation: evoFlash 0.6s ease-in-out infinite !important;
  filter: brightness(1.2) drop-shadow(0 0 12px rgba(255, 215, 0, 0.8)) !important;
}
@keyframes evoGlow {
  0%, 100% { box-shadow: 0 0 20px rgba(255, 215, 0, 0.3); border-color: rgba(255, 215, 0, 0.4); }
  50% { box-shadow: 0 0 60px rgba(255, 215, 0, 0.7), 0 0 120px rgba(255, 200, 0, 0.3); border-color: rgba(255, 215, 0, 0.9); }
}
@keyframes evoFlash {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
  20% { transform: scale(1.12) rotate(3deg); opacity: 0.85; }
  40% { transform: scale(0.92) rotate(-2deg); opacity: 0.75; }
  60% { transform: scale(1.08) rotate(2deg); opacity: 0.9; }
  80% { transform: scale(0.96) rotate(-1deg); opacity: 0.8; }
}
@keyframes expPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.evolution-btn {
  background: linear-gradient(135deg, #ff6b35, #ff8f00) !important;
  animation: evoBtnPulse 1.5s ease-in-out infinite;
}
@keyframes evoBtnPulse {
  0%, 100% { box-shadow: 0 2px 10px rgba(255, 107, 53, 0.3); }
  50% { box-shadow: 0 2px 20px rgba(255, 107, 53, 0.6); }
}

/* ===== 进化粒子特效 ===== */
.evo-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  z-index: 9999;
  pointer-events: none;
}
.evo-flash {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: white;
  animation: evoFlashScreen 3s ease-out forwards;
}
@keyframes evoFlashScreen {
  0% { opacity: 0.9; }
  8% { opacity: 0.3; }
  12% { opacity: 0.8; }
  18% { opacity: 0.2; }
  22% { opacity: 0.7; }
  30% { opacity: 0.1; }
  40% { opacity: 0.5; }
  50% { opacity: 0; }
  100% { opacity: 0; }
}
.evo-particles {
  position: absolute;
  top: 45%; left: 50%;
  width: 0; height: 0;
}
.evo-particle {
  position: absolute;
  font-size: 22px;
  animation: evoParticleFly 3s ease-out forwards;
}
.evo-particle.p0  { color: #ff6b35; --dx: -60px; --dy: -80px; --delay: 0s; }
.evo-particle.p1  { color: #ffd700; --dx: 60px; --dy: -70px; --delay: 0.15s; }
.evo-particle.p2  { color: #ffab40; --dx: -40px; --dy: -90px; --delay: 0.3s; }
.evo-particle.p3  { color: #b388ff; --dx: 50px; --dy: -85px; --delay: 0.45s; }
.evo-particle.p4  { color: #ff6b35; --dx: -70px; --dy: -60px; --delay: 0.6s; }
.evo-particle.p5  { color: #ffd700; --dx: 70px; --dy: -75px; --delay: 0.75s; }
.evo-particle.p6  { color: #ffab40; --dx: -30px; --dy: -100px; --delay: 0.9s; }
.evo-particle.p7  { color: #7c4dff; --dx: 30px; --dy: -95px; --delay: 1.05s; }
.evo-particle.p8  { color: #ff8a65; --dx: -80px; --dy: -50px; --delay: 1.2s; }
.evo-particle.p9  { color: #ffe082; --dx: 80px; --dy: -65px; --delay: 1.35s; }
.evo-particle.p10 { color: #ce93d8; --dx: -20px; --dy: -110px; --delay: 1.5s; }
.evo-particle.p11 { color: #ff6b35; --dx: 40px; --dy: -100px; --delay: 1.65s; }
.evo-particle.p12 { color: #ffd700; --dx: -50px; --dy: -70px; --delay: 1.8s; }
.evo-particle.p13 { color: #b388ff; --dx: 20px; --dy: -90px; --delay: 1.95s; }
.evo-particle.p14 { color: #ffab40; --dx: -90px; --dy: -55px; --delay: 2.1s; }
.evo-particle.p15 { color: #7c4dff; --dx: 90px; --dy: -80px; --delay: 2.25s; }
@keyframes evoParticleFly {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  20% { transform: translate(calc(var(--dx) * 0.5), calc(var(--dy) * 0.5)) scale(1.3); opacity: 0.9; }
  40% { transform: translate(calc(var(--dx) * 0.8), calc(var(--dy) * 0.8)) scale(0.8); opacity: 0.7; }
  60% { transform: translate(calc(var(--dx) * 1.0), calc(var(--dy) * 1.0)) scale(1.1); opacity: 0.5; }
  80% { transform: translate(calc(var(--dx) * 1.2), calc(var(--dy) * 1.2)) scale(0.6); opacity: 0.3; }
  100% { transform: translate(calc(var(--dx) * 1.5), calc(var(--dy) * 1.5)) scale(0.3); opacity: 0; }
}
.evo-text {
  position: absolute;
  top: 35%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 36px;
  font-weight: 900;
  color: #ffd700;
  text-shadow: 0 0 20px rgba(255, 215, 0, 0.8), 0 0 40px rgba(255, 215, 0, 0.4);
  animation: evoTextPop 5s ease-out forwards;
  letter-spacing: 4px;
}
@keyframes evoTextPop {
  0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0; }
  8% { transform: translate(-50%, -50%) scale(1.4); opacity: 1; }
  12% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.8; }
  15% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1); opacity: 0.9; }
  100% { transform: translate(-50%, -50%) scale(1.2); opacity: 0; }
}

/* ===== 没绑定伴侣提示 ===== */
.no-partner-banner {
  text-align: center;
  padding: 60px 20px;
  color: var(--text-secondary);
}
.no-partner-icon { font-size: 48px; display: block; margin-bottom: 12px; }
.no-partner-text { font-size: 14px; display: block; margin-bottom: 16px; }
.bind-btn-small {
  display: inline-block;
  padding: 8px 24px;
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 14px;
  font-weight: 600;
}

/* 首页：没伴侣时的宠物管理链接 */
.pet-area-no-partner {
  margin: 0 12px 6px;
  padding: 16px;
  text-align: center;
  background: #fff;
  border: 1px solid #ffdce8;
  border-radius: var(--radius);
}
