<!-- pages/tasks/tasks.wxml -->
<scroll-view class="page" scroll-y>
  <view class="page-title">📋 情侣任务</view>
  <view class="page-subtitle">给伴侣指派任务，一起完成挑战</view>

  <!-- 指派任务 -->
  <view class="card">
    <view style="font-weight:600;margin-bottom:8px">🎯 指派任务</view>
    <input class="input" placeholder="让TA做什么..." model:value="{{taskTitle}}" />
    <picker mode="selector" range="{{categories}}" bindchange="onCategory" value="{{cateIdx}}">
      <view class="input" style="margin-top:6px">{{categories[cateIdx]}}</view>
    </picker>
    <button class="btn btn-primary btn-block" style="margin-top:8px" bindtap="assignTask" wx:if="{{partner}}">指派给 {{partner.nickname}}</button>
    <view wx:if="{{!partner}}" class="empty">请先绑定伴侣</view>
  </view>

  <!-- 事件任务 -->
  <view class="card" wx:if="{{events.length}}">
    <view style="font-weight:600;margin-bottom:8px">🏆 挑战任务（大量经验）</view>
    <view wx:for="{{events}}" wx:key="id" class="event-item">
      <view style="flex:1">
        <view style="font-weight:600">{{item.icon}} {{item.title}}</view>
        <view style="font-size:12px;color:#666;margin-top:2px">{{item.description}}</view>
      </view>
      <view style="text-align:right">
        <view style="font-size:14px;color:#2e7d32;font-weight:700">+{{item.exp_reward}}EXP</view>
        <button class="btn btn-sm btn-primary" style="margin-top:4px" bindtap="acceptEvent" data-code="{{item.event_code}}">接取</button>
      </view>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="page-title" style="padding-bottom:4px">📋 任务记录</view>
  <view wx:for="{{tasks}}" wx:key="id" class="card">
    <view class="list-item">
      <view class="list-info">
        <view class="list-title">{{item.title}}</view>
        <view style="font-size:11px;color:#999;margin-top:2px">
          来自{{item.assigner_id === myId ? '我' : '伴侣'}} · {{item.category}}
        </view>
      </view>
      <view style="text-align:right">
        <view class="tag tag-{{item.status}}">{{statusMap[item.status]}}</view>
        <view style="font-size:11px;color:#2e7d32;font-weight:600;margin-top:2px">+{{item.exp_reward}}EXP</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!tasks.length}}" class="empty">还没有任务</view>
</scroll-view>
