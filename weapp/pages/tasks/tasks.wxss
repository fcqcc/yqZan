/* pages/tasks/tasks.wxss */
.task-section-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-weight: 600;
  margin-bottom: 8px;
}
.event-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,.4);
}
.event-item:last-child {
  border-bottom: none;
}
.event-emoji {
  margin-right: 4rpx;
}
