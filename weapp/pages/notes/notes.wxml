<!-- pages/notes/notes.wxml — 单列便签 + 贴上动效 -->
<scroll-view class="page" scroll-y>
  <view class="page-title">💌 留言板</view>
  <view class="page-subtitle">给对方留一句心里话</view>

  <view class="oak-input-board">
    <textarea class="oak-input" placeholder="想对 Ta 说什么…" model:value="{{content}}" maxlength="200" auto-height />
    <view class="oak-input-bar">
      <text class="oak-count">{{content ? content.length : 0}}/200</text>
      <button class="btn btn-primary btn-sm oak-send" bindtap="send">贴上</button>
    </view>
  </view>

  <view class="oak-list">
    <view wx:for="{{notes}}" wx:key="id" class="oak-row {{stickId === item.id ? 'oak-row--stick' : ''}}">
      <view class="oak-row-pin" />
      <view class="oak-row-paper" style="background:{{item.paper}}">
        <view class="oak-row-text">{{item.content}}</view>
        <view class="oak-row-meta">
          <text class="oak-author">{{item.user_id === userInfo.id ? '我' : 'Ta'}}</text>
          <text class="oak-date">{{item.dateShort}}</text>
          <view class="oak-like" catchtap="like" data-id="{{item.id}}">
            <text>{{item.liked ? '❤' : '♡'}}</text>
            <text wx:if="{{item.likes}}" class="oak-like-num">{{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!notes || notes.length === 0}}" class="oak-empty">还没有便利贴，写第一条吧</view>
</scroll-view>
