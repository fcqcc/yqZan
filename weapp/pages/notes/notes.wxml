<!-- pages/notes/notes.wxml — 留言板（原型风格） -->
<scroll-view class="app-theme-{{uiTheme}} page" scroll-y>
  <view class="notes-input-header">
    <input class="notes-input" placeholder="写点什么..." model:value="{{content}}" maxlength="200" confirm-type="send" bindconfirm="send" />
    <view class="notes-submit" bindtap="send">📌</view>
  </view>

  <view class="notes-list">
    <view wx:for="{{notes}}" wx:key="id" class="note-item {{item.isMine ? '' : 'note-item--partner'}}">
      <text wx:if="{{item.isMine}}" class="note-del" catchtap="del" data-id="{{item.id}}">✕</text>
      <view class="note-content">{{item.content}}</view>
      <view class="note-meta">
        <text>{{item.isMine ? '我' : 'Ta'}} · {{item.dateShort}}</text>
        <view class="note-actions">
          <text class="note-action {{item.liked ? 'note-action--liked' : ''}}" catchtap="like" data-id="{{item.id}}">
            ❤️ {{item.likes || 0}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!notes || notes.length === 0}}" class="empty">还没有留言，写第一条吧</view>
</scroll-view>
