<scroll-view class="page" scroll-y>
  <view class="page-title">💬 便利贴墙</view>
  <view class="page-subtitle">给对方留言</view>
  <view class="write-box">
    <input class="input" placeholder="写点什么..." model:value="{{content}}" />
    <button class="btn btn-sm btn-primary" bindtap="send">发送</button>
  </view>
  <view wx:for="{{notes}}" wx:key="id" class="card">
    <view style="font-size:14px;line-height:1.6">{{item.content}}</view>
    <view style="display:flex;justify-content:space-between;margin-top:8px;font-size:12px;color:#999">
      <text>{{item.user_id === userInfo.id ? '我' : 'Ta'}} · {{item.created_at.slice(0,10)}}</text>
      <view bindtap="like" data-id="{{item.id}}" style="color:#e91e63">{{item.liked ? '❤️' : '🤍'}} {{item.likes}}</view>
    </view>
  </view>
</scroll-view>