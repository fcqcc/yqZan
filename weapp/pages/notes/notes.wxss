/* pages/notes/notes.wxss — 原型风格 */
.notes-input-header {
  padding: 12px 16px;
  display: flex;
  gap: 8px;
  background: linear-gradient(180deg, #ff8fab 0%, #ff6b9d 50%, #d4a0f0 100%);
  border-bottom: none;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4px 16px rgba(255, 107, 157, 0.15);
}

.notes-input {
  flex: 1;
  border: 1px solid #ffdce8;
  border-radius: 20px;
  padding: 8px 14px;
  font-size: 14px;
  background: #fff;
}

.notes-submit {
  background: #fff;
  color: var(--primary, #ff6b9d);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(255, 107, 157, 0.2);
}

.notes-list {
  padding: 12px;
}

.note-item {
  background: white;
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 10px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  border-left: 4px solid var(--primary, #ff6b9d);
  position: relative;
}

.note-item--partner {
  border-left-color: var(--lilac, #c9a0f5);
}

.note-del {
  position: absolute;
  top: 8px;
  right: 10px;
  color: #ccc;
  font-size: 14px;
}

.note-content {
  font-size: 14px;
  margin-bottom: 6px;
  line-height: 1.5;
  color: var(--text, #333);
  padding-right: 20px;
}

.note-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-light, #999);
}

.note-action {
  color: var(--text-light, #999);
}

.note-action--liked {
  color: var(--primary, #ff6b9d);
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-light, #999);
  font-size: 13px;
}
