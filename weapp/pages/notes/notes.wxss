/* pages/notes/notes.wxss — 原型风格 */
.notes-input-header {
  padding: 12px 16px;
  display: flex;
  gap: 8px;
  background: #fff;
  border-bottom: 2px dotted #f0e8ec;
  position: sticky;
  top: 0;
  z-index: 10;
}

.notes-input {
  flex: 1;
  border: 2px dashed #F5C6D0;
  border-radius: 14px 6px 14px 6px;
  padding: 8px 14px;
  font-size: 14px;
  background: #fffafb;
}

.notes-submit {
  background: #E891A4;
  color: #fff;
  border-radius: 12px 4px 12px 4px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.3);
}

.notes-list {
  padding: 12px;
}

.note-item {
  background: white;
  border-radius: 16px 8px 16px 8px;
  padding: 14px;
  margin-bottom: 10px;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.1);
  border: 2px dashed #F5C6D0;
  position: relative;
}

.note-item--partner {
  border-left-color: var(--lilac, #c9a0f5);
}

.note-del {
  position: absolute;
  top: 8px;
  right: 10px;
  color: #ccc;
  font-size: 14px;
}

.note-content {
  font-size: 14px;
  margin-bottom: 6px;
  line-height: 1.5;
  color: var(--text, #333);
  padding-right: 20px;
}

.note-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-light, #999);
}

.note-action {
  color: var(--text-light, #999);
}

.note-action--liked {
  color: var(--primary, #ff6b9d);
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-light, #999);
  font-size: 13px;
}
