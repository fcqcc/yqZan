<!-- pages/backpack/backpack.wxml — 背包 & 图鉴（粉红主题） -->
<scroll-view class="app-theme-{{uiTheme}} page" scroll-y>
  <!-- ===== 背包头部 ===== -->
  <view class="bp-header">
    <view class="bp-header-bg"></view>
    <view class="bp-header-title-row">
      <text class="bp-header-icon">🎒</text>
      <text class="bp-header-title">背包</text>
    </view>
    <text class="bp-header-sub">管理你的道具与收藏</text>
    <view class="bp-dot bp-dot--1"></view>
    <view class="bp-dot bp-dot--2"></view>
  </view>

  <!-- ===== 主 TAB 切换（原型 4 Tab） ===== -->
  <view class="backpack-tabs">
    <view class="bp-tab {{tab === 'backpack' ? 'bp-tab--active' : ''}}" bindtap="switchTab" data-tab="backpack">背包</view>
    <view class="bp-tab {{tab === 'pokedex' ? 'bp-tab--active' : ''}}" bindtap="switchTab" data-tab="pokedex">图鉴</view>
    <view class="bp-tab {{tab === 'achievements' ? 'bp-tab--active' : ''}}" bindtap="switchTab" data-tab="achievements">成就</view>
    <view class="bp-tab {{tab === 'crystals' ? 'bp-tab--active' : ''}}" bindtap="switchTab" data-tab="crystals">晶石商店</view>
  </view>

  <!-- ============================ 背包 TAB ============================ -->
  <block wx:if="{{tab === 'backpack'}}">
    <!-- 分类子 TAB -->
    <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="cat-bar">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="cat-item {{backpackTab === item ? 'cat-item--active' : ''}}"
          bindtap="switchBackpackTab"
          data-cat="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>

    <!-- 空状态 -->
    <view wx:if="{{filteredItems.length === 0}}" class="empty">
      <text class="empty-icon">🎒</text>
      <text>{{backpackTab === '全部' ? '背包空空如也~' : '该分类下没有道具'}}</text>
      <text class="empty-sub">去扭蛋机抽卡获得各种道具！</text>
    </view>

    <!-- 卡片网格（原型 4 列） -->
    <view wx:if="{{filteredItems.length > 0}}" class="bp-grid">
      <view
        wx:for="{{filteredItems}}"
        wx:key="id"
        class="bp-item {{item.usable ? 'bp-item--usable' : ''}}"
        bindtap="onUseItem"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text class="bp-item-icon">{{item.icon || '📦'}}</text>
        <text class="bp-item-name">{{item.name}}</text>
        <text class="bp-item-count">×{{item.quantity || 1}}</text>
      </view>
    </view>
  </block>

  <!-- ============================ 图鉴 TAB ============================ -->
  <block wx:if="{{tab === 'pokedex'}}">
    <view class="sub-tab-bar">
      <view
        class="sub-tab {{pokedexTab === 'pets' ? 'sub-tab--active' : ''}}"
        bindtap="switchPokedexTab" data-tab="pets"
      >🐾 宠物</view>
      <view
        class="sub-tab {{pokedexTab === 'items' ? 'sub-tab--active' : ''}}"
        bindtap="switchPokedexTab" data-tab="items"
      >🎁 道具</view>
    </view>

    <block wx:if="{{pokedexTab === 'pets'}}">
      <view class="section-card">
        <text class="section-sub">共 {{petsTotal}} 种，已获得 {{petsObtained}} 种</text>
        <view class="card-grid">
          <view wx:for="{{petsList}}" wx:key="type" class="item-card {{item.obtained ? '' : 'item-card--locked'}}">
            <view class="item-card-top">
              <text class="bestiary-cell-rarity bestiary-rarity-{{item.rarity}}">{{item.rarity}}</text>
              <text wx:if="{{item.obtained}}" class="pokedex-check">✓</text>
              <text wx:else class="pokedex-check">🔒</text>
            </view>
            <text class="item-card-name">{{item.obtained ? item.name : '???'}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{evolutionsList.length > 0}}" class="section-card">
        <text class="section-label">✨ 进化形态</text>
        <view class="card-grid">
          <view wx:for="{{evolutionsList}}" wx:key="item_id" class="item-card {{item.obtained ? '' : 'item-card--locked'}}">
            <view class="item-card-top">
              <text wx:if="{{item.obtained}}" class="pokedex-check">✓</text>
              <text wx:else class="pokedex-check">🔒</text>
            </view>
            <text class="item-card-name">{{item.obtained ? item.name : '???'}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{pokedexTab === 'items'}}">
      <view class="section-card">
        <text class="section-sub">共 {{itemsTotal}} 种，已获得 {{itemsObtained}} 种</text>
        <view class="card-grid">
          <view wx:for="{{itemsList}}" wx:key="item_id" class="item-card {{item.obtained ? '' : 'item-card--locked'}}">
            <view class="item-card-top">
              <text class="bestiary-cell-rarity bestiary-rarity-{{item.rarity}}">{{item.rarity}}</text>
              <text wx:if="{{item.obtained}}" class="pokedex-check">✓</text>
              <text wx:else class="pokedex-check">🔒</text>
            </view>
            <text class="item-card-name">{{item.obtained ? item.name : '???'}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- ============================ 成就 TAB（原型独立 Tab） ============================ -->
  <block wx:if="{{tab === 'achievements'}}">
    <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="cat-bar">
        <view
          wx:for="{{achCategories}}"
          wx:key="*this"
          class="cat-item {{achTab === item ? 'cat-item--active' : ''}}"
          bindtap="switchAchTab"
          data-cat="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
    <view class="bp-content">
      <text class="section-sub">共 {{achievements.length}} 项，已解锁 {{achievementsUnlocked}} 项</text>
      <view wx:if="{{filteredAch.length === 0}}" class="empty">
        <text class="empty-icon">🏆</text>
        <text>该分类暂无成就</text>
      </view>
      <view wx:else class="achievement-list">
        <view wx:for="{{filteredAch}}" wx:key="id" class="achievement-item">
          <view class="achievement-icon {{item.unlocked ? 'achievement-icon--gold' : 'achievement-icon--locked'}}">
            {{item.unlocked ? '🏆' : '🔒'}}
          </view>
          <view class="achievement-info">
            <text class="achievement-name">{{item.unlocked ? item.name : (item.hidden ? '???' : item.name)}}</text>
            <text class="achievement-desc">{{item.unlocked ? item.desc : '达成特定条件解锁'}}</text>
            <view wx:if="{{!item.unlocked && item.progress != null}}" class="achievement-progress">
              <view class="progress-mini">
                <view class="progress-mini-fill" style="width:{{item.progress}}%"></view>
              </view>
            </view>
          </view>
          <text wx:if="{{item.unlocked}}" class="achievement-reward">{{item.reward_type === 'shards' ? '💎' : '🎟️'}}+{{item.reward_amount}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ============================ 晶石商店 TAB ============================ -->
  <block wx:if="{{tab === 'crystals'}}">
    <view class="crystal-header">
      <text class="crystal-balance-icon">💎</text>
      <text class="crystal-balance-num">{{crystalBalance}}</text>
      <text class="crystal-balance-label">晶石</text>
    </view>
    <view class="section-card">
      <text class="section-label">🏪 兑换商店</text>
      <view wx:if="{{exchangeList.length === 0}}" class="empty">
        <text class="empty-icon">📦</text>
        <text>正在加载…</text>
      </view>
      <view wx:else class="exchange-grid">
        <view wx:for="{{exchangeList}}" wx:key="item_id" class="exchange-item {{crystalBalance < item.cost ? 'exchange-item--locked' : ''}}"
              bindtap="onExchange" data-item_id="{{item.item_id}}" data-name="{{item.name}}" data-cost="{{item.cost}}">
          <text class="exchange-item-name">{{item.name}}</text>
          <text class="exchange-item-cost">💎 {{item.cost}}</text>
        </view>
      </view>
    </view>
    <view class="crystal-hint">重复抽到宠物自动转化为晶石，可在本店兑换道具</view>
  </block>
</scroll-view>