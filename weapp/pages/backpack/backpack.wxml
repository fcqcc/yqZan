<!-- pages/backpack/backpack.wxml — 背包 & 图鉴 -->
<scroll-view class="page" scroll-y>
  <!-- ===== 主 TAB 切换 ===== -->
  <view class="tab-bar">
    <view
      class="tab-item {{tab === 'backpack' ? 'tab-item--active' : ''}}"
      bindtap="switchTab" data-tab="backpack"
    >🎒 背包</view>
    <view
      class="tab-item {{tab === 'pokedex' ? 'tab-item--active' : ''}}"
      bindtap="switchTab" data-tab="pokedex"
    >📖 图鉴</view>
  </view>

  <!-- ============================ 背包 TAB ============================ -->
  <block wx:if="{{tab === 'backpack'}}">
    <!-- 分类子 TAB -->
    <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="cat-bar">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="cat-item {{backpackTab === item ? 'cat-item--active' : ''}}"
          bindtap="switchBackpackTab"
          data-cat="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>

    <!-- 空状态 -->
    <view wx:if="{{filteredItems.length === 0}}" class="empty">
      <text class="empty-icon">🎒</text>
      <text>{{backpackTab === '全部' ? '背包空空如也~' : '该分类下没有道具'}}</text>
      <text class="empty-sub">去扭蛋机抽卡获得各种道具！</text>
    </view>

    <!-- 卡片网格 -->
    <view wx:if="{{filteredItems.length > 0}}" class="card-grid">
      <view
        wx:for="{{filteredItems}}"
        wx:key="id"
        class="item-card {{item.usable ? 'item-card--usable' : ''}}"
        bindtap="onUseItem"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <view class="item-card-top">
          <text class="item-card-icon">{{item.icon || '📦'}}</text>
          <text wx:if="{{item.quantity > 1}}" class="item-card-qty">×{{item.quantity}}</text>
        </view>
        <text class="item-card-name">{{item.name}}</text>
        <text class="item-card-desc">{{item.desc}}</text>
        <view wx:if="{{item.usable}}" class="item-card-btn">使用</view>
      </view>
    </view>
  </block>

  <!-- ============================ 图鉴 TAB ============================ -->
  <block wx:if="{{tab === 'pokedex'}}">
    <view class="sub-tab-bar">
      <view
        class="sub-tab {{pokedexTab === 'pets' ? 'sub-tab--active' : ''}}"
        bindtap="switchPokedexTab" data-tab="pets"
      >🐾 宠物</view>
      <view
        class="sub-tab {{pokedexTab === 'items' ? 'sub-tab--active' : ''}}"
        bindtap="switchPokedexTab" data-tab="items"
      >🎁 道具</view>
    </view>

    <block wx:if="{{pokedexTab === 'pets'}}">
      <view class="section-card">
        <text class="section-sub">共 {{petsTotal}} 种，已获得 {{petsObtained}} 种</text>
        <view class="bestiary-grid">
          <view wx:for="{{petsList}}" wx:key="type" class="bestiary-cell {{item.obtained ? '' : 'bestiary-cell--unknown'}}">
            <text class="bestiary-cell-rarity bestiary-rarity-{{item.rarity}}">{{item.rarity}}</text>
            <text class="bestiary-cell-name">{{item.obtained ? item.name : '???'}}</text>
            <view wx:if="{{item.obtained}}" class="bestiary-badge">✓</view>
          </view>
        </view>
      </view>
      <view wx:if="{{evolutionsList.length > 0}}" class="section-card">
        <text class="section-label">✨ 进化形态</text>
        <view class="bestiary-grid">
          <view wx:for="{{evolutionsList}}" wx:key="item_id" class="bestiary-cell {{item.obtained ? '' : 'bestiary-cell--unknown'}}">
            <text class="bestiary-cell-name">{{item.obtained ? item.name : '???'}}</text>
            <view wx:if="{{item.obtained}}" class="bestiary-badge">✓</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{pokedexTab === 'items'}}">
      <view class="section-card">
        <text class="section-sub">共 {{itemsTotal}} 种，已获得 {{itemsObtained}} 种</text>
        <view class="bestiary-grid">
          <view wx:for="{{itemsList}}" wx:key="item_id" class="bestiary-cell {{item.obtained ? '' : 'bestiary-cell--unknown'}}">
            <text class="bestiary-cell-rarity bestiary-rarity-{{item.rarity}}">{{item.rarity}}</text>
            <text class="bestiary-cell-name">{{item.obtained ? item.name : '???'}}</text>
            <view wx:if="{{item.obtained}}" class="bestiary-badge">✓</view>
          </view>
        </view>
      </view>
    </block>
  </block>
</scroll-view>
