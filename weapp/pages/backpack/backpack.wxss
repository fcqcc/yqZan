/* pages/backpack/backpack.wxss — 背包 & 图鉴（粉红主题） */
.page { height: 100vh; background: transparent; }

/* ===== 背包头部 ===== */
.bp-header {
  position: relative;
  overflow: hidden;
  margin: 8px 12px 0;
  padding: 20px 20px 18px;
  background: linear-gradient(180deg, #ff8fab 0%, #ff6b9d 50%, #d4a0f0 100%);
  border-radius: var(--radius-lg, 20px);
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.25);
}
.bp-header-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 60% 50% at 20% 0%, rgba(255,255,255,0.12), transparent 60%),
              radial-gradient(ellipse 50% 40% at 80% 100%, rgba(255,182,193,0.15), transparent 50%);
  pointer-events: none;
}
.bp-header-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
  z-index: 1;
}
.bp-header-icon { font-size: 24px; }
.bp-header-title {
  font-size: 20px;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.bp-header-sub {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4px;
  position: relative;
  z-index: 1;
}
.bp-dot {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  pointer-events: none;
  animation: bpDotPulse 2.8s ease-in-out infinite;
}
.bp-dot--1 { top: 20%; right: 15%; background: rgba(255, 255, 255, 0.45); animation-delay: 0s; }
.bp-dot--2 { bottom: 24%; left: 12%; background: rgba(255, 182, 193, 0.5); animation-delay: 1s; }
@keyframes bpDotPulse {
  0%, 100% { opacity: 0.25; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ===== TAB 切换栏（原型风格） ===== */
.backpack-tabs {
  display: flex;
  background: white;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.bp-tab {
  flex: 1;
  text-align: center;
  font-size: 12px;
  color: var(--text-secondary, #666);
  padding: 6px 0;
}

.bp-tab--active {
  color: var(--primary, #ff6b9d);
  font-weight: 600;
  border-bottom: 2px solid var(--primary, #ff6b9d);
}

.bp-content {
  padding: 12px;
}

.bp-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  padding: 0 12px 12px;
}

.bp-item {
  background: white;
  border-radius: 14px;
  padding: 12px 8px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

.bp-item-icon {
  display: block;
  font-size: 28px;
  margin-bottom: 4px;
}

.bp-item-name {
  display: block;
  font-size: 11px;
  color: var(--text, #333);
}

.bp-item-count {
  display: block;
  font-size: 10px;
  color: var(--primary, #ff6b9d);
  font-weight: 600;
}

.achievement-list {
  margin-top: 8px;
}

.achievement-item {
  background: white;
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.achievement-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.achievement-icon--gold {
  background: linear-gradient(135deg, #ffd700, #ffa500);
}

.achievement-icon--locked {
  background: #f0f0f0;
  color: var(--text-light, #999);
}

.achievement-info {
  flex: 1;
  min-width: 0;
}

.achievement-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text, #333);
}

.achievement-desc {
  display: block;
  font-size: 11px;
  color: var(--text-secondary, #666);
  margin-top: 2px;
}

.progress-mini {
  flex: 1;
  height: 4px;
  background: #f0f0f0;
  border-radius: 2px;
  overflow: hidden;
  margin-top: 6px;
}

.progress-mini-fill {
  height: 100%;
  background: var(--primary, #ff6b9d);
  border-radius: 2px;
}

.achievement-reward {
  font-size: 12px;
  color: var(--primary, #ff6b9d);
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 旧 TAB 栏（兼容） ===== */
.tab-bar {
  display: flex;
  margin: 8px 12px;
  background: #ffffff;
  border: 1.5px solid #f0c0d0;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(255, 107, 157, 0.08);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary);
  transition: all 0.15s ease;
  position: relative;
}
.tab-item:active { opacity: 0.7; }
.tab-item--active {
  color: var(--pink-dark);
  background: rgba(255, 107, 157, 0.08);
}
.tab-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 2px;
  background: var(--pink-dark);
  border-radius: 1px;
}

/* ===== 类型分组卡片 ===== */
.section-card {
  margin: 0 12px 8px;
  background: #ffffff;
  border: 1px solid #f0c0d0;
  border-radius: var(--radius);
  padding: 14px 16px;
  box-shadow: 0 2px 10px rgba(255, 107, 157, 0.1);
}
.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.section-label { font-size: 13px; font-weight: 700; color: var(--text); }
.section-sub { font-size: 11px; color: var(--text-muted); display: block; margin-bottom: 10px; }
.group-count { font-size: 11px; color: var(--text-muted); }

/* ===== 物品网格 ===== */
.item-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.item-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 10px 4px;
  border-radius: var(--radius-sm);
  background: #fffafb;
  border: 1px solid rgba(255, 107, 157, 0.12);
  transition: all 0.12s ease;
  position: relative;
}
.item-cell:active { transform: scale(0.95); }
.item-cell--usable { border-color: rgba(255, 107, 157, 0.35); }
.item-cell-icon { font-size: 26px; display: block; }
.item-cell-name { font-size: 10px; color: var(--text); text-align: center; line-height: 1.2; }
.item-cell-count {
  position: absolute;
  top: 2px;
  right: 4px;
  font-size: 10px;
  font-weight: 700;
  color: var(--pink-dark);
  background: rgba(255, 107, 157, 0.12);
  padding: 1px 5px;
  border-radius: var(--radius-pill);
  min-width: 16px;
  text-align: center;
}
.item-cell-use {
  font-size: 9px;
  color: #fff;
  background: var(--pink-dark);
  padding: 1px 8px;
  border-radius: var(--radius-pill);
  margin-top: 2px;
}

/* ===== 卡片式物品展示 ===== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.item-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 14px 8px 10px;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #fff5fa, #fff);
  border: 1.5px solid #f0c0d0;
  box-shadow: 0 2px 8px rgba(255, 107, 157, 0.06);
  position: relative;
  transition: all 0.12s;
}
.item-card:active { transform: scale(0.96); }
.item-card--usable { border-color: var(--pink-dark); border-width: 1.5px; }
.item-card--locked {
  background: #f5f0f2;
  border-color: #e8d0d8;
  opacity: 0.7;
}
.item-card-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.item-card-icon { font-size: 32px; display: block; }
.item-card-qty {
  position: absolute;
  top: -4px;
  right: -4px;
  font-size: 11px;
  font-weight: 800;
  color: #fff;
  background: var(--pink-dark);
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  min-width: 18px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(255, 107, 157, 0.3);
}
.item-card-name {
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  line-height: 1.3;
}
.item-card-desc {
  font-size: 10px;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.2;
  margin-top: 1px;
}
.item-card-btn {
  font-size: 10px;
  color: #fff;
  background: var(--pink-dark);
  padding: 2px 16px;
  border-radius: var(--radius-pill);
  margin-top: 4px;
  font-weight: 600;
}

/* ===== 分类子 TAB 滑动栏 ===== */
.cat-scroll {
  margin: 0 12px 8px;
  white-space: nowrap;
}
.cat-bar {
  display: inline-flex;
  gap: 6px;
  padding: 2px 0;
}
.cat-item {
  display: inline-block;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  background: #fff;
  border: 1px solid #f0c0d0;
  border-radius: var(--radius-pill);
  transition: all 0.12s;
}
.cat-item--active {
  color: #fff;
  background: var(--pink-dark);
  border-color: var(--pink-dark);
}

/* ===== 图鉴网格 ===== */
.pokedex-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.pokedex-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 12px 4px;
  border-radius: var(--radius-sm);
  background: #fffafb;
  border: 1px solid rgba(255, 107, 157, 0.12);
}
.pokedex-cell--unknown {
  background: #f5eef2;
  border-color: rgba(255, 107, 157, 0.08);
  opacity: 0.7;
}
.pokedex-cell-icon { font-size: 28px; display: block; }
.pokedex-cell-name { font-size: 10px; color: var(--text); text-align: center; line-height: 1.2; }
.pokedex-cell-badge {
  font-size: 9px;
  color: var(--pink-dark);
  font-weight: 600;
  background: rgba(255, 107, 157, 0.1);
  padding: 1px 6px;
  border-radius: var(--radius-pill);
}

/* ===== 空状态 ===== */
.empty { text-align: center; padding: 40px 16px; color: var(--text-light); font-size: 14px; }
.empty-icon { font-size: 40px; display: block; margin-bottom: 8px; }
.empty-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; display: block; }

/* ===== 晶石商店 ===== */
.crystal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 8px 12px;
  padding: 16px;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border: 1px solid #ffe082;
  border-radius: var(--radius-lg);
  box-shadow: 0 2px 10px rgba(255, 193, 7, 0.12);
}
.crystal-balance-icon { font-size: 28px; }
.crystal-balance-num { font-size: 28px; font-weight: 900; color: #f57f17; }
.crystal-balance-label { font-size: 14px; font-weight: 600; color: #f57f17; }
.exchange-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 8px;
}
.exchange-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 12px 6px;
  border-radius: var(--radius);
  background: #fffafb;
  border: 1px solid #ffdce8;
  transition: all 0.12s;
}
.exchange-item:active { transform: scale(0.95); }
.exchange-item--locked { opacity: 0.5; background: #f5f0f2; }
.exchange-item-name { font-size: 11px; font-weight: 600; color: var(--text); text-align: center; }
.exchange-item-cost { font-size: 11px; font-weight: 700; color: #f57f17; }
.crystal-hint { font-size: 11px; color: var(--text-muted); text-align: center; padding: 0 12px 12px; }

/* ===== 子TAB ===== */
.sub-tab-bar {
  display: flex;
  margin: 0 12px 8px;
  gap: 8px;
}
.sub-tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  background: #fff;
  border: 1px solid #f0c0d0;
  border-radius: var(--radius-sm);
}
.sub-tab--active {
  color: var(--pink-dark);
  background: rgba(255, 107, 157, 0.08);
  border-color: var(--pink-dark);
}

/* ===== 图鉴卡片对勾 ===== */
.pokedex-check { font-size: 14px; display: block; }
.bestiary-cell-rarity {
  font-size: 9px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  margin-bottom: 2px;
}
.bestiary-rarity-N { color: #888; background: #f0f0f0; }
.bestiary-rarity-R { color: #4d8cf0; background: #f0f6ff; }
.bestiary-rarity-SR { color: #9c27b0; background: #faf0ff; }
.bestiary-rarity-SSR { color: #ff8f00; background: #fff8e1; }
.bestiary-rarity-SSRP { color: #e65100; background: #fff3e0; }
.bestiary-cell-name { font-size: 11px; color: var(--text); text-align: center; line-height: 1.3; }
.bestiary-badge {
  position: absolute;
  top: 2px;
  right: 4px;
  font-size: 10px;
  color: #2e7d32;
  font-weight: 700;
}

/* ===== 成就网格 — 卡片风格（同背包） ===== */
.ach-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.ach-cell {
  display: flex;
  flex-direction: column;
  padding: 14px 12px 12px;
  border-radius: var(--radius);
  border: 1px solid #f0c0d0;
  gap: 6px;
  position: relative;
  box-shadow: 0 2px 8px rgba(255, 107, 157, 0.06);
  transition: all 0.12s;
}
.ach-cell--unlocked {
  background: linear-gradient(135deg, #fff5fa, #ffffff);
  border-color: #f0c0d0;
}
.ach-cell--hidden-unlocked {
  background: linear-gradient(135deg, #fff8e1, #ffffff);
  border-color: #ffd54f;
  box-shadow: 0 2px 12px rgba(255, 213, 79, 0.2);
}
.ach-cell--locked {
  background: #f5f0f2;
  border-color: #e8d0d8;
  opacity: 0.7;
}
.ach-cell-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2px;
}
.ach-icon { font-size: 26px; display: block; }
.ach-reward {
  font-size: 11px; font-weight: 700; color: #7c4dff;
  background: rgba(124, 77, 255, 0.08);
  padding: 2px 8px; border-radius: var(--radius-pill);
}
.ach-hidden-tag {
  font-size: 10px; color: var(--text-muted); font-weight: 700;
  background: #e8e8e8; padding: 2px 8px; border-radius: var(--radius-pill);
}
.ach-name { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.3; }
.ach-desc { font-size: 11px; color: var(--text-secondary); line-height: 1.4; }
.ach-cell--unlocked::after,
.ach-cell--hidden-unlocked::after {
  content: '✓';
  position: absolute; top: 4px; right: 4px;
  font-size: 12px; font-weight: 800;
  color: #2e7d32;
  background: rgba(46, 125, 50, 0.1);
  width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  text-align: center; line-height: 20px;
}
.ach-cell--hidden-unlocked::after {
  color: #e65100;
  background: rgba(230, 81, 0, 0.1);
}
