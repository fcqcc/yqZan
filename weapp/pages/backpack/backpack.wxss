/* pages/backpack/backpack.wxss — 背包 & 图鉴（可爱手绘风） */

/* ========== 设计变量 ========== */
.bp-page {
  --primary: #E891A4;
  --primary-dark: #D4708A;
  --primary-light: #FADCE6;
  --primary-pale: #FFF0F5;
  --accent: #FFD93D;
  --card-bg: #FFFFFF;
  --text-primary: #5D4E60;
  --text-secondary: #8B7A8E;
  --text-light: #B8A9BB;
  --bg-cream: #FFF9F5;
  --bg-pink: #FFE8EE;
  --success: #7BC67B;
  --card-border: #F5C6D0;

  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 12%, rgba(232, 145, 164, 0.18) 0%, transparent 45%),
    radial-gradient(circle at 85% 80%, rgba(168, 212, 230, 0.18) 0%, transparent 50%),
    linear-gradient(180deg, var(--bg-cream) 0%, var(--bg-pink) 100%);
  padding-bottom: 40rpx;
  font-family: 'Noto Sans SC', -apple-system, sans-serif;
}

/* ========== 顶部 Hero 头 ========== */
.bp-hero {
  position: relative;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  border-radius: 0 0 60rpx 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 0 rgba(212, 112, 138, 0.15);
}
.bp-hero__bg {
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.bp-hero__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}
.bp-hero__icon {
  font-size: 72rpx;
  filter: drop-shadow(4rpx 4rpx 0 rgba(212, 112, 138, 0.3));
  transform: rotate(-6deg);
  display: inline-block;
}
.bp-hero__title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.bp-hero__title {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 44rpx;
  color: white;
  text-shadow: 4rpx 4rpx 0 rgba(212, 112, 138, 0.3);
  letter-spacing: 2rpx;
}
.bp-hero__sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 500;
}
.bp-hero__chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 10rpx 18rpx;
  border-radius: 28rpx 10rpx 28rpx 10rpx;
  border: 2rpx dashed var(--primary);
  box-shadow: 4rpx 4rpx 0 rgba(212, 112, 138, 0.25);
}
.bp-hero__chip-num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 30rpx;
  color: var(--primary-dark);
  font-weight: 700;
}
.bp-hero__chip-label {
  font-size: 26rpx;
}

.bp-hero__dots {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.bp-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}
.bp-dot--1 { width: 16rpx; height: 16rpx; top: 30rpx; right: 90rpx; }
.bp-dot--2 { width: 10rpx; height: 10rpx; top: 90rpx; right: 220rpx; background: var(--accent); opacity: 0.7; }
.bp-dot--3 { width: 12rpx; height: 12rpx; bottom: 24rpx; left: 80rpx; background: var(--accent); opacity: 0.6; }

/* ========== 主 Tab 4 卡片 ========== */
.bp-tabs {
  display: flex;
  gap: 14rpx;
  padding: 28rpx 24rpx 16rpx;
  margin-top: -10rpx;
  position: relative;
  z-index: 2;
}
.bp-tab {
  flex: 1;
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 28rpx 10rpx 28rpx 10rpx;
  padding: 18rpx 6rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-shadow: 4rpx 4rpx 0 rgba(232, 145, 164, 0.15);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
}
.bp-tab__icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: 2rpx;
  filter: grayscale(0.4);
  opacity: 0.65;
  transition: all 0.2s ease;
}
.bp-tab__label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  transition: color 0.2s ease;
}
.bp-tab__count {
  font-size: 18rpx;
  color: var(--text-light);
  font-family: 'ZCOOL KuaiLe', cursive;
  transition: color 0.2s ease;
}
.bp-tab--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  border-color: var(--primary-dark);
  transform: translate(-2rpx, -2rpx);
  box-shadow: 6rpx 6rpx 0 rgba(212, 112, 138, 0.3);
}
.bp-tab--active .bp-tab__icon {
  filter: none;
  opacity: 1;
  transform: scale(1.1);
}
.bp-tab--active .bp-tab__label {
  color: white;
  font-weight: 700;
}
.bp-tab--active .bp-tab__count {
  color: rgba(255, 255, 255, 0.9);
}
.bp-tab--hover {
  transform: translate(-1rpx, -1rpx);
  box-shadow: 5rpx 5rpx 0 rgba(232, 145, 164, 0.25);
}

/* ========== 分类子 Tab（横向滚动） ========== */
.cat-scroll {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
}
.cat-bar {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}
.cat-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 24rpx 8rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: 3rpx 3rpx 0 rgba(232, 145, 164, 0.12);
  flex-shrink: 0;
  transition: all 0.15s ease;
}
.cat-item__label {
  display: inline-block;
  line-height: 1;
}
.cat-item--active {
  background: var(--primary-pale);
  color: var(--primary-dark);
  border-color: var(--primary);
  font-weight: 700;
  transform: rotate(-1deg);
  box-shadow: 4rpx 4rpx 0 rgba(212, 112, 138, 0.25);
}
.cat-item--hover {
  transform: translate(-1rpx, -1rpx);
}

/* ========== 道具网格（4 列） ========== */
.bp-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}
.bp-item {
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 24rpx 10rpx 24rpx 10rpx;
  padding: 14rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  box-shadow: 4rpx 4rpx 0 rgba(232, 145, 164, 0.18);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.bp-item--hover {
  transform: translate(-2rpx, -2rpx);
  box-shadow: 6rpx 6rpx 0 rgba(212, 112, 138, 0.3);
}
.bp-item__top {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
}
.bp-item__rarity {
  font-size: 16rpx;
  font-family: 'ZCOOL KuaiLe', cursive;
  padding: 2rpx 8rpx;
  border-radius: 8rpx 3rpx 8rpx 3rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.bp-item__rarity--N { background: #ECECEC; color: #888; }
.bp-item__rarity--R { background: #B3E0FF; color: #1A6FB3; }
.bp-item__rarity--SR { background: #FFD9A3; color: #B36600; }
.bp-item__rarity--SSR {
  background: linear-gradient(135deg, #FFB6C1, #FFD93D);
  color: #8B1A4B;
}
.bp-item__use-badge {
  font-size: 14rpx;
  background: var(--success);
  color: white;
  padding: 1rpx 8rpx;
  border-radius: 6rpx 2rpx 6rpx 2rpx;
}
.bp-item__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-pale);
  border-radius: 18rpx 6rpx 18rpx 6rpx;
  margin-top: 14rpx;
  border: 2rpx dashed var(--card-border);
}
.bp-item--ssr .bp-item__icon-wrap {
  background: linear-gradient(135deg, #FFE8EE, #FFF6D9);
  border-color: #FFC1D6;
}
.bp-item--sr .bp-item__icon-wrap {
  background: linear-gradient(135deg, #FFF1E0, #FFE8EE);
  border-color: #FFD0A3;
}
.bp-item__icon {
  font-size: 48rpx;
  display: block;
  line-height: 1;
}
.bp-item__name {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}
.bp-item__bottom {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.bp-item__count {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 22rpx;
  color: var(--primary-dark);
  background: var(--primary-pale);
  padding: 1rpx 10rpx;
  border-radius: 10rpx 3rpx 10rpx 3rpx;
  border: 1rpx dashed var(--primary-light);
}
.bp-item--usable {
  cursor: pointer;
}

/* ========== 空状态卡片 ========== */
.empty-card {
  margin: 30rpx 24rpx;
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 32rpx 14rpx 32rpx 14rpx;
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 6rpx 6rpx 0 rgba(232, 145, 164, 0.15);
}
.empty-card__icon {
  font-size: var(--text-meta-size);
  display: block;
  margin-bottom: 8rpx;
  filter: grayscale(0.3);
  opacity: 0.7;
}
.empty-card__title {
  font-size: var(--text-meta-size);
  color: var(--text-primary);
  font-weight: var(--text-meta-weight);
}
.empty-card__sub {
  font-size: var(--text-meta-size);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}
.empty-card__hint {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--primary-pale);
  padding: 10rpx 20rpx;
  border-radius: 20rpx 6rpx 20rpx 6rpx;
  font-size: 22rpx;
  color: var(--primary-dark);
  border: 1rpx dashed var(--primary);
}
.empty-card__hint-dot {
  font-weight: var(--text-meta-weight);
}

/* ========== Section 卡片（图鉴/成就/商店通用） ========== */
.section-card {
  margin: 22rpx 24rpx;
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 32rpx 14rpx 32rpx 14rpx;
  padding: 24rpx 24rpx 28rpx;
  box-shadow: 6rpx 6rpx 0 rgba(232, 145, 164, 0.15);
  position: relative;
}
.section-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-card__title {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 32rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.section-card__sub {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.section-card__stats {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  background: var(--primary-pale);
  padding: 6rpx 16rpx;
  border-radius: 16rpx 6rpx 16rpx 6rpx;
  border: 1rpx dashed var(--primary);
}
.section-card__stat-num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 30rpx;
  color: var(--primary-dark);
  font-weight: 700;
}
.section-card__stat-slash {
  font-size: 20rpx;
  color: var(--text-light);
}
.section-card__stat-total {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.section-card__stat-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}
.section-card__progress {
  margin-bottom: 20rpx;
}
.section-card__progress-bar {
  height: 16rpx;
  background: #f5f0f2;
  border-radius: 8rpx;
  overflow: hidden;
  border: 2rpx solid #f0e8ec;
}
.section-card__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

/* ========== 图鉴二级 Tab ========== */
.sub-tab-bar {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx 4rpx;
}
.sub-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 22rpx 8rpx 22rpx 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  box-shadow: 3rpx 3rpx 0 rgba(232, 145, 164, 0.12);
  transition: all 0.15s ease;
}
.sub-tab--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  border-color: var(--primary-dark);
  transform: translate(-1rpx, -1rpx);
  box-shadow: 4rpx 4rpx 0 rgba(212, 112, 138, 0.3);
}
.sub-tab--hover {
  transform: translate(-1rpx, -1rpx);
}

/* ========== 卡片网格（4 列 · 图鉴） ========== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.item-card {
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 22rpx 8rpx 22rpx 8rpx;
  padding: 12rpx 6rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  box-shadow: 3rpx 3rpx 0 rgba(232, 145, 164, 0.15);
  transition: transform 0.15s ease;
}
.item-card__top {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: 6rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-card__icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-pale);
  border-radius: 18rpx 6rpx 18rpx 6rpx;
  margin-top: 12rpx;
  border: 2rpx dashed var(--card-border);
}
.item-card__icon {
  font-size: 50rpx;
  line-height: 1;
  display: block;
}
.item-card__icon--locked {
  font-size: 36rpx;
  filter: grayscale(1);
  opacity: 0.4;
}
.item-card__name {
  font-size: 20rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}
.item-card--locked {
  background: #FAFAFA;
  opacity: 0.7;
}
.item-card--locked .item-card__icon-wrap {
  background: #F0F0F0;
}
.item-card--evo .item-card__icon-wrap {
  background: linear-gradient(135deg, #FFE8EE, #FFF6D9);
  border-color: #FFD0D9;
}
.item-card__evo-tag {
  font-size: 16rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: white;
  padding: 2rpx 10rpx;
  border-radius: 8rpx 3rpx 8rpx 3rpx;
  font-family: 'ZCOOL KuaiLe', cursive;
}

.pokedex-check {
  font-size: 22rpx;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  line-height: 1;
}
.pokedex-check--ok {
  background: var(--success);
  color: white;
  font-weight: 700;
  box-shadow: 0 0 0 2rpx white, 0 0 0 4rpx var(--success);
}

.bestiary-cell-rarity {
  font-size: 16rpx;
  font-family: 'ZCOOL KuaiLe', cursive;
  padding: 2rpx 8rpx;
  border-radius: 8rpx 3rpx 8rpx 3rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.bestiary-rarity-N { background: #ECECEC; color: #888; }
.bestiary-rarity-R { background: #B3E0FF; color: #1A6FB3; }
.bestiary-rarity-SR { background: #FFD9A3; color: #B36600; }
.bestiary-rarity-SSR { background: linear-gradient(135deg, #FFB6C1, #FFD93D); color: #8B1A4B; }

/* ========== 成就列表 ========== */
.ach-list {
  margin: 8rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.ach-item {
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 24rpx 10rpx 24rpx 10rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 4rpx 4rpx 0 rgba(232, 145, 164, 0.12);
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.ach-item--unlocked {
  background: linear-gradient(135deg, #FFF5FB 0%, #FFE8F2 100%);
  border-color: #F5C6D0;
}
.ach-item--locked {
  background: #FAFAFA;
  opacity: 0.85;
}
.ach-item--hover {
  transform: translate(-1rpx, -1rpx);
  box-shadow: 5rpx 5rpx 0 rgba(212, 112, 138, 0.25);
}
.ach-item__icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx 6rpx 20rpx 6rpx;
  font-size: 44rpx;
  flex-shrink: 0;
  border: 2rpx dashed;
}
.ach-item__icon--gold {
  background: linear-gradient(135deg, #FFD93D, #FFB347);
  border-color: #E8A93B;
  color: #8B4513;
  box-shadow: 4rpx 4rpx 0 rgba(232, 169, 59, 0.3);
}
.ach-item__icon--gray {
  background: #ECECEC;
  border-color: #D0D0D0;
  filter: grayscale(1);
  opacity: 0.7;
}
.ach-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.ach-item__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}
.ach-item__name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ach-item--locked .ach-item__name {
  color: var(--text-light);
}
.ach-item__reward {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx 4rpx 12rpx 4rpx;
  border: 1rpx dashed var(--primary);
  flex-shrink: 0;
}
.ach-item__desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
.ach-item__progress {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.ach-item__progress-bar {
  flex: 1;
  height: 12rpx;
  background: #ECECEC;
  border-radius: 6rpx;
  overflow: hidden;
  border: 1rpx solid #D0D0D0;
}
.ach-item__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 6rpx;
}
.ach-item__progress-num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 20rpx;
  color: var(--text-secondary);
  min-width: 56rpx;
  text-align: right;
}
.ach-item__check {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--success);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 0 0 3rpx white, 0 0 0 5rpx var(--success);
}

/* ========== 晶石商店 ========== */
.crystal-card {
  position: relative;
  margin: 22rpx 24rpx 8rpx;
  background: linear-gradient(135deg, #B19CD9 0%, #E891A4 100%);
  border-radius: 32rpx 14rpx 32rpx 14rpx;
  padding: 28rpx 28rpx;
  overflow: hidden;
  box-shadow: 6rpx 6rpx 0 rgba(177, 156, 217, 0.3);
  border: 2rpx dashed #B19CD9;
}
.crystal-card__bg {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.crystal-card__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.crystal-card__icon {
  font-size: 72rpx;
  display: inline-block;
  filter: drop-shadow(4rpx 4rpx 0 rgba(0,0,0,0.15));
  transform: rotate(-8deg);
}
.crystal-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.crystal-card__num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 56rpx;
  color: white;
  font-weight: 700;
  text-shadow: 4rpx 4rpx 0 rgba(0,0,0,0.15);
  line-height: 1.1;
}
.crystal-card__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
}
.crystal-card__btn {
  background: white;
  color: var(--primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 22rpx;
  border-radius: 22rpx 8rpx 22rpx 8rpx;
  box-shadow: 3rpx 3rpx 0 rgba(0,0,0,0.15);
  border: 2rpx solid white;
}
.crystal-card__btn--hover {
  transform: translate(-1rpx, -1rpx);
  box-shadow: 4rpx 4rpx 0 rgba(0,0,0,0.2);
}

/* ========== 兑换物品网格 ========== */
.exchange-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-top: 4rpx;
}
.exchange-item {
  background: white;
  border: 2rpx dashed var(--card-border);
  border-radius: 24rpx 10rpx 24rpx 10rpx;
  padding: 18rpx 12rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  box-shadow: 4rpx 4rpx 0 rgba(232, 145, 164, 0.15);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.exchange-item--hover {
  transform: translate(-2rpx, -2rpx);
  box-shadow: 6rpx 6rpx 0 rgba(212, 112, 138, 0.3);
}
.exchange-item--locked {
  opacity: 0.55;
  filter: grayscale(0.4);
}
.exchange-item__icon-wrap {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-pale) 0%, #FFF6D9 100%);
  border-radius: 20rpx 6rpx 20rpx 6rpx;
  border: 2rpx dashed var(--primary-light);
}
.exchange-item__icon {
  font-size: 54rpx;
  line-height: 1;
  display: block;
}
.exchange-item__name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.exchange-item__cost {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: var(--primary-pale);
  padding: 4rpx 14rpx;
  border-radius: 14rpx 4rpx 14rpx 4rpx;
  border: 1rpx dashed var(--primary);
  font-family: 'ZCOOL KuaiLe', cursive;
}
.exchange-item__cost-icon {
  font-size: 22rpx;
}
.exchange-item__cost-num {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 700;
}
.exchange-item__cost--insufficient {
  background: #ECECEC;
  border-color: #C8C8C8;
}
.exchange-item__cost--insufficient .exchange-item__cost-num {
  color: #888;
}
.exchange-item__lock {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

/* ========== 提示卡片 ========== */
.crystal-hint-card {
  margin: 22rpx 24rpx 0;
  background: linear-gradient(135deg, #FFF5FB 0%, #FFE8F2 100%);
  border: 2rpx dashed var(--card-border);
  border-radius: 22rpx 8rpx 22rpx 8rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-shadow: 4rpx 4rpx 0 rgba(232, 145, 164, 0.12);
}
.crystal-hint-card__icon {
  font-size: 40rpx;
  display: block;
  flex-shrink: 0;
}
.crystal-hint-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.crystal-hint-card__title {
  font-size: 26rpx;
  color: var(--primary-dark);
  font-weight: 700;
  font-family: 'ZCOOL KuaiLe', cursive;
}
.crystal-hint-card__text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ========== 底部留白 ========== */
.bp-footer {
  height: 60rpx;
}
