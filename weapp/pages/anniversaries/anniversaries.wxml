<scroll-view class="app-root app-theme-{{uiTheme}} page" scroll-y>
  <!-- ===== 页面Header ===== -->
  <view class="page-header">
    <text class="page-title">纪念日</text>
    <view class="header-action" bindtap="importHolidays">📆 导入</view>
  </view>

  <!-- ===== 顶部统计英雄区 ===== -->
  <view class="anniv-hero">
    <view class="anniv-hero__row">
      <view class="anniv-hero__heart">💕</view>
      <view class="anniv-hero__body">
        <text class="anniv-hero__title">我们的纪念日</text>
        <text class="anniv-hero__sub">已陪伴 {{totalDays}} 天 · {{anniversaries.length}} 个特别的日子</text>
      </view>
      <view class="anniv-hero__days">
        {{totalDays}}<br/><text class="anniv-hero__days-unit">天</text>
      </view>
    </view>
  </view>

  <!-- ===== 分类标签 ===== -->
  <view class="anniv-tabs">
    <view
      class="anniv-tab {{activeCategory === '' ? 'anniv-tab--active' : ''}}"
      data-cat=""
      bindtap="onCategoryTap"
    >💕 全部 <text class="anniv-tab__count">{{anniversaries.length}}</text></view>
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="anniv-tab {{activeCategory === item.key ? 'anniv-tab--active' : ''}}"
      data-cat="{{item.key}}"
      bindtap="onCategoryTap"
    >{{item.emoji}} {{item.label}} <text class="anniv-tab__count">{{item.count}}</text></view>
  </view>

  <!-- ===== 即将到来 ===== -->
  <view wx:if="{{nextAnniv}}" class="anniv-soon">
    <view class="anniv-soon__icon">{{nextAnniv.icon || '💕'}}</view>
    <view class="anniv-soon__body">
      <text class="anniv-soon__title">下一个：{{nextAnniv.title}}</text>
      <text class="anniv-soon__sub">{{nextAnniv.date_val}} · 准备好惊喜了吗?</text>
    </view>
    <view class="anniv-soon__days">
      {{nextAnniv.days}}<text class="anniv-hero__days-unit"> 天</text>
    </view>
  </view>

  <!-- ===== 纪念日列表 ===== -->
  <view class="anniv-list">
    <view
      wx:for="{{filteredAnniversaries}}"
      wx:key="id"
      class="anniv-item anniv-item--{{item.colorClass || 'pink'}}"
    >
      <view class="anniv-item__art">{{item.icon || '💑'}}</view>
      <view class="anniv-item__body">
        <view class="anniv-item__row">
          <text class="anniv-item__name">{{item.title}}</text>
          <text class="anniv-item__tag" style="color: white; background: var(--{{item.colorClass || 'pink'}});">{{item.category || '纪念'}}</text>
        </view>
        <view class="anniv-item__date">{{item.date_val}} · {{item.recurring ? '每年' : '一次'}}</view>
      </view>
      <view class="anniv-item__countdown">
        <text class="anniv-item__days {{item.isToday ? '' : (item.days <= 30 ? 'anniv-item__days--soon' : (item.days > 365 ? 'anniv-item__days--past' : ''))}}">{{item.isToday ? '🎉' : item.days}}</text>
        <text class="anniv-item__days-unit">{{item.isToday ? '今天' : '天后'}}</text>
      </view>
      <text class="anniv-item__del" catchtap="del" data-id="{{item.id}}" data-title="{{item.title}}">×</text>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{filteredAnniversaries.length === 0}}" class="empty">还没有纪念日</view>

  <!-- ===== FAB 浮动添加按钮 ===== -->
  <view class="fab" bindtap="toggleForm">
    <text>+</text>
  </view>

  <!-- ===== 添加表单弹窗 ===== -->
  <view wx:if="{{showForm}}" class="overlay" catchtap="toggleForm">
    <view class="sheet sheet--drawer" catchtap="catchTap">
      <view class="sheet-title">添加纪念日</view>
      <view class="field">
        <text class="field-label">纪念日名称</text>
        <input class="input" placeholder="如：在一起" model:value="{{title}}" />
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <view class="input input-picker" bindtap="openDatePicker">
          {{dateVal || '点选日期'}}
        </view>
      </view>
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" catchtap="toggleForm">取消</button>
        <button class="btn btn-primary" catchtap="create">确定</button>
      </view>
    </view>
  </view>

  <!-- ===== 日期选择器 ===== -->
  <view wx:if="{{showDatePicker}}" class="overlay overlay--picker-bottom" catchtap="closeDatePicker">
    <view class="date-picker-sheet" catchtap="catchTap">
      <view class="date-picker-bar">
        <text class="date-picker-link" catchtap="closeDatePicker">取消</text>
        <text class="date-picker-title">选择日期</text>
        <text class="date-picker-link date-picker-link--strong" catchtap="confirmDatePicker">确定</text>
      </view>
      <picker-view
        class="date-picker-view"
        indicator-style="height:44px;"
        mask-style="background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,.6),rgba(255,255,255,.95));"
        value="{{datePickerIdx}}"
        bindchange="onDatePickerViewChange"
      >
        <picker-view-column>
          <view wx:for="{{dateYears}}" wx:key="*this" class="date-picker-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{dateMonths}}" wx:key="*this" class="date-picker-item">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{dateDays}}" wx:key="*this" class="date-picker-item">{{item}}日</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- ===== 节日导入弹窗 ===== -->
  <view wx:if="{{showHolidayPicker}}" class="overlay">
    <view class="overlay-dismiss" bindtap="closeHolidayPicker" />
    <view class="holiday-picker" catchtap="catchTap">
      <view class="holiday-picker-header">
        <text class="holiday-picker-title">🎉 选择要导入的节日</text>
        <text class="holiday-picker-close" bindtap="closeHolidayPicker">✕</text>
      </view>
      <scroll-view scroll-y class="holiday-picker-list">
        <checkbox-group bindchange="onHolidayCheckChange">
          <label
            wx:for="{{holidayList}}"
            wx:key="title"
            class="holiday-item {{item.disabled ? 'holiday-item--disabled' : ''}}"
          >
            <checkbox value="{{item.title}}" checked="{{item.checked}}" disabled="{{item.disabled}}" class="holiday-checkbox" />
            <text class="holiday-emoji">{{item.emoji}}</text>
            <view class="holiday-info">
              <text class="holiday-title">{{item.title}}</text>
              <text class="holiday-date">{{item.date}}</text>
            </view>
            <text wx:if="{{item.disabled}}" class="holiday-tag">已存在</text>
          </label>
        </checkbox-group>
      </scroll-view>
      <view class="holiday-picker-footer">
        <button class="btn btn-primary" bindtap="confirmImport">确认导入（{{holidaySelectedCount}}）</button>
      </view>
    </view>
  </view>
</scroll-view>
