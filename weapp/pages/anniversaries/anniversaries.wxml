<scroll-view class="page" scroll-y>
  <view class="page-title">📅 纪念日</view>
  <view class="page-subtitle">重要的日子，一个都不能忘</view>
  <view class="anni-actions">
    <button class="btn btn-primary" bindtap="toggleForm">➕ 添加</button>
    <button class="btn btn-outline" bindtap="importHolidays">📆 导入节日</button>
  </view>

  <!-- 添加表单 -->
  <view wx:if="{{showForm}}" class="overlay">
    <view class="overlay-dismiss" bindtap="toggleForm" />
    <view class="sheet" catchtap="catchTap">
      <view class="sheet-title">添加纪念日</view>
      <input class="input" placeholder="名称（如：在一起）" model:value="{{title}}" />
      <picker mode="date" value="{{dateVal}}" bindchange="onDateChange" style="margin-top:8px">
        <view class="input">{{dateVal || '选择日期'}}</view>
      </picker>
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" bindtap="toggleForm">取消</button>
        <button class="btn btn-primary" bindtap="create">确定</button>
      </view>
    </view>
  </view>

  <!-- 节日勾选弹窗（用 checkbox-group） -->
  <view wx:if="{{showHolidayPicker}}" class="overlay">
    <view class="overlay-dismiss" bindtap="closeHolidayPicker" />
    <view class="holiday-picker" catchtap="catchTap">
      <view class="holiday-picker-header">
        <text class="holiday-picker-title">🎉 选择要导入的节日</text>
        <text class="holiday-picker-close" bindtap="closeHolidayPicker">✕</text>
      </view>
      <scroll-view scroll-y class="holiday-picker-list">
        <checkbox-group bindchange="onHolidayCheckChange">
          <label
            wx:for="{{holidayList}}"
            wx:key="title"
            class="holiday-item {{item.disabled ? 'holiday-item--disabled' : ''}}"
          >
            <checkbox
              value="{{item.title}}"
              checked="{{item.checked}}"
              disabled="{{item.disabled}}"
              class="holiday-checkbox"
            />
            <text class="holiday-emoji">{{item.emoji}}</text>
            <view class="holiday-info">
              <text class="holiday-title">{{item.title}}</text>
              <text class="holiday-date">{{item.date}}</text>
            </view>
            <text wx:if="{{item.disabled}}" class="holiday-tag">已存在</text>
          </label>
        </checkbox-group>
      </scroll-view>
      <view class="holiday-picker-footer">
        <button class="btn btn-primary" bindtap="confirmImport">确认导入（{{holidaySelectedCount}}）</button>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:for="{{anniversaries}}" wx:key="id" class="card" style="display:flex;justify-content:space-between;align-items:center">
    <view><view style="font-weight:600">{{item.title}}</view><view style="font-size:12px;color:#999;margin-top:2px">{{item.date_val}}</view></view>
    <view style="text-align:right"><view style="font-size:20px;font-weight:900;color:#9d2d5a">{{item.days}}天</view><view style="font-size:11px;color:#999">倒计时</view></view>
  </view>
  <view wx:if="{{!anniversaries.length}}" class="empty">还没有纪念日</view>
</scroll-view>
