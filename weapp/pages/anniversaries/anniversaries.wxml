<scroll-view class="app-root app-theme-{{uiTheme}} page" scroll-y>
  <view class="anni-actions">
    <button class="btn btn-primary" bindtap="toggleForm">➕ 添加</button>
    <button class="btn btn-outline" bindtap="importHolidays">📆 导入节日</button>
  </view>

  <!-- 添加表单 -->
  <view wx:if="{{showForm}}" class="overlay" catchtap="toggleForm">
    <view class="sheet sheet--drawer" catchtap="catchTap">
      <view class="sheet-title">添加纪念日</view>
      <view class="field">
        <text class="field-label">纪念日名称</text>
        <input class="input" placeholder="如：在一起" model:value="{{title}}" />
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <view class="input input-picker" bindtap="openDatePicker">
          {{dateVal || '点选日期'}}
        </view>
      </view>
      <view class="sheet-actions-inline">
        <button class="btn btn-outline" catchtap="toggleForm">取消</button>
        <button class="btn btn-primary" catchtap="create">确定</button>
      </view>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view wx:if="{{showDatePicker}}" class="overlay overlay--picker-bottom" catchtap="closeDatePicker">
    <view class="date-picker-sheet" catchtap="catchTap">
      <view class="date-picker-bar">
        <text class="date-picker-link" catchtap="closeDatePicker">取消</text>
        <text class="date-picker-title">选择日期</text>
        <text class="date-picker-link date-picker-link--strong" catchtap="confirmDatePicker">确定</text>
      </view>
      <picker-view
        class="date-picker-view"
        indicator-style="height:44px;"
        mask-style="background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(255,255,255,.6),rgba(255,255,255,.95));"
        value="{{datePickerIdx}}"
        bindchange="onDatePickerViewChange"
      >
        <picker-view-column>
          <view wx:for="{{dateYears}}" wx:key="*this" class="date-picker-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{dateMonths}}" wx:key="*this" class="date-picker-item">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{dateDays}}" wx:key="*this" class="date-picker-item">{{item}}日</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 节日勾选弹窗 -->
  <view wx:if="{{showHolidayPicker}}" class="overlay">
    <view class="overlay-dismiss" bindtap="closeHolidayPicker" />
    <view class="holiday-picker" catchtap="catchTap">
      <view class="holiday-picker-header">
        <text class="holiday-picker-title">🎉 选择要导入的节日</text>
        <text class="holiday-picker-close" bindtap="closeHolidayPicker">✕</text>
      </view>
      <scroll-view scroll-y class="holiday-picker-list">
        <checkbox-group bindchange="onHolidayCheckChange">
          <label
            wx:for="{{holidayList}}"
            wx:key="title"
            class="holiday-item {{item.disabled ? 'holiday-item--disabled' : ''}}"
          >
            <checkbox value="{{item.title}}" checked="{{item.checked}}" disabled="{{item.disabled}}" class="holiday-checkbox" />
            <text class="holiday-emoji">{{item.emoji}}</text>
            <view class="holiday-info">
              <text class="holiday-title">{{item.title}}</text>
              <text class="holiday-date">{{item.date}}</text>
            </view>
            <text wx:if="{{item.disabled}}" class="holiday-tag">已存在</text>
          </label>
        </checkbox-group>
      </scroll-view>
      <view class="holiday-picker-footer">
        <button class="btn btn-primary" bindtap="confirmImport">确认导入（{{holidaySelectedCount}}）</button>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="anni-list">
    <view wx:for="{{anniversaries}}" wx:key="id" class="anni-item {{item.isToday ? 'anni-item--today' : ''}}">
      <text class="anni-icon">{{item.isToday ? '🎉' : '💑'}}</text>
      <view class="anni-info">
        <text class="anni-name">{{item.title}}{{item.isToday ? ' 🎉' : ''}}</text>
        <text class="anni-date-text">{{item.date_val}}</text>
      </view>
      <view class="anni-days-wrap">
        <text wx:if="{{item.isToday}}" class="anni-today-tag">今天</text>
        <text wx:else class="anni-days-count">{{item.days}}<text class="anni-days-unit">天</text></text>
      </view>
      <text class="del-btn" catchtap="del" data-id="{{item.id}}" data-title="{{item.title}}">✕</text>
    </view>
    <view class="add-anni-btn" bindtap="toggleForm">+ 新建纪念日 / 导入节日</view>
  </view>

  <view wx:if="{{!anniversaries.length}}" class="empty">还没有纪念日</view>
</scroll-view>
