/* pages/anniversaries/anniversaries.wxss */
.page { height: 100vh; background: transparent; }
.page-title { font-size: 18px; font-weight: 800; color: var(--text); padding: 12px 16px 2px; }
.page-subtitle { font-size: 12px; color: var(--text-secondary); padding: 0 16px 8px; }
.anni-actions { display: flex; gap: 8px; padding: 0 12px; margin-bottom: 8px; }
.anni-actions .btn { flex: 1; }
.card { margin: 0 12px 6px; padding: 14px 16px; background: var(--glass-bg); border-radius: var(--radius); border: var(--glass-border); box-shadow: var(--shadow-sm); }
.empty { text-align: center; padding: 40px 16px; color: var(--text-light); font-size: 14px; }
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 50; display: flex; align-items: flex-end; }
.overlay-dismiss { position: absolute; inset: 0; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 20px; box-sizing: border-box; }
.sheet-title { font-size: 16px; font-weight: 700; margin-bottom: 12px; }
.sheet-actions-inline { display: flex; gap: 8px; margin-top: 12px; }
.sheet-actions-inline .btn { flex: 1; }
.input { width: 100%; height: 40px; border: 1px solid #ddd; border-radius: 8px; padding: 0 12px; font-size: 14px; box-sizing: border-box; }

/* ===== 节日勾选弹窗 ===== */
.holiday-picker {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.holiday-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 20px 12px;
  border-bottom: 1rpx solid #f0f0f0;
}
.holiday-picker-title { font-size: 16px; font-weight: 700; color: var(--text); }
.holiday-picker-close { font-size: 20px; color: var(--text-muted); padding: 4px; }
.holiday-picker-list { flex: 1; overflow-y: auto; padding: 8px 0; }
.holiday-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  transition: background 0.1s;
}
.holiday-item:active { background: #fff5fb; }
.holiday-item--disabled { opacity: 0.5; }
.holiday-checkbox {
  flex-shrink: 0;
  transform: scale(0.85);
}
.holiday-emoji { font-size: 24px; flex-shrink: 0; }
.holiday-info { flex: 1; display: flex; flex-direction: column; gap: 1px; }
.holiday-title { font-size: 14px; font-weight: 600; color: var(--text); }
.holiday-date { font-size: 11px; color: var(--text-muted); }
.holiday-tag { font-size: 10px; color: #999; background: #f0f0f0; padding: 2px 8px; border-radius: 999px; }
.holiday-picker-footer {
  padding: 12px 20px 20px;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.holiday-picker-count { font-size: 12px; color: var(--text-secondary); text-align: center; }
