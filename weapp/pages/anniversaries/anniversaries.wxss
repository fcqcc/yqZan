/* pages/anniversaries/anniversaries.wxss */
.anni-actions {
  display: flex;
  gap: 10px;
  padding: 12px;
}

.page { height: 100vh; background: var(--bg); }

/* 节日导入弹窗 */
.holiday-picker {
  background: white;
  border-radius: 16px 16px 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.08);
}
.holiday-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px 12px;
  border-bottom: 1px solid #f0e8ec;
}
.holiday-picker-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}
.holiday-picker-close {
  font-size: 18px;
  color: #999;
  padding: 4px 8px;
}
.holiday-picker-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px 0;
}
.holiday-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
}
.holiday-item--disabled { opacity: 0.45; }
.holiday-checkbox { transform: scale(0.85); }
.holiday-emoji { font-size: 22px; width: 30px; text-align: center; }
.holiday-info { flex: 1; }
.holiday-title { font-size: 14px; font-weight: 600; color: #333; display: block; }
.holiday-date { font-size: 11px; color: #999; display: block; margin-top: 1px; }
.holiday-tag {
  font-size: 10px;
  color: #999;
  background: #f5f0f2;
  padding: 2px 8px;
  border-radius: 10px;
}
.holiday-picker-footer {
  padding: 12px 18px;
  border-top: 1px solid #f0e8ec;
}

.anni-list {
  padding: 0 12px 24px;
}

.anni-item {
  background: white;
  border-radius: 16px 8px 16px 8px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.1);
  border: 2px dashed #F5C6D0;
  position: relative;
}

.anni-item--today {
  border: 2px dashed #E891A4;
  background: linear-gradient(135deg, #FFF5FB, #FFE8F2);
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.15);
}

.anni-icon {
  font-size: 28px;
  width: 44px;
  text-align: center;
  flex-shrink: 0;
}

.anni-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.anni-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text, #333);
}

.anni-date-text {
  font-size: 11px;
  color: var(--text-secondary, #666);
}

.anni-days-wrap {
  text-align: right;
  padding-right: 24px;
}

.anni-days-count {
  font-size: 18px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
}

.anni-days-unit {
  font-size: 11px;
  color: var(--text-secondary, #666);
  font-weight: 400;
}

.anni-today-tag {
  font-size: 13px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
}

/* ========== 日期选择器（Picker-View 底部弹窗） ========== */
.overlay--picker-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(60, 40, 50, 0.5);
}
.date-picker-sheet {
  width: 100%;
  max-height: 70vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.08);
  padding-bottom: env(safe-area-inset-bottom);
}
.date-picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
  border-bottom: 2rpx dotted #F0E8EC;
}
.date-picker-link {
  font-size: 26rpx;
  color: var(--text-secondary, #8B7A8E);
  padding: 8rpx 4rpx;
  font-weight: 500;
}
.date-picker-link--strong {
  color: var(--primary, #E891A4);
  font-weight: 700;
}
.date-picker-title {
  font-size: 28rpx;
  color: var(--text-primary, #5D4E60);
  font-weight: 700;
  font-family: 'ZCOOL KuaiLe', cursive;
}
.date-picker-view {
  width: 100%;
  height: 360rpx;
  text-align: center;
}
.date-picker-item {
  font-size: 32rpx;
  color: var(--text-primary, #5D4E60);
  font-weight: 600;
  font-family: 'ZCOOL KuaiLe', cursive;
  line-height: 44px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.del-btn {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 16px;
  padding: 4px;
}

.add-anni-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px;
  color: var(--primary, #ff6b9d);
  font-size: 14px;
}
