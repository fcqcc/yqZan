/* pages/anniversaries/anniversaries.wxss — 原型重设计 */
.page { height: 100vh; background: var(--bg); position: relative; }

/* ===== 页面Header ===== */
.page-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
.page-header__row {
  display: flex;
  align-items: center;
  padding: 14px 16px;
}
.page-header::before {
  content: '';
  position: absolute;
  top: -30px; right: -20px;
  width: 120px; height: 120px;
  background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.page-title {
  font-size: var(--text-h1-size);
  font-weight: var(--text-h1-weight);
  color: white;
  flex: 1;
  text-align: center;
  font-family: 'ZCOOL KuaiLe', cursive;
  letter-spacing: 2px;
  text-shadow: 1.5px 1.5px 0 rgba(212, 112, 138, 0.4);
}
.header-action {
  background: rgba(255,255,255,0.95);
  color: var(--primary-dark);
  padding: 6px 14px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.25);
  border: 1.5px dashed var(--primary);
}

/* ===== 顶部统计英雄区 ===== */
.anniv-hero {
  padding: 20px 16px 14px;
  background: white;
  border-radius: 0 0 32px 16px;
  position: relative;
  box-shadow: 0 6px 0 rgba(232, 145, 164, 0.12);
}
.anniv-hero__row {
  display: flex;
  align-items: center;
  gap: 14px;
}
.anniv-hero__heart {
  width: 70px; height: 70px;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36px;
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.3);
  border: 3px dashed white;
  outline: 2px dashed var(--primary);
  outline-offset: -6px;
  flex-shrink: 0;
  animation: heartbeat 1.5s ease-in-out infinite;
}
@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
.anniv-hero__body { flex: 1; }
.anniv-hero__title {
  font-family: var(--font-deco);
  font-size: var(--text-h2-size);
  color: var(--text-primary);
  line-height: 1.1;
}
.anniv-hero__sub {
  font-size: var(--text-meta-size);
  color: var(--text-secondary);
  margin-top: 2px;
}
.anniv-hero__days {
  font-family: var(--font-deco);
  font-size: var(--text-h3-size);
  color: var(--primary-dark);
  font-weight: var(--text-h3-weight);
  text-align: right;
  line-height: 1.3;
  text-shadow: 2px 2px 0 rgba(232, 145, 164, 0.2);
}
.anniv-hero__days-unit {
  font-size: var(--text-h3-size);
  color: var(--text-secondary);
  font-weight: var(--text-h3-weight);
}

/* ===== 分类标签 ===== */
.anniv-tabs {
  display: flex;
  gap: 8px;
  padding: 14px 16px 8px;
  overflow-x: auto;
  scrollbar-width: none;
}
.anniv-tabs::-webkit-scrollbar {
  display: none;
}
.anniv-tab {
  flex-shrink: 0;
  padding: 7px 16px;
  background: white;
  border: 1.5px dashed var(--card-border);
  border-radius: 18px 6px 18px 6px;
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 600;
  box-shadow: 2px 2px 0 rgba(232, 145, 164, 0.12);
  display: flex;
  align-items: center;
  gap: 4px;
}
.anniv-tab--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  border-color: var(--primary-dark);
  transform: rotate(-1deg);
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}
.anniv-tab__count {
  font-size: var(--text-tag-size);
  background: rgba(255,255,255,0.3);
  padding: 1px 6px;
  border-radius: 8px 2px 8px 2px;
}
.anniv-tab:not(.anniv-tab--active) .anniv-tab__count {
  background: var(--primary-pale);
  color: var(--primary-dark);
}

/* ===== 即将到来 ===== */
.anniv-soon {
  margin: 4px 16px 14px;
  padding: 14px 18px;
  background: linear-gradient(135deg, #FFE8E8 0%, #FFD9D9 100%);
  border: 2px dashed #FF6B6B;
  border-radius: 22px 10px 22px 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 4px 4px 0 rgba(255, 107, 107, 0.25);
  position: relative;
  overflow: hidden;
}
.anniv-soon::after {
  content: '🎉';
  position: absolute;
  top: -10px; right: -5px;
  font-size: 50px;
  opacity: 0.4;
  transform: rotate(15deg);
  pointer-events: none;
}
.anniv-soon__icon {
  width: 50px; height: 50px;
  background: white;
  border-radius: 14px 4px 14px 4px;
  display: flex; align-items: center; justify-content: center;
  font-size: 28px;
  border: 2px dashed #FF6B6B;
  box-shadow: 2px 2px 0 rgba(255, 107, 107, 0.3);
  flex-shrink: 0;
  z-index: 1;
}
.anniv-soon__body { flex: 1; z-index: 1; }
.anniv-soon__title {
  font-family: var(--font-deco);
  font-size: var(--text-h2-size);
  color: #FF6B6B;
  font-weight: var(--text-h2-weight);
  line-height: 1.1;
}
.anniv-soon__sub {
  font-size: var(--text-meta-size);
  color: var(--text-secondary);
  margin-top: 2px;
}
.anniv-soon__days {
  font-family: var(--font-deco);
  font-size: var(--text-h3-size);
  color: #FF6B6B;
  font-weight: var(--text-h3-weight);
  text-align: right;
  z-index: 1;
  text-shadow: 2px 2px 0 rgba(255, 107, 107, 0.2);
  flex-shrink: 0;
}

/* ===== 纪念日卡片（v2 面板风格） ===== */
.anniv-list { padding: 0 16px 100px; }
.anniv-item {
  margin-bottom: 14px;
  background: transparent;
  border: none;
  border-radius: 20px 12px 20px 12px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 8px 24px rgba(180, 80, 130, 0.28);
  position: relative;
  overflow: hidden;
}
.anniv-item::before { display: none; }
.anniv-item__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.35;
  border-radius: inherit;
  pointer-events: none;
}
.anniv-item--pink { --c: var(--c-pink, #E891A4); }
.anniv-item--red { --c: var(--c-red, #FF6B6B); }
.anniv-item--purple { --c: var(--c-purple, #B19CD9); }
.anniv-item--orange { --c: var(--c-orange, #FF8E53); }
.anniv-item--blue { --c: var(--c-blue, #7BC4E8); }
.anniv-item--green { --c: var(--c-green, #7BC67B); }
.anniv-item--yellow { --c: #C49B00; }

/* ===== 今天纪念日高亮 ===== */
.anniv-item--today {
  background: transparent;
  border: 2px solid #FFD700;
  box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.2), 0 8px 24px rgba(255, 71, 87, 0.3);
}
.anniv-item--today .anniv-item__art {
  border-color: #FFD700;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
}
.anniv-item--today .anniv-item__name {
  color: #FFD700;
  font-size: 17px;
}
.anniv-item--today .anniv-item__date {
  color: rgba(255,255,255,0.9);
  font-weight: 600;
}
.anniv-item--today .anniv-item__tag {
  background: linear-gradient(135deg, #FFD700, #FFC107) !important;
  color: #7A4A00 !important;
}
.anniv-item__today-badge {
  position: absolute;
  top: -6px; left: -6px;
  background: linear-gradient(135deg, #FF6B6B, #FF4757);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 14px;
  box-shadow: 0 3px 8px rgba(255, 71, 87, 0.3);
  z-index: 5;
  border: none;
}

.anniv-item__art {
  width: 50px; height: 50px;
  flex-shrink: 0;
  background: rgba(255,255,255,0.95);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  border: none;
  box-shadow: 0 4px 10px rgba(0,0,0,0.12);
  position: relative;
  z-index: 2;
}
.anniv-item--red .anniv-item__art,
.anniv-item--purple .anniv-item__art,
.anniv-item--orange .anniv-item__art,
.anniv-item--blue .anniv-item__art,
.anniv-item--green .anniv-item__art,
.anniv-item--yellow .anniv-item__art { background: rgba(255,255,255,0.95); }

.anniv-item__body { flex: 1; min-width: 0; position: relative; z-index: 2; }
.anniv-item__row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}
.anniv-item__name {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 17px;
  color: #fff;
  font-weight: 700;
  text-shadow: 0 2px 4px rgba(0,0,0,0.4);
}
.anniv-item__tag {
  font-size: 10px;
  color: white;
  padding: 2px 8px;
  border-radius: 8px;
  font-weight: 700;
  flex-shrink: 0;
  letter-spacing: 0.5px;
}
.anniv-item__date {
  font-size: 11px;
  color: rgba(255,255,255,0.9);
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  letter-spacing: 0.5px;
}
.anniv-item__countdown {
  text-align: right;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}
.anniv-item__days {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 28px;
  color: #fff;
  font-weight: 700;
  text-shadow: 0 2px 6px rgba(0,0,0,0.4);
  line-height: 1;
}
.anniv-item__days--soon { color: #FFD93D; }
.anniv-item__days--past { color: rgba(255,255,255,0.6); }
.anniv-item__days-unit {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 10px;
  color: rgba(255,255,255,0.85);
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  margin-top: 2px;
  text-align: center;
}
.anniv-item__del {
  position: absolute;
  top: 8px; right: 8px;
  width: 24px; height: 24px;
  background: rgba(255,255,255,0.9);
  color: rgba(0,0,0,0.4);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
  border: none;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  line-height: 1;
  font-weight: 700;
  z-index: 3;
}

/* ===== FAB ===== */
.fab {
  position: fixed;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  width: 56px; height: 56px;
  border-radius: 22px 8px 22px 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  font-weight: 300;
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.4);
  border: 2.5px dashed rgba(255,255,255,0.5);
  outline: 2px dashed #E891A4;
  outline-offset: -8px;
  z-index: 50;
}
.fab text {
  color: #E891A4;
}

/* ===== 以下为原有弹窗样式（保持不动） ===== */
.holiday-picker {
  background: white;
  border-radius: 16px 16px 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.08);
}
.holiday-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px 12px;
  border-bottom: 1px solid #f0e8ec;
}
.holiday-picker-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}
.holiday-picker-close {
  font-size: 18px;
  color: #999;
  padding: 4px 8px;
}
.holiday-picker-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px 0;
}
.holiday-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
}
.holiday-item--disabled { opacity: 0.45; }
.holiday-checkbox { transform: scale(0.85); }
.holiday-emoji { font-size: 22px; width: 30px; text-align: center; }
.holiday-info { flex: 1; }
.holiday-title { font-size: 14px; font-weight: 600; color: #333; display: block; }
.holiday-date { font-size: var(--text-body-size); color: #999; display: block; margin-top: 1px; }
.holiday-tag {
  font-size: 10px;
  color: #999;
  background: #f5f0f2;
  padding: 2px 8px;
  border-radius: 10px;
}
.holiday-picker-footer {
  padding: 12px 18px;
  border-top: 1px solid #f0e8ec;
  display: flex;
  justify-content: center;
}

/* ===== 日期选择器 ===== */
.overlay--picker-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(60, 40, 50, 0.5);
}
.date-picker-sheet {
  width: 100%;
  max-height: 70vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.08);
  padding-bottom: env(safe-area-inset-bottom);
}
.date-picker-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
  border-bottom: 2rpx dotted #F0E8EC;
}
.date-picker-link {
  font-size: 26rpx;
  color: var(--text-secondary, #8B7A8E);
  padding: 8rpx 4rpx;
  font-weight: 500;
}
.date-picker-link--strong {
  color: var(--primary, #E891A4);
  font-weight: 700;
}
.date-picker-title {
  font-size: 28rpx;
  color: var(--text-primary, #5D4E60);
  font-weight: 700;
  font-family: 'ZCOOL KuaiLe', cursive;
}
.date-picker-view {
  width: 100%;
  height: 360rpx;
  text-align: center;
}
.date-picker-item {
  font-size: 32rpx;
  color: var(--text-primary, #5D4E60);
  font-weight: 600;
  font-family: 'ZCOOL KuaiLe', cursive;
  line-height: 44px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
