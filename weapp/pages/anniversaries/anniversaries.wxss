/* pages/anniversaries/anniversaries.wxss — 原型风格 */
.anni-actions {
  display: flex;
  gap: 10px;
  padding: 12px;
}

.anni-list {
  padding: 0 12px 24px;
}

.anni-item {
  background: white;
  border-radius: 16px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  position: relative;
}

.anni-item--today {
  border: 2px solid var(--primary, #ff6b9d);
  background: linear-gradient(135deg, #fff5f2, #ffe8f0);
  box-shadow: 0 4px 16px rgba(255, 107, 157, 0.12);
}

.anni-icon {
  font-size: 28px;
  width: 44px;
  text-align: center;
  flex-shrink: 0;
}

.anni-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.anni-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text, #333);
}

.anni-date-text {
  font-size: 11px;
  color: var(--text-secondary, #666);
}

.anni-days-wrap {
  text-align: right;
  padding-right: 24px;
}

.anni-days-count {
  font-size: 18px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
}

.anni-days-unit {
  font-size: 11px;
  color: var(--text-secondary, #666);
  font-weight: 400;
}

.anni-today-tag {
  font-size: 13px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
}

.del-btn {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 16px;
  padding: 4px;
}

.add-anni-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px;
  color: var(--primary, #ff6b9d);
  font-size: 14px;
}
