<!-- pages/settings/settings.wxml — 我的（原型风格） -->
<view class="app-root app-theme-{{uiTheme}}">
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="page-inner">

      <!-- 粉色渐变头部 -->
      <view class="profile-header">
        <!-- 底部浮动装饰图（容器absolute，image无position） -->
        <view class="profile-header__bottom-wrap">
          <image class="profile-header__bottom-img" src="/assets/images/settings-header-bottom.png" mode="widthFix" />
        </view>
        <view class="page-nav" style="padding-top: {{statusBarHeight}}px">
          <view class="page-nav__bar" style="height: {{navBarHeight}}px">
            <!-- <text class="page-nav__title">我的</text> -->
          </view>
        </view>
        <view class="profile-avatars">
          <view class="profile-avatar-item">{{myInitial}}</view>
          <text class="profile-heart">💕</text>
          <view class="profile-avatar-item profile-avatar-item--small">{{partner ? partnerInitial : '?'}}</view>
        </view>
        <text class="profile-name">{{userInfo.nickname || '我'}}</text>
        <text class="profile-code">邀请码: {{userInfo.invite_code || '------'}} · {{partner ? '已绑定伴侣' : '未绑定伴侣'}}</text>
        <view class="profile-stats">
          <view class="profile-stat">
            <text class="profile-stat-value">{{level}}</text>
            <text class="profile-stat-label">等级</text>
          </view>
          <view class="profile-stat">
            <text class="profile-stat-value">{{togetherDays}}</text>
            <text class="profile-stat-label">在一起</text>
          </view>
          <view class="profile-stat">
            <text class="profile-stat-value">{{sparkCount}}</text>
            <text class="profile-stat-label">火花</text>
          </view>
        </view>
        <!-- 底部装饰图 -->
        <image class="profile-header__bottom" src="/assets/images/settings-header-bottom.png" mode="widthFix" />
      </view>

      <!-- 绑定伴侣（未绑定时显示） -->
      <view wx:if="{{!partner}}" class="bind-card">
        <view class="bind-title">💞 绑定伴侣</view>
        <view class="bind-desc">输入对方的邀请码，一起攒钱</view>
        <input class="input bind-input" placeholder="对方的6位邀请码" model:value="{{inviteCodeInput}}" maxlength="6" />
        <button class="bind-btn" bindtap="handleBind">绑定</button>
      </view>

      <!-- 菜单组 -->
      <view class="menu-section">

        <view class="menu-group">
          <view class="menu-item" bindtap="go" data-url="/pages/backpack/backpack" hover-class="menu-item-hover">
            <view class="menu-icon">💎</view>
            <text class="menu-text">我的积分（晶石）</text>
            <text class="menu-value">{{shards || 0}}</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="go" data-url="/pages/gacha/gacha" hover-class="menu-item-hover">
            <view class="menu-icon">🎟️</view>
            <text class="menu-text">抽奖券</text>
            <text class="menu-badge">{{tickets || 0}}</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item menu-item-last" bindtap="go" data-url="/pages/backpack/backpack" hover-class="menu-item-hover">
            <view class="menu-icon">🎒</view>
            <text class="menu-text">背包/图鉴/成就</text>
            <text class="menu-sub">{{collectionProgress || '0/35'}}</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-group">
          <view class="menu-item" bindtap="go" data-url="/pages/pets/pets" hover-class="menu-item-hover">
            <view class="menu-icon">🐾</view>
            <text class="menu-text">宠物管理</text>
            <text class="menu-value">{{petCount || 0}}只</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="go" data-url="/pages/anniversaries/anniversaries" hover-class="menu-item-hover">
            <view class="menu-icon">💝</view>
            <text class="menu-text">纪念日</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item menu-item-last" bindtap="go" data-url="/pages/notes/notes" hover-class="menu-item-hover">
            <view class="menu-icon">💬</view>
            <text class="menu-text">留言板</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>

        <view class="menu-group menu-group--settings">
          <!-- <view class="menu-item" bindtap="onSwitchTheme" hover-class="menu-item-hover">
            <view class="menu-icon">🎨</view>
            <text class="menu-text">切换主题</text>
            <text class="menu-value">{{themeName}}</text>
            <text class="menu-arrow">›</text>
          </view> -->
          <view class="menu-item" bindtap="editNickname" hover-class="menu-item-hover">
            <view class="menu-icon">✏️</view>
            <text class="menu-text">修改昵称</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item" bindtap="onBindMenuTap" hover-class="menu-item-hover">
            <view class="menu-icon">🔗</view>
            <text class="menu-text">绑定/解绑伴侣</text>
            <text class="menu-arrow">›</text>
          </view>
          <view class="menu-item menu-item-last" bindtap="goToAbout" hover-class="menu-item-hover">
            <view class="menu-icon">⚙️</view>
            <text class="menu-text">设置</text>
            <text class="menu-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="danger-actions">
        <button wx:if="{{partner}}" class="danger-btn unbind" bindtap="unbindPartner">解绑伴侣</button>
        <button class="danger-btn logout" bindtap="logout">退出登录</button>
      </view>
    </view>
  </scroll-view>
</view>
