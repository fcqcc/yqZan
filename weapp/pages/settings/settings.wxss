page { height: 100%; }

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: transparent;
}

.page-inner {
  padding: 0 0 120px;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.profile-header {
  background: linear-gradient(180deg, #ff8fab 0%, #ff6b9d 50%, #d4a0f0 100%);
  padding: 28px 20px;
  color: white;
  text-align: center;
  box-shadow: 0 8px 24px rgba(255, 107, 157, 0.2);
}

.profile-avatars {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.profile-avatar-item {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
  border: 3px solid rgba(255, 255, 255, 0.4);
}

.profile-avatar-item--small {
  width: 44px;
  height: 44px;
  font-size: 20px;
  margin-left: -12px;
}

.profile-heart {
  font-size: 22px;
}

.profile-name {
  display: block;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 2px;
}

.profile-code {
  display: block;
  font-size: 11px;
  opacity: 0.85;
  margin-bottom: 12px;
}

.profile-stats {
  display: flex;
  justify-content: center;
  gap: 24px;
}

.profile-stat {
  text-align: center;
}

.profile-stat-value {
  display: block;
  font-size: 18px;
  font-weight: 700;
}

.profile-stat-label {
  display: block;
  font-size: 11px;
  opacity: 0.8;
}

/* ===== 绑定卡片 ===== */
.bind-card {
  margin: 12px;
  background: white;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.bind-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
}

.bind-desc {
  font-size: 12px;
  color: var(--text-secondary, #666);
  margin-bottom: 12px;
}

.bind-input {
  border: 1px solid #ffdce8;
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 10px;
  font-size: 14px;
}

.bind-btn {
  background: var(--primary, #ff6b9d);
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
}

.bind-btn::after { border: none; }

/* ===== 菜单 ===== */
.menu-section {
  padding: 12px;
}

.menu-group {
  background: white;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #f5f5f5;
}

.menu-item-last {
  border-bottom: none;
}

.menu-item-hover {
  background: rgba(255, 107, 157, 0.06);
}

.menu-icon {
  width: 34px;
  height: 34px;
  background: var(--primary-pale, #ffe8f0);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  margin-right: 12px;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 15px;
  color: var(--text, #333);
}

.menu-arrow {
  color: var(--text-light, #999);
  font-size: 14px;
}

.menu-badge {
  background: var(--primary, #ff6b9d);
  color: white;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 8px;
  margin-right: 8px;
}

.menu-value {
  color: var(--primary, #ff6b9d);
  font-weight: 600;
  font-size: 13px;
  margin-right: 8px;
}

.menu-sub {
  font-size: 12px;
  color: var(--text-light, #999);
  margin-right: 8px;
}

/* ===== 危险操作 ===== */
.danger-actions {
  padding: 0 12px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.danger-btn {
  border: none;
  border-radius: 12px;
  font-size: 14px;
  padding: 12px;
}

.danger-btn::after { border: none; }

.danger-btn.unbind {
  background: var(--unbind-bg, #ffe4ec);
  color: var(--unbind-color, #e85a7a);
}

.danger-btn.logout {
  background: var(--logout-bg, #f5eef2);
  color: var(--logout-color, #8a6a7a);
}

/* 游客模式遮罩 */
.guest-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.guest-card {
  display: none;
}
.guest-card-icon { font-size: 44px; margin-bottom: 12px; }
.guest-card-title { font-size: 17px; font-weight: 700; color: var(--ink); display: block; margin-bottom: 6px; }
.guest-card-desc { font-size: 13px; color: var(--ink-soft); display: block; margin-bottom: 24px; }
.guest-card-btn {
  border: none; border-radius: 22px; padding: 12px 0;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  color: #fff; font-size: 15px; font-weight: 600; width: 100%; line-height: 1.4;
}
.guest-card-btn::after { border: none; }
