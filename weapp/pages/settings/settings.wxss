page {
  height: 100%;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: transparent;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page-inner {
  padding: 32rpx 40rpx 0;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.glass-card {
  background: var(--glass-bg);
  border: 1rpx solid #ffd6e8;
  box-shadow: var(--glass-shadow);
}

.couple-card {
  border-radius: 48rpx;
  padding: 40rpx 36rpx 36rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-group {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent);
  background: rgba(255, 255, 255, 0.95);
  position: absolute;
  left: 0;
  top: 0;
  box-sizing: border-box;
}

.avatar.partner {
  left: 48rpx;
  top: 48rpx;
  border-color: var(--accent-partner);
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--avatar-ph-text);
  background: var(--avatar-ph-bg);
}

.avatar-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  border-style: dashed;
  border-color: var(--avatar-slot-border);
  background: var(--avatar-slot-bg);
}

.couple-info {
  text-align: center;
  margin: 8rpx 0 20rpx;
}

.couple-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.couple-slogan-wrap {
  margin-top: 12rpx;
}

.couple-slogan {
  font-size: 26rpx;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.level-badge {
  width: 100%;
  padding: 16rpx 24rpx;
  background: var(--level-badge-bg);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.level-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

.level-progress {
  margin-top: 8rpx;
  width: 100%;
}

.info-card {
  border-radius: 44rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--settings-label);
}

.info-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 62%;
}

.info-value {
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
  word-break: break-all;
}

.info-value.code {
  font-family: 'SF Mono', Monaco, monospace;
  color: var(--settings-code);
}

.icon-hit {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.72;
}

.divider {
  height: 1rpx;
  background: var(--divider);
}

.menu-list {
  border-radius: 44rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 36rpx;
  border-bottom: 0.5px solid var(--divider);
}

.menu-item-last {
  border-bottom: none;
}

.menu-item-hover {
  background: var(--menu-hover);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon-wrap {
  opacity: 0.92;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}

.menu-chevron {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--chevron);
  line-height: 1;
}

.bind-card {
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.bind-input {
  margin-top: 0;
}

.bind-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #f8a5c4, #d65c8a);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(214, 92, 138, 0.35);
}

.bind-btn::after {
  border: none;
}

.bind-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.bound-tip {
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.bound-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.bound-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--pink-dark);
}

.danger-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.danger-btn {
  width: 100%;
  margin: 0;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.danger-btn::after {
  border: none;
}

.danger-btn.unbind {
  color: var(--unbind-color);
  background: var(--unbind-bg);
  box-shadow: var(--unbind-shadow);
}

.danger-btn.logout {
  color: var(--logout-color);
  background: var(--logout-bg);
}
