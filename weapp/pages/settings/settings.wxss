page { height: 100%; }

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: transparent;
}

.page-inner {
  padding: 0 0 120px;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.profile-header {
  position: relative;
  background: linear-gradient(135deg, #E891A4 0%, #FADCE6 100%);
  padding: 0 20px 28px;
  color: white;
  text-align: center;
  border-radius: 0 0 30px 15px;
  overflow: hidden;
}

/* 背景装饰图 — 占满头部，垫在内容下面 */
.profile-header__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35;
  pointer-events: none;
}

.profile-header__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(232,145,164,0.3) 0%, rgba(250,220,230,0.5) 100%);
  pointer-events: none;
}

/* 确保头部内容在背景层之上 */
.page-nav { position: relative; z-index: 1; }
.profile-avatars { position: relative; z-index: 1; }
.profile-name { position: relative; z-index: 1; }
.profile-code { position: relative; z-index: 1; }
.profile-stats { position: relative; z-index: 1; }

.profile-avatars {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.profile-avatar-item {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  color: var(--primary, #ff6b9d);
  border: 3px solid rgba(255, 255, 255, 0.4);
}

.profile-avatar-item--small {
  width: 44px;
  height: 44px;
  font-size: 20px;
  margin-left: -12px;
}

.profile-heart {
  font-size: 22px;
}

.profile-name {
  display: block;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 2px;
}

.profile-code {
  display: block;
  font-size: 11px;
  opacity: 0.85;
  margin-bottom: 12px;
}

.profile-stats {
  display: flex;
  justify-content: center;
  gap: 24px;
}

.profile-stat {
  text-align: center;
}

.profile-stat-value {
  display: block;
  font-size: 18px;
  font-weight: 700;
}

.profile-stat-label {
  display: block;
  font-size: 11px;
  opacity: 0.8;
}

/* ===== 绑定卡片 ===== */
.bind-card {
  margin: 12px;
  background: white;
  border-radius: 18px 8px 18px 8px;
  padding: 16px;
  border: 2px dashed #F5C6D0;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.1);
}

.bind-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 4px;
}

.bind-desc {
  font-size: 12px;
  color: var(--text-secondary, #666);
  margin-bottom: 12px;
}

.bind-input {
  border: 2px dashed #F5C6D0;
  border-radius: 14px 6px 14px 6px;
  padding: 10px 14px;
  margin-bottom: 10px;
  font-size: 14px;
  background: #fffafb;
}

.bind-btn {
  background: #E891A4;
  color: white;
  border: none;
  border-radius: 14px 4px 14px 4px;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.3);
}

.bind-btn::after { border: none; }

/* ===== 菜单 ===== */
.menu-section {
  padding: 12px;
}

.menu-group {
  background: white;
  border-radius: 18px 8px 18px 8px;
  overflow: hidden;
  margin-bottom: 12px;
  border: 2px dashed #F5C6D0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 2px dotted #f0e8ec;
}

.menu-item-last {
  border-bottom: none;
}

.menu-item-hover {
  background: rgba(232, 145, 164, 0.06);
}

.menu-icon {
  width: 36px;
  height: 36px;
  background: #FFF0F5;
  border-radius: 10px 4px 10px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  margin-right: 12px;
  flex-shrink: 0;
  border: 2px dashed #F5C6D0;
}

.menu-text {
  flex: 1;
  font-size: 15px;
  color: var(--text, #333);
}

.menu-arrow {
  color: var(--text-light, #999);
  font-size: 14px;
}

.menu-badge {
  background: #E891A4;
  color: white;
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 8px 3px 8px 3px;
  margin-right: 8px;
}

.menu-value {
  color: #D4708A;
  font-weight: 700;
  font-size: 13px;
  margin-right: 8px;
}

.menu-sub {
  font-size: 12px;
  color: var(--text-light, #999);
  margin-right: 8px;
}

/* ===== 危险操作 ===== */
.danger-actions {
  padding: 0 12px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.danger-btn {
  border: none;
  border-radius: 12px;
  font-size: 14px;
  padding: 12px;
}

.danger-btn::after { border: none; }

.danger-btn.unbind {
  background: var(--unbind-bg, #ffe4ec);
  color: var(--unbind-color, #e85a7a);
}

.danger-btn.logout {
  background: var(--logout-bg, #f5eef2);
  color: var(--logout-color, #8a6a7a);
}

/* 游客模式遮罩 */
.guest-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.guest-card {
  display: none;
}
.guest-card-icon { font-size: 44px; margin-bottom: 12px; }
.guest-card-title { font-size: 17px; font-weight: 700; color: var(--ink); display: block; margin-bottom: 6px; }
.guest-card-desc { font-size: 13px; color: var(--ink-soft); display: block; margin-bottom: 24px; }
.guest-card-btn {
  border: none; border-radius: 22px; padding: 12px 0;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  color: #fff; font-size: 15px; font-weight: 600; width: 100%; line-height: 1.4;
}
.guest-card-btn::after { border: none; }
