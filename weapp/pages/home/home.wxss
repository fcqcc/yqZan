/* 首页 — 蜜桃苏打 · 年轻情侣向 · 固定区 + 立体内容井 */

page {
  --rose: #ff6b9d;
  --rose-light: #ff8fab;
  --rose-soft: #ffb8cc;
  --rose-pale: #ffe8f0;
  --rose-deep: #e84d85;
  --peach: #ffb5a0;
  --peach-pale: #fff0eb;
  --lilac: #c9a0f5;
  --lilac-pale: #f0e8ff;
  --sky: #89cff0;
  --sky-pale: #e8f6fc;
  --mint: #7ed4b8;
  --mint-pale: #e8faf3;
  --plum-deep: #c43d6e;
  --plum: #ff8fab;
  --plum-mid: #e84d85;
  --gold: var(--rose);
  --gold-bright: var(--rose-light);
  --gold-pale: var(--rose-pale);
  --copper: var(--peach);
  --sage: var(--mint);
  --stone: #fff5f2;
  --stone-deep: #ffe4dc;
  --surface: #ffffff;
  --ink: #3a2e35;
  --ink-soft: #8a7078;
  --ink-muted: #b8a4ac;
  --accent: var(--rose);
  --accent-deep: var(--rose-deep);
  --line: rgba(255, 107, 157, 0.1);
  --line-strong: rgba(255, 107, 157, 0.18);
  --elev-1: 0 1px 2px rgba(255, 107, 157, 0.06), 0 2px 8px rgba(255, 140, 180, 0.08);
  --elev-2: 0 2px 4px rgba(255, 107, 157, 0.08), 0 8px 24px rgba(255, 140, 180, 0.14), 0 16px 40px rgba(221, 160, 240, 0.08);
  --elev-3: 0 4px 8px rgba(255, 107, 157, 0.1), 0 16px 40px rgba(255, 140, 180, 0.18), 0 32px 64px rgba(221, 160, 240, 0.1);
  --inset: inset 0 1px 0 rgba(255, 255, 255, 0.92), inset 0 -1px 0 rgba(255, 107, 157, 0.05);
  --radius: 20px;
  --radius-sm: 14px;
  --header-start: #ff8fab;
  --header-mid: #ff6b9d;
  --header-end: #d4a0f0;
  background: var(--stone);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--stone);
}

/* ==================== 固定仪表盘 ==================== */
.fixed-dock {
  position: relative;
  flex-shrink: 0;
  z-index: 20;
  background: linear-gradient(180deg, var(--header-start) 0%, var(--header-mid) 50%, var(--header-end) 100%);
  padding: 12px 18px 0;
  box-shadow: 0 12px 32px rgba(255, 107, 157, 0.22), 0 4px 12px rgba(212, 160, 240, 0.18);
}

.fixed-dock__mesh {
  position: absolute;
  inset: 0;
  opacity: 0.32;
  background-image:
    radial-gradient(circle at 72% 22%, rgba(255, 255, 255, 0.22) 0%, transparent 42%),
    radial-gradient(circle at 12% 68%, rgba(212, 160, 240, 0.18) 0%, transparent 40%),
    linear-gradient(180deg, transparent 0%, rgba(255, 107, 157, 0.1) 100%);
  pointer-events: none;
}

.fixed-dock__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(50px);
  pointer-events: none;
}
.fixed-dock__glow--1 {
  width: 140px; height: 140px;
  top: 20px; right: 8%;
  background: rgba(255, 255, 255, 0.18);
}
.fixed-dock__glow--2 {
  width: 100px; height: 100px;
  bottom: 40px; left: -20px;
  background: rgba(201, 160, 245, 0.25);
}

.fixed-dock__inner {
  position: relative;
  z-index: 2;
}

.fixed-dock__ledge {
  position: relative;
  z-index: 3;
  height: 14px;
  margin: 0 -18px;
  background: linear-gradient(180deg, rgba(255, 107, 157, 0.15) 0%, transparent 100%);
}
.fixed-dock__ledge-bar {
  position: absolute;
  left: 50%;
  bottom: 4px;
  transform: translateX(-50%);
  width: 40px;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.45);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
}

/* 顶部信息 */
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.hero-couple {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar-stack {
  position: relative;
  width: 72px;
  height: 48px;
  flex-shrink: 0;
}

.avatar-ring {
  position: absolute;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff 0%, #fff5f8 100%);
  border: 2px solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: 700;
  color: var(--rose-deep);
  box-shadow:
    0 4px 14px rgba(255, 107, 157, 0.35),
    0 1px 0 rgba(255, 255, 255, 1) inset;
}
.avatar-ring--me { left: 0; top: 2px; z-index: 2; }
.avatar-ring--partner { left: 28px; top: 2px; z-index: 1; }
.avatar-ring--empty {
  background: rgba(255, 255, 255, 0.35);
  border: 2px dashed rgba(255, 255, 255, 0.65);
  box-shadow: none;
}

.hero-greet { display: flex; flex-direction: column; gap: 3px; }
.hero-greet-label {
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.3px;
  text-shadow: 0 1px 8px rgba(196, 61, 110, 0.25);
}
.hero-greet-sub {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.88);
}
.hero-greet-sub--bind {
  color: #fff;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.hero-pills {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: flex-end;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 2px 8px rgba(255, 107, 157, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(8px);
}
.pill--spark {
  background: rgba(255, 255, 255, 0.28);
  border-color: rgba(255, 255, 255, 0.45);
}
.pill--muted { opacity: 0.55; }
.pill-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.95);
}

/* 资产金库卡 — 强立体 */
.vault-card {
  position: relative;
  margin-bottom: 16px;
  border-radius: 22px;
  transform: translateZ(0);
}

.vault-card__rim {
  position: absolute;
  inset: -1px;
  border-radius: 23px;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 140, 180, 0.55) 50%, rgba(221, 160, 240, 0.4) 100%);
  z-index: 0;
}

.vault-card__body {
  position: relative;
  z-index: 1;
  background: linear-gradient(168deg, rgba(255,255,255,0.92) 0%, rgba(255,250,251,0.88) 55%, rgba(255,245,248,0.85) 100%);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 22px;
  padding: 20px 20px 16px;
  box-shadow:
    var(--elev-3),
    inset 0 1px 0 rgba(255, 255, 255, 1),
    inset 0 -2px 4px rgba(255, 107, 157, 0.04);
  overflow: hidden;
}
.vault-card__body::before {
  content: '';
  position: absolute;
  top: -100%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    60deg,
    transparent 25%,
    rgba(255,255,255,0.3) 30%,
    rgba(255,255,255,0.45) 32%,
    rgba(255,255,255,0.15) 35%,
    transparent 40%
  );
  pointer-events: none;
  z-index: 5;
  animation: glassShineVault 8s ease-in-out infinite;
}
@keyframes glassShineVault {
  0%, 100% { transform: translateX(-40%) translateY(-30%) rotate(50deg); opacity: 0.5; }
  50% { transform: translateX(40%) translateY(30%) rotate(50deg); opacity: 1; }
}

.vault-card__tag {
  display: inline-block;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent-deep);
  background: var(--gold-pale);
  padding: 4px 10px;
  border-radius: 6px;
  margin-bottom: 8px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.vault-card__amount {
  font-size: 38px;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1.5px;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
}

.vault-card__meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--ink-soft);
  margin: 8px 0 12px;
}
.vault-card__pct {
  font-weight: 800;
  color: var(--accent-deep);
}

.vault-track {
  position: relative;
  height: 10px;
  background: var(--stone-deep);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: inset 0 2px 4px rgba(255, 107, 157, 0.12);
}
.vault-track__fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--rose-deep) 0%, var(--rose) 50%, var(--peach) 100%);
  box-shadow: 0 0 12px rgba(255, 107, 157, 0.45);
  z-index: 2;
}
.vault-track__glow {
  position: absolute;
  left: 0; top: 0;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5));
  z-index: 3;
}

.vault-stats {
  display: flex;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.vault-stat { flex: 1; text-align: center; }
.vault-stat__num {
  display: block;
  font-size: 20px;
  font-weight: 800;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.vault-stat__lbl {
  display: block;
  font-size: 10px;
  color: var(--ink-muted);
  margin-top: 2px;
  letter-spacing: 0.5px;
}
.vault-stat__sep {
  width: 1px;
  height: 28px;
  background: var(--line-strong);
}

/* ==================== 可滚动内容井 ==================== */
.scroll-well {
  flex: 1;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  background: linear-gradient(180deg, var(--stone-deep) 0%, var(--stone) 80px, var(--stone) 100%);
  box-shadow: inset 0 10px 20px rgba(255, 107, 157, 0.08);
  border-radius: 20px 20px 0 0;
  margin-top: -6px;
  position: relative;
  z-index: 10;
}

.scroll-well__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 20px 8px;
}
.scroll-well__notch {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 107, 157, 0.22);
  margin-bottom: 10px;
  box-shadow: inset 0 1px 2px rgba(255, 140, 180, 0.15);
}
.scroll-well__title {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--ink-muted);
}

.scroll-bottom-spacer { height: 36px; }

/* 快捷入口 — 浮雕按钮 */
.dock {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  padding: 8px 18px 20px;
}

.dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.dock-item:active .dock-icon { transform: translateY(2px); box-shadow: var(--inset); }
.dock-item--press .dock-icon { transform: translateY(2px); box-shadow: var(--inset); opacity: 0.92; }

.dock-icon {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  box-shadow:
    0 4px 0 var(--stone-deep),
    0 6px 16px rgba(255, 140, 180, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.85);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.dock-icon--rose { background: linear-gradient(145deg, #fff, #ffe8f0); }
.dock-icon--gold { background: linear-gradient(145deg, #fff, #f0e8ff); }
.dock-icon--lavender { background: linear-gradient(145deg, #fff, #f0e8ff); }
.dock-icon--sky { background: linear-gradient(145deg, #fff, #e8f6fc); }

.dock-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--ink-soft);
}

/* 签到 */
.checkin {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 0 18px 20px;
  padding: 16px 18px;
  background: linear-gradient(168deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.85) 100%);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: var(--radius);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--elev-2), inset 0 1px 0 rgba(255, 255, 255, 0.9);
}
.checkin--done { background: linear-gradient(145deg, #fff, #fff5f8); }

.checkin-icon {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: var(--stone);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2px 4px rgba(255, 107, 157, 0.06), 0 2px 6px rgba(255, 140, 180, 0.08);
}
.checkin-icon--done {
  background: linear-gradient(145deg, var(--rose-pale), #ffdce8);
  box-shadow: 0 2px 8px rgba(255, 107, 157, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.checkin-copy { flex: 1; }
.checkin-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
}
.checkin-sub {
  display: block;
  font-size: 11px;
  color: var(--ink-muted);
  margin-top: 3px;
}

.checkin-cta {
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(180deg, var(--rose-light) 0%, var(--rose) 100%);
  box-shadow: 0 3px 0 var(--rose-deep), 0 6px 16px rgba(255, 107, 157, 0.35);
}
.checkin-cta--done {
  background: var(--stone);
  color: var(--ink-muted);
  box-shadow: inset 0 2px 4px rgba(255, 107, 157, 0.06);
}

/* 区块 */
.block {
  padding: 0 18px;
  margin-bottom: 24px;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.sec-head-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
.sec-accent {
  width: 3px;
  height: 16px;
  border-radius: 2px;
  background: linear-gradient(180deg, var(--rose), var(--peach));
  box-shadow: 0 0 8px rgba(255, 107, 157, 0.35);
}
.sec-accent--warm { background: linear-gradient(180deg, var(--peach), #ffc9b8); }
.sec-accent--mint { background: linear-gradient(180deg, var(--mint), #a8e8d0); }
.sec-accent--peach { background: linear-gradient(180deg, var(--lilac), #ddb8f8); }

.sec-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}
.sec-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--accent-deep);
}
.sec-link-hit {
  padding: 8px 6px;
  margin: -8px -6px;
}
.sec-link::after { content: ' ›'; opacity: 0.6; }

/* 计划卡 */
.plan-premium {
  background: linear-gradient(168deg, rgba(255,255,255,0.92) 0%, rgba(255,250,251,0.88) 55%, rgba(255,245,248,0.85) 100%);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: var(--radius);
  padding: 20px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--elev-2), inset 0 1px 0 rgba(255, 255, 255, 1);
}

.plan-premium-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}
.plan-premium-name {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6px;
}
.plan-premium-status {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(126, 212, 184, 0.18);
  color: #4db896;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
}
.plan-premium-status.is-done {
  background: var(--gold-pale);
  color: var(--accent-deep);
}
.plan-premium-pct {
  font-size: 28px;
  font-weight: 800;
  color: var(--accent-deep);
  letter-spacing: -1px;
}

.plan-premium-amounts {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 12px;
}
.plan-premium-cur { font-size: 22px; font-weight: 800; color: var(--ink); }
.plan-premium-sep { color: var(--ink-muted); }
.plan-premium-tar { font-size: 14px; color: var(--ink-muted); }

.plan-premium-track {
  height: 10px;
  background: var(--stone-deep);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 14px;
  box-shadow: inset 0 2px 4px rgba(255, 107, 157, 0.1);
}
.plan-premium-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--rose-deep), var(--rose-light));
  box-shadow: 0 0 10px rgba(255, 107, 157, 0.35);
}

.plan-premium-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.plan-premium-date { font-size: 11px; color: var(--ink-muted); }
.plan-premium-btn {
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  box-shadow: 0 3px 0 var(--rose-deep), 0 4px 12px rgba(255, 107, 157, 0.3);
}

.plan-empty {
  text-align: center;
  padding: 32px 20px;
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px dashed var(--line-strong);
  box-shadow: var(--inset);
}
.plan-empty-icon {
  width: 64px; height: 64px;
  margin: 0 auto 12px;
  border-radius: 20px;
  background: var(--stone);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2px 6px rgba(255, 107, 157, 0.06);
}
.plan-empty-title { display: block; font-size: 15px; font-weight: 700; color: var(--ink); }
.plan-empty-hint { display: block; font-size: 12px; color: var(--ink-muted); margin-top: 4px; }

/* 纪念日 */
.anni-premium {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  background: linear-gradient(168deg, rgba(255,255,255,0.9) 0%, rgba(255,250,251,0.85) 100%);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: var(--radius);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--elev-2), inset 0 1px 0 rgba(255, 255, 255, 1);
}
.anni-premium--today {
  border-color: rgba(255, 107, 157, 0.35);
  box-shadow: var(--elev-2), 0 0 0 1px rgba(255, 140, 180, 0.2), inset 0 1px 0 rgba(255, 255, 255, 1);
}

.anni-premium-badge {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--accent-deep);
  background: var(--gold-pale);
  padding: 4px 8px;
  border-radius: 6px;
  flex-shrink: 0;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.anni-premium-icon {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: linear-gradient(145deg, var(--rose-pale), #ffdce8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(255, 107, 157, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.anni-premium-main { flex: 1; min-width: 0; }
.anni-premium-name { display: block; font-size: 15px; font-weight: 700; color: var(--ink); }
.anni-premium-date { display: block; font-size: 11px; color: var(--ink-muted); margin-top: 3px; }

.anni-premium-count { text-align: right; }
.anni-premium-num {
  font-size: 32px;
  font-weight: 800;
  color: var(--accent-deep);
  letter-spacing: -1px;
  line-height: 1;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
}
.anni-premium-unit { font-size: 11px; color: var(--ink-muted); }

/* 任务 */
.task-card {
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px solid rgba(255, 255, 255, 0.9);
  padding: 4px 16px;
  box-shadow: var(--elev-1), inset 0 1px 0 rgba(255, 255, 255, 1);
}

.ct-item {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px 0;
  border-top: 1px solid var(--line);
}
.ct-item:first-child { border-top: none; }
.ct-body { display: flex; gap: 10px; align-items: flex-start; }
.ct-icon { font-size: 18px; flex-shrink: 0; }
.ct-info { flex: 1; }
.ct-name { font-size: 14px; font-weight: 700; color: var(--ink); display: block; }
.ct-desc { font-size: 12px; color: var(--ink-muted); display: block; margin-top: 3px; line-height: 1.5; }
.ct-actions { display: flex; gap: 8px; margin-left: 28px; }
.ct-btn {
  font-size: 12px; padding: 6px 16px; border: none;
  border-radius: 999px; line-height: 1.6; min-height: 0; font-weight: 600;
}
.ct-btn::after { border: none; }
.ct-btn-forgive, .ct-btn-complete {
  color: #fff;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  box-shadow: 0 2px 0 var(--rose-deep);
}
.ct-btn-reject, .ct-btn-decline { background: var(--stone); color: var(--ink-soft); box-shadow: inset 0 1px 3px rgba(255, 107, 157, 0.06); }
.ct-btn-retry { background: #fff3cd; color: #7a6520; }
.ct-btn-confirm { background: var(--mint); color: #fff; }
.ct-btn-dispute { background: rgba(200, 80, 80, 0.1); color: #c44; }
.ct-done-badge { font-size: 13px; font-weight: 600; color: var(--accent-deep); margin-left: 28px; }
.ct-waiting-text, .ct-status-text { font-size: 12px; color: var(--ink-muted); margin-left: 28px; }
.ct-forgive-completed {
  margin-left: 28px; padding: 10px 16px; border-radius: 12px;
  font-size: 13px; font-weight: 600; color: var(--accent-deep);
  background: var(--rose-pale); border: 1px solid rgba(255, 107, 157, 0.2);
}
.ct-item--forgive, .ct-item--please-forgive {
  background: linear-gradient(145deg, #fffafb, #fff5f8);
  border-radius: 12px; padding: 14px; margin: 0 -4px;
  border: 1px solid rgba(255, 140, 180, 0.25);
  box-shadow: var(--elev-1);
}
.ct-btn--please { background: linear-gradient(180deg, var(--rose-light), var(--rose)) !important; color: #fff !important; }
.ct-forgive-completed--please { color: var(--rose-deep); background: var(--rose-pale); }
.ct-done-badge--please { color: var(--rose-deep); }
.ct-status-text--please { color: var(--rose-deep); }

/* 宠物舞台 */
.pet-stage {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  background: linear-gradient(168deg, rgba(255,255,255,0.92) 0%, rgba(255,250,251,0.88) 55%, rgba(255,245,248,0.85) 100%);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.75);
  box-shadow: var(--elev-2), inset 0 1px 0 rgba(255, 255, 255, 1);
}
.pet-stage::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255,255,255,0.35) 35%,
    rgba(255,255,255,0.5) 37%,
    rgba(255,255,255,0.2) 40%,
    transparent 45%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 5;
  animation: glassShine 6s ease-in-out infinite;
}
@keyframes glassShine {
  0%, 100% { transform: translateX(-30%) translateY(-20%) rotate(45deg); opacity: 0.6; }
  50% { transform: translateX(30%) translateY(20%) rotate(45deg); opacity: 1; }
}

.pet-stage-glow {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 220px; height: 180px;
  background: radial-gradient(ellipse, rgba(255, 140, 180, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.pet-stage-inner {
  position: relative;
  padding: 28px 20px 22px;
  text-align: center;
}

.pet-stage-avatar {
  width: 104px;
  height: 104px;
  margin: 0 auto 14px;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff, var(--stone));
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow:
    0 8px 24px rgba(255, 140, 180, 0.2),
    0 2px 0 var(--stone-deep),
    inset 0 2px 8px rgba(255, 255, 255, 0.9);
  border: 2px solid rgba(255, 140, 180, 0.35);
}

.pet-stage-img { width: 88px; height: 88px; border-radius: 50%; }
.pet-stage-emoji { font-size: 56px; line-height: 1; }

.pet-stage-name {
  display: block;
  font-size: 18px;
  font-weight: 800;
  color: var(--ink);
}
.pet-stage-tags {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 6px;
}
.pet-tag {
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  background: var(--stone);
  color: var(--ink-soft);
  box-shadow: inset 0 1px 2px rgba(255, 107, 157, 0.05);
}
.pet-tag--rarity {
  background: linear-gradient(145deg, var(--lilac-pale), #e8d8ff);
  color: #9b6fd4;
}

.pet-stage-intimacy {
  max-width: 240px;
  margin: 16px auto 20px;
}
.pet-intimacy-head {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--ink-muted);
  margin-bottom: 6px;
  font-weight: 600;
}
.pet-intimacy-track {
  height: 6px;
  background: var(--stone-deep);
  border-radius: 999px;
  overflow: hidden;
  box-shadow: inset 0 1px 3px rgba(255, 107, 157, 0.08);
}
.pet-intimacy-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--rose), var(--lilac));
}

.pet-dock {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin: 6px 0 8px;
}
.pet-dock-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 600;
  color: var(--ink-muted);
}
.pet-dock-btn:active .pet-dock-icon { transform: translateY(2px); box-shadow: var(--inset); }
.pet-dock-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 800;
  color: var(--accent-deep);
  box-shadow: 0 3px 0 var(--stone-deep), 0 4px 10px rgba(255, 140, 180, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.85);
  transition: transform 0.1s, box-shadow 0.1s;
}

.pet-empty-stage {
  text-align: center;
  padding: 40px 24px;
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px dashed var(--line-strong);
  box-shadow: var(--inset);
}
.pet-empty-stage--press { opacity: 0.88; transform: scale(0.99); }
.pet-empty-title { display: block; font-size: 15px; font-weight: 700; color: var(--ink); margin-top: 12px; }
.pet-empty-hint { display: block; font-size: 12px; color: var(--ink-muted); margin-top: 4px; }

/* 宠物动画 */
.feed-bowl-wrap {
  position: absolute; top: -8px; right: -8px;
  width: 40px; height: 40px; z-index: 10;
  overflow: hidden; pointer-events: none;
}
.feed-bowl { font-size: 24px; position: absolute; top: 0; left: 0; }
.feed-food-cover {
  position: absolute; bottom: 2px; left: 2px; right: 2px;
  background: var(--surface); z-index: 2;
  transition: height 0.1s linear;
}

.pet-stage-avatar.pet-fan-shake { animation: petFanShake 0.5s ease-out !important; }
@keyframes petFanShake {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-14deg) translateX(-3px); }
  40% { transform: rotate(12deg) translateX(3px); }
  60% { transform: rotate(-10deg) translateX(-2px); }
  80% { transform: rotate(8deg) translateX(2px); }
  100% { transform: rotate(0deg) translateX(0); }
}
.pet-stage-avatar.pet-walk-anim { animation: petAnimWalk 1s ease-in-out !important; }
@keyframes petAnimWalk {
  0% { transform: translateX(0) translateY(0); }
  20% { transform: translateX(-14px) translateY(-6px); }
  40% { transform: translateX(0) translateY(0); }
  60% { transform: translateX(14px) translateY(-6px); }
  80% { transform: translateX(0) translateY(0); }
  100% { transform: translateX(0) translateY(0); }
}
.pet-stage-avatar.pet-wild-move { animation: petWildMove 0.7s ease-in-out !important; }
@keyframes petWildMove {
  0% { transform: translate(0, 0) rotate(0deg); }
  12% { transform: translate(-12px, -8px) rotate(-8deg); }
  25% { transform: translate(10px, -12px) rotate(6deg); }
  37% { transform: translate(-8px, 10px) rotate(-10deg); }
  50% { transform: translate(14px, 6px) rotate(8deg); }
  62% { transform: translate(-10px, -10px) rotate(-6deg); }
  75% { transform: translate(8px, 12px) rotate(10deg); }
  87% { transform: translate(-14px, 4px) rotate(-12deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}
.pet-stage-avatar.pet-talk-anim { animation: petAnimTalk 0.6s ease-in-out !important; }
@keyframes petAnimTalk {
  0% { transform: translateX(0) rotate(0deg); }
  25% { transform: translateX(6px) rotate(4deg); }
  50% { transform: translateX(-6px) rotate(-4deg); }
  75% { transform: translateX(4px) rotate(2deg); }
  100% { transform: translateX(0) rotate(0deg); }
}
.pet-stage-avatar.pet-violent-shake { animation: petViolentShake 0.6s ease-in-out !important; }
@keyframes petViolentShake {
  0%, 100% { transform: translateX(0) translateY(0) rotate(0deg); }
  10% { transform: translateX(-8px) translateY(-4px) rotate(-8deg); }
  20% { transform: translateX(10px) translateY(3px) rotate(8deg); }
  30% { transform: translateX(-6px) translateY(-10px) rotate(-6deg); }
  40% { transform: translateX(8px) translateY(5px) rotate(7deg); }
  50% { transform: translateX(-12px) translateY(-3px) rotate(-10deg); }
  60% { transform: translateX(10px) translateY(8px) rotate(9deg); }
  70% { transform: translateX(-5px) translateY(-8px) rotate(-5deg); }
  80% { transform: translateX(12px) translateY(3px) rotate(7deg); }
  90% { transform: translateX(-8px) translateY(-5px) rotate(-6deg); }
}
.pet-action-emoji {
  position: absolute; top: -8px; left: 50%;
  transform: translateX(-50%);
  font-size: 26px; z-index: 20; pointer-events: none;
}
.emoji-float-up { animation: emojiFloatUp 1.2s ease-out forwards; }
@keyframes emojiFloatUp {
  100% { opacity: 0; transform: translateX(-50%) translateY(-50px); }
}
.pet-bounce .pet-stage-emoji, .pet-bounce .pet-stage-img { animation: petBounce 2s ease-in-out infinite; }
.pet-walk-slow .pet-stage-avatar { animation: petWalk 4s ease-in-out infinite; }
.pet-walk .pet-stage-avatar { animation: petWalk 2.5s ease-in-out infinite; }
.pet-excited .pet-stage-avatar { animation: petJump 0.8s ease-in-out infinite; }
.pet-magic .pet-stage-avatar { animation: petMagic 1.5s ease-in-out infinite; }
@keyframes petBounce { 50% { transform: translateY(-5px); } }
@keyframes petWalk { 50% { transform: translateX(10px); } }
@keyframes petJump { 50% { transform: translateY(-10px); } }
@keyframes petMagic { 50% { transform: rotate(6deg); } }
.evolution-glow { box-shadow: 0 0 32px rgba(255, 140, 180, 0.55) !important; }
.evolution-flash { animation: evoFlash 0.6s ease-in-out infinite !important; }
@keyframes evoFlash { 50% { opacity: 0.8; filter: brightness(1.15); } }

/* 弹窗 */
.modal-overlay, .levelup-overlay {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(58, 46, 53, 0.45);
  backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
}
.levelup-overlay { z-index: 2000; }

.pet-modal {
  width: 300px;
  background: var(--surface);
  border-radius: 28px;
  padding: 8px 24px 28px;
  text-align: center;
  box-shadow: var(--elev-3);
  border: 1px solid rgba(255, 255, 255, 0.9);
}
.pet-modal-handle {
  width: 36px; height: 4px;
  background: var(--stone-deep);
  border-radius: 2px;
  margin: 10px auto 16px;
}
.pet-modal-img { width: 88px; height: 88px; display: block; margin: 0 auto; }
.pet-modal-emoji { font-size: 64px; line-height: 1; }
.pet-modal-name {
  font-size: 20px; font-weight: 800; color: var(--ink);
  display: block; margin-bottom: 16px;
}
.pet-modal-stat {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 10px; font-size: 11px;
}
.pet-modal-stat-label { width: 56px; text-align: left; color: var(--ink-muted); font-weight: 600; }
.pet-modal-bar {
  flex: 1; height: 6px; background: var(--stone-deep);
  border-radius: 999px; overflow: hidden;
  box-shadow: inset 0 1px 3px rgba(255, 107, 157, 0.08);
}
.pet-modal-fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, var(--rose-deep), var(--rose));
}
.pet-modal-stat-val { width: 48px; text-align: right; font-weight: 700; color: var(--accent-deep); }
.pet-modal-evo { display: block; font-size: 12px; font-weight: 700; color: var(--lilac); margin: 8px 0; }
.pet-modal-desc { display: block; font-size: 12px; color: var(--ink-muted); line-height: 1.6; margin: 12px 0 16px; }
.pet-modal-btn {
  width: 100%; height: 44px; line-height: 44px;
  border: none; border-radius: 999px;
  font-size: 14px; font-weight: 700;
  color: #fff;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  box-shadow: 0 3px 0 var(--rose-deep);
}
.pet-modal-btn::after { border: none; }
.pet-modal-close { display: block; margin-top: 14px; font-size: 12px; color: var(--ink-muted); }

.levelup-modal {
  width: 260px; padding: 40px 32px;
  text-align: center; position: relative;
  background: var(--surface);
  border-radius: 28px;
  box-shadow: var(--elev-3);
  border: 1px solid rgba(255, 255, 255, 0.9);
  animation: levelUpPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes levelUpPop {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.levelup-ring {
  position: absolute; inset: -20px;
  border: 2px solid rgba(255, 140, 180, 0.35);
  border-radius: 50%;
  animation: ringPulse 1.5s ease-out infinite;
}
@keyframes ringPulse {
  100% { transform: scale(1.15); opacity: 0; }
}
.levelup-kicker {
  display: block; font-size: 11px; font-weight: 800;
  letter-spacing: 3px; color: var(--accent-deep);
}
.levelup-lv {
  display: block; font-size: 52px; font-weight: 900;
  color: var(--ink); letter-spacing: -2px; margin: 8px 0;
}
.levelup-sub { display: block; font-size: 13px; color: var(--ink-muted); }

.adventure-modal {
  width: 300px; padding: 32px 24px 24px;
  text-align: center; border-radius: 28px;
  background: linear-gradient(180deg, var(--surface), #fff5f8);
  box-shadow: var(--elev-3);
  border: 1px solid rgba(255, 255, 255, 0.9);
}
.adventure-emoji { font-size: 48px; display: block; margin-bottom: 8px; }
.adventure-title { display: block; font-size: 17px; font-weight: 800; color: var(--ink); }
.adventure-desc { display: block; font-size: 12px; color: var(--ink-muted); margin-top: 4px; }
.adventure-rewards { display: flex; justify-content: center; gap: 12px; margin: 20px 0; }
.adventure-reward {
  flex: 1; padding: 12px 8px;
  background: var(--rose-pale);
  border-radius: 14px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}
.ar-num { display: block; font-size: 20px; font-weight: 800; color: var(--accent-deep); }
.ar-label { display: block; font-size: 10px; color: var(--ink-muted); margin-top: 2px; }
.adventure-week {
  font-size: 11px; color: var(--ink-muted);
  padding: 8px 12px; background: var(--stone);
  border-radius: 10px; margin-bottom: 8px;
}
.adventure-tap { font-size: 11px; color: var(--ink-muted); }

/* 今日互动标识 */
.pet-today-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(212,175,55,.15);
  border: 1px solid rgba(212,175,55,.25);
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 10px;
  color: #D4AF37;
  margin-top: 4px;
}
.pet-dock-check {
  position: absolute;
  top: -4px; right: -4px;
  width: 16px; height: 16px;
  border-radius: 50%;
  background: #4CAF50;
  color: #fff;
  font-size: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 16px;
}

/* 签到动画 */
.checkin-bounce {
  animation: checkinBounce .5s ease;
}
@keyframes checkinBounce {
  0%{transform:scale(1)}
  30%{transform:scale(1.05)}
  50%{transform:scale(.95)}
  70%{transform:scale(1.02)}
  100%{transform:scale(1)}
}
.checkin-done-pop {
  animation: donePop .6s ease;
}
@keyframes donePop {
  0%{transform:scale(1)}
  20%{transform:scale(1.1)}
  40%{transform:scale(.9)}
  60%{transform:scale(1.05)}
  100%{transform:scale(1)}
}

/* 游客模式遮罩 */
.guest-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.guest-card {
  background: #fff;
  border-radius: 24px;
  padding: 36px 28px 28px;
  text-align: center;
  max-width: 300px;
  width: 100%;
  box-shadow: 0 16px 48px rgba(0,0,0,0.2);
}
.guest-card-icon { font-size: 44px; margin-bottom: 12px; }
.guest-card-title { font-size: 17px; font-weight: 700; color: var(--ink); display: block; margin-bottom: 6px; }
.guest-card-desc { font-size: 13px; color: var(--ink-soft); display: block; margin-bottom: 24px; }
.guest-card-btn {
  border: none; border-radius: 22px; padding: 12px 0;
  background: linear-gradient(180deg, var(--rose-light), var(--rose));
  color: #fff; font-size: 15px; font-weight: 600; width: 100%; line-height: 1.4;
}
.guest-card-btn::after { border: none; }
