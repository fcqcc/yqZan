/* pages/home/home.wxss — 可爱手绘风（对齐原型） */

page {
  --primary: #F9A85C;
  --primary-dark: #E8924C;
  --primary-light: #FDE8C8;
  --primary-pale: #FFF8E6;
  --accent: #FFD93D;
  --success: #7BC67B;
  --text: #7A5C4A;
  --text-secondary: #A89080;
  --text-light: #C8B8A8;
  --border: #F5D6B0;
  --line-dot: #f0e0e4;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8E6 100%);
}

.page {
  height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8E6 100%);
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.home-bottom-spacer {
  height: 32px;
}

/* ===== 头部 ===== */
.home-header {
  position: relative;
  padding: 0 16px 24px;
  color: #fff;
  border-radius: 0 0 30px 15px;
  overflow: hidden;
}

/* 背景装饰图 - 容器absolute，image无position */
.home-header__bg-wrap {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}
.home-header__bg {
  width: 100%;
  height: 100%;
  display: block;
}

.home-header__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(135deg, rgba(232,145,164,0.4) 0%, rgba(250,220,230,0.5) 100%);
  pointer-events: none;
}

/* 内容浮在背景之上 */
.home-header .page-nav,
.home-header .couple-info,
.home-header .home-badges,
.home-header .stats-row { position: relative; z-index: 2; }

.couple-info {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  color: var(--primary);
  border: 3px solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.couple-name {
  display: block;
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 3px;
}

.couple-days {
  display: block;
  font-size: 12px;
  opacity: 0.9;
}

.couple-days--bind {
  text-decoration: underline;
}

.home-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 4px 10px;
  border-radius: 12px 4px 12px 4px;
  font-size: 11px;
}

.badge--active {
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  transform: rotate(-1deg);
}

.stats-row {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14px 6px 14px 6px;
  padding: 12px 8px;
  text-align: center;
}

.stat-card__value {
  display: block;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 2px;
}

.stat-card__label {
  display: block;
  font-size: 10px;
  opacity: 0.9;
}

/* ===== 快捷入口 ===== */
/* ===== 焦点栏 ===== */
.focus-bar {
  padding: 8px 12px 20px;
  margin-top: -24px;
}
.focus-bar__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.focus-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: rgba(255, 251, 249, 0.85);
  border-radius: 16px 6px 16px 6px;
  padding: 12px 4px 10px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.6), 0 1px 3px rgba(249, 168, 92, 0.1), 0 4px 12px rgba(249, 168, 92, 0.06), 4px 4px 0 rgba(249, 168, 92, 0.2);
  border: 2px dashed var(--primary-light);
}
.focus-bar__item--press {
  transform: translate(2px, 2px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.6), 0 1px 2px rgba(249, 168, 92, 0.08), 0 2px 6px rgba(249, 168, 92, 0.04), 2px 2px 0 rgba(249, 168, 92, 0.2);
}
.focus-bar__icon {
  width: 38px;
  height: 38px;
  border-radius: 12px 4px 12px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.focus-bar__emoji {
  font-size: 20px;
}
.focus-bar__icon--rose { background: #FFF8E6; }
.focus-bar__icon--lavender { background: #F5EEFF; }
.focus-bar__icon--gold { background: #FFF8E1; }
.focus-bar__icon--coral { background: #FFEEE8; }
.focus-bar__icon--sky { background: #EEF7FF; }
.focus-bar__icon--green { background: #EEF9EE; }
.focus-bar__label {
  font-size: 11px;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ===== 签到 ===== */
.checkin-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 12px 14px;
  margin: 0 14px 12px;
  border-radius: 14px 6px 14px 6px;
  border: 2px dashed var(--border);
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.12);
}

.checkin-mini-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.checkin-mini-icon {
  width: 32px;
  height: 32px;
  color: var(--success);
}

.checkin-mini-text {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
}

.checkin-mini-sub {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.checkin-mini-btn {
  background: var(--success);
  color: #fff;
  padding: 6px 18px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  font-weight: 600;
}

.checkin-mini-btn--done {
  background: var(--primary-pale);
  color: var(--primary);
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px 10px;
}

.section-header--compact {
  padding: 0 14px 10px;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 12px;
  color: var(--text-light);
}

/* ===== 计划卡片 ===== */
.plan-card {
  background: #fff;
  border-radius: 16px 6px 16px 6px;
  padding: 16px;
  margin: 16px 14px 24px;
  box-shadow: 3px 3px 0 rgba(61, 0, 13, 0.12);
  border: 2px dashed var(--border);
}
.plan-card__tag {
  display: inline-block;
  font-size: 10px;
  color: #fff;
  background: linear-gradient(135deg, #F9A85C, #E8924C);
  border-radius: 8px 2px 8px 2px;
  padding: 2px 8px;
  margin-bottom: 8px;
}

.plan-card--empty {
  text-align: center;
  padding: 32px 20px;
  color: var(--text-light);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.plan-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.plan-tag {
  background: var(--primary-pale);
  color: var(--primary-dark);
  padding: 3px 10px;
  border-radius: 10px 4px 10px 4px;
  font-size: 11px;
}

.plan-progress {
  margin: 10px 0;
}

.progress-bar {
  height: 10px;
  background: #f5f0f2;
  border-radius: 5px;
  overflow: hidden;
  border: 2px solid #E8E0D8;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 5px;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-secondary);
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 2px dotted var(--line-dot);
}

.plan-date {
  font-size: 11px;
  color: var(--text-light);
}

.plan-action-btn {
  background: var(--primary);
  color: #fff;
  padding: 6px 16px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  box-shadow: 2px 2px 0 rgba(232, 146, 76, 0.3);
}

.plan-empty-title {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-top: 12px;
}

.plan-empty-hint {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  margin-top: 4px;
}

/* ===== 纪念日 ===== */
.anniversary-section--today {
  padding: 0 10px;
  margin-bottom: 24px;
  animation: todayGlow 2s ease-in-out infinite;
}
@keyframes todayGlow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 107, 107, 0.15); }
  50% { box-shadow: 0 0 0 8px rgba(255, 107, 107, 0.05); }
}
.anniversary-section--today .anniversary-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 50%, #FFD93D 100%) !important;
  border: 2px solid #FF4757 !important;
  box-shadow: 0 4px 24px rgba(255, 71, 87, 0.3), 4px 4px 0 rgba(255, 71, 87, 0.3) !important;
}
.anniversary-section--today .anniversary-icon {
  background: linear-gradient(135deg, #fff, #FFE8CC) !important;
  box-shadow: 3px 3px 0 rgba(255, 255, 255, 0.4) !important;
}
.anniversary-section--today .anniversary-icon cp-icon {
  color: #FF6B6B !important;
}
.anniversary-name--today {
  font-size: 17px;
  color: #fff;
  text-shadow: 0 1px 4px rgba(0,0,0,0.15);
}
.anniversary-date--today {
  font-size: 12px;
  color: #FFE8CC;
  font-weight: 700;
}
.anniversary-days--today {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  background: rgba(255,255,255,0.25);
  border-radius: 12px 4px 12px 4px;
  padding: 6px 12px;
}
.anniversary-days__today-icon {
  font-size: 28px;
  display: block;
}
.anniversary-days__today-label {
  font-size: 11px;
  color: #fff;
  font-weight: 700;
}

.anniversary-card {
  background: linear-gradient(135deg, #FFF5FB, #FFE8F2);
  border-radius: 16px 8px 16px 8px;
  padding: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 2px dashed var(--border);
}

.anniversary-icon {
  width: 46px;
  height: 46px;
  background: var(--primary);
  border-radius: 12px 4px 12px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.2);
  flex-shrink: 0;
}

.anniversary-info {
  flex: 1;
  min-width: 0;
}

.anniversary-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 3px;
}

.anniversary-date {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
}

.anniversary-days {
  text-align: right;
}

.anniversary-days__num {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary-dark);
}

.anniversary-days__pre {
  font-size: 11px;
  color: var(--text-secondary);
  margin-right: 2px;
}

.anniversary-days__unit {
  font-size: 11px;
  color: var(--text-secondary);
  margin-left: 2px;
}

/* ===== 浮动宠物 ===== */
.pet-float {
  position: fixed;
  z-index: 100;
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left 4s ease-in-out, top 4s ease-in-out;
}
.pet-float__img {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  box-shadow: 0 6px 20px rgba(232,145,164,0.35);
  pointer-events: none;
}
.pet-float__emoji {
  font-size: 72px;
  line-height: 1;
  filter: drop-shadow(0 4px 8px rgba(232,145,164,0.35));
}

.pet-talk-bubble {
  position: absolute;
  bottom: 110%;
  left: 50%;
  transform: translateX(-50%);
  color: #5D3E2A;
  font-size: 12px;
  line-height: 1.5;
  padding: 8px 14px;
  border-radius: 16px 16px 16px 4px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  max-width: 300px;
  min-width: 60px;
  white-space: normal;
  word-break: break-all;
  word-wrap: break-word;
  text-align: left;
  z-index: 50;
  animation: popIn 0.3s ease-out;
  pointer-events: none;
  display: inline-block;
  background: rgba(255,255,255,0.85);
}
.pet-talk-bubble::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  border: 8px solid transparent;
  border-top-color: rgba(255,255,255,0.95);
}
@keyframes popIn {
  0% { transform: translateX(-50%) scale(0.6); opacity: 0; }
  70% { transform: translateX(-50%) scale(1.05); }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}
.pet-float-shake {
  animation: petShake 0.5s ease-in-out;
}
@keyframes petShake {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-12deg) scale(1.1); }
  30% { transform: rotate(10deg) scale(1.05); }
  45% { transform: rotate(-8deg) scale(1.1); }
  60% { transform: rotate(6deg) scale(1.05); }
  80% { transform: rotate(-3deg) scale(1); }
  100% { transform: rotate(0deg) scale(1); }
}

/* ===== 卡片任务 ===== */
.block--tasks {
  padding: 0 14px 20px;
}

.task-card {
  background: #fff;
  border-radius: 16px 8px 16px 8px;
  border: 2px dashed var(--border);
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.12);
  overflow: hidden;
}

.ct-item {
  padding: 12px 14px;
  border-top: 2px dotted var(--line-dot);
}

.ct-item:first-child {
  border-top: none;
}

.ct-body {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.ct-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.ct-info {
  flex: 1;
}

.ct-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  display: block;
}

.ct-desc {
  font-size: 12px;
  color: var(--text-light);
  display: block;
  margin-top: 3px;
  line-height: 1.5;
}

.ct-actions {
  display: flex;
  gap: 8px;
  margin-left: 28px;
  margin-top: 8px;
}

.ct-btn {
  font-size: 12px;
  padding: 4px 12px;
  border-radius: 14px 4px 14px 4px;
  border: none;
  line-height: 1.4;
}

.ct-btn::after {
  border: none;
}

.ct-btn-forgive,
.ct-btn-complete {
  background: var(--primary);
  color: #fff;
}

.ct-btn-reject,
.ct-btn-decline {
  background: #FFF8E6;
  color: var(--text-secondary);
  border: 1px dashed var(--border);
}

.ct-btn-retry {
  background: #fff8e1;
  color: #7a6520;
}

.ct-btn-confirm {
  background: var(--success);
  color: #fff;
}

.ct-btn-dispute {
  background: rgba(200, 80, 80, 0.1);
  color: #c44;
}

.ct-done-badge,
.ct-waiting-text,
.ct-status-text {
  font-size: 12px;
  color: var(--text-light);
  margin-left: 28px;
  margin-top: 8px;
  display: block;
}

.ct-forgive-completed {
  font-size: 12px;
  color: var(--primary-dark);
  background: var(--primary-pale);
  padding: 8px 12px;
  border-radius: 10px 4px 10px 4px;
  margin: 8px 0 0 28px;
}

/* ===== 弹窗 ===== */
.modal-overlay,
.levelup-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(249, 168, 92, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.levelup-overlay {
  z-index: 2000;
}

.pet-modal {
  width: 300px;
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  padding: 8px 24px 28px;
  text-align: center;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.2);
}

.pet-modal-handle {
  width: 36px;
  height: 4px;
  background: var(--primary-light);
  border-radius: 2px;
  margin: 10px auto 16px;
}

.pet-modal-img {
  width: 88px;
  height: 88px;
  display: block;
  margin: 0 auto;
}

.pet-modal-emoji {
  font-size: 64px;
  line-height: 1;
}

.pet-modal-name {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  display: block;
  margin-bottom: 16px;
}

.pet-modal-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  font-size: 11px;
}

.pet-modal-stat-label {
  width: 56px;
  text-align: left;
  color: var(--text-secondary);
  font-weight: 600;
}

.pet-modal-bar {
  flex: 1;
  height: 8px;
  background: #E8E0D8;
  border-radius: 999px;
  overflow: hidden;
  border: 2px solid #E8E0D8;
}

.pet-modal-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-dark), var(--primary));
  border-radius: 999px;
}

.pet-modal-stat-val {
  width: 48px;
  text-align: right;
  font-weight: 700;
  color: var(--primary-dark);
}

.pet-modal-evo {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #C9A0E8;
  margin: 8px 0;
}

.pet-modal-desc {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  line-height: 1.6;
  margin: 12px 0 16px;
}

.pet-modal-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border: none;
  border-radius: 25px 10px 25px 10px;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.3);
}

.pet-modal-btn::after {
  border: none;
}

.pet-modal-close {
  display: block;
  margin-top: 14px;
  font-size: 12px;
  color: var(--text-light);
}

.levelup-modal {
  width: 280px;
  padding: 36px 32px;
  text-align: center;
  position: relative;
  border-radius: 28px 12px 28px 12px;
  overflow: hidden;
  box-shadow: 0 12px 40px rgba(232,145,164,0.4);
  animation: levelupPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes levelupPop {
  0% { transform: scale(0) rotate(-15deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.levelup-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
}
.levelup-overlay-bg {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.2);
  z-index: 1; pointer-events: none;
}
.levelup-content {
  position: relative; z-index: 2;
}

.levelup-star {
  position: absolute;
  animation: starFloat 2s ease-in-out infinite;
  font-size: 24px;
}
.levelup-star--1 { top: -20px; left: -10px; animation-delay: 0s; }
.levelup-star--2 { top: -15px; right: -5px; animation-delay: 0.5s; }
.levelup-star--3 { bottom: -20px; left: 50%; transform: translateX(-50%); animation-delay: 1s; }
@keyframes starFloat {
  0%, 100% { transform: translateY(0); opacity: 0.7; }
  50% { transform: translateY(-8px); opacity: 1; }
}
.levelup-star--3 {
  animation: starFloat2 2.5s ease-in-out infinite;
}
@keyframes starFloat2 {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.7; }
  50% { transform: translateX(-50%) translateY(-8px); opacity: 1; }
}

.levelup-kicker {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  margin-bottom: 4px;
}

.levelup-lv {
  display: block;
  font-size: 60px;
  font-weight: 700;
  font-family: 'ZCOOL KuaiLe', cursive;
  color: #FFD93D;
  text-shadow: 0 3px 8px rgba(0,0,0,0.5);
  line-height: 1;
  margin: 6px 0;
}

.levelup-sub {
  display: block;
  font-size: 13px;
  color: rgba(255,255,255,0.95);
  text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  margin-top: 4px;
}

.adventure-modal {
  width: 300px;
  padding: 32px 24px 24px;
  text-align: center;
  border-radius: 20px 8px 20px 8px;
  background: #fff;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(232, 146, 76, 0.2);
}

.adventure-emoji {
  font-size: 48px;
  display: block;
  margin-bottom: 8px;
}

.adventure-title {
  display: block;
  font-size: 17px;
  font-weight: 800;
  color: var(--text);
}

.adventure-desc {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  margin-top: 4px;
}

.adventure-rewards {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 20px 0;
}

.adventure-reward {
  flex: 1;
  padding: 12px 8px;
  background: var(--primary-pale);
  border-radius: 14px 6px 14px 6px;
  border: 1px dashed var(--border);
}

.ar-num {
  display: block;
  font-size: 20px;
  font-weight: 800;
  color: var(--primary-dark);
}

.ar-label {
  display: block;
  font-size: 10px;
  color: var(--text-light);
  margin-top: 2px;
}

.adventure-week {
  font-size: 11px;
  color: var(--text-light);
  padding: 8px 12px;
  background: #FFF8E6;
  border-radius: 10px 4px 10px 4px;
  margin-bottom: 8px;
}

.adventure-tap {
  font-size: 11px;
  color: var(--text-light);
}

/* 非遮挡式游客引导横幅 */
.guest-cta {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #F9A85C 0%, #E8924C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  box-shadow: 0 -3px 12px rgba(232, 146, 76, 0.25);
}
.guest-cta:active {
  opacity: 0.85;
}
.guest-cta-icon {
  font-size: 18px;
}
.guest-cta-text {
  font-size: 14px;
  color: #fff;
  font-weight: 600;
}
.guest-cta-arrow {
  font-size: 18px;
  color: #fff;
  font-weight: 700;
}

/* ===== 纪念日滚动条 ===== */
.anni-ticker {
  height: 44px;
  background: linear-gradient(90deg, #F9A85C, #F0A5B5);
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 0 14px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.anni-ticker__inner {
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
}
.anni-ticker__tag {
  font-size: 18px;
  margin-right: 10px;
  flex-shrink: 0;
}
.anni-ticker__track {
  display: flex;
  overflow: hidden;
  flex: 1;
}
.anni-ticker__text {
  font-size: 15px;
  color: #fff;
  white-space: nowrap;
  animation: anniScroll 10s linear infinite;
  padding-right: 40px;
}
@keyframes anniScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.anni-ticker__arrow {
  font-size: 18px;
  color: rgba(255,255,255,0.7);
  margin-left: 4px;
  flex-shrink: 0;
}
.anni-ticker--hover {
  opacity: 0.9;
}

/* ===== 紧凑日历入口 ===== */
.cal-mini {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  margin: 0 16px 8px;
  background: rgba(232,145,164,0.08);
  border-radius: 14px 6px 14px 6px;
  border: 1.5px dashed #F0C8D4;
}
.cal-mini__icon {
  font-size: 16px;
  margin-right: 6px;
}
.cal-mini__text {
  font-size: 13px;
  color: var(--primary-dark);
  flex: 1;
}
.cal-mini__arrow {
  font-size: 16px;
  color: var(--text-light);
}
.cal-mini--hover {
  background: rgba(232,145,164,0.15);
}

.checkin-bounce {
  animation: checkinBounce 0.5s ease;
}

@keyframes checkinBounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.05); }
  50% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

/* ===== 宠物动画（首页用） ===== */
/* 互动反馈emoji上浮 */
@keyframes emojiFloatUp {
  0% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-40px); }
}
.emoji-float-up {
  animation: emojiFloatUp 1.2s ease-out forwards;
}

/* 抚摸：扇形摆动 */
@keyframes petFanShake {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-12deg); }
  40% { transform: rotate(10deg); }
  60% { transform: rotate(-8deg); }
  80% { transform: rotate(5deg); }
  100% { transform: rotate(0deg); }
}
.pet-fan-shake {
  animation: petFanShake 0.6s ease !important;
}

/* 喂食：剧烈抖动 */
@keyframes petViolentShake {
  0% { transform: translateX(0); }
  10% { transform: translateX(-6px) rotate(-3deg); }
  20% { transform: translateX(6px) rotate(3deg); }
  30% { transform: translateX(-8px) rotate(-4deg); }
  40% { transform: translateX(8px) rotate(4deg); }
  50% { transform: translateX(-6px) rotate(-2deg); }
  60% { transform: translateX(6px) rotate(2deg); }
  70% { transform: translateX(-4px) rotate(-1deg); }
  80% { transform: translateX(4px) rotate(1deg); }
  90% { transform: translateX(-2px); }
  100% { transform: translateX(0); }
}
.pet-violent-shake {
  animation: petViolentShake 0.8s ease !important;
}

/* 散步：左右蹦跳 */
@keyframes petWalkAnim {
  0% { transform: translateY(0) translateX(0); }
  15% { transform: translateY(-15px) translateX(-5px); }
  30% { transform: translateY(0) translateX(0); }
  45% { transform: translateY(-12px) translateX(5px); }
  60% { transform: translateY(0) translateX(0); }
  75% { transform: translateY(-8px) translateX(-3px); }
  100% { transform: translateY(0) translateX(0); }
}
.pet-walk-anim {
  animation: petWalkAnim 0.8s ease !important;
}

/* 玩耍：无规则快速移动 */
@keyframes petWildMove {
  0% { transform: translate(0, 0) rotate(0deg); }
  12% { transform: translate(8px, -10px) rotate(8deg); }
  25% { transform: translate(-6px, 6px) rotate(-5deg); }
  37% { transform: translate(10px, 4px) rotate(6deg); }
  50% { transform: translate(-8px, -8px) rotate(-4deg); }
  62% { transform: translate(5px, 10px) rotate(3deg); }
  75% { transform: translate(-10px, -4px) rotate(-6deg); }
  87% { transform: translate(6px, 6px) rotate(4deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}
.pet-wild-move {
  animation: petWildMove 0.7s ease !important;
}

/* 聊天：轻快左右摇晃 */
@keyframes petTalkAnim {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-6deg); }
  30% { transform: rotate(5deg); }
  45% { transform: rotate(-4deg); }
  60% { transform: rotate(3deg); }
  80% { transform: rotate(-2deg); }
  100% { transform: rotate(0deg); }
}
.pet-talk-anim {
  animation: petTalkAnim 0.6s ease !important;
}

/* === 闲时动画（根据形态） === */
@keyframes petBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
.pet-bounce {
  animation: petBounce 1.5s ease-in-out infinite;
}

@keyframes petWalkSlow {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(4px); }
  50% { transform: translateX(0); }
  75% { transform: translateX(-4px); }
}
.pet-walk-slow {
  animation: petWalkSlow 3s ease-in-out infinite;
}

@keyframes petWalk {
  0%, 100% { transform: translateX(0) translateY(0); }
  25% { transform: translateX(5px) translateY(-2px); }
  50% { transform: translateX(0) translateY(0); }
  75% { transform: translateX(-5px) translateY(-2px); }
}
.pet-walk {
  animation: petWalk 2s ease-in-out infinite;
}

@keyframes petExcited {
  0%, 100% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(1.08) rotate(-3deg); }
  50% { transform: scale(1) rotate(0deg); }
  75% { transform: scale(1.08) rotate(3deg); }
}
.pet-excited {
  animation: petExcited 1.2s ease-in-out infinite;
}

@keyframes petMagic {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
  25% { transform: scale(1.1) rotate(-5deg); opacity: 0.85; }
  50% { transform: scale(1) rotate(0deg); opacity: 1; }
  75% { transform: scale(1.1) rotate(5deg); opacity: 0.85; }
}
.pet-magic {
  animation: petMagic 1.8s ease-in-out infinite;
}

@keyframes petSleep {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}
.pet-sleep {
  animation: petSleep 3s ease-in-out infinite;
}

/* ===== 宠物互动次数标记 ===== */
.pet-interact-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--primary-pale);
  color: var(--primary-dark);
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 10px 4px 10px 4px;
  border: 1px dashed var(--primary);
  position: relative;
  z-index: 1;
  margin-bottom: 6px;
}
.pet-interact-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  display: inline-block;
}
.pet-interact-dot--used {
  opacity: 0.25;
}

/* ===== 首页抽签卡片（突出样式） ===== */
.dc-home-card {
  margin: 0 14px 12px;
  padding: 16px 18px;
  background: linear-gradient(135deg, #FDE8C8 0%, #FFF8E6 100%);
  border: 2px dashed #F9A85C;
  border-radius: 18px 8px 20px 10px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: 3px 3px 0 rgba(249, 168, 92, 0.18);
}
.dc-home-card__bg {
  position: absolute;
  top: -20px; right: -20px;
  width: 100px; height: 100px;
  background: radial-gradient(circle, rgba(249, 168, 92, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.dc-home-card__row {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  position: relative;
  z-index: 1;
}
.dc-home-card__emoji {
  font-size: 40px;
  filter: drop-shadow(2px 2px 0 rgba(232, 146, 76, 0.25));
  transform: rotate(-8deg);
  flex-shrink: 0;
}
.dc-home-card__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.dc-home-card__title {
  font-size: 15px;
  font-weight: 700;
  color: #7A5C4A;
}
.dc-home-card__sub {
  font-size: 11px;
  color: #A89080;
}
.dc-home-card__arrow {
  font-size: 24px;
  color: #E8924C;
  font-weight: 700;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.dc-home-card--press {
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 rgba(249, 168, 92, 0.18);
}

/* ===== 新首页：顶部条 ===== */
.top-strip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px 14px;
  background: transparent;
}
.top-avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; font-weight: 700;
  box-shadow: 0 3px 8px rgba(232,145,164,0.3);
  flex-shrink: 0;
}
.top-info { flex: 1; min-width: 0; }
.top-name { font-size: 14px; font-weight: 700; color: var(--text, #7A5C4A); display: block; }
.top-meta { font-size: 11px; color: var(--text-light, #A89080); margin-top: 1px; display: block; }
.top-meta--bind { color: var(--primary-dark); font-weight: 600; }
.top-badges { display: flex; gap: 5px; flex-shrink: 0; }
.top-badge {
  background: linear-gradient(135deg, #FFE5D9, #FFD4C4);
  color: #8B5A2B; padding: 3px 8px; border-radius: 10px;
  font-size: 10px; font-weight: 600;
}
.top-badge--fire { background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: white; }

/* ===== 英雄区：角色主图 ===== */
.hero-section { position: relative; }
.hero-img { width: 100%; height: 125px; object-fit: cover; display: block; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.35) 0%, transparent 60%);
  display: flex; align-items: center;
  padding: 0 16px;
}
.hero-text { color: white; }
.hero-label {
  font-size: 11px; opacity: 0.9; margin-bottom: 2px; display: block;
}
.hero-amount {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 26px; font-weight: 700;
  text-shadow: 0 2px 4px rgba(0,0,0,0.4);
}
.hero-amount small {
  font-size: 14px; opacity: 0.9; margin-left: 4px; font-weight: 400;
}
.hero-cta {
  position: absolute; right: 16px; top: 50%;
  transform: translateY(-50%);
  background: white; color: var(--primary-dark);
  padding: 6px 14px; border-radius: 16px;
  font-size: 12px; font-weight: 700;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  display: inline-block;
}

/* ===== 快捷功能：圆形图标 ===== */
.circle-actions {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 12px; padding: 12px 16px;
}
.circle-action { text-align: center; }
.circle-icon {
  width: 56px; height: 56px; margin: 0 auto 5px; border-radius: 50%;
  overflow: hidden; box-shadow: 0 6px 14px rgba(232,145,164,0.2);
  display: block;
}
.circle-label { font-size: 11px; color: var(--text-primary, #7A5C4A); font-weight: 500; }

/* ===== 迷你统计条 ===== */
.stats-strip {
  display: flex; gap: 8px; padding: 0 16px 12px; margin-top: -8px;
}
.stat-mini {
  flex: 1; background: white; border-radius: 14px;
  padding: 10px 6px; text-align: center;
  box-shadow: 0 3px 10px rgba(232,145,164,0.1);
}
.stat-mini-val {
  font-size: 16px; color: var(--primary-dark); font-weight: 700;
}
.stat-mini-label {
  font-size: 10px; color: var(--text-light, #C8B8A8); margin-top: 1px;
}

/* ===== 计划卡片背景图 ===== */
.plan-card--tagged {
  background: rgba(255,255,240,0.55);
}
.plan-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 1;
  border-radius: inherit;
  pointer-events: none;
}

/* ===== 面板 v2：存钱计划卡片 ===== */
.panel-plan-card {
  position: relative; overflow: hidden;
  border-radius: 20px 12px 20px 12px;
  margin: 16px 14px 20px;
  box-shadow: 0 8px 24px rgba(249, 168, 92, 0.28);
}
.panel-plan-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
}
.panel-plan-content {
  position: relative; z-index: 2;
  padding: 16px 18px;
}
.panel-plan-tag {
  display: inline-block;
  background: rgba(255,255,255,0.95);
  color: #8B5A2B;
  padding: 3px 10px; border-radius: 10px;
  font-size: 11px; font-weight: 700;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  float: right;
  margin-left: 8px;
}
.panel-plan-name {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 22px; color: #fff; font-weight: 700;
  margin: 0 0 4px;
  text-shadow: 0 2px 6px rgba(0,0,0,0.3);
  display: inline;
}
.panel-plan-amounts {
  display: flex; align-items: baseline; gap: 6px;
  margin-bottom: 10px;
}
.panel-plan-curr {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px; color: #fff; font-weight: 700;
  text-shadow: 0 1px 3px rgba(0,0,0,0.3);
}
.panel-plan-tar {
  font-size: 12px; color: rgba(255,255,255,0.9);
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}
.panel-plan-bar {
  height: 8px;
  background: rgba(255,255,255,0.35);
  border-radius: 4px; overflow: hidden;
  margin-bottom: 8px;
}
.panel-plan-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD93D 0%, #FF8E8E 100%);
  border-radius: 4px;
  box-shadow: 0 0 8px rgba(255,217,61,0.5);
}
.panel-plan-meta {
  display: flex; justify-content: space-between;
  align-items: center;
}
.panel-plan-date {
  font-size: 11px; color: rgba(255,255,255,0.95);
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}
.panel-plan-cta {
  background: #fff; color: var(--primary-dark);
  padding: 6px 16px; border-radius: 16px;
  font-size: 12px; font-weight: 700;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

/* ===== 面板 v2：纪念日卡片 ===== */
.panel-anni-card {
  position: relative; overflow: hidden;
  border-radius: 18px;
  margin: 0 14px 18px;
  box-shadow: 0 8px 24px rgba(180,80,130,0.3);
}
.panel-anni-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; pointer-events: none;
  opacity: 0.35;
}
.panel-anni-content {
  position: relative; z-index: 2;
  padding: 14px;
  display: flex; align-items: center; gap: 12px;
}
.panel-anni-icon {
  width: 50px; height: 50px;
  background: rgba(255,255,255,0.95);
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  flex-shrink: 0;
}
.panel-anni-text { flex: 1; }
.panel-anni-name {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 18px; color: #fff; font-weight: 700;
  text-shadow: 0 2px 4px rgba(0,0,0,0.4);
  margin-bottom: 2px;
  display: block;
}
.panel-anni-date {
  font-size: 11px; color: rgba(255,255,255,0.95);
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  display: block;
}
.panel-anni-days { text-align: right; }
.panel-anni-days-num {
  font-family: 'ZCOOL KuaiLe', cursive;
  font-size: 32px; color: #fff; font-weight: 700;
  line-height: 1;
  text-shadow: 0 2px 6px rgba(0,0,0,0.4);
}
.panel-anni-days-lbl {
  font-size: 10px; color: rgba(255,255,255,0.95);
  text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  margin-top: 2px;
  display: block;
}
.panel-anni-today-icon { font-size: 28px; display: block; }
.panel-anni-today-lbl { font-size: 11px; color: #fff; font-weight: 700; display: block; margin-top: 2px; text-shadow: 0 1px 3px rgba(0,0,0,0.4); }
.panel-anni--today {
  border: 2px solid #FFD700;
  box-shadow: 0 0 0 4px rgba(255,215,0,0.2), 0 8px 24px rgba(255,215,0,0.25);
