/* 首页 — 一起攒 · 新布局 */
.page { height: 100vh; background: transparent; display: flex; flex-direction: column; }
.fixed-top { flex-shrink: 0; }
.scroll-body { flex: 1; overflow-y: scroll; -webkit-overflow-scrolling: touch; }

/* ===== 1. 伴侣+等级 ===== */
.compact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px 8px;
}
.ch-left { flex: 1; }
.ch-name { font-size: 20px; font-weight: 800; color: var(--text); display: inline; }
.ch-partner { font-size: 13px; color: var(--text-secondary); margin-left: 6px; }
.ch-bind { background: rgba(214, 92, 138, 0.12); padding: 2px 8px; border-radius: 10px; }
.ch-days { font-size: 11px; color: var(--text-muted); margin-left: 4px; }
.ch-spark { font-size: 11px; color: #ff6b35; margin-left: 4px; font-weight: 700; }
.ch-level { text-align: center; }
.ch-lv {
  background: rgba(214, 92, 138, 0.12);
  padding: 3px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--pink-dark);
  display: inline-block;
}
.ch-lv-bar { width: 48px; height: 3px; background: rgba(214, 92, 138, 0.2); border-radius: 2px; margin: 4px auto 0; overflow: hidden; }
.ch-lv-fill { height: 100%; background: var(--pink-dark); border-radius: 2px; }
.ch-days-inline { font-size: 10px; font-weight: 400; opacity: 0.8; }

/* ===== 2. 攒钱总进度（核心大卡片） ===== */
.money-card {
  margin: 4px 12px 8px;
  background: linear-gradient(135deg, #ffffff 0%, #fff8fc 55%, #ffe8f2 100%);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 8px 24px rgba(214, 92, 138, 0.12);
  border: 1px solid #ffd6e8;
  position: relative;
  overflow: hidden;
}
.money-card::before {
  content: '';
  position: absolute;
  top: -40px; right: -30px;
  width: 120px; height: 120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(214, 92, 138, 0.08) 0%, transparent 70%);
}
.money-top { display: flex; justify-content: space-between; align-items: flex-start; }
.money-info { flex: 1; }
.money-label { font-size: 12px; color: var(--text-secondary); display: block; }
.money-amount { font-size: 32px; font-weight: 900; color: var(--pink-dark); display: block; margin-top: 2px; letter-spacing: -1px; }
.money-target { font-size: 12px; color: var(--text-muted); margin-top: 2px; display: block; }
.money-icon { font-size: 32px; opacity: .6; }
.money-bar {
  height: 8px;
  background: rgba(214, 92, 138, 0.15);
  border-radius: 4px;
  margin-top: 14px;
  overflow: hidden;
}
.money-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 4px;
  transition: width 1s ease;
}
.money-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
}
.money-pct {
  font-size: 11px;
  color: var(--pink-dark);
  font-weight: 600;
}
.money-plans-count {
  font-size: 10px;
  color: var(--text-muted);
}

/* ===== 3. 各计划进度列表 ===== */
.plans-mini-list {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  box-shadow: var(--shadow-sm);
}
.pml-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.pml-title { font-size: 13px; font-weight: 700; color: var(--text); }
.pml-more { font-size: 11px; color: var(--pink-dark); }
.pml-item { margin-bottom: 10px; }
.pml-item:last-child { margin-bottom: 0; }
.pml-top { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
.pml-name { color: var(--text); font-weight: 500; }
.pml-amount { color: var(--pink-dark); font-weight: 600; }
.pml-bar {
  height: 5px;
  background: rgba(214, 92, 138, 0.12);
  border-radius: 3px;
  overflow: hidden;
}
.pml-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 3px;
  transition: width .8s ease;
}

/* ===== 4. 空状态 ===== */
.empty-state {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 24px 16px;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.empty-icon { font-size: 36px; display: block; }
.empty-text { font-size: 14px; color: var(--text-secondary); margin-top: 6px; display: block; }
.empty-sub { font-size: 12px; color: var(--pink-dark); margin-top: 4px; display: block; }

/* ===== 5. 纪念日 ===== */
.anni-row {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.anni-emoji { font-size: 20px; }
.anni-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
.anni-label { font-size: 12px; color: var(--text-secondary); }
.anni-days { font-size: 24px; font-weight: 800; color: var(--pink-dark); }
.anni-unit { font-size: 12px; font-weight: 400; color: var(--text-secondary); margin-left: 2px; }
.anni-arrow { font-size: 18px; color: var(--text-muted); }

/* ===== 5b. 今天的纪念日（金边高亮） ===== */
.today-anni-banner {
  margin: 0 12px 6px;
  background-color: #fff8e7;
  border: 3px solid #d4a017;
  border-radius: 12px;
  padding: 10px 16px;
  box-shadow: 0 0 12px rgba(212, 160, 23, 0.3);
}
.today-anni-item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.today-anni-emoji { font-size: 24px; }
.today-anni-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.today-anni-label { font-size: 15px; font-weight: 700; color: #8b6914; }
.today-anni-badge {
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #d4a017, #b8860b);
  padding: 4px 14px;
  border-radius: 999px;
}

/* ===== 6. 快捷入口 ===== */
.quick-row {
  display: flex;
  gap: 8px;
  padding: 0 12px;
  margin-bottom: 8px;
}
.qr-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: #ffffff;
  border: 1px solid #ffd6e8;
  border-radius: var(--radius);
  padding: 12px 6px;
  box-shadow: var(--shadow-sm);
}
.qr-item:active { background: #fff5fb; }
.qr-emoji { font-size: 22px; }
.qr-label { font-size: 11px; color: var(--text-secondary); }

/* ===== 7. 底部数据 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  margin: 0 12px 8px;
  padding: 10px 16px;
  gap: 0;
  box-shadow: var(--shadow-sm);
}
.sb-item { flex: 1; text-align: center; }
.sb-num { display: block; font-size: 14px; font-weight: 700; color: var(--pink-dark); }
.sb-label { display: block; font-size: 10px; color: var(--text-secondary); margin-top: 1px; }

/* ===== 7.5 卡片任务 ===== */
.card-tasks-section {
  margin: 0 12px 8px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  box-shadow: var(--shadow-sm);
}
.ct-header { margin-bottom: 8px; }
.ct-title { font-size: 13px; font-weight: 700; color: var(--text); }
.ct-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 0;
  border-top: 1px solid rgba(214, 92, 138, 0.08);
}
.ct-item:first-child { border-top: none; }
.ct-body {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.ct-icon { font-size: 20px; flex-shrink: 0; }
.ct-info { flex: 1; }
.ct-name { font-size: 13px; font-weight: 600; color: var(--text); display: block; }
.ct-desc { font-size: 11px; color: var(--text-secondary); display: block; margin-top: 2px; line-height: 1.5; }
.ct-actions { display: flex; gap: 8px; margin-left: 28px; }
.ct-btn {
  font-size: 12px;
  padding: 4px 14px;
  border: none;
  border-radius: 14px;
  line-height: 1.8;
  min-height: 0;
}
.ct-btn::after { border: none; }
.ct-btn-forgive { background: #ff6b9d; color: #fff; }
.ct-btn-reject { background: rgba(214, 92, 138, 0.1); color: var(--text-secondary); }
.ct-btn-retry { background: #ffd43b; color: #333; }
.ct-btn-confirm { background: #52c41a; color: #fff; }
.ct-btn-hooray {
  background: linear-gradient(135deg, #ff6b9d, #c44d7a);
  font-size: 14px;
  padding: 6px 22px;
  font-weight: 700;
  box-shadow: 0 3px 12px rgba(196, 77, 122, 0.35);
  animation: forgiveBtnGlow 2s ease-in-out infinite;
}
.ct-btn-dispute { background: rgba(255, 71, 87, 0.1); color: #ff4757; }
.ct-btn-complete { background: var(--pink); color: #fff; }
.ct-btn-decline { background: rgba(214, 92, 138, 0.1); color: var(--text-secondary); }
.ct-done-badge { font-size: 14px; margin-left: 28px; }
.ct-forgive-completed {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 14px;
  font-weight: 600;
  background: linear-gradient(135deg, #fff0f7, #fff5f0);
  border: 1.5px solid #ffd700;
  border-radius: 20px;
  padding: 8px 18px;
  margin-left: 28px;
  color: var(--pink-dark);
  box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
  animation: forgiveBtnGlow 2s ease-in-out infinite;
  cursor: pointer;
}
.ct-forgive-completed:active {
  opacity: 0.7;
  transform: scale(0.96);
}
.ct-waiting-text { font-size: 11px; color: var(--text-muted); margin-left: 28px; }
.ct-status-text { font-size: 11px; color: var(--text-muted); margin-left: 28px; }

/* ===== 原谅卡专属特效（超稀有SSR） ===== */
.ct-item--forgive {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #fff5f0 0%, #fff0f7 40%, #fef8ff 100%);
  border: 1.5px solid #ffd700;
  border-radius: 14px;
  padding: 14px 14px 12px;
  margin: -4px 0 2px;
  animation: forgivePulse 2.5s ease-in-out infinite;
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.25), inset 0 0 30px rgba(255, 215, 0, 0.05);
}
.ct-item--forgive::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 40%, rgba(255, 215, 0, 0.06) 0%, transparent 50%),
              radial-gradient(circle at 70% 60%, rgba(255, 107, 157, 0.06) 0%, transparent 50%);
  pointer-events: none;
  animation: forgiveShimmer 4s ease-in-out infinite;
}
.ct-item--forgive .ct-icon { font-size: 26px; animation: forgiveBounce 2s ease-in-out infinite; }
.ct-item--forgive .ct-name {
  font-size: 14px;
  background: linear-gradient(90deg, #c44d7a, #ff6b9d, #d4a017);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.ct-item--forgive .ct-btn-forgive {
  background: linear-gradient(135deg, #ff6b9d, #c44d7a);
  font-size: 13px;
  padding: 5px 18px;
  font-weight: 700;
  box-shadow: 0 3px 10px rgba(196, 77, 122, 0.35);
  animation: forgiveBtnGlow 2s ease-in-out infinite;
}
.ct-item--forgive .ct-btn-reject {
  font-size: 13px;
  padding: 5px 18px;
  background: rgba(255, 215, 0, 0.15);
  color: #b8860b;
  border: 1px solid rgba(255, 215, 0, 0.3);
}

@keyframes forgivePulse {
  0%, 100% { box-shadow: 0 0 20px rgba(255, 215, 0, 0.25), inset 0 0 30px rgba(255, 215, 0, 0.05); }
  50% { box-shadow: 0 0 35px rgba(255, 215, 0, 0.4), inset 0 0 40px rgba(255, 215, 0, 0.08); }
}
@keyframes forgiveShimmer {
  0%, 100% { transform: translate(0, 0) rotate(0deg); opacity: 0.5; }
  33% { transform: translate(8px, -8px) rotate(3deg); opacity: 0.8; }
  66% { transform: translate(-4px, 4px) rotate(-2deg); opacity: 0.6; }
}
@keyframes forgiveBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-5px) scale(1.1); }
}
@keyframes forgiveBtnGlow {
  0%, 100% { box-shadow: 0 3px 10px rgba(196, 77, 122, 0.35); }
  50% { box-shadow: 0 3px 18px rgba(196, 77, 122, 0.55); }
}

/* ===== 8. 宠物展示区域 ===== */
.pet-area {
  margin: 0 12px 12px;
  background: linear-gradient(135deg, #fef9ff 0%, #fff0f8 100%);
  border: 1px solid #fad6e8;
  border-radius: var(--radius-lg);
  padding: 20px 16px 14px;
  text-align: center;
  position: relative;
  box-shadow: 0 4px 16px rgba(214, 92, 138, 0.08);
  overflow: hidden;
}
.pet-container {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe4f0 0%, #ffd4e8 100%);
  box-shadow: 0 4px 12px rgba(214, 92, 138, 0.15);
  position: relative;
  z-index: 1;
}
.pet-emoji {
  font-size: 36px;
  display: block;
  line-height: 1;
  transition: transform 0.3s ease;
}
.pet-image {
  width: 60px;
  height: 60px;
  display: block;
}
.pet-intimacy-text {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--pink-dark);
  margin-top: 8px;
}
.pet-skill-text {
  display: block;
  font-size: 11px;
  color: #8b6914;
  margin-top: 3px;
}
.pet-tip {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 4px;
}
.pet-click-hint {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 11px;
  color: var(--text-muted);
  opacity: 0.6;
}

/* 互动环绕按钮组 */
.pet-interact-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 10px;
}
.interact-btn {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 44px;
  padding: 6px 0;
  border-radius: 50%;
  background: rgba(255,255,255,0.92);
  border: 1px solid #ffd6e8;
  box-shadow: 0 2px 8px rgba(214,92,138,0.12);
  transition: all 0.12s;
}
.interact-btn:active { transform: scale(0.9); }
.interact-icon { font-size: 18px; }
.interact-label { font-size: 9px; color: var(--text-muted); font-weight: 600; }
.interact-pet { top: 0; left: 4px; }
.interact-walk { top: 0; right: 4px; }
.interact-play { bottom: 8px; left: -8px; }
.interact-talk { bottom: 8px; right: -8px; }

/* ===== 宠物动画 ===== */
.pet-happy .pet-container {
  animation: petHappyJump 0.6s ease-out !important;
}
@keyframes petHappyJump {
  0% { transform: translateY(0) scale(1); }
  20% { transform: translateY(-18px) scale(1.12); }
  40% { transform: translateY(-8px) scale(1.05); }
  60% { transform: translateY(-14px) scale(1.08); }
  80% { transform: translateY(-4px) scale(1.02); }
  100% { transform: translateY(0) scale(1); }
}

/* ===== 宠物动画 ===== */
/* 睡眠 - 轻微上下浮动 */
.pet-sleep .pet-emoji {
  animation: petBounce 3s ease-in-out infinite;
}
/* 通用弹跳动画（所有宠物默认） */
.pet-bounce .pet-emoji {
  animation: petBounce 2s ease-in-out infinite;
}
/* 慢走 - 左右慢速移动 */
.pet-walk-slow .pet-container {
  animation: petWalk 4s ease-in-out infinite;
}
/* 正常走 - 左右中速移动 */
.pet-walk .pet-container {
  animation: petWalk 2.5s ease-in-out infinite;
}
/* 兴奋 - 快速跳跃 */
.pet-excited .pet-container {
  animation: petJump 0.8s ease-in-out infinite;
}
/* 魔法 - 旋转+缩放 */
.pet-magic .pet-container {
  animation: petMagic 1.5s ease-in-out infinite;
}
.pet-magic .pet-emoji {
  animation: petGlow 1.5s ease-in-out infinite;
}

@keyframes petBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}
@keyframes petWalk {
  0%, 100% { transform: translateX(-20px); }
  50% { transform: translateX(20px); }
}
@keyframes petJump {
  0%, 100% { transform: translateY(0) scale(1); }
  25% { transform: translateY(-12px) scale(1.08); }
  50% { transform: translateY(0) scale(1); }
  75% { transform: translateY(-6px) scale(1.04); }
}
@keyframes petMagic {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-8px) rotate(-8deg); }
  50% { transform: translateY(0) rotate(0deg); }
  75% { transform: translateY(-8px) rotate(8deg); }
}
@keyframes petGlow {
  0%, 100% { filter: brightness(1); transform: scale(1); }
  50% { filter: brightness(1.3); transform: scale(1.1); }
}

/* ===== 扭蛋机入口浮动按钮 ===== */
.gacha-btn {
  position: fixed;
  top: 12px;
  right: 12px;
  z-index: 999;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b9d 0%, #c44d7a 100%);
  box-shadow: 0 4px 14px rgba(196, 77, 122, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.gacha-btn:active {
  transform: scale(0.92);
  opacity: 0.85;
}
.gacha-icon {
  font-size: 22px;
  line-height: 1;
}
.gacha-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  border-radius: 10px;
  background: #ff4757;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  box-shadow: 0 2px 6px rgba(255, 71, 87, 0.4);
  line-height: 1;
}

/* ===== 宠物信息弹窗 ===== */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}
.pet-modal {
  background: #fff;
  border-radius: 20px;
  padding: 32px 24px 24px;
  width: 280px;
  text-align: center;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  animation: scaleIn 0.25s ease;
}
.pet-modal-emoji {
  font-size: 54px;
  display: block;
  margin-bottom: 6px;
}
.pet-modal-img {
  width: 80px;
  height: 80px;
  display: block;
  margin: 0 auto;
}
.pet-modal-name {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  display: block;
}
.pet-modal-level-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 6px;
}
.pet-modal-level-label {
  font-size: 12px;
  color: var(--text-secondary);
}
.pet-modal-level-val {
  font-size: 14px;
  font-weight: 700;
  color: var(--pink-dark);
}
.pet-modal-bar-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0;
}
.pet-modal-bar {
  flex: 1;
  height: 6px;
  background: rgba(214, 92, 138, 0.15);
  border-radius: 3px;
  overflow: hidden;
}
.pet-modal-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 3px;
  transition: width 0.6s ease;
}
.pet-modal-pct {
  font-size: 11px;
  font-weight: 600;
  color: var(--pink-dark);
  min-width: 36px;
  text-align: right;
}
.pet-modal-desc {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 6px;
}
.pet-modal-btn {
  margin-top: 16px;
  width: 100%;
  height: 42px;
  line-height: 42px;
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  border: none;
  border-radius: 21px;
  box-shadow: 0 4px 12px rgba(214, 92, 138, 0.3);
}
.pet-modal-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
.pet-modal-btn-secondary {
  margin-top: 8px;
  background: rgba(214,92,138,0.1);
  color: var(--pink-dark);
  font-size: 13px;
  box-shadow: none;
}
.pet-modal-close {
  position: absolute;
  top: 12px;
  right: 16px;
  font-size: 18px;
  color: var(--text-muted);
  padding: 4px 8px;
  cursor: pointer;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

/* ===== 升级动画弹窗 ===== */
.levelup-overlay {
  position: fixed; inset: 0; z-index: 2000;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn 0.3s ease;
}
.levelup-modal {
  background: linear-gradient(160deg, #fff8fc, #fff0f7);
  border-radius: 24px;
  padding: 40px 32px 32px;
  width: 260px;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(214,92,138,0.3);
  animation: levelUpPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes levelUpPop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.levelup-title { font-size: 16px; font-weight: 700; color: var(--pink-dark); display: block; }
.levelup-lv {
  font-size: 56px; font-weight: 900;
  background: linear-gradient(135deg, #c44d7a, #ff6b9d, #d4a017);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin: 8px 0;
  animation: levelUpLv 1s ease-in-out infinite alternate;
}
@keyframes levelUpLv {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}
.levelup-sub { font-size: 12px; color: var(--text-secondary); display: block; }
.levelup-stars { position: absolute; inset: 0; pointer-events: none; }
.levelup-star {
  position: absolute; font-size: 14px;
  animation: levelUpStarFloat 2s ease-in-out infinite;
}
.levelup-star.s1 { top: 10%; left: 10%; animation-delay: 0s; }
.levelup-star.s2 { top: 8%; right: 12%; animation-delay: 0.3s; }
.levelup-star.s3 { bottom: 15%; left: 8%; animation-delay: 0.6s; }
.levelup-star.s4 { bottom: 12%; right: 10%; animation-delay: 0.9s; }
.levelup-star.s5 { top: 50%; left: 5%; animation-delay: 1.2s; }
@keyframes levelUpStarFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.6; }
  50% { transform: translateY(-12px) rotate(180deg); opacity: 1; }
}
.levelup-sparkle { margin-top: 12px; position: relative; height: 20px; }
.levelup-particle {
  position: absolute; font-size: 10px; color: #ffd700;
  animation: levelUpParticle 1.5s ease-out infinite;
}
.levelup-particle.p0 { left: 20%; animation-delay: 0s; }
.levelup-particle.p1 { left: 40%; animation-delay: 0.3s; }
.levelup-particle.p2 { left: 60%; animation-delay: 0.6s; }
.levelup-particle.p3 { left: 80%; animation-delay: 0.9s; }
@keyframes levelUpParticle {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(-30px) scale(0); opacity: 0; }
}

/* ===== 冒险归来弹窗 ===== */
.adventure-modal {
  background: linear-gradient(160deg, #fff8fc, #fef3e0);
  border-radius: 24px;
  padding: 32px 24px 20px;
  width: 280px;
  text-align: center;
  position: relative;
  box-shadow: 0 20px 60px rgba(214,92,138,0.25);
  animation: levelUpPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.adventure-emoji { font-size: 48px; display: block; margin-bottom: 6px; animation: petBounce 1.5s ease-in-out infinite; }
.adventure-title { font-size: 17px; font-weight: 800; color: var(--pink-dark); display: block; }
.adventure-desc { font-size: 12px; color: var(--text-secondary); display: block; margin-top: 2px; }
.adventure-rewards {
  display: flex; justify-content: center; gap: 16px;
  margin: 16px 0;
}
.adventure-reward {
  display: flex; flex-direction: column; align-items: center;
  background: rgba(255,255,255,0.7);
  border-radius: 12px;
  padding: 10px 14px;
  min-width: 64px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.ar-icon { font-size: 22px; }
.ar-num { font-size: 18px; font-weight: 800; color: var(--pink-dark); margin-top: 2px; }
.ar-label { font-size: 10px; color: var(--text-muted); margin-top: 1px; }
.adventure-week {
  background: rgba(212,160,23,0.08);
  border-radius: 8px;
  padding: 6px 12px;
  margin-bottom: 8px;
}
.adventure-week-text { font-size: 11px; color: #8b6914; }
.adventure-tap { font-size: 11px; color: var(--text-muted); display: block; }
