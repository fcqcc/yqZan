/* 首页 v2 */
.page { min-height: 100vh; padding-bottom: 16px; }

/* ===== 情侣信息头 ===== */
.profile-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  margin-top: 8px;
}
.ph-avatars { display: flex; align-items: center; gap: 4px; }
.ph-avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 600; color: white;
}
.ph-heart { font-size: 14px; margin: 0 2px; }
.ph-info { flex: 1; }
.ph-names { display: block; font-size: 18px; font-weight: 600; color: var(--text); }
.ph-level-badge {
  display: inline-block;
  margin-top: 4px;
  padding: 2px 10px;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--gold-light), #FFF5E0);
  font-size: 11px; font-weight: 600;
  color: #8B7332;
}

/* ===== 存款卡片 ===== */
.save-card { margin: 4px 16px 12px; }
.save-amount { font-size: 28px; font-weight: 700; color: var(--gold); display: block; margin: 4px 0; }
.save-ring {
  width: 64px; height: 64px;
  border-radius: 50%;
  background: #FFE4DC;
  display: flex; align-items: center; justify-content: center;
}
.save-ring-text {
  width: 52px; height: 52px;
  border-radius: 50%;
  background: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; color: var(--gold);
}

/* ===== 4指标 ===== */
.indicator-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 0 16px;
  margin-bottom: 12px;
}
.indicator-card {
  background: var(--card-bg);
  backdrop-filter: blur(8px);
  border: var(--card-border);
  border-radius: var(--radius-md);
  padding: 14px 12px;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.indicator-card:active { transform: scale(0.98); }
.indicator-num { display: block; font-size: 22px; font-weight: 700; color: var(--gold); }
.indicator-label { display: block; font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

/* ===== 纪念日横幅 ===== */
.anni-banner {
  margin: 0 16px 12px;
  background: linear-gradient(135deg, rgba(255,183,178,0.3), rgba(255,248,240,0.9));
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 0.5px solid rgba(255,255,255,0.5);
}
.anni-banner-icon { font-size: 24px; }
.anni-banner-info { flex: 1; }
.anni-banner-label { display: block; font-size: 12px; color: var(--text-secondary); }
.anni-banner-days { font-size: 20px; font-weight: 700; color: var(--pink-dark); margin-top: 1px; }
.anni-banner-arrow { font-size: 20px; color: var(--text-light); }

/* ===== 今日待办 ===== */
.tc-item { display: flex; align-items: center; gap: 8px; padding: 5px 0; }
.tc-check { font-size: 14px; }
.tc-text { font-size: 13px; color: var(--text); }

/* ===== 6宫格 ===== */
.func-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  padding: 0 16px;
}
.func-item {
  display: flex; flex-direction: column;
  align-items: center;
  padding: 16px 8px 12px;
  background: var(--card-bg);
  backdrop-filter: blur(8px);
  border: var(--card-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}
.func-item:active { transform: scale(0.96); background: rgba(255,248,240,1); }
.func-icon {
  width: 44px; height: 44px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  margin-bottom: 8px;
}
.func-pink { background: linear-gradient(135deg, #FFE4DC, #FFB7B2); }
.func-purple { background: linear-gradient(135deg, #EDE0FF, #C5A3FF); }
.func-green { background: linear-gradient(135deg, #E8F5E9, #A5D6A7); }
.func-orange { background: linear-gradient(135deg, #FFF3E0, #FFCC80); }
.func-gold { background: linear-gradient(135deg, #FFF8E1, #FFD54F); }
.func-label { font-size: 12px; font-weight: 500; color: var(--text); }
