}
@keyframes panelAnniGold {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,215,0,0.15), 0 8px 24px rgba(255,215,0,0.2); }
  50% { box-shadow: 0 0 0 8px rgba(255,215,0,0.06), 0 8px 24px rgba(255,215,0,0.2); }
}

/* ===== 自定义游客弹窗 ===== */
.guest-modal {
  background: #FFFAF7;
  border-radius: 24px 12px 24px 12px;
  padding: 32px 28px 24px;
  width: 300px;
  text-align: center;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), 0 2px 8px rgba(232,145,164,0.15), 0 8px 28px rgba(232,145,164,0.1), 6px 6px 0 rgba(232,145,164,0.25);
  border: 2px dashed #E8D0B8;
}
.guest-modal-icon {
  font-size: 48px;
  margin-bottom: 12px;
}
.guest-modal-title {
  font-size: 17px;
  font-weight: 700;
  color: #5D3E2A;
  display: block;
  margin-bottom: 10px;
  font-family: 'ZCOOL KuaiLe', cursive;
}
.guest-modal-desc {
  font-size: 12px;
  color: #8B6E5A;
  line-height: 1.6;
  display: block;
  margin-bottom: 22px;
  text-align: left;
  padding: 0 4px;
}
.guest-modal-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.guest-btn {
  border: none;
  border-radius: 18px 6px 18px 6px;
  height: 44px;
  font-size: 14px;
  font-weight: 700;
  font-family: 'ZCOOL KuaiLe', cursive;
  line-height: 44px;
  padding: 0;
}
.guest-btn--primary {
  background: linear-gradient(135deg, #F9A85C, #E8924C);
  color: #fff;
  box-shadow: 3px 3px 0 rgba(232, 146, 76, 0.35);
}
.guest-btn--cancel {
  background: transparent;
  color: #A89080;
  height: 36px;
  line-height: 36px;
  font-size: 12px;
}

