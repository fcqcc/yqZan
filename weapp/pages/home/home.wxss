/* 首页 — 新布局 */
.page { height: 100vh; background: transparent; }

/* ===== 自定义导航 ===== */
.nav-bar { position: sticky; top: 0; z-index: 50; }
.nav-safe { height: env(safe-area-inset-top, 44px); }
.nav-content { padding: 8px 16px 4px; }
.nav-title { font-size: 17px; font-weight: 700; color: var(--text); letter-spacing: .5px; }

/* ===== 1. 伴侣+等级（紧凑行） ===== */
.compact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px 8px;
}
.ch-left { flex: 1; }
.ch-name { font-size: 20px; font-weight: 800; color: var(--text); display: inline; }
.ch-partner { font-size: 13px; color: var(--text-secondary); margin-left: 6px; }
.ch-bind { background: rgba(214, 92, 138, 0.12); padding: 2px 8px; border-radius: 10px; }
.ch-days { font-size: 11px; color: var(--text-muted); margin-left: 4px; }
.ch-level { text-align: center; }
.ch-lv {
  background: rgba(214, 92, 138, 0.12);
  padding: 3px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--pink-dark);
  display: inline-block;
}
.ch-lv-bar { width: 48px; height: 3px; background: rgba(214, 92, 138, 0.2); border-radius: 2px; margin: 4px auto 0; overflow: hidden; }
.ch-lv-fill { height: 100%; background: var(--pink-dark); border-radius: 2px; }

/* ===== 2. 存钱卡片（最重要） ===== */
.money-card {
  margin: 4px 12px 8px;
  background: linear-gradient(135deg, #ffffff 0%, #fff8fc 55%, #ffe8f2 100%);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 8px 24px rgba(214, 92, 138, 0.12);
  border: 1px solid #ffd6e8;
  position: relative;
  overflow: hidden;
}
.money-card::before {
  content: '';
  position: absolute;
  top: -40px; right: -30px;
  width: 120px; height: 120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(214, 92, 138, 0.08) 0%, transparent 70%);
}
.money-top { display: flex; justify-content: space-between; align-items: flex-start; }
.money-info { flex: 1; }
.money-label { font-size: 12px; color: var(--text-secondary); display: block; }
.money-amount { font-size: 32px; font-weight: 900; color: var(--pink-dark); display: block; margin-top: 2px; letter-spacing: -1px; }
.money-target { font-size: 12px; color: var(--text-muted); margin-top: 2px; display: block; }
.money-icon { font-size: 32px; opacity: .6; }
.money-bar {
  height: 8px;
  background: rgba(214, 92, 138, 0.15);
  border-radius: 4px;
  margin-top: 14px;
  overflow: hidden;
}
.money-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 4px;
  transition: width 1s ease;
}
.money-pct {
  font-size: 11px;
  color: var(--pink-dark);
  font-weight: 600;
  margin-top: 4px;
  display: block;
  text-align: right;
}

/* ===== 3. 纪念日 ===== */
.anni-row {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.anni-emoji { font-size: 20px; }
.anni-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
.anni-label { font-size: 12px; color: var(--text-secondary); }
.anni-days { font-size: 24px; font-weight: 800; color: var(--pink-dark); }
.anni-unit { font-size: 12px; font-weight: 400; color: var(--text-secondary); margin-left: 2px; }
.anni-arrow { font-size: 18px; color: var(--text-muted); }

/* ===== 4. 今日待办 ===== */
.todo-card {
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  margin: 0 12px 6px;
  padding: 14px 16px;
  box-shadow: var(--shadow-sm);
}
.tc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.tc-title { font-size: 13px; font-weight: 700; color: var(--text); }
.tc-more { font-size: 11px; color: var(--pink-dark); }
.tc-item { display: flex; align-items: center; gap: 8px; padding: 6px 0; }
.tc-check { font-size: 14px; }
.tc-text { font-size: 13px; color: var(--text); }

/* ===== 5. 便利贴 ===== */
.note-card {
  margin: 0 12px 8px;
  background: linear-gradient(135deg, #fff0f3, #fff);
  border-radius: var(--radius);
  padding: 14px 16px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
  border: 1px solid rgba(244,143,177,.2);
}
.note-pin { font-size: 16px; margin-top: 2px; }
.note-body { flex: 1; }
.note-text { font-size: 13px; line-height: 1.6; color: var(--text); font-style: italic; }
.note-from { font-size: 11px; color: var(--text-muted); display: block; margin-top: 4px; }

/* ===== 6. 快捷入口（紧凑） ===== */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 12px;
  margin-bottom: 8px;
  box-sizing: border-box;
}
/* 每行 3 个：3 列 + 2 个 gap(4px) */
.qr-item {
  flex: 0 0 calc((100% - 8px) / 3);
  width: calc((100% - 8px) / 3);
  max-width: calc((100% - 8px) / 3);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1px solid #ffd6e8;
  border-radius: var(--radius-sm);
  padding: 10px 6px;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.qr-item:active { background: #fff5fb; }
.qr-icon-img {
  width: 96px;
  height: 96px;
  flex-shrink: 0;
  display: block;
  pointer-events: none;
}

/* ===== 7. 数据详情（底部） ===== */
.stats-bar {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  margin: 0 12px 8px;
  padding: 10px 16px;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.sb-item { flex: 1; text-align: center; }
.sb-num { display: block; font-size: 14px; font-weight: 700; color: var(--pink-dark); }
.sb-label { display: block; font-size: 10px; color: var(--text-secondary); margin-top: 1px; }
.sb-arrow { font-size: 16px; color: var(--text-muted); }
