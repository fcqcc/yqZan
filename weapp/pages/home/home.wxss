/* 首页 — 一起攒 · 新布局 */
.page { height: 100vh; background: transparent; }

/* ===== 1. 伴侣+等级 ===== */
.compact-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px 8px;
}
.ch-left { flex: 1; }
.ch-name { font-size: 20px; font-weight: 800; color: var(--text); display: inline; }
.ch-partner { font-size: 13px; color: var(--text-secondary); margin-left: 6px; }
.ch-bind { background: rgba(214, 92, 138, 0.12); padding: 2px 8px; border-radius: 10px; }
.ch-days { font-size: 11px; color: var(--text-muted); margin-left: 4px; }
.ch-level { text-align: center; }
.ch-lv {
  background: rgba(214, 92, 138, 0.12);
  padding: 3px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--pink-dark);
  display: inline-block;
}
.ch-lv-bar { width: 48px; height: 3px; background: rgba(214, 92, 138, 0.2); border-radius: 2px; margin: 4px auto 0; overflow: hidden; }
.ch-lv-fill { height: 100%; background: var(--pink-dark); border-radius: 2px; }

/* ===== 2. 攒钱总进度（核心大卡片） ===== */
.money-card {
  margin: 4px 12px 8px;
  background: linear-gradient(135deg, #ffffff 0%, #fff8fc 55%, #ffe8f2 100%);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 8px 24px rgba(214, 92, 138, 0.12);
  border: 1px solid #ffd6e8;
  position: relative;
  overflow: hidden;
}
.money-card::before {
  content: '';
  position: absolute;
  top: -40px; right: -30px;
  width: 120px; height: 120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(214, 92, 138, 0.08) 0%, transparent 70%);
}
.money-top { display: flex; justify-content: space-between; align-items: flex-start; }
.money-info { flex: 1; }
.money-label { font-size: 12px; color: var(--text-secondary); display: block; }
.money-amount { font-size: 32px; font-weight: 900; color: var(--pink-dark); display: block; margin-top: 2px; letter-spacing: -1px; }
.money-target { font-size: 12px; color: var(--text-muted); margin-top: 2px; display: block; }
.money-icon { font-size: 32px; opacity: .6; }
.money-bar {
  height: 8px;
  background: rgba(214, 92, 138, 0.15);
  border-radius: 4px;
  margin-top: 14px;
  overflow: hidden;
}
.money-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 4px;
  transition: width 1s ease;
}
.money-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
}
.money-pct {
  font-size: 11px;
  color: var(--pink-dark);
  font-weight: 600;
}
.money-plans-count {
  font-size: 10px;
  color: var(--text-muted);
}

/* ===== 3. 各计划进度列表 ===== */
.plans-mini-list {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  box-shadow: var(--shadow-sm);
}
.pml-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.pml-title { font-size: 13px; font-weight: 700; color: var(--text); }
.pml-more { font-size: 11px; color: var(--pink-dark); }
.pml-item { margin-bottom: 10px; }
.pml-item:last-child { margin-bottom: 0; }
.pml-top { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
.pml-name { color: var(--text); font-weight: 500; }
.pml-amount { color: var(--pink-dark); font-weight: 600; }
.pml-bar {
  height: 5px;
  background: rgba(214, 92, 138, 0.12);
  border-radius: 3px;
  overflow: hidden;
}
.pml-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  border-radius: 3px;
  transition: width .8s ease;
}

/* ===== 4. 空状态 ===== */
.empty-state {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 24px 16px;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.empty-icon { font-size: 36px; display: block; }
.empty-text { font-size: 14px; color: var(--text-secondary); margin-top: 6px; display: block; }
.empty-sub { font-size: 12px; color: var(--pink-dark); margin-top: 4px; display: block; }

/* ===== 5. 纪念日 ===== */
.anni-row {
  margin: 0 12px 6px;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.anni-emoji { font-size: 20px; }
.anni-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
.anni-label { font-size: 12px; color: var(--text-secondary); }
.anni-days { font-size: 24px; font-weight: 800; color: var(--pink-dark); }
.anni-unit { font-size: 12px; font-weight: 400; color: var(--text-secondary); margin-left: 2px; }
.anni-arrow { font-size: 18px; color: var(--text-muted); }

/* ===== 6. 快捷入口 ===== */
.quick-row {
  display: flex;
  gap: 8px;
  padding: 0 12px;
  margin-bottom: 8px;
}
.qr-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: #ffffff;
  border: 1px solid #ffd6e8;
  border-radius: var(--radius);
  padding: 12px 6px;
  box-shadow: var(--shadow-sm);
}
.qr-item:active { background: #fff5fb; }
.qr-emoji { font-size: 22px; }
.qr-label { font-size: 11px; color: var(--text-secondary); }

/* ===== 7. 底部数据 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  border: var(--glass-border);
  border-radius: var(--radius);
  margin: 0 12px 8px;
  padding: 10px 16px;
  gap: 0;
  box-shadow: var(--shadow-sm);
}
.sb-item { flex: 1; text-align: center; }
.sb-num { display: block; font-size: 14px; font-weight: 700; color: var(--pink-dark); }
.sb-label { display: block; font-size: 10px; color: var(--text-secondary); margin-top: 1px; }
