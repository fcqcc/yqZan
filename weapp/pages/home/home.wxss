/* pages/home/home.wxss — 可爱手绘风（对齐原型） */

page {
  --primary: #E891A4;
  --primary-dark: #D4708A;
  --primary-light: #FADCE6;
  --primary-pale: #FFF0F5;
  --accent: #FFD93D;
  --success: #7BC67B;
  --text: #5D4E60;
  --text-secondary: #8B7A8E;
  --text-light: #B8A9BB;
  --border: #F5C6D0;
  --line-dot: #f0e0e4;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF0F5 100%);
}

.page {
  height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF0F5 100%);
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.home-bottom-spacer {
  height: 32px;
}

/* ===== 头部 ===== */
.home-header {
  position: relative;
  padding: 0 16px 24px;
  color: #fff;
  border-radius: 0 0 30px 15px;
  overflow: hidden;
}

/* 背景装饰图 - 容器absolute，image无position */
.home-header__bg-wrap {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}
.home-header__bg {
  width: 100%;
  height: 100%;
  display: block;
}

.home-header__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(135deg, rgba(232,145,164,0.4) 0%, rgba(250,220,230,0.5) 100%);
  pointer-events: none;
}

/* 内容浮在背景之上 */
.home-header .page-nav,
.home-header .couple-info,
.home-header .home-badges,
.home-header .stats-row { position: relative; z-index: 2; }

.couple-info {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  color: var(--primary);
  border: 3px solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.couple-name {
  display: block;
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 3px;
}

.couple-days {
  display: block;
  font-size: 12px;
  opacity: 0.9;
}

.couple-days--bind {
  text-decoration: underline;
}

.home-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 4px 10px;
  border-radius: 12px 4px 12px 4px;
  font-size: 11px;
}

.badge--active {
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  transform: rotate(-1deg);
}

.stats-row {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14px 6px 14px 6px;
  padding: 12px 8px;
  text-align: center;
}

.stat-card__value {
  display: block;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 2px;
}

.stat-card__label {
  display: block;
  font-size: 10px;
  opacity: 0.9;
}

/* ===== 快捷入口 ===== */
/* ===== 焦点栏 ===== */
.focus-bar {
  padding: 8px 12px 20px;
  margin-top: -24px;
}
.focus-bar__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.focus-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: #fff;
  border-radius: 16px 6px 16px 6px;
  padding: 12px 4px 10px;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.15);
  border: 2px dashed var(--primary-light);
}
.focus-bar__item--press {
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 rgba(232, 145, 164, 0.15);
}
.focus-bar__icon {
  width: 38px;
  height: 38px;
  border-radius: 12px 4px 12px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.focus-bar__emoji {
  font-size: 20px;
}
.focus-bar__icon--rose { background: #FFF0F5; }
.focus-bar__icon--lavender { background: #F5EEFF; }
.focus-bar__icon--gold { background: #FFF8E1; }
.focus-bar__icon--coral { background: #FFEEE8; }
.focus-bar__icon--sky { background: #EEF7FF; }
.focus-bar__icon--green { background: #EEF9EE; }
.focus-bar__label {
  font-size: 11px;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ===== 签到 ===== */
.checkin-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 12px 14px;
  margin: 0 14px 12px;
  border-radius: 14px 6px 14px 6px;
  border: 2px dashed var(--border);
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.12);
}

.checkin-mini-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.checkin-mini-icon {
  width: 32px;
  height: 32px;
  color: var(--success);
}

.checkin-mini-text {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
}

.checkin-mini-sub {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.checkin-mini-btn {
  background: var(--success);
  color: #fff;
  padding: 6px 18px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  font-weight: 600;
}

.checkin-mini-btn--done {
  background: var(--primary-pale);
  color: var(--primary);
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px 10px;
}

.section-header--compact {
  padding: 0 14px 10px;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 12px;
  color: var(--text-light);
}

/* ===== 计划卡片 ===== */
.plan-card {
  background: #fff;
  border-radius: 16px 6px 16px 6px;
  padding: 16px;
  margin: 16px 14px 24px;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.12);
  border: 2px dashed var(--border);
}
.plan-card__tag {
  display: inline-block;
  font-size: 10px;
  color: #fff;
  background: linear-gradient(135deg, #E891A4, #D4708A);
  border-radius: 8px 2px 8px 2px;
  padding: 2px 8px;
  margin-bottom: 8px;
}

.plan-card--empty {
  text-align: center;
  padding: 32px 20px;
  color: var(--text-light);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.plan-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.plan-tag {
  background: var(--primary-pale);
  color: var(--primary-dark);
  padding: 3px 10px;
  border-radius: 10px 4px 10px 4px;
  font-size: 11px;
}

.plan-progress {
  margin: 10px 0;
}

.progress-bar {
  height: 10px;
  background: #f5f0f2;
  border-radius: 5px;
  overflow: hidden;
  border: 2px solid #f0e8ec;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 5px;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-secondary);
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 2px dotted var(--line-dot);
}

.plan-date {
  font-size: 11px;
  color: var(--text-light);
}

.plan-action-btn {
  background: var(--primary);
  color: #fff;
  padding: 6px 16px;
  border-radius: 14px 4px 14px 4px;
  font-size: 12px;
  box-shadow: 2px 2px 0 rgba(212, 112, 138, 0.3);
}

.plan-empty-title {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-top: 12px;
}

.plan-empty-hint {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  margin-top: 4px;
}

/* ===== 纪念日 ===== */
.anniversary-section {
  padding: 0 14px;
  margin-bottom: 24px;
}

.anniversary-card {
  background: linear-gradient(135deg, #FFF5FB, #FFE8F2);
  border-radius: 16px 8px 16px 8px;
  padding: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 2px dashed var(--border);
}

.anniversary-icon {
  width: 46px;
  height: 46px;
  background: var(--primary);
  border-radius: 12px 4px 12px 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.2);
  flex-shrink: 0;
}

.anniversary-info {
  flex: 1;
  min-width: 0;
}

.anniversary-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 3px;
}

.anniversary-date {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
}

.anniversary-days {
  text-align: right;
}

.anniversary-days__num {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary-dark);
}

.anniversary-days__pre {
  font-size: 11px;
  color: var(--text-secondary);
  margin-right: 2px;
}

.anniversary-days__unit {
  font-size: 11px;
  color: var(--text-secondary);
  margin-left: 2px;
}

/* ===== 浮动宠物 ===== */
.pet-float {
  position: fixed;
  z-index: 100;
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left 4s ease-in-out, top 4s ease-in-out;
}
.pet-float__img {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  box-shadow: 0 6px 20px rgba(232,145,164,0.35);
  pointer-events: none;
}
.pet-float__emoji {
  font-size: 72px;
  line-height: 1;
  filter: drop-shadow(0 4px 8px rgba(232,145,164,0.35));
  pointer-events: none;
}
.pet-float-shake {
  animation: petShake 0.5s ease-in-out;
}
@keyframes petShake {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-12deg) scale(1.1); }
  30% { transform: rotate(10deg) scale(1.05); }
  45% { transform: rotate(-8deg) scale(1.1); }
  60% { transform: rotate(6deg) scale(1.05); }
  80% { transform: rotate(-3deg) scale(1); }
  100% { transform: rotate(0deg) scale(1); }
}

/* ===== 卡片任务 ===== */
.block--tasks {
  padding: 0 14px 20px;
}

.task-card {
  background: #fff;
  border-radius: 16px 8px 16px 8px;
  border: 2px dashed var(--border);
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.12);
  overflow: hidden;
}

.ct-item {
  padding: 12px 14px;
  border-top: 2px dotted var(--line-dot);
}

.ct-item:first-child {
  border-top: none;
}

.ct-body {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.ct-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.ct-info {
  flex: 1;
}

.ct-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  display: block;
}

.ct-desc {
  font-size: 12px;
  color: var(--text-light);
  display: block;
  margin-top: 3px;
  line-height: 1.5;
}

.ct-actions {
  display: flex;
  gap: 8px;
  margin-left: 28px;
  margin-top: 8px;
}

.ct-btn {
  font-size: 12px;
  padding: 4px 12px;
  border-radius: 14px 4px 14px 4px;
  border: none;
  line-height: 1.4;
}

.ct-btn::after {
  border: none;
}

.ct-btn-forgive,
.ct-btn-complete {
  background: var(--primary);
  color: #fff;
}

.ct-btn-reject,
.ct-btn-decline {
  background: #FFF9F5;
  color: var(--text-secondary);
  border: 1px dashed var(--border);
}

.ct-btn-retry {
  background: #fff8e1;
  color: #7a6520;
}

.ct-btn-confirm {
  background: var(--success);
  color: #fff;
}

.ct-btn-dispute {
  background: rgba(200, 80, 80, 0.1);
  color: #c44;
}

.ct-done-badge,
.ct-waiting-text,
.ct-status-text {
  font-size: 12px;
  color: var(--text-light);
  margin-left: 28px;
  margin-top: 8px;
  display: block;
}

.ct-forgive-completed {
  font-size: 12px;
  color: var(--primary-dark);
  background: var(--primary-pale);
  padding: 8px 12px;
  border-radius: 10px 4px 10px 4px;
  margin: 8px 0 0 28px;
}

/* ===== 弹窗 ===== */
.modal-overlay,
.levelup-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(232, 145, 164, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.levelup-overlay {
  z-index: 2000;
}

.pet-modal {
  width: 300px;
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  padding: 8px 24px 28px;
  text-align: center;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.2);
}

.pet-modal-handle {
  width: 36px;
  height: 4px;
  background: var(--primary-light);
  border-radius: 2px;
  margin: 10px auto 16px;
}

.pet-modal-img {
  width: 88px;
  height: 88px;
  display: block;
  margin: 0 auto;
}

.pet-modal-emoji {
  font-size: 64px;
  line-height: 1;
}

.pet-modal-name {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  display: block;
  margin-bottom: 16px;
}

.pet-modal-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  font-size: 11px;
}

.pet-modal-stat-label {
  width: 56px;
  text-align: left;
  color: var(--text-secondary);
  font-weight: 600;
}

.pet-modal-bar {
  flex: 1;
  height: 8px;
  background: #f0e8ec;
  border-radius: 999px;
  overflow: hidden;
  border: 2px solid #f0e8ec;
}

.pet-modal-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-dark), var(--primary));
  border-radius: 999px;
}

.pet-modal-stat-val {
  width: 48px;
  text-align: right;
  font-weight: 700;
  color: var(--primary-dark);
}

.pet-modal-evo {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #C9A0E8;
  margin: 8px 0;
}

.pet-modal-desc {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  line-height: 1.6;
  margin: 12px 0 16px;
}

.pet-modal-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border: none;
  border-radius: 25px 10px 25px 10px;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}

.pet-modal-btn::after {
  border: none;
}

.pet-modal-close {
  display: block;
  margin-top: 14px;
  font-size: 12px;
  color: var(--text-light);
}

.levelup-modal {
  width: 260px;
  padding: 40px 32px;
  text-align: center;
  position: relative;
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.2);
}

.levelup-ring {
  position: absolute;
  inset: -20px;
  border: 2px solid rgba(232, 145, 164, 0.35);
  border-radius: 50%;
}

.levelup-kicker {
  display: block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
  color: var(--primary-dark);
}

.levelup-lv {
  display: block;
  font-size: 52px;
  font-weight: 900;
  color: var(--text);
  margin: 8px 0;
}

.levelup-sub {
  display: block;
  font-size: 13px;
  color: var(--text-light);
}

.adventure-modal {
  width: 300px;
  padding: 32px 24px 24px;
  text-align: center;
  border-radius: 20px 8px 20px 8px;
  background: #fff;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.2);
}

.adventure-emoji {
  font-size: 48px;
  display: block;
  margin-bottom: 8px;
}

.adventure-title {
  display: block;
  font-size: 17px;
  font-weight: 800;
  color: var(--text);
}

.adventure-desc {
  display: block;
  font-size: 12px;
  color: var(--text-light);
  margin-top: 4px;
}

.adventure-rewards {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 20px 0;
}

.adventure-reward {
  flex: 1;
  padding: 12px 8px;
  background: var(--primary-pale);
  border-radius: 14px 6px 14px 6px;
  border: 1px dashed var(--border);
}

.ar-num {
  display: block;
  font-size: 20px;
  font-weight: 800;
  color: var(--primary-dark);
}

.ar-label {
  display: block;
  font-size: 10px;
  color: var(--text-light);
  margin-top: 2px;
}

.adventure-week {
  font-size: 11px;
  color: var(--text-light);
  padding: 8px 12px;
  background: #FFF9F5;
  border-radius: 10px 4px 10px 4px;
  margin-bottom: 8px;
}

.adventure-tap {
  font-size: 11px;
  color: var(--text-light);
}

.guest-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(232, 145, 164, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.guest-card {
  background: #fff;
  border-radius: 20px 8px 20px 8px;
  padding: 32px 24px;
  text-align: center;
  border: 2px dashed var(--border);
  box-shadow: 4px 4px 0 rgba(212, 112, 138, 0.2);
  max-width: 300px;
}

.guest-card-icon {
  font-size: 44px;
  margin-bottom: 12px;
}

.guest-card-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 6px;
}

.guest-card-desc {
  font-size: 13px;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24px;
}

.guest-card-btn {
  border: none;
  border-radius: 25px 10px 25px 10px;
  padding: 12px 0;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  width: 100%;
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}

.guest-card-btn::after {
  border: none;
}

/* ===== 纪念日滚动条 ===== */
.anni-ticker {
  height: 44px;
  background: linear-gradient(90deg, #E891A4, #F0A5B5);
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 0 14px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.anni-ticker__inner {
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
}
.anni-ticker__tag {
  font-size: 18px;
  margin-right: 10px;
  flex-shrink: 0;
}
.anni-ticker__track {
  display: flex;
  overflow: hidden;
  flex: 1;
}
.anni-ticker__text {
  font-size: 15px;
  color: #fff;
  white-space: nowrap;
  animation: anniScroll 10s linear infinite;
  padding-right: 40px;
}
@keyframes anniScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.anni-ticker__arrow {
  font-size: 18px;
  color: rgba(255,255,255,0.7);
  margin-left: 4px;
  flex-shrink: 0;
}
.anni-ticker--hover {
  opacity: 0.9;
}

/* ===== 紧凑日历入口 ===== */
.cal-mini {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  margin: 0 16px 8px;
  background: rgba(232,145,164,0.08);
  border-radius: 14px 6px 14px 6px;
  border: 1.5px dashed #F0C8D4;
}
.cal-mini__icon {
  font-size: 16px;
  margin-right: 6px;
}
.cal-mini__text {
  font-size: 13px;
  color: var(--primary-dark);
  flex: 1;
}
.cal-mini__arrow {
  font-size: 16px;
  color: var(--text-light);
}
.cal-mini--hover {
  background: rgba(232,145,164,0.15);
}

.checkin-bounce {
  animation: checkinBounce 0.5s ease;
}

@keyframes checkinBounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.05); }
  50% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

/* ===== 宠物动画（首页用） ===== */
/* 互动反馈emoji上浮 */
@keyframes emojiFloatUp {
  0% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-40px); }
}
.emoji-float-up {
  animation: emojiFloatUp 1.2s ease-out forwards;
}

/* 抚摸：扇形摆动 */
@keyframes petFanShake {
  0% { transform: rotate(0deg); }
  20% { transform: rotate(-12deg); }
  40% { transform: rotate(10deg); }
  60% { transform: rotate(-8deg); }
  80% { transform: rotate(5deg); }
  100% { transform: rotate(0deg); }
}
.pet-fan-shake {
  animation: petFanShake 0.6s ease !important;
}

/* 喂食：剧烈抖动 */
@keyframes petViolentShake {
  0% { transform: translateX(0); }
  10% { transform: translateX(-6px) rotate(-3deg); }
  20% { transform: translateX(6px) rotate(3deg); }
  30% { transform: translateX(-8px) rotate(-4deg); }
  40% { transform: translateX(8px) rotate(4deg); }
  50% { transform: translateX(-6px) rotate(-2deg); }
  60% { transform: translateX(6px) rotate(2deg); }
  70% { transform: translateX(-4px) rotate(-1deg); }
  80% { transform: translateX(4px) rotate(1deg); }
  90% { transform: translateX(-2px); }
  100% { transform: translateX(0); }
}
.pet-violent-shake {
  animation: petViolentShake 0.8s ease !important;
}

/* 散步：左右蹦跳 */
@keyframes petWalkAnim {
  0% { transform: translateY(0) translateX(0); }
  15% { transform: translateY(-15px) translateX(-5px); }
  30% { transform: translateY(0) translateX(0); }
  45% { transform: translateY(-12px) translateX(5px); }
  60% { transform: translateY(0) translateX(0); }
  75% { transform: translateY(-8px) translateX(-3px); }
  100% { transform: translateY(0) translateX(0); }
}
.pet-walk-anim {
  animation: petWalkAnim 0.8s ease !important;
}

/* 玩耍：无规则快速移动 */
@keyframes petWildMove {
  0% { transform: translate(0, 0) rotate(0deg); }
  12% { transform: translate(8px, -10px) rotate(8deg); }
  25% { transform: translate(-6px, 6px) rotate(-5deg); }
  37% { transform: translate(10px, 4px) rotate(6deg); }
  50% { transform: translate(-8px, -8px) rotate(-4deg); }
  62% { transform: translate(5px, 10px) rotate(3deg); }
  75% { transform: translate(-10px, -4px) rotate(-6deg); }
  87% { transform: translate(6px, 6px) rotate(4deg); }
  100% { transform: translate(0, 0) rotate(0deg); }
}
.pet-wild-move {
  animation: petWildMove 0.7s ease !important;
}

/* 聊天：轻快左右摇晃 */
@keyframes petTalkAnim {
  0% { transform: rotate(0deg); }
  15% { transform: rotate(-6deg); }
  30% { transform: rotate(5deg); }
  45% { transform: rotate(-4deg); }
  60% { transform: rotate(3deg); }
  80% { transform: rotate(-2deg); }
  100% { transform: rotate(0deg); }
}
.pet-talk-anim {
  animation: petTalkAnim 0.6s ease !important;
}

/* === 闲时动画（根据形态） === */
@keyframes petBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
.pet-bounce {
  animation: petBounce 1.5s ease-in-out infinite;
}

@keyframes petWalkSlow {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(4px); }
  50% { transform: translateX(0); }
  75% { transform: translateX(-4px); }
}
.pet-walk-slow {
  animation: petWalkSlow 3s ease-in-out infinite;
}

@keyframes petWalk {
  0%, 100% { transform: translateX(0) translateY(0); }
  25% { transform: translateX(5px) translateY(-2px); }
  50% { transform: translateX(0) translateY(0); }
  75% { transform: translateX(-5px) translateY(-2px); }
}
.pet-walk {
  animation: petWalk 2s ease-in-out infinite;
}

@keyframes petExcited {
  0%, 100% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(1.08) rotate(-3deg); }
  50% { transform: scale(1) rotate(0deg); }
  75% { transform: scale(1.08) rotate(3deg); }
}
.pet-excited {
  animation: petExcited 1.2s ease-in-out infinite;
}

@keyframes petMagic {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
  25% { transform: scale(1.1) rotate(-5deg); opacity: 0.85; }
  50% { transform: scale(1) rotate(0deg); opacity: 1; }
  75% { transform: scale(1.1) rotate(5deg); opacity: 0.85; }
}
.pet-magic {
  animation: petMagic 1.8s ease-in-out infinite;
}

@keyframes petSleep {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}
.pet-sleep {
  animation: petSleep 3s ease-in-out infinite;
}

/* ===== 宠物互动次数标记 ===== */
.pet-interact-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--primary-pale);
  color: var(--primary-dark);
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 10px 4px 10px 4px;
  border: 1px dashed var(--primary);
  position: relative;
  z-index: 1;
  margin-bottom: 6px;
}
.pet-interact-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  display: inline-block;
}
.pet-interact-dot--used {
  opacity: 0.25;
}

/* ===== 首页抽签卡片（突出样式） ===== */
.dc-home-card {
  margin: 0 14px 12px;
  padding: 16px 18px;
  background: linear-gradient(135deg, #FADCE6 0%, #FFF0F5 100%);
  border: 2px dashed #E891A4;
  border-radius: 18px 8px 20px 10px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: 3px 3px 0 rgba(232, 145, 164, 0.18);
}
.dc-home-card__bg {
  position: absolute;
  top: -20px; right: -20px;
  width: 100px; height: 100px;
  background: radial-gradient(circle, rgba(232, 145, 164, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.dc-home-card__row {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  position: relative;
  z-index: 1;
}
.dc-home-card__emoji {
  font-size: 40px;
  filter: drop-shadow(2px 2px 0 rgba(212, 112, 138, 0.25));
  transform: rotate(-8deg);
  flex-shrink: 0;
}
.dc-home-card__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.dc-home-card__title {
  font-size: 15px;
  font-weight: 700;
  color: #5D4E60;
}
.dc-home-card__sub {
  font-size: 11px;
  color: #8B7A8E;
}
.dc-home-card__arrow {
  font-size: 24px;
  color: #D4708A;
  font-weight: 700;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.dc-home-card--press {
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 rgba(232, 145, 164, 0.18);
}
