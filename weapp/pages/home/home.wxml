<!-- pages/home/home.wxml — 一起攒 · 首页 -->
<scroll-view class="page" scroll-y>
  <!-- ===== 1. 伴侣+等级 ===== -->
  <view class="compact-header">
    <view class="ch-left">
      <text class="ch-name">{{userInfo.nickname}}</text>
      <text wx:if="{{partner}}" class="ch-partner">💑 {{partner.nickname}}</text>
      <text wx:else class="ch-partner ch-bind" bindtap="goBind">➕ 绑定伴侣</text>
      <text class="ch-days" wx:if="{{together_days}}">· 第{{together_days}}天</text>
    </view>
    <view class="ch-level" bindtap="go" data-url="/pages/level/level">
      <text class="ch-lv">Lv{{level}}</text>
      <view class="ch-lv-bar"><view class="ch-lv-fill" style="width:{{progress_pct}}%"></view></view>
    </view>
  </view>

  <!-- ===== 2. 攒钱总进度（核心大卡片） ===== -->
  <view class="money-card" bindtap="go" data-url="/pages/plans/plans">
    <view class="money-top">
      <view class="money-info">
        <text class="money-label">累计已存</text>
        <text class="money-amount">{{delivered_text}}</text>
        <text wx:if="{{target_text != '¥0'}}" class="money-target">总目标 {{target_text}}</text>
        <text wx:else class="money-target">先创建一个存钱计划吧 🎯</text>
      </view>
      <view class="money-icon">💰</view>
    </view>
    <view class="money-bar">
      <view class="money-bar-fill" style="width:{{plan_progress}}%"></view>
    </view>
    <view class="money-footer">
      <text class="money-pct">{{plan_progress.toFixed(1)}}%</text>
      <text class="money-plans-count" wx:if="{{plan_count > 0}}">{{plan_count}} 个计划进行中</text>
    </view>
  </view>

  <!-- ===== 3. 各计划进度列表 ===== -->
  <view wx:if="{{plans.length > 0}}" class="plans-mini-list">
    <view class="pml-header">
      <text class="pml-title">📋 我的计划</text>
      <text class="pml-more" bindtap="go" data-url="/pages/plans/plans">全部 ›</text>
    </view>
    <view wx:for="{{plans.slice(0,3)}}" wx:key="id" class="pml-item" bindtap="go" data-url="/pages/plans/plans">
      <view class="pml-top">
        <text class="pml-name">{{item.title}}</text>
        <text class="pml-amount">¥{{item._curText}} / ¥{{item._tarText}}</text>
      </view>
      <view class="pml-bar">
        <view class="pml-bar-fill" style="width:{{item.progressPct}}%"></view>
      </view>
    </view>
  </view>

  <!-- ===== 4. 空状态 ===== -->
  <view wx:if="{{plans.length === 0}}" class="empty-state" bindtap="go" data-url="/pages/plans/plans">
    <text class="empty-icon">🐷</text>
    <text class="empty-text">还没有存钱计划</text>
    <text class="empty-sub">点我创建一个 →</text>
  </view>

  <!-- ===== 5. 纪念日倒计时 ===== -->
  <view wx:if="{{nearestAnni}}" class="anni-row" bindtap="go" data-url="/pages/anniversaries/anniversaries">
    <text class="anni-emoji">⏰</text>
    <view class="anni-info">
      <text class="anni-label">距离{{nearestAnni.title}}</text>
      <text class="anni-days">{{nearestAnni.days}}<text class="anni-unit">天</text></text>
    </view>
    <text class="anni-arrow">›</text>
  </view>

  <!-- ===== 6. 快捷入口 ===== -->
  <view class="quick-row">
    <view class="qr-item" catchtap="go" data-url="/pages/anniversaries/anniversaries">
      <text class="qr-emoji">🎉</text>
      <text class="qr-label">纪念日</text>
    </view>
    <view class="qr-item" catchtap="go" data-url="/pages/backpack/backpack">
      <text class="qr-emoji">🎒</text>
      <text class="qr-label">背包</text>
    </view>
    <view class="qr-item" catchtap="go" data-url="/pages/gifts/gifts">
      <text class="qr-emoji">🎁</text>
      <text class="qr-label">礼物</text>
    </view>
    <view class="qr-item" catchtap="go" data-url="/pages/level/level">
      <text class="qr-emoji">🏆</text>
      <text class="qr-label">等级</text>
    </view>
    <view class="qr-item" catchtap="go" data-url="/pages/gacha/gacha">
      <text class="qr-emoji">🎰</text>
      <text class="qr-label">抽卡</text>
    </view>
  </view>

  <!-- ===== 7. 底部数据 ===== -->
  <view class="stats-bar" bindtap="go" data-url="/pages/plans/plans">
    <view class="sb-item"><text class="sb-num">{{plan_count}}</text><text class="sb-label">计划</text></view>
    <view class="sb-item"><text class="sb-num">{{anni_count}}</text><text class="sb-label">纪念日</text></view>
    <view class="sb-item"><text class="sb-num">{{gift_count}}</text><text class="sb-label">礼物</text></view>
    <view class="sb-item"><text class="sb-num">{{together_days}}天</text><text class="sb-label">相伴</text></view>
  </view>

  <!-- ===== 8. 宠物展示区域 ===== -->
  <view class="pet-area" bindtap="showPetModal" data-pet="1">
    <view class="pet-container {{petAnimationClass}}">
      <text class="pet-emoji">{{petEmoji}}</text>
    </view>
    <text class="pet-intimacy-text">❤️ 亲密度 Lv{{intimacyLevel}}</text>
    <text class="pet-tip" wx:if="{{intimacyLevel <= 2}}">多存钱能提升亲密度 🪙</text>
    <text class="pet-tip" wx:elif="{{intimacyLevel <= 5}}">一起加油存钱吧 💪</text>
    <text class="pet-tip" wx:elif="{{intimacyLevel <= 8}}">感情越来越好了 💕</text>
    <text class="pet-tip" wx:else>幸福满级！🎉</text>
    <text class="pet-click-hint">点我互动 ›</text>
  </view>
</scroll-view>

<!-- ===== 宠物信息弹窗 ===== -->
<view wx:if="{{showPetModal}}" class="modal-overlay" bindtap="hidePetModal">
  <view class="pet-modal" catchtap="stopPropagation">
    <text class="pet-modal-emoji">{{petEmoji}}</text>
    <text class="pet-modal-name">{{petName}}</text>
    <view class="pet-modal-level-row">
      <text class="pet-modal-level-label">亲密度</text>
      <text class="pet-modal-level-val">Lv{{intimacyLevel}}</text>
    </view>
    <view class="pet-modal-bar-wrap">
      <view class="pet-modal-bar">
        <view class="pet-modal-fill" style="width:{{intimacyPct}}%"></view>
      </view>
      <text class="pet-modal-pct">{{intimacyPct}}%</text>
    </view>
    <text class="pet-modal-desc">{{petDescription}}</text>
    <button class="pet-modal-btn" bindtap="feedCurrentPet">🍼 投喂宠物</button>
    <text class="pet-modal-close" bindtap="hidePetModal">✕</text>
  </view>
</view>
