<view class="app-root app-theme-{{uiTheme}} page">
  <scroll-view class="home-scroll" scroll-y show-scrollbar="{{false}}">

    <!-- 顶部导航占位 -->
    <view class="page-nav" style="padding-top: {{statusBarHeight}}px">
      <view class="page-nav__bar" style="height: {{navBarHeight}}px"></view>
    </view>

    <!-- 顶部条：头像 + 信息 + 徽章（无统计） -->
    <view class="top-strip">
      <view class="top-avatar">{{myInitial}}</view>
      <view class="top-info">
        <text class="top-name">{{coupleDisplayName || userInfo.nickname || '小可爱'}}</text>
        <text class="top-meta" wx:if="{{partner}}">已在一起 {{together_days}} 天</text>
        <text class="top-meta top-meta--bind" wx:else bindtap="goBind">绑定伴侣，开启双人攒钱</text>
      </view>
      <view class="top-badges">
        <view class="top-badge top-badge--fire" wx:if="{{sparkCount > 0}}">火花 {{sparkCount}}</view>
        <view class="top-badge" bindtap="goLevel">Lv.{{level}}</view>
      </view>
    </view>

    <!-- 英雄区：角色主图 -->
    <view class="hero-section">
      <image class="hero-img" src="/assets/images/home_banner_bg.png" mode="aspectFill" />
      <view class="hero-overlay">
        <view class="hero-text">
          <text class="hero-label">我们的小家</text>
          <text class="hero-amount">{{delivered_text}}<small>已攒</small></text>
        </view>
        <view class="hero-cta" catchtap="goTab" data-url="/pages/plans/plans">记一笔</view>
      </view>
    </view>

    <!-- ===== 存钱计划（v2 面板风格） ===== -->
    <block wx:if="{{featuredPlan}}">
      <view class="panel-plan-card">
        <image src="/assets/images/panel_plan_bg.png" mode="aspectFill" class="panel-plan-bg" />
        <view class="panel-plan-content">
          <text class="panel-plan-tag">存钱计划</text>
          <text class="panel-plan-name">{{featuredPlan.title}}</text>
          <view class="panel-plan-amounts">
            <text class="panel-plan-curr">{{featuredPlan._curText}}</text>
            <text class="panel-plan-tar">/ {{featuredPlan._tarText}}</text>
          </view>
          <view class="panel-plan-bar">
            <view class="panel-plan-fill" style="width:{{featuredPlan.progressPct}}%"></view>
          </view>
          <view class="panel-plan-meta">
            <text class="panel-plan-date">{{featuredPlan.deadline_date || '未设截止日期'}} · {{featuredPlan.progressPctText}}%</text>
            <view wx:if="{{!featuredPlan.done}}" class="panel-plan-cta" catchtap="goTab" data-url="/pages/plans/plans">记一笔</view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="plan-card plan-card--empty" bindtap="goTab" data-url="/pages/plans/plans">
      <view class="plan-card__tag">存钱计划</view>
      <cp-icon name="target" size="48" />
      <text class="plan-empty-title">还没有存钱计划</text>
      <text class="plan-empty-hint">设定一个小目标，从今天开始</text>
    </view>

    <!-- 快捷功能：圆形图标（新素材） -->
    <view class="circle-actions">
      <view class="circle-action" catchtap="goTab" data-url="/pages/plans/plans">
        <image class="circle-icon" src="/assets/images/func_savings.png" mode="aspectFill" />
        <text class="circle-label">存钱</text>
      </view>
      <view class="circle-action" catchtap="go" data-url="/pages/anniversaries/anniversaries">
        <image class="circle-icon" src="/assets/images/func_anniversary.png" mode="aspectFill" />
        <text class="circle-label">纪念日</text>
      </view>
      <view class="circle-action" catchtap="go" data-url="/pages/gacha/gacha">
        <image class="circle-icon" src="/assets/images/func_card.png" mode="aspectFill" />
        <text class="circle-label">抽卡</text>
      </view>
      <view class="circle-action" catchtap="go" data-url="/pages/decision/decision">
        <image class="circle-icon" src="/assets/images/func_draw.png" mode="aspectFill" />
        <text class="circle-label">抽签</text>
      </view>
      <view class="circle-action" catchtap="go" data-url="/pages/calendar/calendar">
        <image class="circle-icon" src="/assets/images/func_calendar.png" mode="aspectFill" />
        <text class="circle-label">日历</text>
      </view>
      <view class="circle-action" catchtap="go" data-url="/pages/notes/notes">
        <image class="circle-icon" src="/assets/images/func_message.png" mode="aspectFill" />
        <text class="circle-label">留言</text>
      </view>
    </view>

    <!-- ===== 每日签到（自动，仅显示徽章） ===== -->

    <!-- ===== 纪念日提醒（v2 面板风格） ===== -->
    <view wx:if="{{nearestAnni || todayAnni}}" class="panel-anni-card {{todayAnni ? 'panel-anni--today' : ''}}" bindtap="go" data-url="/pages/anniversaries/anniversaries">
      <image src="/assets/images/panel_anni_bg.png" mode="aspectFill" class="panel-anni-bg" />
      <view class="panel-anni-content">
        <view class="panel-anni-icon">
          <cp-icon name="heart" size="28" color="#E891A4" />
        </view>
        <view class="panel-anni-text">
          <text class="panel-anni-name">{{todayAnni ? todayAnni.title : nearestAnni.title}}</text>
          <text class="panel-anni-date">{{todayAnni ? '🎉 就是今天！' : nearestAnni.date}}</text>
        </view>
        <view wx:if="{{!todayAnni}}" class="panel-anni-days">
          <text class="panel-anni-days-num">{{nearestAnni.days}}</text>
          <text class="panel-anni-days-lbl">天后</text>
        </view>
        <view wx:else class="panel-anni-days panel-anni-days--today">
          <text class="panel-anni-today-icon">🎉</text>
          <text class="panel-anni-today-lbl">今天</text>
        </view>
      </view>
    </view>

    <!-- 浮动宠物 -->
    <view wx:if="{{pet}}" class="pet-float {{petFloatAnim}}" style="left: {{petFloatX}}px; top: {{petFloatY}}px;" bindtap="onPetFloatTap">
      <view wx:if="{{petTalkBubble}}" class="pet-talk-bubble">{{petTalkBubble}}</view>
      <image wx:if="{{petImageUrl}}" class="pet-float__img" src="{{petImageUrl}}" mode="aspectFit"></image>
      <text wx:else class="pet-float__emoji">{{petEmoji}}</text>
    </view>

    <view wx:if="{{cardTasksAsAssigner.length > 0}}" class="block block--tasks">
      <view class="section-header section-header--compact">
        <text class="section-title">我发起的任务</text>
      </view>
      <view class="task-card">
        <view wx:for="{{cardTasksAsAssigner}}" wx:key="id" class="ct-item ct-assigner {{item.card_item_id === 'forgive_me' ? 'ct-item--forgive' : ''}} {{item.card_item_id === 'please_forgive_me' ? 'ct-item--please-forgive' : ''}}">
          <view class="ct-body">
            <text class="ct-icon">{{item.card_item_id === 'forgive_me' ? '🥺' : item.card_item_id === 'please_forgive_me' ? '💎' : '📋'}}</text>
            <view class="ct-info">
              <text class="ct-name">{{item.card_name || '任务'}}</text>
              <text class="ct-desc">{{item.task_display_text}}</text>
            </view>
          </view>
          <view wx:if="{{item.card_item_id === 'forgive_me' && item.rejected && item.status === 'pending'}}" class="ct-actions">
            <button class="ct-btn ct-btn-retry" bindtap="onCardRetry" data-id="{{item.id}}">再次请求</button>
          </view>
          <view wx:elif="{{item.card_item_id === 'forgive_me' && item.status === 'completed'}}" class="ct-forgive-completed" bindtap="onCardForgive" data-id="{{item.id}}" data-mode="ack">对方原谅你了，点我确认</view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && item.rejected && item.status === 'pending'}}" class="ct-actions ct-actions--please">
            <button class="ct-btn ct-btn-retry ct-btn--please" bindtap="onCardRetry" data-id="{{item.id}}">再次诚挚请求</button>
          </view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && item.status === 'completed'}}" class="ct-forgive-completed ct-forgive-completed--please" bindtap="onCardForgive" data-id="{{item.id}}" data-mode="ack">对方原谅你了，快去找他当面认错吧</view>
          <view wx:elif="{{item.status === 'completed_pending'}}" class="ct-actions">
            <button class="ct-btn ct-btn-confirm" bindtap="onCardConfirm" data-id="{{item.id}}">确认完成</button>
            <button class="ct-btn ct-btn-dispute" bindtap="onCardDispute" data-id="{{item.id}}">未完成</button>
          </view>
          <view wx:elif="{{item.status === 'disputed'}}" class="ct-actions">
            <text class="ct-waiting-text">等待对方重新完成</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{cardTasksAsAssignee.length > 0}}" class="block block--tasks">
      <view class="section-header section-header--compact">
        <text class="section-title">指派给我的任务</text>
      </view>
      <view class="task-card">
        <view wx:for="{{cardTasksAsAssignee}}" wx:key="id" class="ct-item ct-assignee {{item.card_item_id === 'forgive_me' ? 'ct-item--forgive' : ''}} {{item.card_item_id === 'please_forgive_me' ? 'ct-item--please-forgive' : ''}}">
          <view class="ct-body">
            <text class="ct-icon">{{item.card_item_id === 'forgive_me' ? '🥺' : item.card_item_id === 'please_forgive_me' ? '💎' : '📋'}}</text>
            <view class="ct-info">
              <text class="ct-name">{{item.card_name || '任务'}}</text>
              <text class="ct-desc">{{item.task_display_text}}</text>
            </view>
          </view>
          <view wx:if="{{item.card_item_id === 'forgive_me' && !item.rejected && item.status === 'pending'}}" class="ct-actions">
            <button class="ct-btn ct-btn-forgive" bindtap="onCardForgive" data-id="{{item.id}}">愿意原谅</button>
            <button class="ct-btn ct-btn-reject" bindtap="onCardReject" data-id="{{item.id}}">不愿意</button>
          </view>
          <view wx:elif="{{item.card_item_id === 'forgive_me' && item.rejected}}" class="ct-status-text">已收到，等待你的决定</view>
          <view wx:elif="{{item.card_item_id === 'forgive_me' && item.status === 'completed_pending'}}" class="ct-status-text">等待对方确认中…</view>
          <view wx:elif="{{item.card_item_id === 'forgive_me' && item.status === 'completed'}}" class="ct-done-badge">已原谅</view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && !item.rejected && item.status === 'pending'}}" class="ct-actions ct-actions--please">
            <button class="ct-btn ct-btn-forgive ct-btn--please" bindtap="onCardForgive" data-id="{{item.id}}">原谅TA</button>
            <button class="ct-btn ct-btn-reject" bindtap="onCardReject" data-id="{{item.id}}">不愿意</button>
          </view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && item.rejected}}" class="ct-status-text ct-status-text--please">等待TA的再次诚挚道歉…</view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && item.status === 'completed_pending'}}" class="ct-status-text">等待对方确认中…</view>
          <view wx:elif="{{item.card_item_id === 'please_forgive_me' && item.status === 'completed'}}" class="ct-done-badge ct-done-badge--please">已原谅</view>
          <view wx:elif="{{item.status === 'pending' && item.card_item_id !== 'serve_me'}}" class="ct-actions">
            <button class="ct-btn ct-btn-complete" bindtap="onCardComplete" data-id="{{item.id}}">已完成</button>
            <button class="ct-btn ct-btn-decline" bindtap="onCardDecline" data-id="{{item.id}}">我不要</button>
          </view>
          <view wx:elif="{{item.status === 'pending' && item.card_item_id === 'serve_me'}}" class="ct-actions">
            <button class="ct-btn ct-btn-complete" bindtap="onCardComplete" data-id="{{item.id}}">已完成</button>
          </view>
          <view wx:elif="{{item.status === 'disputed' && item.card_item_id !== 'serve_me'}}" class="ct-actions">
            <button class="ct-btn ct-btn-complete" bindtap="onCardComplete" data-id="{{item.id}}">已完成</button>
            <button class="ct-btn ct-btn-decline" bindtap="onCardDecline" data-id="{{item.id}}">我不要</button>
          </view>
          <view wx:elif="{{item.status === 'disputed' && item.card_item_id === 'serve_me'}}" class="ct-actions">
            <button class="ct-btn ct-btn-complete" bindtap="onCardComplete" data-id="{{item.id}}">已完成</button>
          </view>
        </view>
      </view>
    </view>

    <view class="home-bottom-spacer"></view>
  </scroll-view>

  <!-- 非遮挡式游客引导横幅 -->
  <view wx:if="{{isGuest}}" class="guest-cta" bindtap="_guestPrompt">
    <text class="guest-cta-icon">💕</text>
    <text class="guest-cta-text">登录后和TA一起存钱养宠物</text>
    <text class="guest-cta-arrow">›</text>
  </view>

  <!-- 弹窗 -->
  <view wx:if="{{showPetModal}}" class="modal-overlay" bindtap="hidePetModal">
    <view class="pet-modal" catchtap="stopPropagation">
      <view class="pet-modal-handle"></view>
      <view class="pet-modal-visual">
        <image wx:if="{{petImageUrl}}" class="pet-modal-img" src="{{petImageUrl}}" mode="aspectFit"></image>
        <text wx:else class="pet-modal-emoji">{{petEmoji}}</text>
      </view>
      <text class="pet-modal-name">{{petName}}</text>
      <view class="pet-modal-stat">
        <text class="pet-modal-stat-label">亲密度</text>
        <view class="pet-modal-bar"><view class="pet-modal-fill" style="width:{{intimacyPct}}%"></view></view>
        <text class="pet-modal-stat-val">{{intimacyPct}}%</text>
      </view>
      <view class="pet-modal-stat" wx:if="{{!petEvolutionReady}}">
        <text class="pet-modal-stat-label">经验 Lv.{{petLevel}}</text>
        <view class="pet-modal-bar"><view class="pet-modal-fill" style="width:{{petExpNeeded > 0 ? (petExp / petExpNeeded * 100) : 0}}%"></view></view>
        <text class="pet-modal-stat-val">{{petExp}}/{{petExpNeeded}}</text>
      </view>
      <text wx:elif="{{petEvolutionReady}}" class="pet-modal-evo">可进化 · 前往宠物管理</text>
      <text class="pet-modal-desc">{{petDescription}}</text>
      <button class="pet-modal-btn" bindtap="feedCurrentPet">投喂宠物</button>
      <text class="pet-modal-close" bindtap="hidePetModal">关闭</text>
    </view>
  </view>

  <view wx:if="{{showLevelUp}}" class="levelup-overlay">
    <view class="levelup-modal">
      <image src="/assets/images/gacha_prob_bg.png" mode="aspectFill" class="levelup-bg" />
      <view class="levelup-overlay-bg"></view>
      <view class="levelup-content">
        <view class="levelup-star levelup-star--1">⭐</view>
        <view class="levelup-star levelup-star--2">✨</view>
        <view class="levelup-star levelup-star--3">🌟</view>
        <text class="levelup-kicker">🎉 恭喜升级</text>
        <text class="levelup-lv">Lv.{{levelUpNewLevel}}</text>
        <text class="levelup-sub">情侣等级提升</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showAdventure && adventureData}}" class="levelup-overlay" bindtap="hideAdventure">
    <view class="adventure-modal" catchtap="stopPropagation">
      <text class="adventure-emoji">{{adventureData.pet_emoji}}</text>
      <text class="adventure-title">{{adventureData.pet_name}} 冒险归来</text>
      <text class="adventure-desc">{{adventureData.passive_name}}</text>
      <view class="adventure-rewards">
        <view wx:if="{{adventureData.reward.shards > 0}}" class="adventure-reward">
          <text class="ar-num">+{{adventureData.reward.shards}}</text>
          <text class="ar-label">积分</text>
        </view>
        <view wx:if="{{adventureData.reward.exp > 0}}" class="adventure-reward">
          <text class="ar-num">+{{adventureData.reward.exp}}</text>
          <text class="ar-label">经验</text>
        </view>
        <view wx:if="{{adventureData.reward.tickets > 0}}" class="adventure-reward">
          <text class="ar-num">+{{adventureData.reward.tickets}}</text>
          <text class="ar-label">抽卡券</text>
        </view>
      </view>
      <view wx:if="{{adventureData.week_summary}}" class="adventure-week">
        <text>本周累计 · 积分 {{adventureData.week_summary.total_shards}} · 经验 {{adventureData.week_summary.total_exp}}</text>
      </view>
      <text class="adventure-tap">轻触关闭</text>
    </view>
  </view>

  <!-- 自定义游客弹窗 -->
  <view wx:if="{{showGuestModal}}" class="modal-overlay" bindtap="closeGuestModal">
    <view class="guest-modal" catchtap="stopPropagation">
      <view class="guest-modal-icon">💕</view>
      <text class="guest-modal-title">登录体验完整功能</text>
      <text class="guest-modal-desc">登录后可以和TA一起：共同存钱、宠物养成、纪念日提醒、每日签到</text>
      <view class="guest-modal-actions">
        <button class="guest-btn guest-btn--primary" bindtap="goLogin">去登录</button>
        <button class="guest-btn guest-btn--cancel" bindtap="closeGuestModal">暂不</button>
      </view>
    </view>
  </view>
</view>
