<!-- pages/home/home.wxml — 首页 v2 -->
<scroll-view class="page" scroll-y>
  <!-- ===== 情侣信息头 ===== -->
  <view class="profile-header">
    <view class="ph-avatars">
      <text class="ph-avatar">{{userInfo.nickname.slice(0,1)}}</text>
      <text class="ph-heart">💕</text>
      <text class="ph-avatar" wx:if="{{partner}}">{{partner.nickname.slice(0,1)}}</text>
    </view>
    <view class="ph-info">
      <text class="ph-names">{{userInfo.nickname}} / {{partner ? partner.nickname : '等待绑定'}}</text>
      <text class="ph-level-badge">Lv{{level}}</text>
    </view>
  </view>

  <!-- ===== 存款进度 ===== -->
  <view class="card save-card" bindtap="go" data-url="/pages/plans/plans">
    <view class="card-row">
      <view>
        <text class="card-sub">已存金额</text>
        <text class="save-amount">{{delivered_text}}</text>
        <text class="card-sub">目标 {{target_text}}</text>
      </view>
      <view class="save-ring" style="background: conic-gradient(var(--gold) 0deg, var(--gold) {{ringDeg}}deg, #FFE4DC {{ringDeg}}deg, #FFE4DC 360deg);">
        <text class="save-ring-text">{{plan_pct_text}}</text>
      </view>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width:{{plan_progress}}%"></view></view>
  </view>

  <!-- ===== 4个指标卡片 ===== -->
  <view class="indicator-grid">
    <view class="indicator-card" bindtap="go" data-url="/pages/plans/plans">
      <text class="indicator-num">{{plan_count}}</text>
      <text class="indicator-label">计划数</text>
    </view>
    <view class="indicator-card" bindtap="go" data-url="/pages/anniversaries/anniversaries">
      <text class="indicator-num">{{anni_count}}</text>
      <text class="indicator-label">纪念日</text>
    </view>
    <view class="indicator-card" bindtap="go" data-url="/pages/gifts/gifts">
      <text class="indicator-num">{{gift_count}}</text>
      <text class="indicator-label">礼物</text>
    </view>
    <view class="indicator-card" bindtap="go" data-url="/pages/level/level">
      <text class="indicator-num">{{together_days}}天</text>
      <text class="indicator-label">相伴</text>
    </view>
  </view>

  <!-- ===== 纪念日倒计时 ===== -->
  <view wx:if="{{nearestAnni}}" class="anni-banner" bindtap="go" data-url="/pages/anniversaries/anniversaries">
    <text class="anni-banner-icon">🎂</text>
    <view class="anni-banner-info">
      <text class="anni-banner-label">距离{{nearestAnni.title}}</text>
      <text class="anni-banner-days">{{nearestAnni.days}} 天</text>
    </view>
    <text class="anni-banner-arrow">›</text>
  </view>

  <!-- ===== 今日待办 ===== -->
  <view wx:if="{{pendingTodos.length}}" class="card">
    <view class="card-row" style="margin-bottom:8px">
      <text class="card-title">今日待办</text>
      <text class="card-sub" bindtap="go" data-url="/pages/todos/todos">全部 ›</text>
    </view>
    <view wx:for="{{pendingTodos}}" wx:key="id" class="tc-item">
      <text class="tc-check">⬜</text>
      <text class="tc-text">{{item.title}}</text>
    </view>
  </view>

  <!-- ===== 6宫格功能入口 ===== -->
  <view class="func-grid">
    <view class="func-item" bindtap="go" data-url="/pages/plans/plans">
      <view class="func-icon func-pink">💰</view>
      <text class="func-label">存钱</text>
    </view>
    <view class="func-item" bindtap="go" data-url="/pages/wishes/wishes">
      <view class="func-icon func-purple">🔮</view>
      <text class="func-label">心愿</text>
    </view>
    <view class="func-item" bindtap="go" data-url="/pages/todos/todos">
      <view class="func-icon func-green">📋</view>
      <text class="func-label">要做</text>
    </view>
    <view class="func-item" bindtap="go" data-url="/pages/tasks/tasks">
      <view class="func-icon func-orange">🎯</view>
      <text class="func-label">任务</text>
    </view>
    <view class="func-item" bindtap="go" data-url="/pages/anniversaries/anniversaries">
      <view class="func-icon func-pink">📅</view>
      <text class="func-label">纪念日</text>
    </view>
    <view class="func-item" bindtap="go" data-url="/pages/gifts/gifts">
      <view class="func-icon func-gold">🎁</view>
      <text class="func-label">礼物</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</scroll-view>
