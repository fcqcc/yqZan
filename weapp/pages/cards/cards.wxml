<!-- pages/cards/cards.wxml — 贺卡（毛玻璃网格） -->
<scroll-view class="page" scroll-y>
     4|  <view class="page-title">🎉 贺卡</view>
  <view class="page-subtitle">用精美贺卡记录每一个瞬间</view>

  <button class="btn btn-primary" style="margin:0 12px 14px" bindtap="showTemplates">✨ 生成贺卡</button>

  <!-- 模板选择弹层 -->
  <view wx:if="{{showTpl}}" class="overlay" bindtap="hideTemplates">
    <view class="sheet" catchtap="">
      <view class="sheet-title">选择模板</view>
      <scroll-view scroll-y style="max-height:400px">
        <view wx:for="{{templates}}" wx:key="id" class="tpl-item" bindtap="generate" data-id="{{item.id}}">
          <view class="tpl-name">{{item.name}}</view>
          <view class="tpl-desc">{{item.description}}</view>
          <view class="tpl-level">Lv{{item.min_level}}+</view>
        </view>
      </scroll-view>
      <button class="btn btn-outline btn-block" style="margin-top:8px" bindtap="hideTemplates">取消</button>
    </view>
  </view>

  <!-- 卡片网格 -->
  <view class="card-grid">
    <view wx:for="{{cards}}" wx:key="id" class="card-item">
      <text class="card-emoji">{{item.type === 'flip' ? '📖' : item.type === 'auto' ? '🎊' : '💌'}}</text>
      <view class="card-name">{{item.title}}</view>
      <view class="card-date">{{item.created_at.slice(0,10)}}</view>
      <text class="card-badge">{{item.type === 'flip' ? '翻页' : item.type === 'auto' ? '自动' : '模板'}}</text>
    </view>
  </view>

  <view wx:if="{{!cards.length && !showTpl}}" class="empty">还没有贺卡 ✨ 点击上方生成</view>
</scroll-view>
