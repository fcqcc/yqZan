/* 贺卡页 — 实色卡片网格 */
.page { padding-bottom: 24px; }

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  padding: 0 12px;
}
.card-item {
  background: #ffffff;
  border: 1px solid #ffd6e8;
  border-radius: var(--radius);
  padding: 16px 12px;
  box-shadow: var(--shadow-sm);
  text-align: center;
}
.card-item:active { transform: scale(.96); }
.card-emoji { font-size: 28px; display: block; margin-bottom: 6px; }
.card-name { font-size: 13px; font-weight: 600; color: var(--text); }
.card-date { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
.card-badge {
  display: inline-block;
  font-size: 10px;
  padding: 1px 8px;
  border-radius: var(--radius-pill);
  background: var(--pink-glass);
  color: var(--pink-dark);
  margin-top: 4px;
}
