/* 通用样式库 */
page {
  --primary: #9d2d5a;
  --gold: #c9a227;
  --bg: #f5f5f5;
  --card: #ffffff;
  --text: #333;
  --text-light: #999;
  --danger: #d4380d;
  --success: #2e7d32;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 12px;
  padding: 16px;
  margin: 8px 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,.06);
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 14px;
  border: none;
  transition: all .2s;
}
.btn-primary {
  background: linear-gradient(135deg, var(--primary), #c75b82);
  color: #fff;
}
.btn-primary:active { opacity: .8; }
.btn-outline {
  background: transparent;
  border: 1px solid var(--primary);
  color: var(--primary);
}
.btn-danger {
  background: var(--danger);
  color: #fff;
}
.btn-sm {
  padding: 6px 12px;
  font-size: 12px;
}

/* 输入框 */
.input {
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
}

/* 标题 */
.page-title {
  font-size: 20px;
  font-weight: 700;
  padding: 16px 12px 8px;
}
.page-subtitle {
  font-size: 13px;
  color: var(--text-light);
  padding: 0 12px 12px;
}

/* 进度条 */
.progress-bar {
  height: 6px;
  background: #f0f0f0;
  border-radius: 3px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), var(--primary));
  border-radius: 3px;
  transition: width .5s;
}

/* 统计网格 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.stat-item {
  flex: 1;
  min-width: 80px;
  background: #fafafa;
  border-radius: 8px;
  padding: 10px;
  text-align: center;
}
.stat-num {
  font-size: 20px;
  font-weight: 900;
  color: var(--primary);
}
.stat-label {
  font-size: 11px;
  color: var(--text-light);
  margin-top: 2px;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 40px 0;
  color: var(--text-light);
  font-size: 14px;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
}
.tag-active { background: #e8f5e9; color: #2e7d32; }
.tag-done { background: #e3f2fd; color: #1565c0; }
.tag-pending { background: #fff3e0; color: #e65100; }

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}
.list-item:last-child { border: none; }
.list-info { flex: 1; }
.list-title { font-weight: 600; font-size: 14px; }
.list-sub { font-size: 12px; color: var(--text-light); margin-top: 2px; }
