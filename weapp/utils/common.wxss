/* ===== 可爱手绘风（与原型一致）===== */
@import '../styles/theme-handdrawn.wxss';

page {
  --text: #5D4E60;
  --text-secondary: #8B7A8E;
  --text-light: #B8A9BB;
  --text-muted: #B8A9BB;
  --rose: #E891A4;
  --rose-light: #FADCE6;
  --rose-pale: #FFF0F5;
  --rose-deep: #D4708A;
  --peach: #E891A4;
  --lilac: #D4A0E8;
  --lilac-pale: #F5EDFF;
  --mint: #7BC67B;
  --pink: #E891A4;
  --pink-dark: #D4708A;
  --primary: #E891A4;
  --primary-light: #FADCE6;
  --primary-pale: #FFF0F5;
  --cream: #FFF9F5;
  --gold: #FFD93D;
  --gold-light: #FFF8E1;
  --purple: #D4A0E8;
  --purple-light: #F5EDFF;
  --pink-glass: rgba(232, 145, 164, 0.35);
  --white: #ffffff;
  --gradient-header: linear-gradient(135deg, #E891A4 0%, #FADCE6 100%);
  --hd-border: #F5C6D0;
  --hd-line-dot: #f0e0e4;
  --success: #7BC67B;

  --input-min-height: 48px;
  --input-padding-y: 13px;
  --input-padding-x: 16px;
  --input-font-size: 15px;
  --input-line-height: 1.45;
  --field-label-size: 13px;
  --field-label-weight: 600;
  --field-gap: 14px;

  --card-bg: #ffffff;
  --card-border: 2px dashed #F5C6D0;
  --shadow-sm: 3px 3px 0 rgba(232, 145, 164, 0.12);
  --shadow-md: 3px 3px 0 rgba(232, 145, 164, 0.15), 0 2px 8px rgba(232, 145, 164, 0.06);
  --shadow-lg: 4px 4px 0 rgba(212, 112, 138, 0.2), 0 4px 12px rgba(232, 145, 164, 0.1);
  --progress-bar-bg: rgba(232, 145, 164, 0.12);

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 20px;
  --radius-pill: 999px;
  --bg-start: #FFF9F5;
  --bg-mid: #FFF5F0;
  --bg-end: #FFE8EE;
  --radius: 16px;
  --glass-bg: #fffafb;
  --glass-border: 2px dashed #F5C6D0;
  --glass-blur: none;
  --glass-shadow: 3px 3px 0 rgba(232, 145, 164, 0.12);
  background:
    radial-gradient(circle at 20% 80%, rgba(232, 145, 164, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(168, 212, 230, 0.12) 0%, transparent 50%),
    linear-gradient(180deg, #FFF9F5 0%, #FFE8EE 100%);
  background-attachment: fixed;
  color: var(--text);
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12px;
}

.card {
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: 18px 8px 20px 10px;
  padding: 16px;
  margin: 8px 12px;
  box-shadow: var(--shadow-md);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.card:active {
  transform: scale(0.99);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10px 24px;
  border-radius: 25px 10px 25px 10px;
  font-size: 14px;
  font-weight: 600;
  border: none;
  transition: all 0.12s ease;
}
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--rose-deep) 100%);
  color: var(--white);
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}
.btn-primary:active {
  transform: translate(2px, 2px) scale(0.97);
  box-shadow: 1px 1px 0 rgba(212, 112, 138, 0.3);
}
.btn-outline {
  background: #fffafb;
  border: 2px dashed var(--hd-border);
  color: var(--text);
  box-shadow: 2px 2px 0 rgba(232, 145, 164, 0.12);
}
.btn-outline:active {
  transform: scale(0.96);
  opacity: 0.88;
}
.btn-danger {
  background: linear-gradient(135deg, #e57373, #c62828);
  color: #fff;
  box-shadow: var(--shadow-sm);
}
.btn-danger:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.btn-sm {
  padding: 6px 14px;
  font-size: 12px;
  border-radius: 14px 4px 14px 4px;
}
.btn-block {
  width: 100%;
}

.btn-money,
.btn-wish,
.btn-todo,
.btn-task,
.btn-anni,
.btn-gift,
.btn-note {
  background: linear-gradient(135deg, var(--primary) 0%, var(--rose-deep) 100%);
  color: var(--white);
  box-shadow: 3px 3px 0 rgba(212, 112, 138, 0.3);
}
.btn-money:active,
.btn-wish:active,
.btn-todo:active,
.btn-task:active,
.btn-anni:active,
.btn-gift:active,
.btn-note:active {
  transform: translate(2px, 2px) scale(0.97);
}

.input {
  background: #fffafb;
  border: 2px dashed var(--hd-border);
  border-radius: 14px 6px 14px 6px;
  min-height: var(--input-min-height);
  padding: var(--input-padding-y) var(--input-padding-x);
  font-size: var(--input-font-size);
  line-height: var(--input-line-height);
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.input:focus {
  border-color: var(--primary);
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(232, 145, 164, 0.12);
}
.input::placeholder {
  color: var(--text-secondary);
}

.field {
  margin-bottom: var(--field-gap);
}
.field-label {
  display: block;
  font-size: var(--field-label-size);
  font-weight: var(--field-label-weight);
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  padding: 14px 16px 2px;
  color: var(--text);
}

/* 自定义导航（融入渐变头部） */
.page-nav {
  width: 100%;
  box-sizing: border-box;
}
.page-nav__bar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.page-nav__title {
  font-size: 17px;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.5px;
}

.page-subtitle {
  font-size: 12px;
  color: var(--text-secondary);
  padding: 0 16px 10px;
}

.progress-bar {
  height: 10px;
  background: var(--progress-bar-bg);
  border: 2px solid #f0e8ec;
  border-radius: 8px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #E891A4 0%, #D4708A 50%, #FFD93D 100%);
  border-radius: 6px;
  transition: width 0.3s ease;
}

.tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 12px 4px 12px 4px;
  font-size: 11px;
  font-weight: 600;
  border: none;
  background: var(--primary-pale);
  color: var(--rose-deep);
}
.tag-promised {
  background: var(--primary-pale);
  color: var(--rose-deep);
}
.tag-in_progress {
  background: #E8F5E9;
  color: var(--success);
}
.tag-fulfilled {
  background: var(--purple-light);
  color: #6b4f9a;
}
.tag-pending {
  background: var(--primary-pale);
  color: var(--rose-deep);
}
.tag-accepted {
  background: rgba(255, 217, 61, 0.25);
  color: #b8860b;
}
.tag-verified {
  background: var(--purple-light);
  color: #6b4f9a;
}
.tag-declined {
  background: rgba(255, 180, 200, 0.45);
  color: #c6285c;
}
.tag-active {
  background: #E8F5E9;
  color: var(--success);
}
.tag-done {
  background: var(--primary-pale);
  color: var(--rose-deep);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 2px dotted var(--hd-line-dot);
}
.list-item:last-child {
  border-bottom: none;
}
.list-info {
  flex: 1;
  min-width: 0;
}
.list-title {
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
}
.list-sub {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.empty {
  text-align: center;
  padding: 40px 16px;
  color: var(--text-light);
  font-size: 14px;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
}
.overlay-dismiss {
  flex: 1;
  min-height: 0;
  width: 100%;
  align-self: stretch;
  background: rgba(232, 145, 164, 0.15);
}
.sheet {
  flex-shrink: 0;
  align-self: center;
  background: #fffafb;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 20px 16px 30px;
  width: 100%;
  max-width: 500px;
  box-sizing: border-box;
  border-top: 2px dashed var(--hd-border);
  box-shadow: 0 -8px 28px rgba(232, 145, 164, 0.14);
}
.sheet-title {
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  color: var(--text);
  padding-bottom: 12px;
  border-bottom: 2px dotted var(--hd-line-dot);
  margin-bottom: 14px;
}

.sheet-actions-inline {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  width: 80%;
  margin: 16px auto 4px;
  box-sizing: border-box;
}
.sheet-actions-inline .btn {
  flex: 1;
  margin: 0;
  min-width: 0;
}

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: transparent;
}
.nav-safe {
  height: env(safe-area-inset-top, 44px);
}
.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px 12px;
}
.nav-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5px;
}

.event-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 2px dotted var(--hd-line-dot);
}
.event-item:last-child {
  border-bottom: none;
}

.code {
  font-family: 'SF Mono', Monaco, monospace;
  color: var(--gold);
}

.card--closable,
.wish-card,
.plan-card {
  position: relative;
}

.card-close-hit {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  line-height: 1;
  font-weight: 300;
  color: var(--text-light);
  border-radius: var(--radius-sm);
}
.card-close-hit:active,
.card-close-hit--press {
  color: var(--rose);
  background: rgba(232, 145, 164, 0.12);
}

/* ============================================================
   交互特效动画库
   ============================================================ */

/* ----- 1. 交错列表入场 ----- */
.anim-stagger > .anim-item { opacity: 0; transform: translateY(24rpx); }
.anim-stagger > .anim-item:nth-child(1)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.03s forwards; }
.anim-stagger > .anim-item:nth-child(2)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.06s forwards; }
.anim-stagger > .anim-item:nth-child(3)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.09s forwards; }
.anim-stagger > .anim-item:nth-child(4)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.12s forwards; }
.anim-stagger > .anim-item:nth-child(5)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.15s forwards; }
.anim-stagger > .anim-item:nth-child(6)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.18s forwards; }
.anim-stagger > .anim-item:nth-child(7)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.21s forwards; }
.anim-stagger > .anim-item:nth-child(8)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.24s forwards; }
.anim-stagger > .anim-item:nth-child(9)  { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.27s forwards; }
.anim-stagger > .anim-item:nth-child(10) { animation: staggerIn 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) 0.30s forwards; }
@keyframes staggerIn {
  0%   { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ----- 2. 按钮涟漪波纹 ----- */
.btn-ripple {
  position: relative;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}
.btn-ripple::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at var(--ripple-x, 50%) var(--ripple-y, 50%), rgba(255,255,255,0.4) 0%, transparent 70%);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.btn-ripple:active::after {
  opacity: 1;
  animation: rippleOut 0.5s ease-out forwards;
}
@keyframes rippleOut {
  0%   { transform: scale(0.5); opacity: 0.5; }
  100% { transform: scale(2.5); opacity: 0; }
}

/* ----- 3. 数字跳动 ----- */
.anim-count {
  display: inline-block;
}
.anim-count--up {
  animation: countPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes countPop {
  0%   { transform: scale(0.5); opacity: 0.3; }
  70%  { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

/* ----- 4. 进度条流光 ----- */
.progress-shine .plan-card__bar-fill,
.progress-shine .progress-fill {
  position: relative;
  overflow: hidden;
}
.progress-shine .plan-card__bar-fill::before,
.progress-shine .progress-fill::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  animation: shineSweep 2.4s ease-in-out infinite;
}
@keyframes shineSweep {
  0%   { left: -60%; }
  100% { left: 160%; }
}

/* ----- 5. 骨架屏闪烁 ----- */
.shimmer {
  background: linear-gradient(90deg, var(--primary-pale) 0%, #FFF5F8 40%, var(--primary-pale) 80%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}
.shimmer--text { height: 28rpx; width: 60%; margin-bottom: 8rpx; }
.shimmer--title { height: 34rpx; width: 40%; margin-bottom: 12rpx; }
.shimmer--card { height: 180rpx; border-radius: 24rpx; margin-bottom: 14rpx; }
@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ----- 6. 弹窗/提示弹入 ----- */
.anim-pop-in {
  animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes popIn {
  0%   { opacity: 0; transform: scale(0.7) translateY(20rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* ----- 7. 爱心飘浮装饰 ----- */
.anim-float-heart {
  display: inline-block;
  animation: floatHeart 1.8s ease-in-out infinite;
}
@keyframes floatHeart {
  0%, 100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-10rpx) scale(1.08); }
}

/* ----- 8. 卡片点击反馈 ----- */
.card-tap {
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}
.card-tap:active {
  transform: scale(0.97) translate(1rpx, 1rpx);
  box-shadow: 2rpx 2rpx 0 rgba(232, 145, 164, 0.12);
}

/* ----- 9. 标签切换滑动 ----- */
.anim-tab-slide {
  transition: all 0.2s cubic-bezier(0.34, 1.2, 0.64, 1);
}

/* ----- 10. 标记打勾动画 ----- */
.anim-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: var(--success);
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  animation: checkPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes checkPop {
  0%   { transform: scale(0); }
  60%  { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* ----- 11. 页面进入渐入 ----- */
.anim-fade-in {
  animation: fadeIn 0.3s ease both;
}
@keyframes fadeIn {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}
