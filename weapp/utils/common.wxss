/* ===== 全局设计规范 v2 ===== */
page {
  /* 色彩系统 */
  --pink: #FFB7B2;
  --pink-dark: #E89088;
  --cream: #FFF0E3;
  --gold: #D4AF37;
  --gold-light: #F5E6B8;
  --purple: #C5A3FF;
  --purple-light: #EDE0FF;

  --text: #3E3A39;
  --text-secondary: #8E8A89;
  --text-light: #B5B0AE;
  --white: #FFFFFF;

  --card-bg: rgba(255, 248, 240, 0.92);
  --card-border: 0.5px solid rgba(255, 255, 255, 0.5);
  --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 6px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.06);

  --radius-sm: 12px;
  --radius-md: 24px;
  --radius-lg: 30px;
  --radius-pill: 999px;

  font-family: 'PingFang SC', -apple-system, 'Helvetica Neue', sans-serif;
  background: linear-gradient(180deg, #FFF0E3 0%, #FFF5ED 50%, #FFFAF5 100%);
  background-attachment: fixed;
  color: var(--text);
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

/* ===== 卡片通用 ===== */
.card {
  background: var(--card-bg);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: var(--card-border);
  border-radius: var(--radius-md);
  padding: 16px;
  box-shadow: var(--shadow-md);
  transition: all 0.2s ease;
}
.card:active {
  transform: scale(0.99);
  background: rgba(255, 248, 240, 1);
}

/* 列表容器 */
.list-container {
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* 卡片内行布局 */
.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.card-row:last-child { margin-bottom: 0; }

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text);
}
.card-sub {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
}
.card-stat {
  font-size: 20px;
  font-weight: 700;
  color: var(--gold);
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 6px;
  background: #FFE4DC;
  border-radius: var(--radius-pill);
  overflow: hidden;
  margin: 12px 0 8px;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--gold));
  border-radius: var(--radius-pill);
  transition: width 0.3s ease;
}

/* ===== 标签 ===== */
.tag {
  background: #FFE4DC;
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-size: 12px;
  color: var(--text);
  font-weight: 500;
}
.tag-gold {
  background: linear-gradient(135deg, var(--gold-light), #FFF5E0);
  color: #8B7332;
}
.tag-done {
  background: var(--purple-light);
  color: #7B52CC;
}
.tag-pending {
  background: #FFE4DC;
  color: #B07060;
}

/* ===== 毛玻璃按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 24px;
  border-radius: var(--radius-lg);
  font-size: 14px;
  font-weight: 600;
  border: none;
  transition: all 0.1s ease;
}
.btn-primary {
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: var(--white);
  box-shadow: var(--shadow-sm);
}
.btn-primary:active { transform: scale(0.96); opacity: 0.8; }
.btn-outline {
  background: var(--card-bg);
  border: 0.5px solid var(--pink);
  color: var(--text);
  backdrop-filter: blur(8px);
}
.btn-outline:active { transform: scale(0.96); opacity: 0.8; }
.btn-sm {
  padding: 6px 16px;
  font-size: 12px;
  border-radius: var(--radius-pill);
}
.btn-block { width: 100%; }

/* 模块专属按钮 */
.btn-money { background: linear-gradient(135deg, var(--pink), var(--pink-dark)); color: white; }
.btn-wish { background: linear-gradient(135deg, var(--purple), #B388FF); color: white; }
.btn-todo { background: linear-gradient(135deg, #81C784, #66BB6A); color: white; }
.btn-task { background: linear-gradient(135deg, #FFB74D, #FF9800); color: white; }
.btn-anni { background: linear-gradient(135deg, var(--pink), var(--pink-dark)); color: white; }
.btn-gift { background: linear-gradient(135deg, var(--gold), #C59B27); color: white; }

/* ===== 输入框 ===== */
.input {
  background: rgba(255, 248, 240, 0.6);
  backdrop-filter: blur(8px);
  border: 0.5px solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-sm);
  padding: 11px 14px;
  font-size: 14px;
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
  transition: all 0.2s;
}
.input:focus {
  border-color: var(--pink);
  background: rgba(255, 248, 240, 0.9);
  box-shadow: 0 0 0 3px rgba(255, 183, 178, 0.15);
}
.input::placeholder { color: var(--text-secondary); }

/* ===== 导航栏 ===== */
.nav-bar { position: sticky; top: 0; z-index: 50; background: transparent; }
.nav-safe { height: env(safe-area-inset-top, 44px); }
.nav-content {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 16px 12px;
}
.nav-title { font-size: 20px; font-weight: 600; color: var(--text); }

/* ===== 页面标题 ===== */
.page-title {
  font-size: 22px;
  font-weight: 600;
  padding: 14px 16px 4px;
  color: var(--text);
}
.page-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  padding: 0 16px 12px;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 60px 16px;
  color: var(--text-secondary);
  font-size: 14px;
}

/* ===== 弹层 ===== */
.overlay {
  position: fixed; inset: 0;
  background: rgba(62, 58, 57, 0.2);
  z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  background: var(--card-bg);
  backdrop-filter: blur(16px);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  padding: 20px 16px 30px;
  width: 100%;
  max-width: 500px;
  border-top: var(--card-border);
}
.sheet-title {
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  color: var(--text);
  padding-bottom: 12px;
  border-bottom: 0.5px solid rgba(0,0,0,0.06);
  margin-bottom: 14px;
}

/* ===== 列表项通用 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: 8px 0;
}
.list-info { flex: 1; min-width: 0; }
.list-title { font-size: 16px; font-weight: 600; color: var(--text); }
.list-sub { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

/* ===== 统计网格 ===== */
.stat-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.stat-item {
  flex: 1; min-width: 60px;
  background: var(--card-bg);
  backdrop-filter: blur(8px);
  border: var(--card-border);
  border-radius: var(--radius-sm);
  padding: 10px 6px;
  text-align: center;
}
.stat-num { font-size: 20px; font-weight: 700; color: var(--gold); }
.stat-label { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
