/* ===== 偏粉实色风（与 theme-global 一致，无毛玻璃）===== */
page {
  --text: #3d2c38;
  --pink: #f8a5c4;
  --pink-dark: #d65c8a;
  --cream: #fff5f9;
  --gold: #c9a0b2;
  --gold-light: #f5e3ec;
  --purple: #b59ed4;
  --purple-light: #f3ecfc;
  --pink-glass: rgba(248, 165, 196, 0.35);
  --text-secondary: #8a6a7a;
  --text-light: #b89aa8;
  --white: #ffffff;

  --input-min-height: 48px;
  --input-padding-y: 13px;
  --input-padding-x: 16px;
  --input-font-size: 15px;
  --input-line-height: 1.45;
  --field-label-size: 13px;
  --field-label-weight: 600;
  --field-gap: 14px;

  --card-bg: #ffffff;
  --card-border: 1px solid #ffd6e8;
  --shadow-sm: 0 2px 10px rgba(214, 92, 138, 0.1);
  --shadow-md: 0 8px 24px rgba(214, 92, 138, 0.12), 0 2px 8px rgba(214, 92, 138, 0.06);
  --shadow-lg: 0 14px 36px rgba(214, 92, 138, 0.14), 0 4px 12px rgba(214, 92, 138, 0.08);
  --progress-bar-bg: rgba(214, 92, 138, 0.15);

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 20px;
  --radius-pill: 999px;
  --bg-start: #fff5fb;
  --bg-mid: #ffe8f2;
  --bg-end: #ffd6ea;
  --text-muted: #b89aa8;
  --radius: 16px;
  --glass-bg: #fff8fc;
  --glass-border: 1px solid #ffd6e8;
  --glass-blur: none;
  --glass-shadow: 0 8px 22px rgba(214, 92, 138, 0.1);
  background: linear-gradient(165deg, #fff5fb 0%, #ffe8f2 42%, #ffd6ea 100%);
  background-attachment: fixed;
  color: var(--text);
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12px;
}

.card {
  background: var(--card-bg);
  border: var(--card-border);
  border-radius: var(--radius-md);
  padding: 16px;
  margin: 8px 12px;
  box-shadow: var(--shadow-md);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.card:active {
  transform: scale(0.99);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10px 24px;
  border-radius: var(--radius-lg);
  font-size: 14px;
  font-weight: 600;
  border: none;
  transition: all 0.12s ease;
}
.btn-primary {
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: var(--white);
  box-shadow: var(--shadow-sm);
}
.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.88;
}
.btn-outline {
  background: #fff8fc;
  border: 1px solid rgba(214, 92, 138, 0.28);
  color: var(--text);
}
.btn-outline:active {
  transform: scale(0.96);
  opacity: 0.88;
}
.btn-danger {
  background: linear-gradient(135deg, #e57373, #c62828);
  color: #fff;
  box-shadow: var(--shadow-sm);
}
.btn-danger:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.btn-sm {
  padding: 6px 14px;
  font-size: 12px;
  border-radius: var(--radius-pill);
}
.btn-block {
  width: 100%;
}

.btn-money,
.btn-wish,
.btn-todo,
.btn-task,
.btn-anni,
.btn-gift,
.btn-note {
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: var(--white);
  box-shadow: var(--shadow-sm);
}
.btn-money:active,
.btn-wish:active,
.btn-todo:active,
.btn-task:active,
.btn-anni:active,
.btn-gift:active,
.btn-note:active {
  transform: scale(0.96);
  opacity: 0.88;
}

.input {
  background: #fff8fc;
  border: 1px solid #ffd6e8;
  border-radius: var(--radius-sm);
  min-height: var(--input-min-height);
  padding: var(--input-padding-y) var(--input-padding-x);
  font-size: var(--input-font-size);
  line-height: var(--input-line-height);
  width: 100%;
  box-sizing: border-box;
  color: var(--text);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.input:focus {
  border-color: rgba(214, 92, 138, 0.55);
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(214, 92, 138, 0.12);
}
.input::placeholder {
  color: var(--text-secondary);
}

.field {
  margin-bottom: var(--field-gap);
}
.field-label {
  display: block;
  font-size: var(--field-label-size);
  font-weight: var(--field-label-weight);
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  padding: 14px 16px 2px;
  color: var(--text);
}
.page-subtitle {
  font-size: 12px;
  color: var(--text-secondary);
  padding: 0 16px 10px;
}

.progress-bar {
  height: 6px;
  background: var(--progress-bar-bg);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink), var(--gold), var(--purple));
  background-size: 200% 100%;
  border-radius: var(--radius-pill);
  transition: width 0.3s ease;
}

.tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-weight: 600;
}
.tag-promised {
  background: rgba(248, 165, 196, 0.4);
  color: #a03068;
}
.tag-in_progress {
  background: rgba(248, 165, 196, 0.32);
  color: #b84a78;
}
.tag-fulfilled {
  background: var(--purple-light);
  color: #6b4f9a;
}
.tag-pending {
  background: rgba(248, 165, 196, 0.32);
  color: #a03068;
}
.tag-accepted {
  background: rgba(201, 160, 178, 0.35);
  color: #6d4a5c;
}
.tag-verified {
  background: var(--purple-light);
  color: #6b4f9a;
}
.tag-declined {
  background: rgba(255, 180, 200, 0.45);
  color: #c6285c;
}
.tag-active {
  background: rgba(214, 92, 138, 0.14);
  color: var(--pink-dark);
}
.tag-done {
  background: var(--purple-light);
  color: #6b4f9a;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid rgba(42, 36, 38, 0.06);
}
.list-item:last-child {
  border-bottom: none;
}
.list-info {
  flex: 1;
  min-width: 0;
}
.list-title {
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
}
.list-sub {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.empty {
  text-align: center;
  padding: 40px 16px;
  color: var(--text-light);
  font-size: 14px;
}

/* 底部表单弹层：勿在整块 overlay 上 bindtap 关闭——input/picker 等原生区会触摸穿透，误点遮罩。
   用 overlay-dismiss（flex:1，仅占表单上方）承接「点空白关闭」。 */
.overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
}
.overlay-dismiss {
  flex: 1;
  min-height: 0;
  width: 100%;
  align-self: stretch;
  background: rgba(255, 255, 255, 0.38);
}
.sheet {
  flex-shrink: 0;
  align-self: center;
  background: #fffafc;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 20px 16px 30px;
  width: 100%;
  max-width: 500px;
  box-sizing: border-box;
  border-top: 1px solid #ffd6e8;
  box-shadow: 0 -8px 28px rgba(214, 92, 138, 0.12);
}
.sheet-title {
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  color: var(--text);
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(42, 36, 38, 0.08);
  margin-bottom: 14px;
}

/* 弹层底部：取消 + 主按钮同一行，占 sheet 内宽的 80%，取消左、主按钮右 */
.sheet-actions-inline {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  gap: 12px;
  width: 80%;
  margin: 16px auto 4px;
  box-sizing: border-box;
}
.sheet-actions-inline .btn {
  flex: 1;
  margin: 0;
  min-width: 0;
}

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: transparent;
}
.nav-safe {
  height: env(safe-area-inset-top, 44px);
}
.nav-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px 12px;
}
.nav-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5px;
}

.event-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(42, 36, 38, 0.06);
}
.event-item:last-child {
  border-bottom: none;
}

.code {
  font-family: 'SF Mono', Monaco, monospace;
  color: var(--gold);
}

/* 列表卡片右上角关闭/删除（×） */
.card--closable,
.wish-card,
.plan-card {
  position: relative;
}

.card-close-hit {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  line-height: 1;
  font-weight: 300;
  color: var(--text-light);
  border-radius: var(--radius-sm);
}
.card-close-hit:active,
.card-close-hit--press {
  color: var(--pink-dark);
  background: rgba(214, 92, 138, 0.12);
}
